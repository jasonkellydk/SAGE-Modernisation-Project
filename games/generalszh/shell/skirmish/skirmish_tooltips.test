#include <boost/test/unit_test.hpp>

import std;

import games.generalszh.shell.skirmish.skirmish_tooltips;

using namespace generalszh::shell;

BOOST_AUTO_TEST_SUITE(skirmish_tooltips)

// Core/GameEngine/Source/GameNetwork/GameSpy/LobbyUtils.cpp playerTemplateComboBoxTooltip / playerTemplateListBoxTooltip:
// the faction box's chosen row's ArmyTooltip (row 0, Random: TOOLTIP:BioStrategyLong_Random), the open list's row with
// no delay (0), nothing set off its rows.
BOOST_AUTO_TEST_CASE(legacy_parity_a_faction_box_tells_its_armys_strategy)
{
	SetupCatalog catalog;
	catalog.factions = {{2, u"USA", "TOOLTIP:BioStrategyLong_USA"}, {3, u"China", "TOOLTIP:BioStrategyLong_China"}};
	BOOST_TEST((FactionTooltip(catalog, 0) == TooltipCall{"TOOLTIP:BioStrategyLong_Random"}));
	BOOST_TEST((FactionTooltip(catalog, 2) == TooltipCall{"TOOLTIP:BioStrategyLong_China"}));
	BOOST_TEST((FactionTooltip(catalog, 9) == TooltipCall{}));
	BOOST_TEST((FactionListTooltip(catalog, 1) == TooltipCall{"TOOLTIP:BioStrategyLong_USA", 0}));
	BOOST_TEST(!FactionListTooltip(catalog, -1).has_value());
}

// GeneralsMD/.../SkirmishMapSelectMenu.cpp mapListTooltipFunc with Core/.../MapUtil.cpp populateMapListboxNoReset's
// item data: no medal 0 (TOOLTIP:MapNoSuccess) .. every brutal opponent beaten 4 (TOOLTIP:MapMaxBrutalSuccess); a map
// that is not a multiplayer one (-1) and a point off the cells: an empty tooltip.
BOOST_AUTO_TEST_CASE(legacy_parity_the_map_list_tells_the_medal_won_there)
{
	const std::vector<int> levels{0, 1, 2, 3, 4, -1};
	BOOST_TEST(MapListTooltip(levels, 0, 1).label == "TOOLTIP:MapNoSuccess");
	BOOST_TEST(MapListTooltip(levels, 1, 0).label == "TOOLTIP:MapEasySuccess");
	BOOST_TEST(MapListTooltip(levels, 2, 1).label == "TOOLTIP:MapMediumSuccess");
	BOOST_TEST(MapListTooltip(levels, 3, 1).label == "TOOLTIP:MapHardSuccess");
	BOOST_TEST(MapListTooltip(levels, 4, 1).label == "TOOLTIP:MapMaxBrutalSuccess");
	BOOST_TEST(MapListTooltip(levels, 5, 1).label.empty());
	BOOST_TEST(MapListTooltip(levels, 2, -1).label.empty());
	BOOST_TEST(MapListTooltip(levels, -1, 0).label.empty());
}

// GeneralsMD/.../PopupPlayerInfo.cpp BattleHonorTooltip over SkirmishGameOptionsMenu.cpp populateSkirmishBattleHonors'
// list (InsertBattleHonor's item data: the honour's bit, BATTLE_HONOR_NOT_GAINED until gained, the streak's and wins'
// counts in the spacer row above): a fresh record shows the "Disabled" texts at 1.5 the width; a streak of 12 and 120
// wins their steps; a spacer cell holds the count below it (0: TOOLTIP:BattleHonors; 128 wins happen to be
// BATTLE_HONOR_BATTLE_TANK's bit, so the spacer over domination then tells the battle tank's honour, as the original);
// off the cells TOOLTIP:BattleHonors at the normal width.
BOOST_AUTO_TEST_CASE(legacy_parity_battle_honors_tell_what_each_is)
{
	SetupCatalog catalog;
	engine::config::Preferences fresh = engine::config::Preferences::Parse("");
	auto rows = BattleHonors(fresh, catalog);
	BOOST_TEST_REQUIRE(rows.size() == 4u);
	BOOST_TEST((BattleHonorTooltip(rows, 1, 0) == TooltipCall{"TOOLTIP:BattleHonorCampaignChinaDisabled", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 1, 3) == TooltipCall{"TOOLTIP:BattleHonorCampaignChallengeDisabled", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 1, 5) == TooltipCall{"TOOLTIP:BattleHonorBattleTankDisabled", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 3, 2) == TooltipCall{"TOOLTIP:BattleHonorBlitzDisabled", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 3, 3) == TooltipCall{"TOOLTIP:BattleHonorStreakDisabled", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 3, 5) == TooltipCall{"TOOLTIP:BattleHonorUltimate", -1, 1.5f})); // no official maps: perfect
	BOOST_TEST((BattleHonorTooltip(rows, 0, 0) == TooltipCall{"TOOLTIP:BattleHonors"}));
	BOOST_TEST((BattleHonorTooltip(rows, -1, 0) == TooltipCall{"TOOLTIP:BattleHonors"}));
	BOOST_TEST((BattleHonorTooltip(rows, 3, -1) == TooltipCall{"TOOLTIP:BattleHonors"}));

	engine::config::Preferences veteran = engine::config::Preferences::Parse("BestWinStreak = 12\nWins = 128\nHonors = 16640\n");
	rows = BattleHonors(veteran, catalog); // Honors 0x4100: blitz 5, air wing
	BOOST_TEST((BattleHonorTooltip(rows, 1, 4) == TooltipCall{"TOOLTIP:BattleHonorAirWing", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 3, 2) == TooltipCall{"TOOLTIP:BattleHonorBlitz5", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 3, 3) == TooltipCall{"TOOLTIP:BattleHonorStreak10", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 3, 4) == TooltipCall{"TOOLTIP:BattleHonorDomination100", -1, 1.5f}));
	BOOST_TEST((BattleHonorTooltip(rows, 2, 4) == TooltipCall{"TOOLTIP:BattleHonorBattleTank", -1, 1.5f}));
	BOOST_TEST(!BattleHonorTooltip(rows, 2, 3).has_value()); // 12 (0x8 | 0x4): no honour's bit, nothing set
}

// GeneralsMD/.../SkirmishGameOptionsMenu.cpp MapSelectorTooltip with positionAdditionalImages' marker squares: on a
// 200 x 150 picture filling the window at (100, 100), a tech building at the middle has its 15-pixel square from
// (193, 168) (100 - 7 and 75 - 7 in the window): strictly inside it (194..207, 169..182) gives TOOLTIP:TechBuilding,
// its edges nothing; a supply dock's square TOOLTIP:SupplyDock; a tech building over a dock wins.
BOOST_AUTO_TEST_CASE(legacy_parity_the_map_preview_tells_tech_buildings_and_supply_docks)
{
	MapPreview preview;
	preview.techs = {{5000, 5000}};
	preview.supplies = {{1000, 1000}, {5000, 5000}};
	const auto at = [&](int x, int y) { return MapSelectorTooltip(preview, 100, 100, 100, 100, 200, 150, 15, x, y); };
	BOOST_TEST(at(200, 175)->label == "TOOLTIP:TechBuilding");
	BOOST_TEST(at(194, 169)->label == "TOOLTIP:TechBuilding");
	BOOST_TEST(at(207, 182)->label == "TOOLTIP:TechBuilding");
	BOOST_TEST(!at(193, 175).has_value());
	BOOST_TEST(!at(208, 175).has_value());
	BOOST_TEST(!at(200, 183).has_value());
	BOOST_TEST(at(120, 110)->label == "TOOLTIP:SupplyDock"); // its square from (113, 108)
	BOOST_TEST(!at(150, 150).has_value());
}

BOOST_AUTO_TEST_SUITE_END()
