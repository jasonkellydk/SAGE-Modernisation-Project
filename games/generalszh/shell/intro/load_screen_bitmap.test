#include <boost/test/unit_test.hpp>

#include <array>
#include <cstddef>
#include <span>
#include <cstdint>
#include <cstdlib>
#include <filesystem>
#include <fstream>
#include <iterator>
#include <vector>

import games.generalszh.shell.intro.load_screen_bitmap;

using namespace generalszh::shell;

namespace
{
// A 24-bit bitmap `width` x `height`, bottom-up, each pixel's (blue, green, red) from `pixel(x, y)` (y from the top).
template<typename Pixel>
std::vector<std::byte> Bitmap(std::int32_t width, std::int32_t height, Pixel pixel)
{
	const std::size_t stride = (static_cast<std::size_t>(width) * 3 + 3) & ~std::size_t{3};
	std::vector<std::byte> bytes(54 + stride * height, std::byte{0});
	const auto put = [&](std::size_t at, std::uint32_t value, int count) {
		for (int i = 0; i < count; ++i)
			bytes[at + i] = static_cast<std::byte>((value >> (8 * i)) & 0xFF);
	};
	bytes[0] = std::byte{'B'};
	bytes[1] = std::byte{'M'};
	put(2, static_cast<std::uint32_t>(bytes.size()), 4);
	put(10, 54, 4);
	put(14, 40, 4);
	put(18, static_cast<std::uint32_t>(width), 4);
	put(22, static_cast<std::uint32_t>(height), 4);
	put(26, 1, 2);
	put(28, 24, 2);
	for (std::int32_t y = 0; y < height; ++y)
		for (std::int32_t x = 0; x < width; ++x)
		{
			const auto [b, g, r] = pixel(x, y);
			const std::size_t at = 54 + stride * static_cast<std::size_t>(height - 1 - y) + static_cast<std::size_t>(x) * 3;
			bytes[at] = std::byte{b};
			bytes[at + 1] = std::byte{g};
			bytes[at + 2] = std::byte{r};
		}
	return bytes;
}

struct Bgr
{
	std::uint8_t b, g, r;
};
}

BOOST_AUTO_TEST_SUITE(load_screen_bitmap)

// WinMain's load screen bitmap (LoadImage LR_LOADFROMFILE): a 24-bit Windows bitmap stores its rows bottom-up, padded to
// four bytes, each pixel blue, green, red; drawn opaque (BitBlt SRCCOPY). A 3 x 2 bitmap whose top-left pixel is red
// and bottom-right blue reads top row first, RGBA.
BOOST_AUTO_TEST_CASE(legacy_parity_a_bottom_up_24_bit_bitmap_reads_top_row_first)
{
	const auto bytes = Bitmap(3, 2, [](std::int32_t x, std::int32_t y) {
		if (x == 0 && y == 0)
			return Bgr{0, 0, 255};
		if (x == 2 && y == 1)
			return Bgr{255, 0, 0};
		return Bgr{0, 128, 0};
	});
	const auto bitmap = DecodeLoadScreenBitmap(bytes);
	BOOST_TEST_REQUIRE(bitmap.has_value());
	BOOST_TEST(bitmap->width == 3u);
	BOOST_TEST(bitmap->height == 2u);
	const auto at = [&](std::uint32_t x, std::uint32_t y, std::uint32_t channel) { return std::to_integer<int>(bitmap->rgba[(y * 3 + x) * 4 + channel]); };
	BOOST_TEST(at(0, 0, 0) == 255); // red
	BOOST_TEST(at(0, 0, 2) == 0);
	BOOST_TEST(at(0, 0, 3) == 255);
	BOOST_TEST(at(2, 1, 2) == 255); // blue
	BOOST_TEST(at(1, 0, 1) == 128);
	// A blit covers no more than the bitmap, and no more than 800 x 600.
	BOOST_TEST((LoadScreenBlitSize(*bitmap) == std::array<std::uint32_t, 2>{3, 2}));
	BOOST_TEST(!DecodeLoadScreenBitmap(std::span(bytes).first(40)).has_value());
}

// The shipped Install_Final.bmp (the install's root): 800 x 600, all of it blitted at the window's corner.
BOOST_AUTO_TEST_CASE(legacy_parity_the_installs_load_screen_is_800_by_600)
{
	const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
	if (install == nullptr || !std::filesystem::exists(std::filesystem::path(install) / "Install_Final.bmp"))
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	std::ifstream file(std::filesystem::path(install) / "Install_Final.bmp", std::ios::binary);
	std::vector<char> raw((std::istreambuf_iterator<char>(file)), std::istreambuf_iterator<char>());
	const auto bitmap = DecodeLoadScreenBitmap(std::as_bytes(std::span(raw)));
	BOOST_TEST_REQUIRE(bitmap.has_value());
	BOOST_TEST(bitmap->width == 800u);
	BOOST_TEST(bitmap->height == 600u);
	BOOST_TEST((LoadScreenBlitSize(*bitmap) == std::array<std::uint32_t, 2>{800, 600}));
}

BOOST_AUTO_TEST_SUITE_END()
