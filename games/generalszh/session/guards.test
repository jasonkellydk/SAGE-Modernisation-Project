// AIGuardMachine (AIGuard.cpp: AIGuardState::onEnter, AIGuardInnerState, AIGuardOuterState, AIGuardReturnState,
// AIGuardIdleState, lookForInnerTarget) on the live shell map.
using namespace generalszh;
