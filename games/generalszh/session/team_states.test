// Teams' own scripts on the live shell map, apart from session.test (one module set per translation unit keeps within
// the compiler's source-location limit).
using namespace generalszh;
namespace level = engine::level;

namespace
{
struct ShellContent
{
	engine::filesystem::VirtualFileSystem files;
	engine::config::Diagnostics grammarDiagnostics;
	std::optional<content::ContentLoader> loader;
	content::GameContent game;
	std::optional<engine::level::generals_map::ReadResult> map;

	bool Load()
	{
		const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
		if (install == nullptr || !std::filesystem::exists(install))
			return false;
		content::MountInstall(files, install);
		loader.emplace(files, content::ZeroHourIniGrammar(grammarDiagnostics));
		game = content::LoadGameContent(*loader, engine::time::FixedStep{30});
		auto read = engine::level::generals_map::Read(*files.Read("Maps/ShellMapMD/ShellMapMD.map"));
		if (!read)
			return false;
		map.emplace(std::move(*read));
		return true;
	}
};

ShellContent &Content()
{
	static ShellContent content;
	static const bool loaded = content.Load();
	(void)loaded;
	return content;
}
}

BOOST_AUTO_TEST_SUITE(shell_map_team_states)

level::ScriptCall Call(std::string name, std::vector<std::string> texts = {}, std::int64_t integer = 0)
{
	level::ScriptCall call;
	call.name = std::move(name);
	for (std::string &text : texts)
	{
		level::ScriptParameter parameter;
		parameter.text = std::move(text);
		call.parameters.push_back(std::move(parameter));
	}
	if (!call.parameters.empty())
		call.parameters.front().integer = integer;
	return call;
}

// INCREMENT_COUNTER(amount, name).
level::ScriptCall Increment(std::string counter)
{
	level::ScriptParameter amount;
	amount.integer = 1;
	level::ScriptParameter name;
	name.text = std::move(counter);
	level::ScriptCall call;
	call.name = "INCREMENT_COUNTER";
	call.parameters = {amount, name};
	return call;
}

level::Script Subroutine(std::string name, std::vector<level::ScriptCall> actions, bool oneShot = false)
{
	level::Script script;
	script.name = std::move(name);
	script.subroutine = true;
	script.oneShot = oneShot;
	script.conditions = {{Call("CONDITION_TRUE")}};
	script.actions = std::move(actions);
	return script;
}

// Team::updateState / Team::updateGenericScripts (GeneralsMD Common/RTS/Team.cpp), with doCreateReinforcements
// (ScriptActions.cpp: a new instance, setActive once its units are out) and ScriptEngine::update's order (the side
// scripts, then ThePlayerList->updateTeamStates, then the objects, then Player::update's generic scripts). A script on
// tick 1 brings in four Humvees of a civilian team at a waypoint:
// - on-create runs on tick 1, in the same tick's team update, once;
// - on-idle needs two idle looks in a row (the team's update sees the members as the last tick's systems left them),
//   then runs every tick;
// - a one-shot generic script runs once (tick 1), a repeating one every tick from tick 1;
// - on-destroyed at DestroyedThreshold 0.5 of four: at two left (4 - 4 * 0.5), once. The kills are requested before a
//   tick and land in its systems, after that tick's team update: the team sees them on the next tick.
BOOST_AUTO_TEST_CASE(legacy_parity_a_teams_own_scripts_run_on_create_idle_generic_and_destroyed)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	std::string waypoint;
	for (const auto &marker : level.markers)
		if (!marker.name.empty())
		{
			waypoint = marker.name;
			break;
		}
	BOOST_TEST_REQUIRE(!waypoint.empty());
	engine::level::Properties team;
	team.Set("teamName", std::string("TestHumvees"));
	team.Set("teamOwner", std::string("PlyrCivilian"));
	team.Set("teamIsSingleton", false);
	team.Set("teamUnitType1", std::string("AmericaVehicleHumvee"));
	team.Set("teamUnitMaxCount1", std::int64_t{4});
	team.Set("teamOnCreateScript", std::string("tsCreate"));
	team.Set("teamOnIdleScript", std::string("tsIdle"));
	team.Set("teamOnDestroyedScript", std::string("tsDestroyed"));
	team.Set("teamDestroyedThreshold", Engine::Math::Fixed::FromRatio(1, 2));
	team.Set("teamGenericScriptHook0", std::string("tsGenericOnce"));
	team.Set("teamGenericScriptHook1", std::string("tsGenericEvery"));
	level.scenario.groups.push_back(team);
	auto &scripts = level.scenario.participants.front().scripts.scripts;
	level::Script spawn;
	spawn.name = "tsSpawn";
	spawn.oneShot = true;
	spawn.conditions = {{Call("CONDITION_TRUE")}};
	spawn.actions = {Call("CREATE_REINFORCEMENT_TEAM", {"TestHumvees", waypoint})};
	scripts.push_back(spawn);
	scripts.push_back(Subroutine("tsCreate", {Increment("created")}));
	scripts.push_back(Subroutine("tsIdle", {Increment("idle")}));
	scripts.push_back(Subroutine("tsDestroyed", {Increment("destroyed")}));
	scripts.push_back(Subroutine("tsGenericOnce", {Increment("genericOnce")}, true));
	scripts.push_back(Subroutine("tsGenericEvery", {Increment("genericEvery")}));

	session::Session game(level, shell.game, {42, 0, {}});
	const auto prototype = game.Teams().FindTeam("TestHumvees");
	BOOST_TEST_REQUIRE(prototype.has_value());
	game.Tick();
	const auto instances = game.Teams().Instances(*prototype);
	BOOST_TEST_REQUIRE(instances.size() == 1u);
	const std::uint32_t instance = instances.front();
	BOOST_TEST(instance != *prototype);
	BOOST_TEST(game.Teams().TeamAt(instance).members.size() == 4u);
	BOOST_TEST(game.ScriptCounter("created") == 1);
	BOOST_TEST(game.ScriptCounter("idle") == 0);
	BOOST_TEST(game.ScriptCounter("genericOnce") == 1);
	BOOST_TEST(game.ScriptCounter("genericEvery") == 1);
	// Whether every member is idle once a tick's systems have run (what the next tick's team update sees).
	const auto allIdle = [&] {
		for (const auto member : game.Teams().TeamAt(instance).members)
		{
			const auto *order = game.World().Get<engine::gameplay::MoveOrder>(member);
			const auto *attack = game.World().Get<engine::gameplay::AttackTarget>(member);
			if ((order != nullptr && order->mode != engine::gameplay::MoveMode::Idle) || (attack != nullptr && attack->target != ecs::Entity{}) ||
				game.World().Get<engine::gameplay::Builder>(member) != nullptr)
				return false;
		}
		return true;
	};
	std::vector<bool> idleAfter{false, allIdle()}; // [tick]
	std::vector<std::int64_t> idleCount{0, game.ScriptCounter("idle")};
	for (int tick = 2; tick <= 120; ++tick)
	{
		game.Tick();
		idleAfter.push_back(allIdle());
		idleCount.push_back(game.ScriptCounter("idle"));
	}
	// Made at the waypoint with no reinforcement origin, they are not sent anywhere (needToMoveToDestination is decided
	// before the units are made): idle as tick 1's team update sees them (made by its scripts just before), and after,
	// so on-idle runs from the second idle look (tick 2) on, every tick.
	BOOST_TEST(idleAfter[1]);
	int first = 0;
	for (int tick = 2; tick <= 120 && first == 0; ++tick)
		if (idleCount[tick] > idleCount[tick - 1])
			first = tick;
	BOOST_TEST_REQUIRE(first == 2);
	BOOST_TEST(idleCount[120] == 120 - first + 1);
	BOOST_TEST(game.ScriptCounter("created") == 1);
	BOOST_TEST(game.ScriptCounter("genericOnce") == 1);
	BOOST_TEST(game.ScriptCounter("genericEvery") == 120);

	const auto members = game.Teams().TeamAt(instance).members;
	auto &kills = game.World().Resource<engine::gameplay::KillRequests>();
	kills.entities.push_back(members[0]);
	for (int tick = 121; tick <= 130; ++tick)
		game.Tick();
	BOOST_TEST(game.ScriptCounter("destroyed") == 0); // three left
	kills.entities.push_back(members[1]);
	game.Tick(); // tick 131: the kill lands after the team update
	BOOST_TEST(game.ScriptCounter("destroyed") == 0);
	game.Tick(); // tick 132: two left
	BOOST_TEST(game.ScriptCounter("destroyed") == 1);
	kills.entities.push_back(members[2]);
	for (int tick = 133; tick <= 140; ++tick)
		game.Tick();
	BOOST_TEST(game.ScriptCounter("destroyed") == 1); // once only
}

// SpecialPowerStore::canUseSpecialPower, Object::doSpecialPowerAtLocation, Player::addScience (special powers woken),
// SpecialPowerModule::onSpecialPowerCreation / triggerSpecialPower with SharedSyncedTimer: the shell map's paradrop
// command centre may not paradrop on its player's order without SCIENCE_Paradrop1 (a script may); learning it makes
// the power ready at once; fired at tick t, the player's shared timer is next ready at t + 7200 (240 s).
BOOST_AUTO_TEST_CASE(legacy_parity_a_generals_power_waits_for_its_science_and_shares_its_timer)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	session::Session game(shell.map->level, shell.game, {42, 0, {}});
	namespace gp = engine::gameplay;
	auto &world = game.World();
	const auto &roster = game.Teams();
	const auto paradrops = roster.FindTeam("teamParadrops");
	BOOST_TEST_REQUIRE(paradrops.has_value());
	const ecs::Entity center = roster.TeamAt(*paradrops).members.front();
	const std::uint32_t player = roster.TeamAt(*paradrops).owner;
	const auto power = shell.game.powers.Template("SuperweaponParadropAmerica");
	const auto science = shell.game.Science("SCIENCE_Paradrop1");
	BOOST_TEST_REQUIRE((power.has_value() && science.has_value()));
	const auto *timers = world.Get<gp::SpecialPowerTimers>(center);
	BOOST_TEST_REQUIRE(timers != nullptr);
	BOOST_TEST_REQUIRE(timers->Find(*power) != nullptr);
	game.Tick();
	const auto planes = [&] { return game.PlayerObjectCount("Paradrops", "AmericaJetCargoPlane"); };
	const std::int64_t before = planes();
	const Engine::Math::FixedVector2 target{Engine::Math::Fixed::FromInt(1000), Engine::Math::Fixed::FromInt(1000)};
	const bool known = world.Resource<gp::PlayerSciences>().Has(player, *science);
	BOOST_TEST_MESSAGE("the paradrop player knows SCIENCE_Paradrop1 from the start: " << known);
	if (!known)
	{
		generalszh::gameplay::FireSpecialPower(game.Game(), center, "SuperweaponParadropAmerica", target, false);
		BOOST_TEST(planes() == before); // a player's order needs the science
		BOOST_TEST(generalszh::gameplay::GrantScience(game.Game(), player, *science));
	}
	auto &shared = world.Resource<gp::SharedPowerTimers>();
	const gp::PowerClock now{world.Resource<gp::SpecialPowerRules>(), shared, player, game.CurrentTick()};
	BOOST_TEST(gp::IsReady(*timers->Find(*power), now));
	generalszh::gameplay::FireSpecialPower(game.Game(), center, "SuperweaponParadropAmerica", target, false);
	BOOST_TEST(planes() > before);
	const std::uint64_t fired = game.CurrentTick();
	// SpecialPowerModule::aboutToDoSpecialPower: the scripts hear it (from this command centre), once.
	auto &records = world.Resource<generalszh::gameplay::ScriptRecords>();
	BOOST_TEST(records.TakeTriggeredPower(player, "SuperweaponParadropAmerica", center));
	BOOST_TEST(!records.TakeTriggeredPower(player, "SuperweaponParadropAmerica"));
	BOOST_TEST(!gp::IsReady(*timers->Find(*power), {world.Resource<gp::SpecialPowerRules>(), shared, player, fired + 7199}));
	BOOST_TEST(gp::IsReady(*timers->Find(*power), {world.Resource<gp::SpecialPowerRules>(), shared, player, fired + 7200}));
}

// ObjectCreationList DeliverPayloadNugget -> SpecialPowerCompletionDie::setCreator / notifyScriptEngine: a carpet bomb
// run from the shell map's Chinese command centre (fired as a script) marks its first bomb as the command centre's;
// when the bombs are gone, its player's scripts hear the power completed from that command centre.
BOOST_AUTO_TEST_CASE(legacy_parity_a_delivered_bomb_tells_the_scripts_its_power_completed)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	session::Session game(shell.map->level, shell.game, {42, 0, {}});
	auto &world = game.World();
	const auto &roster = game.Teams();
	const auto china = roster.FindTeam("teamPlyrChina");
	BOOST_TEST_REQUIRE(china.has_value());
	ecs::Entity center;
	for (const auto member : roster.TeamAt(*china).members)
		if (game.DefinitionName(world.Get<engine::gameplay::DefinitionRef>(member)->index) == "ChinaCommandCenter")
			center = member;
	BOOST_TEST_REQUIRE(world.IsAlive(center));
	const std::uint32_t player = roster.TeamAt(*china).owner;
	// The command centre's power whose delivery drops something with a SpecialPowerCompletionDie (its carpet bombs).
	std::string power;
	const auto *definition = shell.game.objects.Find("ChinaCommandCenter");
	for (const auto &module : generalszh::content::PowerModulesOf(*definition))
		if (const auto ocl = generalszh::content::FindOclPower(*definition, module.power))
			if (const auto runs = shell.game.powers.deliveries.find(ocl->creationList); runs != shell.game.powers.deliveries.end())
				for (const auto &run : runs->second)
					for (const auto &item : run.payload)
						if (const auto *payload = shell.game.objects.Find(item.object))
							for (const auto &part : payload->modules)
								if (part.type == "SpecialPowerCompletionDie" && power.empty())
									power = module.power;
	BOOST_TEST_REQUIRE(!power.empty());
	BOOST_TEST_MESSAGE("carpet bomb power: " << power);
	game.Tick();
	const Engine::Math::FixedVector2 target = game.TransformOf(center)->position.XY() + Engine::Math::FixedVector2{Engine::Math::Fixed::FromInt(600), Engine::Math::Fixed::FromInt(0)};
	generalszh::gameplay::FireSpecialPower(game.Game(), center, power, target, true);
	auto &records = world.Resource<generalszh::gameplay::ScriptRecords>();
	bool completed = false;
	for (int tick = 0; tick < 30 * 90 && !completed; ++tick)
	{
		game.Tick();
		completed = records.TakeCompletedPower(player, "SuperweaponChinaCarpetBomb", center);
	}
	BOOST_TEST(completed);
}

// AIPlayer::newMap / doBaseBuilding / processBaseBuilding (a map's own computer player): a planned power plant the plan
// marks initially built stands from the start (buildStructureNow); destroyed at tick 60, it is noted lost on the next
// look (its timestamp), left alone for RebuildDelayTimeSeconds (30 s) and then put up again by its dozer.
BOOST_AUTO_TEST_CASE(legacy_parity_a_maps_computer_player_rebuilds_what_it_lost)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	engine::level::Participant *america = nullptr;
	for (auto &participant : level.scenario.participants)
		if (participant.properties.Get<std::string>("playerName") == "PlyrAmerica")
			america = &participant;
	BOOST_TEST_REQUIRE(america != nullptr);
	// Beside America's command centre.
	Engine::Math::FixedVector3 where;
	for (const auto &placement : level.placements)
		if (placement.type == "AmericaCommandCenter" && placement.properties.Get<std::string>("originalOwner").value_or("").find("America") != std::string::npos)
			where = placement.position;
	where.x = where.x + Engine::Math::Fixed::FromInt(160);
	engine::level::PlannedPlacement planned;
	planned.type = "AmericaPowerPlant";
	planned.position = where;
	planned.initiallyPlaced = true;
	planned.rebuilds = 1;
	america->plan.push_back(planned);
	// A dozer of its own to build with (it has no factory to make one).
	engine::level::Placement dozer;
	dozer.type = "AmericaVehicleDozer";
	dozer.position = where;
	dozer.position.y = dozer.position.y + Engine::Math::Fixed::FromInt(120);
	dozer.properties.Set("originalOwner", std::string("teamPlyrAmerica"));
	level.placements.push_back(dozer);
	session::Session game(level, shell.game, {42, 0, {}});
	const std::uint32_t player = *game.Teams().FindPlayer("PlyrAmerica");
	auto &ais = game.World().Resource<generalszh::gameplay::AiPlayers>();
	auto *ai = ais.Of(player);
	BOOST_TEST_REQUIRE(ai != nullptr);
	BOOST_TEST(!ai->skirmish);
	const auto &slot = ai->buildList.back();
	BOOST_TEST(slot.structure == "AmericaPowerPlant");
	BOOST_TEST_REQUIRE(game.World().IsAlive(slot.built));
	for (int tick = 0; tick < 60; ++tick)
		game.Tick();
	game.World().Resource<engine::gameplay::KillRequests>().entities.push_back(slot.built);
	game.Tick(); // tick 61: it dies
	std::uint64_t noted = 0, rebuilt = 0;
	for (int tick = 0; tick < 30 * 60 && rebuilt == 0; ++tick)
	{
		game.Tick();
		if (noted == 0 && slot.built == ecs::Entity{} && slot.builtTick > 0)
			noted = slot.builtTick;
		if (slot.built != ecs::Entity{} && game.World().IsAlive(slot.built))
			rebuilt = game.CurrentTick();
	}
	BOOST_TEST_MESSAGE("noted lost at " << noted << ", rebuilt at " << rebuilt);
	BOOST_TEST_REQUIRE(noted > 0u);
	BOOST_TEST(rebuilt >= noted + 900u);
	BOOST_TEST(rebuilt <= noted + 900u + 60u); // at the first 2 s look once the delay is out
	BOOST_TEST_REQUIRE(rebuilt > 0u);
	BOOST_TEST(game.DefinitionName(game.World().Get<engine::gameplay::DefinitionRef>(slot.built)->index) == "AmericaPowerPlant");
	BOOST_TEST(slot.rebuilds == 0);
}

// Legacy parity (ScriptEngine::isSpeechComplete / isAudioComplete): the first time a speech is asked about it is done
// its length in ticks later (45 here: from tick 10, done on tick 55, not 54); once done it is taken off, so asking again
// starts it afresh; speech and sounds are kept apart; a checkpoint keeps what is waiting.
BOOST_AUTO_TEST_CASE(legacy_parity_a_speech_is_done_its_length_after_first_asked)
{
	using generalszh::gameplay::ScriptRecords;
	ScriptRecords records;
	int lengths = 0;
	const auto length = [&lengths]() -> std::uint64_t {
		++lengths;
		return 45;
	};
	BOOST_TEST(!ScriptRecords::SoundComplete(records.testingSpeech, "Line1", 10, length));
	BOOST_TEST(!ScriptRecords::SoundComplete(records.testingSpeech, "Line1", 54, length));
	BOOST_TEST(lengths == 1); // measured once
	BOOST_TEST(!ScriptRecords::SoundComplete(records.testingAudio, "Line1", 54, length)); // a sound of that name: its own
	engine::core::serialization::ByteWriter writer;
	records.Save(writer);
	ScriptRecords loaded;
	engine::core::serialization::ByteReader reader(writer.Bytes());
	BOOST_TEST_REQUIRE(loaded.Load(reader));
	BOOST_TEST_REQUIRE(loaded.testingSpeech.size() == 1u);
	BOOST_TEST(loaded.testingSpeech.front().second == 55u);
	BOOST_TEST(ScriptRecords::SoundComplete(loaded.testingSpeech, "Line1", 55, length));
	BOOST_TEST(loaded.testingSpeech.empty());
	BOOST_TEST(!ScriptRecords::SoundComplete(loaded.testingSpeech, "Line1", 56, length)); // afresh: 101
	BOOST_TEST(loaded.testingSpeech.front().second == 101u);
	// No length (an unknown sound): done at once.
	BOOST_TEST(ScriptRecords::SoundComplete(loaded.testingSpeech, "Nothing", 60, {}));
}

// Legacy parity (ScriptActions::doRemoveCommandBarButton / doAddCommandBarButton, GameLogic::setControlBarOverride,
// CommandSet::getCommandButton): the dozer's set loses its power plant where it shows it (slot 0); adding the barracks
// at slot 1 (the first) puts it there; a button that does not exist, a slot past 18 or an unknown object type change
// nothing; what the sets read now is kept in a checkpoint.
BOOST_AUTO_TEST_CASE(legacy_parity_scripts_add_and_remove_command_bar_buttons)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	auto &scripts = level.scenario.participants.front().scripts.scripts;
	level::Script edit;
	edit.name = "edit";
	edit.oneShot = true;
	edit.conditions = {{Call("CONDITION_TRUE")}};
	level::ScriptCall add = Call("COMMANDBAR_ADD_BUTTON_OBJECTTYPE_SLOT", {"Command_ConstructAmericaBarracks", "AmericaVehicleDozer"});
	level::ScriptParameter slot;
	slot.integer = 1;
	add.parameters.push_back(slot);
	level::ScriptCall badButton = Call("COMMANDBAR_ADD_BUTTON_OBJECTTYPE_SLOT", {"Command_NoSuchButton", "AmericaVehicleDozer"});
	badButton.parameters.push_back(slot);
	level::ScriptCall badSlot = Call("COMMANDBAR_ADD_BUTTON_OBJECTTYPE_SLOT", {"Command_ConstructAmericaBarracks", "AmericaVehicleDozer"});
	level::ScriptParameter far;
	far.integer = 19;
	badSlot.parameters.push_back(far);
	edit.actions = {Call("COMMANDBAR_REMOVE_BUTTON_OBJECTTYPE", {"Command_ConstructAmericaPowerPlant", "AmericaVehicleDozer"}), add, badButton, badSlot,
		Call("COMMANDBAR_REMOVE_BUTTON_OBJECTTYPE", {"Command_ConstructAmericaPowerPlant", "NoSuchObject"})};
	scripts.push_back(edit);
	session::Session game(level, shell.game, {42, 0, {}});
	const auto &catalog = shell.game.commands;
	const auto *original = catalog.Set("AmericaDozerCommandSet");
	BOOST_TEST_REQUIRE(original != nullptr);
	BOOST_TEST(original->buttons[0] == "Command_ConstructAmericaPowerPlant");
	game.Tick();
	auto &overrides = game.World().Resource<generalszh::gameplay::CommandBarOverrides>();
	BOOST_TEST(overrides.slots.size() == 1u); // removing then adding at the same slot: one override
	const auto now = generalszh::gameplay::EffectiveCommandSet(catalog, &overrides, "AmericaDozerCommandSet");
	BOOST_TEST_REQUIRE(now.has_value());
	BOOST_TEST(now->buttons[0] == "Command_ConstructAmericaBarracks");
	BOOST_TEST(now->buttons[1] == original->buttons[1]);
	const auto saved = game.Checkpoint();
	auto restored = session::Session::Restore(level, shell.game, {42, 0, {}}, saved);
	BOOST_TEST_REQUIRE(restored != nullptr);
	const auto &kept = restored->World().Resource<generalszh::gameplay::CommandBarOverrides>();
	BOOST_TEST((kept.slots == overrides.slots));
}

// Legacy parity (ScriptEngine::doFreezeTime / doUnfreezeTime, GameLogic::update: frozen, a frame ends with its scripts
// and its number stays): a script freezes time on tick 1 and starts a 5-tick timer; the scripts go on running (a counter
// every call) and the timer runs down, but the tick stays; when it runs out, on the sixth call, time goes on from tick 1.
BOOST_AUTO_TEST_CASE(legacy_parity_a_script_freezes_time_while_the_scripts_run_on)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	auto &scripts = level.scenario.participants.front().scripts.scripts;
	level::Script freeze;
	freeze.name = "freeze";
	freeze.oneShot = true;
	freeze.conditions = {{Call("CONDITION_TRUE")}};
	level::ScriptCall timer = Call("SET_TIMER", {"t"});
	level::ScriptParameter ticks;
	ticks.integer = 5;
	timer.parameters.push_back(ticks);
	freeze.actions = {Call("FREEZE_TIME"), timer};
	scripts.push_back(freeze);
	level::Script every;
	every.name = "every";
	every.conditions = {{Call("CONDITION_TRUE")}};
	every.actions = {Increment("runs")};
	scripts.push_back(every);
	level::Script thaw;
	thaw.name = "thaw";
	thaw.oneShot = true;
	thaw.conditions = {{Call("TIMER_EXPIRED", {"t"})}};
	thaw.actions = {Call("UNFREEZE_TIME")};
	scripts.push_back(thaw);
	session::Session game(level, shell.game, {42, 0, {}});
	std::vector<std::uint64_t> seen;
	for (int call = 1; call <= 7; ++call)
	{
		game.Tick();
		seen.push_back(game.CurrentTick());
	}
	BOOST_TEST((seen == std::vector<std::uint64_t>{0, 0, 0, 0, 0, 1, 2}));
	BOOST_TEST(game.ScriptCounter("runs") == 7);
	BOOST_TEST(!game.TimeFrozen());
}

BOOST_AUTO_TEST_SUITE_END()
