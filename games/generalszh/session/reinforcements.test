// ScriptActions::doCreateReinforcements' transports (CREATE_REINFORCEMENT_TEAM with a TeamTransport) on the live shell
// map: a Chinook's move, landing, evacuation and departure (ChinookAIUpdate), a cargo plane's paradrop (DeliverPayload
// AIUpdate::deliverPayloadViaModuleData) and TeamStartsFull (PartitionSolver).
using namespace generalszh;
namespace level = engine::level;
namespace gp = engine::gameplay;
using Engine::Math::Fixed;
using Engine::Math::FixedVector2;

namespace
{
struct ShellContent
{
	engine::filesystem::VirtualFileSystem files;
	engine::config::Diagnostics grammarDiagnostics;
	std::optional<content::ContentLoader> loader;
	content::GameContent game;
	std::optional<engine::level::generals_map::ReadResult> map;

	bool Load()
	{
		const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
		if (install == nullptr || !std::filesystem::exists(install))
			return false;
		content::MountInstall(files, install);
		loader.emplace(files, content::ZeroHourIniGrammar(grammarDiagnostics));
		game = content::LoadGameContent(*loader, engine::time::FixedStep{30});
		auto read = engine::level::generals_map::Read(*files.Read("Maps/ShellMapMD/ShellMapMD.map"));
		if (!read)
			return false;
		map.emplace(std::move(*read));
		return true;
	}
};

ShellContent &Content()
{
	static ShellContent content;
	static const bool loaded = content.Load();
	(void)loaded;
	return content;
}

// Two named waypoints between `least` and `most` apart: {destination, origin}.
std::pair<std::string, std::string> Waypoints(const level::Level &level, Fixed least, Fixed most)
{
	for (const auto &to : level.markers)
		for (const auto &from : level.markers)
		{
			if (to.name.empty() || from.name.empty())
				continue;
			const Fixed distance = Engine::Math::Distance(to.position.XY(), from.position.XY());
			if (distance >= least && distance <= most)
				return {to.name, from.name};
		}
	return {};
}

level::Properties Team(std::string name, std::string transport, std::string unit, std::int64_t count, std::string origin)
{
	level::Properties team;
	team.Set("teamName", std::move(name));
	team.Set("teamOwner", std::string("PlyrCivilian"));
	team.Set("teamIsSingleton", false);
	team.Set("teamUnitType1", std::move(unit));
	team.Set("teamUnitMaxCount1", count);
	if (!transport.empty())
		team.Set("teamTransport", std::move(transport));
	team.Set("teamReinforcementOrigin", std::move(origin));
	return team;
}

std::vector<ecs::Entity> OfType(session::Session &game, std::uint32_t team, std::string_view type)
{
	std::vector<ecs::Entity> found;
	for (const ecs::Entity member : game.Teams().TeamAt(team).members)
		if (const auto *ref = game.World().Get<gp::DefinitionRef>(member); ref != nullptr && game.Game().templates.DefinitionAt(ref->index).name == type)
			found.push_back(member);
	return found;
}
}

BOOST_AUTO_TEST_SUITE(shell_map_reinforcements)

// ScriptActions::doCreateReinforcements with a Chinook (ChinookAIUpdate::aiDoCommand, retail: MOVE_TO_AND_EVAC_AND_EXIT
// with TeamTransportsExit): the Chinook is made at the origin, the Humvee inside it (addToContain), the team inactive.
// It flies to the waypoint (AIMoveToState); the tick after its move is over it lands (ChinookTakeoffOrLandingState);
// the tick after it is down everyone is out at once (ChinookEvacuateState: removeAllContained), the team is active
// (setActive) and it takes off (TAKING_OFF); then it heads for where it was made (ChinookHeadOffMapState) and stays
// there: the origin is inside the map, so it is never outside the extent to be removed. (How fast it comes down is its
// locomotor's height behaviour, not this machine's: only the ticks relative to its touchdown are pinned.)
BOOST_AUTO_TEST_CASE(legacy_parity_a_chinook_lands_its_reinforcements_and_heads_home)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	const auto [destination, origin] = Waypoints(level, Fixed::FromInt(300), Fixed::FromInt(500));
	BOOST_TEST_REQUIRE(!destination.empty());
	level.scenario.groups.push_back(Team("TestChinookDrop", "AmericaVehicleChinook", "AmericaVehicleHumvee", 1, origin));
	level.scenario.groups.back().Set("teamTransportsExit", true);
	session::Session game(level, shell.game, {42, 0, {}});
	const auto prototype = game.Teams().FindTeam("TestChinookDrop");
	BOOST_TEST_REQUIRE(prototype.has_value());
	game.Tick();
	gameplay::CreateReinforcements(game.Game(), "TestChinookDrop", destination);
	const auto instances = game.Teams().Instances(*prototype);
	BOOST_TEST_REQUIRE(instances.size() == 1u);
	const std::uint32_t team = instances.front();
	const auto chinooks = OfType(game, team, "AmericaVehicleChinook");
	const auto humvees = OfType(game, team, "AmericaVehicleHumvee");
	BOOST_TEST_REQUIRE(chinooks.size() == 1u);
	BOOST_TEST_REQUIRE(humvees.size() == 1u);
	const ecs::Entity chinook = chinooks.front();
	const ecs::Entity humvee = humvees.front();
	const FixedVector2 start = game.World().Get<gp::Transform>(chinook)->position.XY();
	BOOST_TEST(game.World().Get<gp::Passenger>(humvee) != nullptr);
	BOOST_TEST(!game.Teams().TeamAt(team).active);
	BOOST_TEST(game.World().Get<gameplay::ScriptedEvacuation>(chinook)->locked == 0);
	std::uint64_t arrived = 0, down = 0, out = 0, active = 0, takingOff = 0;
	for (int tick = 0; tick < 1200; ++tick)
	{
		game.Tick();
		const std::uint64_t now = game.CurrentTick();
		BOOST_TEST_REQUIRE(game.World().IsAlive(chinook));
		const auto &at = game.World().Get<gp::Transform>(chinook)->position;
		const auto *transport = game.World().Get<gp::Transport>(chinook);
		if (arrived == 0 && game.World().Get<gp::MoveOrder>(chinook)->mode == gp::MoveMode::Idle)
			arrived = now;
		if (down == 0 && transport->landing && at.z - game.Game().ground.Surface(at.XY()) <= Fixed::FromInt(3))
			down = now;
		if (out == 0 && game.World().Get<gp::Passenger>(humvee) == nullptr)
			out = now;
		if (active == 0 && game.Teams().TeamAt(team).active)
			active = now;
		if (takingOff == 0 && transport->takingOff)
			takingOff = now;
	}
	BOOST_TEST(arrived > 2u);
	BOOST_TEST(down > arrived);
	BOOST_TEST(out == down + 1);
	BOOST_TEST(active == out);
	BOOST_TEST(takingOff == out);
	const auto &at = game.World().Get<gp::Transform>(chinook)->position;
	BOOST_TEST((Engine::Math::Distance(at.XY(), start) < Fixed::FromInt(5)));
	const auto *evacuation = game.World().Get<gameplay::ScriptedEvacuation>(chinook);
	BOOST_TEST_REQUIRE(evacuation != nullptr);
	BOOST_TEST((evacuation->stage == gameplay::EvacuationStage::HeadingOff));
	BOOST_TEST(evacuation->moveEnds == 0u);
}

// ScriptActions::doCreateReinforcements with a cargo plane (DeliverPayloadAIUpdate, PutInContainer AmericaParachute):
// each Ranger packed in its own parachute inside the plane, the plane flying its module's delivery to the waypoint
// (deliverPayloadViaModuleData: target and move-to the waypoint, its DeliveryDistance, DropDelay and DoorDelay); the
// run drops them all, and the team stays inactive (nothing in a delivery activates it).
BOOST_AUTO_TEST_CASE(legacy_parity_a_cargo_plane_paradrops_its_reinforcements)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	const auto [destination, origin] = Waypoints(level, Fixed::FromInt(300), Fixed::FromInt(500));
	BOOST_TEST_REQUIRE(!destination.empty());
	level.scenario.groups.push_back(Team("TestParadrop", "AmericaJetCargoPlane", "AmericaInfantryRanger", 4, origin));
	level.scenario.groups.back().Set("teamStartsFull", true);
	level.scenario.groups.back().Set("teamTransportsExit", true);
	session::Session game(level, shell.game, {42, 0, {}});
	const auto prototype = game.Teams().FindTeam("TestParadrop");
	BOOST_TEST_REQUIRE(prototype.has_value());
	game.Tick();
	gameplay::CreateReinforcements(game.Game(), "TestParadrop", destination);
	const std::uint32_t team = game.Teams().Instances(*prototype).front();
	const auto planes = OfType(game, team, "AmericaJetCargoPlane");
	const auto rangers = OfType(game, team, "AmericaInfantryRanger");
	const auto chutes = OfType(game, team, "AmericaParachute");
	BOOST_TEST_REQUIRE(planes.size() == 1u);
	BOOST_TEST(rangers.size() == 4u);
	BOOST_TEST(chutes.size() == 4u);
	const ecs::Entity plane = planes.front();
	for (const ecs::Entity chute : chutes)
	{
		const auto *seat = game.World().Get<gp::Passenger>(chute);
		BOOST_TEST_REQUIRE(seat != nullptr);
		BOOST_TEST((seat->transport == plane));
	}
	for (const ecs::Entity ranger : rangers)
		BOOST_TEST(game.World().Get<gp::OffMap>(ranger) != nullptr);
	const auto *delivery = game.World().Get<gp::Delivery>(plane);
	BOOST_TEST_REQUIRE(delivery != nullptr);
	const FixedVector2 waypoint = game.Game().waypoints.Position(game.Game().waypoints.Find(destination)).XY();
	BOOST_TEST((delivery->target == waypoint));
	BOOST_TEST((delivery->moveTo == waypoint));
	BOOST_TEST((delivery->distance > Fixed{}));
	const Fixed deliveryDistance = delivery->distance;
	BOOST_TEST(game.World().Get<gameplay::ScriptedEvacuation>(plane) == nullptr);
	BOOST_TEST(!game.Teams().TeamAt(team).active);
	// Its approach ends within DeliveryDistance of the waypoint on the first pass (the move to it is not over before:
	// a final goal is reached within the locomotor's CloseEnoughDist, wings included).
	bool delivering = false;
	std::vector<ecs::Entity> dropped; // out of the plane (off it, alive or not since: the shell map's battle goes on)
	for (int tick = 0; tick < 1500; ++tick)
	{
		game.Tick();
		for (const ecs::Entity ranger : rangers)
			if (game.World().IsAlive(ranger) && game.World().Get<gp::OffMap>(ranger) == nullptr &&
				std::find(dropped.begin(), dropped.end(), ranger) == dropped.end())
				dropped.push_back(ranger);
		const auto *run = game.World().IsAlive(plane) ? game.World().Get<gp::Delivery>(plane) : nullptr;
		if (!delivering && run != nullptr && run->phase == gp::DeliveryPhase::Delivering)
		{
			delivering = true;
			BOOST_TEST(run->attempts == 0);
			const FixedVector2 at = game.World().Get<gp::Transform>(plane)->position.XY();
			BOOST_TEST((Engine::Math::Distance(at, waypoint) < deliveryDistance));
		}
	}
	BOOST_TEST(delivering);
	BOOST_TEST(dropped.size() == 4u);
	BOOST_TEST(!game.Teams().TeamAt(team).active);
}

// ScriptActions::doCreateReinforcements with TeamStartsFull and no TeamTransport (PartitionSolver, PREFER_FAST_SOLUTION):
// the team's own Humvee (TRANSPORT) takes its Rangers, one slot each, while it has room; the rest move on foot; the team
// is active at once and the Humvee moves to the waypoint with them inside.
BOOST_AUTO_TEST_CASE(legacy_parity_a_team_that_starts_full_loads_into_its_own_transport)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	const auto [destination, origin] = Waypoints(level, Fixed::FromInt(300), Fixed::FromInt(500));
	BOOST_TEST_REQUIRE(!destination.empty());
	level.scenario.groups.push_back(Team("TestStartsFull", "", "AmericaVehicleHumvee", 1, origin));
	level.scenario.groups.back().Set("teamUnitType2", std::string("AmericaInfantryRanger"));
	level.scenario.groups.back().Set("teamUnitMaxCount2", std::int64_t{7});
	level.scenario.groups.back().Set("teamStartsFull", true);
	session::Session game(level, shell.game, {42, 0, {}});
	const auto prototype = game.Teams().FindTeam("TestStartsFull");
	BOOST_TEST_REQUIRE(prototype.has_value());
	game.Tick();
	gameplay::CreateReinforcements(game.Game(), "TestStartsFull", destination);
	const std::uint32_t team = game.Teams().Instances(*prototype).front();
	const ecs::Entity humvee = OfType(game, team, "AmericaVehicleHumvee").front();
	const auto rangers = OfType(game, team, "AmericaInfantryRanger");
	BOOST_TEST_REQUIRE(rangers.size() == 7u);
	const std::uint32_t room = game.World().Get<gp::Transport>(humvee)->definition.slots;
	std::uint32_t inside = 0;
	for (const ecs::Entity ranger : rangers)
		if (const auto *seat = game.World().Get<gp::Passenger>(ranger))
		{
			BOOST_TEST((seat->transport == humvee));
			++inside;
		}
		else
			BOOST_TEST((game.World().Get<gp::MoveOrder>(ranger)->mode == gp::MoveMode::Point));
	BOOST_TEST(inside == std::min<std::uint32_t>(room, 7u));
	BOOST_TEST(game.World().Get<gp::Transport>(humvee)->occupied == inside);
	BOOST_TEST(game.Teams().TeamAt(team).active);
	BOOST_TEST((game.World().Get<gp::MoveOrder>(humvee)->mode == gp::MoveMode::Point));
}

// The machines are simulation state: a Chinook drop and a paradrop running together end the same on 1 and 4 workers,
// and restored from a checkpoint taken mid-flight (the Chinook still Moving with its Humvee aboard, the plane on its
// approach) they carry on exactly (equal state hashes after every later tick).
BOOST_AUTO_TEST_CASE(reinforcement_transports_are_deterministic_and_checkpoint)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	const auto [destination, origin] = Waypoints(level, Fixed::FromInt(300), Fixed::FromInt(500));
	BOOST_TEST_REQUIRE(!destination.empty());
	level.scenario.groups.push_back(Team("TestChinookDrop", "AmericaVehicleChinook", "AmericaVehicleHumvee", 2, origin));
	level.scenario.groups.back().Set("teamTransportsExit", true);
	level.scenario.groups.push_back(Team("TestParadrop", "AmericaJetCargoPlane", "AmericaInfantryRanger", 4, origin));
	const auto run = [&](std::size_t workers, bool checkpoint) {
		auto game = std::make_unique<session::Session>(level, shell.game, session::SessionOptions{42, workers, {}});
		game->Tick();
		gameplay::CreateReinforcements(game->Game(), "TestChinookDrop", destination);
		gameplay::CreateReinforcements(game->Game(), "TestParadrop", destination);
		for (int tick = 0; tick < 60; ++tick)
			game->Tick();
		if (checkpoint)
		{
			auto restored = session::Session::Restore(level, shell.game, session::SessionOptions{42, workers, {}}, game->Checkpoint());
			BOOST_TEST_REQUIRE(restored != nullptr);
			BOOST_TEST(restored->StateHash() == game->StateHash());
			game = std::move(restored);
		}
		std::vector<ecs::StateHashValue> hashes;
		for (int tick = 0; tick < 600; ++tick)
		{
			game->Tick();
			hashes.push_back(game->StateHash());
		}
		return hashes;
	};
	const auto single = run(1, false);
	BOOST_TEST((run(4, false) == single));
	BOOST_TEST((run(1, true) == single));
	BOOST_TEST((run(4, true) == single));
}

// AIGroup::groupMoveToPosition for a player's order (CMD_FROM_PLAYER): four Humvees in a row ordered far off take the
// slots of a formation (planFormation: 2 x 2, the ratio nearest 1.5 that fits), 22 apart (their bounding circle is
// smaller), centred on the destination, each its own; ordered to a point inside their own area (grown by
// GroupMoveClickToGatherAreaFactor) they tighten on it instead, all to the one point.
BOOST_AUTO_TEST_CASE(legacy_parity_a_players_group_order_forms_up_or_tightens)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	session::Session game(shell.map->level, shell.game, {42, 0, {}});
	game.Tick();
	const auto team = game.Teams().FindTeam("teamPlyrCivilian");
	BOOST_TEST_REQUIRE(team.has_value());
	const std::uint32_t player = game.Teams().TeamAt(*team).owner;
	const auto [low, high] = game.Game().ground.Extent();
	const FixedVector2 start = (low + high) / Fixed::FromInt(2);
	std::vector<ecs::Entity> humvees;
	for (int index = 0; index < 4; ++index)
		humvees.push_back(game.Place("AmericaVehicleHumvee", start + FixedVector2{Fixed::FromInt(index * 30), Fixed{}}, {}, *team));
	const auto order = [&](FixedVector2 to) {
		gameplay::ApplyCommand(game.Game(), player, commands::MoveTo{humvees, to});
	};
	const FixedVector2 far = start + FixedVector2{Fixed{}, Fixed::FromInt(300)};
	order(far);
	std::vector<FixedVector2> goals;
	FixedVector2 sum;
	for (const ecs::Entity humvee : humvees)
	{
		const auto *move = game.World().Get<gp::MoveOrder>(humvee);
		BOOST_TEST_REQUIRE((move->mode == gp::MoveMode::Point));
		goals.push_back(move->destination);
		sum += move->destination;
	}
	for (std::size_t a = 0; a < goals.size(); ++a)
		for (std::size_t b = a + 1; b < goals.size(); ++b)
			BOOST_TEST((Engine::Math::Distance(goals[a], goals[b]) >= Fixed::FromInt(22) - Fixed::FromRatio(1, 100)));
	BOOST_TEST((Engine::Math::Distance(sum / Fixed::FromInt(4), far) <= Fixed::FromRatio(1, 100)));
	// Inside their own row: all to the one point.
	const FixedVector2 inside = start + FixedVector2{Fixed::FromInt(45), Fixed{}};
	order(inside);
	for (const ecs::Entity humvee : humvees)
		BOOST_TEST((game.World().Get<gp::MoveOrder>(humvee)->destination == inside));
}

// ScriptActions::updateTeamAttackPrioritySet -> Team::setAttackPriorityName (on its prototype), Object's constructor and
// Object::setTeam: a team given an attack priority set that exists keeps it; its members then, those made for it later
// (another reinforcement of it) and a unit moved into it all take the set; it survives a checkpoint.
BOOST_AUTO_TEST_CASE(legacy_parity_a_teams_attack_priority_set_reaches_later_members)
{
	ShellContent &shell = Content();
	if (!shell.map)
		return;
	engine::level::Level level = shell.map->level;
	const auto [destination, origin] = Waypoints(level, Fixed::FromInt(300), Fixed::FromInt(500));
	BOOST_TEST_REQUIRE(!destination.empty());
	level.scenario.groups.push_back(Team("TestPriorities", "", "AmericaVehicleHumvee", 2, origin));
	const auto call = [](std::string name, std::vector<level::ScriptParameter> parameters) {
		level::ScriptCall made;
		made.name = std::move(name);
		made.parameters = std::move(parameters);
		return made;
	};
	const auto text = [](std::string value) {
		level::ScriptParameter parameter;
		parameter.text = std::move(value);
		return parameter;
	};
	level::ScriptParameter fifty;
	fifty.integer = 50;
	level::Script script;
	script.name = "tsPriorities";
	script.oneShot = true;
	script.conditions = {{call("CONDITION_TRUE", {})}};
	script.actions = {call("SET_ATTACK_PRIORITY_THING", {text("TestSet"), text("AmericaVehicleHumvee"), fifty}),
		call("CREATE_REINFORCEMENT_TEAM", {text("TestPriorities"), text(destination)}),
		call("TEAM_APPLY_ATTACK_PRIORITY_SET", {text("TestPriorities"), text("TestSet")})};
	level.scenario.participants.front().scripts.scripts.push_back(script);
	auto game = std::make_unique<session::Session>(level, shell.game, session::SessionOptions{42, 0, {}});
	game->Tick();
	const std::uint16_t set = std::as_const(game->World().Resource<gp::AttackPriorities>()).Find("TestSet");
	BOOST_TEST_REQUIRE(set != 0u);
	const auto prototype = *game->Teams().FindTeam("TestPriorities");
	const auto first = game->Teams().Instances(prototype);
	BOOST_TEST_REQUIRE(first.size() == 1u);
	for (const ecs::Entity member : game->Teams().TeamAt(first.front()).members)
		BOOST_TEST(game->World().Get<gp::Aggression>(member)->prioritySet == set);
	// Saved and restored, the team still has it.
	game = session::Session::Restore(level, shell.game, session::SessionOptions{42, 0, {}}, game->Checkpoint());
	BOOST_TEST_REQUIRE(game != nullptr);
	gameplay::CreateReinforcements(game->Game(), "TestPriorities", destination);
	const auto instances = game->Teams().Instances(prototype);
	BOOST_TEST_REQUIRE(instances.size() == 2u);
	for (const std::uint32_t instance : instances)
		for (const ecs::Entity member : game->Teams().TeamAt(instance).members)
			BOOST_TEST(game->World().Get<gp::Aggression>(member)->prioritySet == set);
	// One of the civilians' own, moved into it.
	const auto civilians = *game->Teams().FindTeam("teamPlyrCivilian");
	const ecs::Entity joiner = game->Place("AmericaVehicleHumvee", game->Game().waypoints.Position(game->Game().waypoints.Find(destination)).XY(), {}, civilians);
	BOOST_TEST(game->World().Get<gp::Aggression>(joiner)->prioritySet == 0u);
	gameplay::ChangeTeam(game->Game(), joiner, instances.front());
	BOOST_TEST(game->World().Get<gp::Aggression>(joiner)->prioritySet == set);
}

BOOST_AUTO_TEST_SUITE_END()
