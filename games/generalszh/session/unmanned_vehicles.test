// Vehicles whose pilot Jarmen Kell snipes (DAMAGE_KILLPILOT), infantry taking them over, and terrorists making car
// bombs of them, on a shipped skirmish map.
using namespace generalszh;
namespace gp = engine::gameplay;
using Engine::Math::Fixed;

namespace
{
struct Install
{
	engine::filesystem::VirtualFileSystem files;
	engine::config::Diagnostics grammarDiagnostics;
	std::optional<content::ContentLoader> loader;
	content::GameContent game;
	bool loaded{false};

	Install()
	{
		const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
		if (install == nullptr || !std::filesystem::exists(install))
			return;
		content::MountInstall(files, install);
		loader.emplace(files, content::ZeroHourIniGrammar(grammarDiagnostics));
		game = content::LoadGameContent(*loader, engine::time::FixedStep{30});
		loaded = true;
	}
};

Install &Data()
{
	static Install install;
	return install;
}

// America (player0, start 0) against China (player1, start 2), both human seats with nobody at them.
struct Match
{
	std::optional<engine::level::generals_map::ReadResult> read;
	session::setup::SkirmishLevel skirmish;
	Engine::Math::FixedVector2 start;

	std::uint32_t Team(const session::Session &game, std::size_t player) const { return *game.Teams().FindTeam(skirmish.players[player].team); }
	Engine::Math::FixedVector2 At(int dx, int dy) const { return {start.x + Fixed::FromInt(dx), start.y + Fixed::FromInt(dy)}; }

	session::SessionOptions Options(std::size_t workers) const
	{
		session::SessionOptions options{11, workers, {}, {"player0", "player1"}};
		for (const auto &player : skirmish.players)
			options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
		return options;
	}
};

std::optional<Match> Prepare(Install &shell)
{
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	if (!bytes)
		return std::nullopt;
	Match match;
	auto read = engine::level::generals_map::Read(*bytes);
	if (!read)
		return std::nullopt;
	match.read = std::move(*read);
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 7;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::Player, u"Other");
	setup.slots[1].playerTemplate = templateOf("FactionChina");
	setup.slots[1].startPos = 2;
	match.skirmish = session::setup::PrepareSkirmishLevel(match.read->level, setup, shell.game.playerTemplates, 4);
	for (const auto &marker : match.read->level.markers)
		if (marker.name == "Player_1_Start")
			match.start = marker.position.XY();
	return match;
}

// The next tick's damage: one KILL_PILOT shot of Jarmen Kell's GLAJarmenKellVehiclePilotSniperRifle (PrimaryDamage 1).
void Snipe(session::Session &game, ecs::Entity sniper, ecs::Entity target)
{
	auto &world = game.World();
	if (!world.Has<gp::PendingDamage>(target))
		world.Add<gp::PendingDamage>(target);
	*world.Get<gp::PendingDamage>(target) =
		gp::PendingDamage{sniper, Fixed::One(), *content::DamageTypeIndex("KILL_PILOT"), *content::DeathTypeIndex("NORMAL")};
}

bool Unmanned(session::Session &game, ecs::Entity entity)
{
	const auto *off = game.World().Get<gp::Disabled>(entity);
	return off != nullptr && (off->mask & gp::disabled_type::Unmanned) != 0;
}
}

BOOST_AUTO_TEST_SUITE(unmanned_vehicles)

// ActiveBody::attemptDamage, DAMAGE_KILLPILOT, and Object::setDisabledUntil(DISABLED_UNMANNED): the tick the shot lands,
// a veteran China Battlemaster (TankArmor: KILL_PILOT 100%) keeps all its health, is unmanned, drops to no experience
// (setExperienceAndLevel(0): level and points none, its health back to a regular's), idles and is the neutral player's
// (setTeam); the hit is told (doDamageFX: amount 1). A civilian taxi (a CARBOMB weapon set) is killed outright on that
// very tick. An infantry the same shot hits is not a VEHICLE: nothing happens to it, not even damage.
BOOST_AUTO_TEST_CASE(legacy_parity_a_pilot_kill_leaves_a_vehicle_unmanned)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const ecs::Entity jarmen = game.Place("GLAInfantryJarmenKell", match->At(0, -300), {}, match->Team(game, 0));
	const ecs::Entity tank = game.Place("ChinaTankBattleMaster", match->At(150, -300), {}, match->Team(game, 1));
	const ecs::Entity taxi = game.Place("CarTaxiCab02", match->At(-150, -300), {}, neutral);
	const ecs::Entity soldier = game.Place("ChinaInfantryRedguard", match->At(0, -450), {}, match->Team(game, 1));
	generalszh::gameplay::PlaceAtVeterancy(game.Game(), tank, 1);
	BOOST_TEST_REQUIRE(world.Get<gp::Experience>(tank)->level == 1);
	const Fixed veteranHealth = world.Get<gp::Health>(tank)->current;
	*world.Get<gp::MoveOrder>(tank) = gp::MoveToPoint(match->At(400, -300));
	const Fixed soldierHealth = world.Get<gp::Health>(soldier)->current;
	Snipe(game, jarmen, tank);
	Snipe(game, jarmen, taxi);
	Snipe(game, jarmen, soldier);
	game.Tick();
	BOOST_TEST(Unmanned(game, tank));
	BOOST_TEST((world.Get<gp::Health>(tank)->current == world.Get<gp::Health>(tank)->maximum));
	BOOST_TEST((world.Get<gp::Health>(tank)->current < veteranHealth)); // a regular's again
	BOOST_TEST(world.Get<gp::Experience>(tank)->level == 0);
	BOOST_TEST(world.Get<gp::Experience>(tank)->points == 0);
	BOOST_TEST((world.Get<gp::MoveOrder>(tank)->mode == gp::MoveMode::Idle));
	BOOST_TEST(world.Get<gp::TeamMember>(tank)->team == neutral);
	BOOST_TEST(world.Get<gp::Owner>(tank)->player == game.Teams().TeamAt(neutral).owner);
	bool told = false;
	world.Resource<gp::Hits>().ForEach([&](const gp::Hit &hit) { told = told || (hit.target == tank && hit.handled && hit.amount == Fixed::One()); });
	BOOST_TEST(told);
	BOOST_TEST((!world.IsAlive(taxi) || world.Get<gp::Dying>(taxi) != nullptr));
	BOOST_TEST(!Unmanned(game, soldier));
	BOOST_TEST((world.Get<gp::Health>(soldier)->current == soldierHealth));
}

// doTeamCaptureNearestUnownedFactionUnit and the unmanned-vehicle case of ActionManager::canEnterObject /
// PhysicsBehavior::onCollide: America's team is told to enter the unmanned Battlemaster nearest its centre (a farther
// one is left); its Ranger walks to it and, the tick it gets there, the tank is manned, captured (setCaptured, counted
// as America's one captured unit), America's (defect at once), its name the Ranger's, and the Ranger is gone; America's vehicles (not INFANTRY) are not sent. A second Ranger bound for a
// tank already taken over gives up and idles (AIEnterState's STATE_FAILURE) the next tick.
BOOST_AUTO_TEST_CASE(legacy_parity_infantry_take_over_the_nearest_unmanned_vehicle)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	const std::uint32_t america = match->Team(game, 0);
	// The sniper stays out of it: the neutral player's.
	const ecs::Entity jarmen = game.Place("GLAInfantryJarmenKell", match->At(0, -500), {}, *game.Teams().FindTeam("team"));
	const ecs::Entity near = game.Place("ChinaTankBattleMaster", match->At(120, -300), {}, match->Team(game, 1));
	const ecs::Entity far = game.Place("ChinaTankBattleMaster", match->At(900, -300), {}, match->Team(game, 1));
	Snipe(game, jarmen, near);
	Snipe(game, jarmen, far);
	game.Tick();
	BOOST_TEST_REQUIRE((Unmanned(game, near) && Unmanned(game, far)));
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(0, -300), {}, america);
	game.Game().names.Assign("Hero", ranger);
	generalszh::gameplay::TeamCaptureNearestUnowned(game.Game(), "#" + std::to_string(america));
	BOOST_TEST_REQUIRE(world.Get<gp::Boarding>(ranger) != nullptr);
	BOOST_TEST((world.Get<gp::Boarding>(ranger)->transport == near));
	// The team's dozer (a VEHICLE) is not sent.
	for (const ecs::Entity member : game.Teams().TeamAt(america).members)
		if (member != ranger)
			BOOST_TEST(world.Get<gp::Boarding>(member) == nullptr);
	int ticks = 0;
	while (world.IsAlive(ranger) && ticks < 600)
	{
		BOOST_TEST_REQUIRE(Unmanned(game, near));
		game.Tick();
		++ticks;
	}
	BOOST_TEST_MESSAGE("taken over after " << ticks << " ticks");
	BOOST_TEST_REQUIRE(!world.IsAlive(ranger));
	BOOST_TEST(!Unmanned(game, near));
	BOOST_TEST(world.Get<gp::TeamMember>(near)->team == america);
	BOOST_TEST((game.Game().names.Find("Hero") == near));
	BOOST_TEST(Unmanned(game, far));
	// Object::setCaptured(true): the tank counts as a captured unit of America's
	// (evaluateSkirmishPlayerHasComparisonCapturedUnits); the one left unmanned is not captured.
	const std::uint32_t americanPlayer = game.Teams().TeamAt(america).owner;
	BOOST_TEST(world.Has<gp::Captured>(near));
	BOOST_TEST(!world.Has<gp::Captured>(far));
	BOOST_TEST(generalszh::gameplay::CountCapturedObjects(game.Game(), americanPlayer) == 1);

	// Bound for a tank no longer unmanned: it gives up the next tick.
	const ecs::Entity late = game.Place("AmericaInfantryRanger", match->At(0, -300), {}, america);
	world.Add<gp::Boarding>(late);
	*world.Get<gp::Boarding>(late) = {near};
	*world.Get<gp::MoveOrder>(late) = gp::MoveToPoint(match->At(120, -300));
	game.Tick();
	BOOST_TEST(world.Get<gp::Boarding>(late) == nullptr);
	BOOST_TEST((world.Get<gp::MoveOrder>(late)->mode == gp::MoveMode::Idle));
	BOOST_TEST(world.Get<gp::TeamMember>(near)->team == america);
}

// ConvertToCarBombCrateCollide through CommandButtonHuntUpdate::huntEnter (scanClosestTarget: the neutral only, near to
// far; canConvertObjectToCarBomb) and aiEnter: a veteran terrorist of America's hunting with its Make Car Bomb button,
// China neutral to it, picks China's Camaro (a Crusader nearer has no CARBOMB weapon set: passed over) at its first scan
// and walks to it (CMD_FROM_AI); the tick it touches it (the boarding's arrival: within the car's bounding circle and
// 20) the car takes its CARBOMB weapon set flag and IS_CARBOMB, defects to America's default team at once, takes the
// terrorist's name, vision (150) and shroud clearing range (200) and veterancy, FX_MakeCarBombSuccess plays on it, and
// the terrorist is gone. A car bomb is never made one again.
BOOST_AUTO_TEST_CASE(legacy_parity_a_hunting_terrorist_makes_a_car_bomb_of_a_neutral_car)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	const std::uint32_t america = match->Team(game, 0), china = match->Team(game, 1);
	const ecs::Entity terrorist = game.Place("GLAInfantryTerrorist", match->At(0, -300), {}, america);
	const ecs::Entity tank = game.Place("AmericaTankCrusader", match->At(-60, -300), {}, china);
	const ecs::Entity car = game.Place("CarCamaro", match->At(140, -300), {}, china);
	const std::uint32_t us = world.Get<gp::Owner>(terrorist)->player, them = world.Get<gp::Owner>(car)->player;
	auto &relationships = world.Resource<gp::Relationships>();
	relationships.Set(us, them, gp::Relationship::Neutral);
	relationships.Set(them, us, gp::Relationship::Neutral);
	game.Game().names.Assign("Bomber", terrorist);
	gameplay::PlaceAtVeterancy(game.Game(), terrorist, 2, true);
	game.Tick();
	BOOST_TEST(!gameplay::CanConvertToCarBomb(game.Game(), terrorist, tank, false)); // no CARBOMB weapon set
	BOOST_TEST_REQUIRE(gameplay::CanConvertToCarBomb(game.Game(), terrorist, car, false));
	gameplay::StartCommandButtonHunt(game.Game(), terrorist, "Command_GLAInfantryTerroristMakeCarBomb");
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Boarding>(terrorist) != nullptr);
	BOOST_TEST((world.Get<gp::Boarding>(terrorist)->transport == car));
	const Fixed reach = world.Get<gp::Targetable>(car)->radius + Fixed::FromInt(20);
	int ticks = 0, within = -1;
	while (world.IsAlive(terrorist) && ticks < 600)
	{
		const auto apart = Engine::Math::Distance(world.Get<gp::Transform>(terrorist)->position.XY(), world.Get<gp::Transform>(car)->position.XY());
		if (within < 0 && apart <= reach)
			within = ticks;
		BOOST_TEST_REQUIRE(world.Get<gp::TeamMember>(car)->team == china);
		game.Tick();
		++ticks;
	}
	BOOST_TEST_MESSAGE("converted after " << ticks << " ticks");
	BOOST_TEST_REQUIRE(!world.IsAlive(terrorist));
	// Converted the tick it begins within reach.
	BOOST_TEST(within == ticks - 1);
	BOOST_TEST(world.Get<gp::TeamMember>(car)->team == america);
	BOOST_TEST(world.Get<gp::Owner>(car)->player == us);
	BOOST_TEST((world.Get<gp::Loadout>(car)->weaponFlags & content::SetFlag(content::WeaponSetFlagNames, "CARBOMB")) != 0u);
	BOOST_TEST((world.Get<gp::StatusFlags>(car)->bits & (std::uint64_t{1} << content::ObjectStatusBit("IS_CARBOMB"))) != 0u);
	BOOST_TEST((world.Get<gp::Aggression>(car)->vision == Fixed::FromInt(150)));
	BOOST_TEST((world.Get<gp::Vision>(car)->clearingRange == Fixed::FromInt(200)));
	BOOST_TEST(world.Get<gp::Experience>(car)->level == 2u);
	BOOST_TEST((game.Game().names.Find("Bomber") == car));
	bool fx = false;
	for (const auto &pickup : world.Resource<gameplay::CratePickups>().list)
		fx = fx || (pickup.picker == car && pickup.fx == "FX_MakeCarBombSuccess");
	BOOST_TEST(fx);
	const ecs::Entity another = game.Place("GLAInfantryTerrorist", match->At(0, -300), {}, america);
	game.Tick();
	BOOST_TEST(!gameplay::CanConvertToCarBomb(game.Game(), another, car, false));
	BOOST_TEST(world.Get<gp::TeamMember>(tank)->team == china);
}

// ConvertToHijackedVehicleCrateCollide (isValidToExecute, executeCrateBehavior), ActionManager::canHijackVehicle and
// HijackerUpdate::update on the shipped GLAInfantryHijacker (VisionRange 100, ShroudClearingRange 200, ParachuteName
// AmericaParachute). Told to hijack China's Crusader (an enemy VEHICLE with an EjectPilotDie) it walks to it and takes it
// the tick it begins within reach (the car bomber's touch): the tank joins America's default team HIJACKED, takes the
// hijacker's name, vision 100 and shroud clearing range 200 and the higher veterancy (the hijacker's veteran), and the
// hijacker rides hidden (off the map, NO_COLLISIONS MASKED UNSELECTABLE) where the tank is, every tick after. A
// hijacked vehicle is never hijacked again. The tank destroyed, the hijacker is out where it last was the tick after
// (HijackerUpdate finds its target gone), back on the map and idle. A Technical (no EjectPilotDie) keeps no driver: its
// hijacker is gone. The same on 4 workers, and a checkpoint taken while it rides carries on exactly.
BOOST_AUTO_TEST_CASE(legacy_parity_a_hijacker_takes_a_vehicle_and_leaves_it_when_it_dies)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	struct Game
	{
		std::unique_ptr<session::Session> game;
		ecs::Entity hijacker, tank, technical, other;
	};
	const auto stage = [&](std::size_t workers) {
		Game made;
		made.game = std::make_unique<session::Session>(match->skirmish.level, shell.game, match->Options(workers));
		made.game->Tick();
		const std::uint32_t america = match->Team(*made.game, 0), china = match->Team(*made.game, 1);
		made.hijacker = made.game->Place("GLAInfantryHijacker", match->At(0, -300), {}, america);
		made.tank = made.game->Place("AmericaTankCrusader", match->At(160, -300), {}, china);
		made.technical = made.game->Place("GLAVehicleTechnical", match->At(0, -150), {}, china);
		made.other = made.game->Place("GLAInfantryHijacker", match->At(-40, -150), {}, america);
		made.game->Game().names.Assign("Jacker", made.hijacker);
		gameplay::PlaceAtVeterancy(made.game->Game(), made.hijacker, 1, true);
		made.game->Tick();
		return made;
	};
	Game one = stage(1), four = stage(4);
	auto &game = *one.game;
	auto &world = game.World();
	const auto tick = [&] {
		game.Tick();
		four.game->Tick();
	};
	const std::uint32_t america = match->Team(game, 0), china = match->Team(game, 1);
	const std::uint64_t hijacked = std::uint64_t{1} << content::ObjectStatusBit("HIJACKED");
	const std::uint64_t hidden = (std::uint64_t{1} << content::ObjectStatusBit("NO_COLLISIONS")) | (std::uint64_t{1} << content::ObjectStatusBit("MASKED")) |
		(std::uint64_t{1} << content::ObjectStatusBit("UNSELECTABLE"));
	const auto status = [&](ecs::Entity entity) {
		const auto *flags = world.Get<gp::StatusFlags>(entity);
		return flags != nullptr ? flags->bits : std::uint64_t{0};
	};
	BOOST_TEST_REQUIRE(gameplay::IsHijacker(game.Game(), one.hijacker));
	BOOST_TEST(gameplay::CanHijack(game.Game(), one.hijacker, one.tank, false));
	BOOST_TEST(gameplay::CanHijack(game.Game(), one.hijacker, one.technical, false));
	BOOST_TEST(!gameplay::CanHijack(game.Game(), one.hijacker, one.other, false)); // not a vehicle, nor an enemy

	BOOST_TEST_REQUIRE(gameplay::OrderHijack(game.Game(), one.hijacker, one.tank, true, false));
	gameplay::OrderHijack(four.game->Game(), four.hijacker, four.tank, true, false);
	const Fixed reach = world.Get<gp::Targetable>(one.tank)->radius + Fixed::FromInt(20);
	int ticks = 0, within = -1;
	while (world.Get<gp::TeamMember>(one.tank)->team == china && ticks < 600)
	{
		const auto apart = Engine::Math::Distance(world.Get<gp::Transform>(one.hijacker)->position.XY(), world.Get<gp::Transform>(one.tank)->position.XY());
		if (within < 0 && apart <= reach)
			within = ticks;
		tick();
		++ticks;
	}
	BOOST_TEST_MESSAGE("hijacked after " << ticks << " ticks");
	BOOST_TEST_REQUIRE(world.Get<gp::TeamMember>(one.tank)->team == america);
	BOOST_TEST(within == ticks - 1);
	BOOST_TEST(world.IsAlive(one.hijacker));
	BOOST_TEST((status(one.tank) & hijacked) != 0u);
	BOOST_TEST((status(one.hijacker) & hidden) == hidden);
	BOOST_TEST(world.Get<gp::OffMap>(one.hijacker) != nullptr);
	BOOST_TEST((world.Get<gp::Aggression>(one.tank)->vision == Fixed::FromInt(100)));
	BOOST_TEST((world.Get<gp::Vision>(one.tank)->clearingRange == Fixed::FromInt(200)));
	BOOST_TEST(world.Get<gp::Experience>(one.tank)->level == 1u);
	BOOST_TEST((game.Game().names.Find("Jacker") == one.tank));
	BOOST_TEST(!gameplay::CanHijack(game.Game(), one.other, one.tank, false));

	// Riding: where the tank is, every tick.
	gameplay::OrderMove(game.Game(), one.tank, match->At(160, -500), true);
	gameplay::OrderMove(four.game->Game(), four.tank, match->At(160, -500), true);
	for (int step = 0; step < 40; ++step)
	{
		tick();
		BOOST_TEST_REQUIRE((world.Get<gp::Transform>(one.hijacker)->position == world.Get<gp::Transform>(one.tank)->position));
	}
	BOOST_TEST((game.StateHash() == four.game->StateHash()));
	auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), game.Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST((restored->StateHash() == game.StateHash()));

	// The tank killed: the hijacker rides on through its slow death; the tick after it is gone, it is out where the
	// tank last was.
	gameplay::KillNow(game.Game(), one.tank);
	gameplay::KillNow(four.game->Game(), four.tank);
	auto last = world.Get<gp::Transform>(one.tank)->position;
	int dying = 0;
	while (world.IsAlive(one.tank) && dying < 900)
	{
		last = world.Get<gp::Transform>(one.tank)->position;
		BOOST_TEST_REQUIRE(world.Get<gp::OffMap>(one.hijacker) != nullptr);
		tick();
		++dying;
	}
	BOOST_TEST_MESSAGE("the tank gone after " << dying << " ticks");
	BOOST_TEST_REQUIRE(!world.IsAlive(one.tank));
	BOOST_TEST(world.Get<gp::OffMap>(one.hijacker) != nullptr);
	tick();
	BOOST_TEST(world.Get<gp::OffMap>(one.hijacker) == nullptr);
	BOOST_TEST((status(one.hijacker) & hidden) == 0u);
	BOOST_TEST((world.Get<gp::Transform>(one.hijacker)->position.XY() == last.XY()));
	BOOST_TEST((world.Get<gp::MoveOrder>(one.hijacker)->mode == gp::MoveMode::Idle));

	// A Technical keeps no driver.
	BOOST_TEST_REQUIRE(gameplay::OrderHijack(game.Game(), one.other, one.technical, true, false));
	gameplay::OrderHijack(four.game->Game(), four.other, four.technical, true, false);
	int walk = 0;
	while (world.IsAlive(one.other) && walk < 600)
	{
		tick();
		++walk;
	}
	BOOST_TEST(!world.IsAlive(one.other));
	BOOST_TEST(world.Get<gp::TeamMember>(one.technical)->team == america);
	BOOST_TEST((game.StateHash() == four.game->StateHash()));
}

// GameLogic::onResumeConstruction / onDoRepair (Core/GameEngine/Source/GameLogic/System/GameLogicDispatch.cpp) ->
// AIGroup::groupResumeConstruction / groupRepair -> DozerAIUpdate::privateResumeConstruction / privateRepair
// (GeneralsMD/.../Object/Update/AIUpdate/DozerAIUpdate.cpp) with ActionManager::canResumeConstructionOf and
// canRepairObject: a power plant its dozer left unfinished is taken up by another dozer the tick the order comes in (a
// build task: it becomes the plant's builder), and the first, ordered too, is refused (the builder is alive at work on it);
// a hurt finished plant gets a dozer's repair task, a whole one none; a unit with no dozer's AI does nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_dozers_resume_and_repair_structures_on_their_players_orders)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	game.Tick();
	const std::uint32_t america = match->Team(game, 0);
	const ecs::Entity first = game.Place("AmericaVehicleDozer", match->At(200, -150), {}, america);
	const ecs::Entity second = game.Place("AmericaVehicleDozer", match->At(260, -150), {}, america);
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(320, -150), {}, america);
	const ecs::Entity finished = game.Place("AmericaPowerPlant", match->At(-200, -350), {}, america);
	BOOST_TEST_REQUIRE(world.IsAlive(finished));
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	const auto send = [&](const commands::GameCommand &command) {
		auto envelope = commands::Encode(command);
		envelope.player = 0;
		game.Tick(std::span(&envelope, 1));
	};
	send(commands::BuildStructure{first, "AmericaPowerPlant", match->At(200, -350), 0});
	ecs::Entity plant;
	if (const auto *task = world.Get<gp::Builder>(first))
		plant = task->target;
	BOOST_TEST_REQUIRE(world.IsAlive(plant));
	BOOST_TEST_REQUIRE(world.Has<gp::UnderConstruction>(plant));
	send(commands::Stop{{first}}); // abandoned: waits to be resumed
	BOOST_TEST(!world.Has<gp::Builder>(first));
	BOOST_TEST((world.Get<gp::UnderConstruction>(plant)->builder == first));
	send(commands::ResumeConstruction{{second}, plant});
	BOOST_TEST_REQUIRE(world.Has<gp::Builder>(second));
	BOOST_TEST((world.Get<gp::Builder>(second)->target == plant));
	BOOST_TEST(world.Get<gp::Builder>(second)->repair == 0u);
	BOOST_TEST((world.Get<gp::UnderConstruction>(plant)->builder == second));
	send(commands::ResumeConstruction{{first, humvee}, plant});
	BOOST_TEST(!world.Has<gp::Builder>(first)); // its builder is at work on it
	BOOST_TEST(!world.Has<gp::Builder>(humvee));
	// Repairs: not while whole; hurt, a repair task.
	send(commands::Repair{{first}, finished});
	BOOST_TEST(!world.Has<gp::Builder>(first));
	world.Get<gp::Health>(finished)->current = world.Get<gp::Health>(finished)->maximum / Fixed::FromInt(2);
	send(commands::Repair{{first, humvee}, finished});
	BOOST_TEST_REQUIRE(world.Has<gp::Builder>(first));
	BOOST_TEST((world.Get<gp::Builder>(first)->target == finished));
	BOOST_TEST(world.Get<gp::Builder>(first)->repair == 1u);
	BOOST_TEST(!world.Has<gp::Builder>(humvee));
}

// GameLogic::onGetHealed -> AIGroup::groupGetHealed -> AIUpdateInterface::privateGetHealed (GeneralsMD/.../Object/
// Update/AIUpdate.cpp): ActionManager::canGetHealedAt (an ally's HEAL_PAD, the infantry hurt), then aiEnter: a hurt
// ranger ordered to its player's barracks sets out into it the tick the order comes in; a whole one does not.
BOOST_AUTO_TEST_CASE(legacy_parity_hurt_infantry_ordered_to_a_heal_pad_goes_in)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	game.Tick();
	const std::uint32_t america = match->Team(game, 0);
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(-200, -350), {}, america);
	const ecs::Entity hurt = game.Place("AmericaInfantryRanger", match->At(-100, -200), {}, america);
	const ecs::Entity whole = game.Place("AmericaInfantryRanger", match->At(-60, -200), {}, america);
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	world.Get<gp::Health>(hurt)->current = world.Get<gp::Health>(hurt)->maximum / Fixed::FromInt(2);
	auto envelope = commands::Encode(commands::GetHealed{{hurt, whole}, barracks});
	envelope.player = 0;
	game.Tick(std::span(&envelope, 1));
	BOOST_TEST_REQUIRE(world.Has<gp::Boarding>(hurt));
	BOOST_TEST((world.Get<gp::Boarding>(hurt)->transport == barracks));
	BOOST_TEST(!world.Has<gp::Boarding>(whole));
}

// ActionManager::canDoSpecialPowerAtObject's SPECIAL_BLACKLOTUS_DISABLE_VEHICLE_HACK (canDisableVehicleViaHacking),
// SPECIAL_BLACKLOTUS_STEAL_CASH_HACK (canStealCashViaHacking) and SPECIAL_HACKER_DISABLE_BUILDING (an enemy's CAPTURABLE
// structure): a Black Lotus may hack an enemy Humvee but not an enemy aircraft nor one of its own player's; steal from an
// enemy supply centre (CASH_GENERATOR, CAPTURABLE) but not from a power plant; a hacker may disable the power plant.
BOOST_AUTO_TEST_CASE(legacy_parity_black_lotus_and_hackers_hack_what_the_original_lets_them)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	game.Tick();
	const std::uint32_t america = match->Team(game, 0), china = match->Team(game, 1);
	const ecs::Entity lotus = game.Place("ChinaInfantryBlackLotus", match->At(0, -200), {}, china);
	const ecs::Entity hacker = game.Place("ChinaInfantryHacker", match->At(20, -200), {}, china);
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(60, -200), {}, america);
	const ecs::Entity ownTank = game.Place("ChinaTankBattleMaster", match->At(0, -160), {}, china);
	const ecs::Entity raptor = game.Place("AmericaJetRaptor", match->At(0, -240), {}, america);
	const ecs::Entity centre = game.Place("AmericaSupplyCenter", match->At(0, -350), {}, america);
	const ecs::Entity plant = game.Place("AmericaPowerPlant", match->At(120, -300), {}, america);
	for (int tick = 0; tick < 10; ++tick)
		game.Tick();
	const auto power = [&](std::string_view name) { return *shell.game.powers.Template(name); };
	const std::uint32_t vehicleHack = power("SpecialAbilityBlackLotusDisableVehicleHack");
	const std::uint32_t cashHack = power("SpecialAbilityBlackLotusStealCashHack");
	const std::uint32_t buildingHack = power("SpecialAbilityHackerDisableBuilding");
	auto &gameWorld = game.Game();
	BOOST_TEST(gameplay::CanTargetWithPower(gameWorld, lotus, vehicleHack, humvee));
	BOOST_TEST(!gameplay::CanTargetWithPower(gameWorld, lotus, vehicleHack, raptor)); // an AIRCRAFT
	BOOST_TEST(!gameplay::CanTargetWithPower(gameWorld, lotus, vehicleHack, ownTank));
	BOOST_TEST(gameplay::CanTargetWithPower(gameWorld, lotus, cashHack, centre));
	BOOST_TEST(!gameplay::CanTargetWithPower(gameWorld, lotus, cashHack, plant)); // no CASH_GENERATOR
	BOOST_TEST(gameplay::CanTargetWithPower(gameWorld, hacker, buildingHack, plant));
	BOOST_TEST(!gameplay::CanTargetWithPower(gameWorld, hacker, buildingHack, humvee)); // no STRUCTURE
}

// JetAIUpdate::privateEnter / doLandingCommand (GeneralsMD/.../Object/Update/AIUpdate/JetAIUpdate.cpp) through
// GameLogic::onEnter: an airborne Raptor of America's ordered into its player's airfield with a space free reserves that
// space (the airfield its producer now) and turns back to land (RETURNING_FOR_LANDING); a grounded one's order does
// nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_jet_ordered_into_its_players_airfield_turns_back_to_land)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	game.Tick();
	const std::uint32_t america = match->Team(game, 0);
	const ecs::Entity airfield = game.Place("AmericaAirfield", match->At(-300, -400), {}, america);
	const ecs::Entity raptor = game.Place("AmericaJetRaptor", match->At(200, -200), {}, america);
	BOOST_TEST_REQUIRE(world.Has<gp::Airfield>(airfield));
	BOOST_TEST_REQUIRE(world.Has<gp::Jet>(raptor));
	game.Tick();
	const auto send = [&] {
		auto envelope = commands::Encode(commands::Enter{{raptor}, airfield});
		envelope.player = 0;
		game.Tick(std::span(&envelope, 1));
	};
	// On the ground: nothing (canEnterObject: not above the terrain).
	world.Get<gp::Jet>(raptor)->state = gp::JetState::Parked;
	world.Get<gp::Jet>(raptor)->airfield = {};
	send();
	BOOST_TEST((world.Get<gp::Jet>(raptor)->airfield == ecs::Entity{}));
	// Flying.
	world.Get<gp::Jet>(raptor)->state = gp::JetState::Flying;
	world.Get<gp::Transform>(raptor)->position.z = game.Game().ground.At(world.Get<gp::Transform>(raptor)->position.XY()) + Fixed::FromInt(100);
	send();
	BOOST_TEST((world.Get<gp::Jet>(raptor)->airfield == airfield));
	BOOST_TEST(world.Get<gp::Jet>(raptor)->space == 0u);
	BOOST_TEST((world.Get<gp::Jet>(raptor)->state == gp::JetState::Returning));
}

// Legacy parity (ParkingPlaceBehavior::setHealee / resetWakeFrame / update, JetAIUpdate's setHealee each update): a
// damaged Raptor parked in its AmericaAirfield space (HealAmountPerSecond 10) becomes a healee. The next heal comes 6
// frames later (HEAL_RATE_FRAMES), then one every 6 frames, each 6 x 10 / 30 = 2 health. Taking off ends it.
BOOST_AUTO_TEST_CASE(legacy_parity_an_airfield_repairs_its_parked_jets)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	game.Tick();
	const std::uint32_t america = match->Team(game, 0);
	const ecs::Entity airfield = game.Place("AmericaAirfield", match->At(-300, -400), {}, america);
	const ecs::Entity raptor = game.Place("AmericaJetRaptor", match->At(-300, -400), {}, america);
	BOOST_TEST_REQUIRE(world.Has<gp::Airfield>(airfield));
	game.Tick();
	{
		auto &jet = *world.Get<gp::Jet>(raptor);
		jet.airfield = airfield;
		jet.space = 0;
		jet.state = gp::JetState::Parked;
		world.Get<gp::Transform>(raptor)->position = world.Get<gp::Airfield>(airfield)->spaces[0].parking;
		world.Get<gp::Health>(raptor)->current = world.Get<gp::Health>(raptor)->maximum / Fixed::FromInt(2);
	}
	const Fixed half = world.Get<gp::Health>(raptor)->current;
	const std::uint64_t parked = game.CurrentTick() + 1; // the first update that sees it parked
	std::vector<std::uint64_t> heals;
	Fixed last = half;
	for (int tick = 0; tick < 40 && heals.size() < 4; ++tick)
	{
		game.Tick();
		BOOST_TEST_REQUIRE((world.Get<gp::Jet>(raptor)->state == gp::JetState::Parked));
		const Fixed now = world.Get<gp::Health>(raptor)->current;
		if (now != last)
		{
			BOOST_TEST((now == last + Fixed::FromInt(2)));
			heals.push_back(game.CurrentTick());
			last = now;
		}
	}
	BOOST_TEST_REQUIRE(heals.size() == 4u);
	BOOST_TEST(heals[0] == parked + 6);
	for (std::size_t index = 1; index < heals.size(); ++index)
		BOOST_TEST(heals[index] == heals[index - 1] + 6);
}

// Legacy parity (ActiveBody::attemptDamage, DAMAGE_KILLPILOT on a rider-change container): Jarmen Kell's pilot shot
// at a standing Combat Bike throws its rider off (aiEvacuateInstantly) and kills him (Object::kill), the kill Jarmen's
// (scoreTheKill: he gains the rider's experience value); at a moving bike it kills the bike itself, again his.
BOOST_AUTO_TEST_CASE(legacy_parity_a_pilot_kill_on_a_combat_bike)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	const ecs::Entity jarmen = game.Place("GLAInfantryJarmenKell", match->At(0, -300), {}, match->Team(game, 0));
	const ecs::Entity standing = game.Place("GLAVehicleCombatBike", match->At(150, -300), {}, match->Team(game, 1));
	const ecs::Entity moving = game.Place("GLAVehicleCombatBike", match->At(-150, -300), {}, match->Team(game, 1));
	game.Tick(); // their initial riders get on
	const auto aboard = world.Resource<gp::CargoManifest>().Aboard(standing);
	BOOST_TEST_REQUIRE(aboard.size() == 1u);
	const ecs::Entity rider = aboard.front();
	generalszh::gameplay::OrderMove(game.Game(), moving, match->At(-600, -300), true, true);
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE((world.Get<gp::MoveOrder>(moving)->mode != gp::MoveMode::Idle));
	const std::int32_t points = world.Get<gp::Experience>(jarmen)->points;
	Snipe(game, jarmen, standing);
	game.Tick();
	BOOST_TEST(world.Resource<gp::CargoManifest>().Aboard(standing).empty());
	game.Tick(); // the kill (Object::kill) is carried out with the next deaths
	BOOST_TEST((!world.IsAlive(rider) || world.Get<gp::Dying>(rider) != nullptr));
	BOOST_TEST(world.Get<gp::Experience>(jarmen)->points > points);
	const std::int32_t after = world.Get<gp::Experience>(jarmen)->points;
	Snipe(game, jarmen, moving);
	game.Tick();
	game.Tick();
	BOOST_TEST((!world.IsAlive(moving) || world.Get<gp::Dying>(moving) != nullptr));
	BOOST_TEST(world.Get<gp::Experience>(jarmen)->points > after);
}

// Legacy parity (RiderChangeContain::isValidContainerFor with no capacity check, onContaining's aiEvacuateInstantly and
// onRemoving under m_containing): Jarmen Kell ordered onto a Combat Bike that carries its Rebel gets on; the Rebel is
// thrown off alive, Jarmen rides it, and the bike is not scuttled.
BOOST_AUTO_TEST_CASE(legacy_parity_a_new_rider_throws_the_old_one_off_a_combat_bike)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	const ecs::Entity bike = game.Place("GLAVehicleCombatBike", match->At(150, -300), {}, match->Team(game, 0));
	const ecs::Entity jarmen = game.Place("GLAInfantryJarmenKell", match->At(120, -300), {}, match->Team(game, 0));
	game.Tick();
	const auto &manifest = world.Resource<gp::CargoManifest>();
	BOOST_TEST_REQUIRE(manifest.Aboard(bike).size() == 1u);
	const ecs::Entity rebel = manifest.Aboard(bike).front();
	generalszh::gameplay::OrderBoard(game.Game(), jarmen, bike, true);
	bool rode = false;
	for (int tick = 0; tick < 300 && !rode; ++tick)
	{
		game.Tick();
		const auto aboard = manifest.Aboard(bike);
		rode = aboard.size() == 1u && aboard.front() == jarmen;
	}
	BOOST_TEST_REQUIRE(rode);
	BOOST_TEST(world.IsAlive(rebel));
	BOOST_TEST(world.Get<gp::Passenger>(rebel) == nullptr);
	BOOST_TEST(world.Get<generalszh::gameplay::RiderChange>(bike)->scuttledTick == 0u);
	BOOST_TEST(world.IsAlive(bike));
}

// ActionManager::canEnterObject for a pilot (its VeterancyCrateCollide, IsPilot) and aiEnter through GameLogic::onEnter,
// then VeterancyCrateCollide::onCollide: a human player's pilot ordered into its player's Crusader goes for it and, on
// reaching it, gives it its veterancy and is gone.
BOOST_AUTO_TEST_CASE(legacy_parity_a_human_players_pilot_ordered_into_its_vehicle_climbs_in)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	game.Tick();
	const std::uint32_t america = match->Team(game, 0);
	const ecs::Entity pilot = game.Place("AmericaInfantryPilot", match->At(200, -200), {}, america);
	const ecs::Entity tank = game.Place("AmericaTankCrusader", match->At(280, -200), {}, america);
	BOOST_TEST_REQUIRE(world.IsAlive(pilot));
	world.Get<gp::Experience>(pilot)->level = 1;
	for (int tick = 0; tick < 60; ++tick)
		game.Tick();
	BOOST_TEST(world.IsAlive(pilot)); // a human's pilot looks for none by itself
	BOOST_TEST(world.Get<gp::Experience>(tank)->level == 0u);
	auto envelope = commands::Encode(commands::Enter{{pilot}, tank});
	envelope.player = 0;
	game.Tick(std::span(&envelope, 1));
	BOOST_TEST_REQUIRE(world.Has<generalszh::gameplay::PilotSeeker>(pilot));
	BOOST_TEST((world.Get<generalszh::gameplay::PilotSeeker>(pilot)->goal == tank));
	const std::uint64_t ordered = game.CurrentTick();
	std::optional<std::uint64_t> joined;
	for (int tick = 0; tick < 300 && !joined; ++tick)
	{
		game.Tick();
		if (world.Get<gp::Experience>(tank)->level == 1u)
			joined = game.CurrentTick();
	}
	BOOST_TEST_REQUIRE(joined.has_value());
	BOOST_TEST_MESSAGE("joined " << (*joined - ordered) << " ticks after the order");
	BOOST_TEST(*joined - ordered == 58u); // pinned: the walk over 80 is this port's locomotion and pathing

	game.Tick();
	BOOST_TEST(!world.IsAlive(pilot));
}

BOOST_AUTO_TEST_SUITE_END()
