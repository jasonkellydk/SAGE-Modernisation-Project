// The terrain's bridges on shipped data: Roads.ini's Bridge blocks and their models' widths, map-drawn bridges made from
// a shipped map's bridge points, and a landmark bridge's towers, damage states and death.
using namespace generalszh;
namespace gp = engine::gameplay;
namespace ga = generalszh::gameplay;
using Engine::Math::Fixed;

namespace
{
struct Install
{
	engine::filesystem::VirtualFileSystem files;
	engine::config::Diagnostics grammarDiagnostics;
	std::optional<content::ContentLoader> loader;
	content::GameContent game;
	bool loaded{false};

	Install()
	{
		const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
		if (install == nullptr || !std::filesystem::exists(install))
			return;
		content::MountInstall(files, install);
		loader.emplace(files, content::ZeroHourIniGrammar(grammarDiagnostics));
		game = content::LoadGameContent(*loader, engine::time::FixedStep{30});
		loaded = true;
	}
};

Install &Data()
{
	static Install install;
	return install;
}

// A map as a two-player skirmish (seats 0 and 1 at the map's first two starts).
struct Match
{
	std::optional<engine::level::generals_map::ReadResult> read;
	session::setup::SkirmishLevel skirmish;

	session::SessionOptions Options(std::size_t workers) const
	{
		session::SessionOptions options{11, workers, {}, {"player0", "player1"}};
		for (const auto &player : skirmish.players)
			options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
		return options;
	}
};

std::optional<Match> Prepare(Install &shell, const std::string &path)
{
	const auto bytes = shell.files.Read(path);
	if (!bytes)
		return std::nullopt;
	Match match;
	auto read = engine::level::generals_map::Read(*bytes);
	if (!read)
		return std::nullopt;
	match.read = std::move(*read);
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 7;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::Player, u"Other");
	setup.slots[1].playerTemplate = templateOf("FactionChina");
	setup.slots[1].startPos = 1;
	match.skirmish = session::setup::PrepareSkirmishLevel(match.read->level, setup, shell.game.playerTemplates, 4);
	return match;
}

std::vector<ecs::Entity> Bridges(session::Session &game)
{
	std::vector<ecs::Entity> found;
	ecs::Query<ecs::Read<ga::Bridge>> query(game.World());
	query.ForEachChunk([&](auto chunk) {
		for (const ecs::Entity entity : chunk.Entities())
			found.push_back(entity);
	});
	return found;
}
}

BOOST_AUTO_TEST_SUITE(bridges)

// W3DBridgeBuffer::loadBridges / W3DBridge::getBridgeInfo and TerrainLogic.cpp Bridge::Bridge(BridgeInfo) on the
// shipped skirmish map Winding River: each BRIDGE_POINT1 / BRIDGE_POINT2 pair is a GenericBridge in the middle of its
// deck, facing from its first point to its second, on the neutral team; its ends BRIDGE_FLOAT_AMT (0.25) above the
// ground; its left and right edges its Roads.ini model's BRIDGE_LEFT extent times its BridgeScale either side of the
// line between its points (as wide as that extent's span times the scale); no towers (compiled out for map bridges).
// GenericBridge's ImmortalBody keeps it from rubble: even killed outright its state stays.
BOOST_AUTO_TEST_CASE(legacy_parity_map_drawn_bridges)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const std::string path = "Maps/Winding River/Winding River.map";
	const auto match = Prepare(shell, path);
	BOOST_TEST_REQUIRE(match.has_value());
	std::size_t pairs = 0;
	const auto &placements = match->read->level.placements;
	for (std::size_t index = 0; index + 1 < placements.size(); ++index)
		if ((placements[index].flags & 0x10u) != 0 && (placements[index + 1].flags & 0x20u) != 0)
			++pairs;
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const auto made = Bridges(game);
	BOOST_TEST(made.size() == pairs);
	BOOST_TEST_REQUIRE(!made.empty());
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	for (const ecs::Entity entity : made)
	{
		const ga::Bridge &bridge = *world.Get<ga::Bridge>(entity);
		BOOST_TEST(game.Game().templates.DefinitionAt(world.Get<gp::DefinitionRef>(entity)->index).name == "GenericBridge");
		BOOST_TEST(world.Get<gp::TeamMember>(entity)->team == neutral);
		BOOST_TEST(bridge.landmark == 0);
		for (const ecs::Entity tower : bridge.towers)
			BOOST_TEST((tower == ecs::Entity{}));
		const content::BridgeContent *kind = ga::BridgeTemplateOf(game.Game(), bridge);
		BOOST_TEST_REQUIRE(kind != nullptr);
		BOOST_TEST_REQUIRE(kind->extentY.has_value());
		BOOST_TEST((bridge.from.z == game.Game().ground.At(bridge.from.XY()) + Fixed::FromRatio(1, 4)));
		BOOST_TEST((bridge.width == (kind->extentY->second - kind->extentY->first) * kind->scale));
		// Its edges' span across the deck is its width (fixed-point rounding: within a raw step per coordinate).
		const Fixed across = Engine::Math::Length(bridge.fromLeft.XY() - bridge.fromRight.XY());
		BOOST_TEST((Engine::Math::Abs(across - bridge.width) <= Fixed::FromRatio(1, 256)));
		const auto &at = world.Get<gp::Transform>(entity)->position;
		BOOST_TEST((at.x == (bridge.fromLeft.x + bridge.toRight.x) / Fixed::FromInt(2)));
		BOOST_TEST(ga::PointOnBridge(bridge, at.XY()));
		// A quarter of the way along the deck from its first end.
		BOOST_TEST(ga::PointOnBridge(bridge, {(bridge.from.x * Fixed::FromInt(3) + bridge.to.x) / Fixed::FromInt(4), (bridge.from.y * Fixed::FromInt(3) + bridge.to.y) / Fixed::FromInt(4)}));
		BOOST_TEST(bridge.curDamageState == ga::body_state::Pristine);
	}
	// Immortal: killed outright it keeps a point of health, and stays pristine.
	ga::KillNow(game.Game(), made.front());
	game.Tick();
	game.Tick();
	BOOST_TEST(world.Get<ga::Bridge>(made.front())->curDamageState != ga::body_state::Rubble);
	BOOST_TEST(!ga::BridgeBroken(game.Game(), made.front(), true));
}

// TerrainRoads.cpp m_terrainBridgeFieldParseTable (parseTransitionToOCL / parseTransitionToFX: EffectNum 1..3 to slots
// 0..2) and W3DBridge::load's BRIDGE_LEFT extent on the shipped Roads.ini Bridge Concrete; BridgeBehavior's
// BridgeDieFX / BridgeDieOCL on TsingMaLandmarkBridge (Delay 45000 ms: 1350 ticks rounded up; Bone:ParentObject).
BOOST_AUTO_TEST_CASE(legacy_parity_roads_ini_bridges)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto found = shell.game.bridges.find("Concrete");
	BOOST_TEST_REQUIRE((found != shell.game.bridges.end()));
	const content::BridgeContent &concrete = found->second;
	BOOST_TEST((concrete.scale == Fixed::FromRatio(85, 100)));
	BOOST_TEST(concrete.models[0] == "CBBridgeSt");
	BOOST_TEST(concrete.towers[0] == "BridgeTowerConcreteLeft01");
	BOOST_TEST(concrete.towers[3] == "BridgeTowerConcreteRight02");
	BOOST_TEST(concrete.fxPerType == 32u);
	BOOST_TEST(concrete.damagedSound == "BridgeDamaged");
	BOOST_TEST(concrete.repairedSound == "BridgeRepaired");
	BOOST_TEST(concrete.damageOcl[1][0] == "OCL_BridgeDamaged01");
	BOOST_TEST_REQUIRE(concrete.extentY.has_value());
	BOOST_TEST_MESSAGE("Concrete BRIDGE_LEFT y from " << Engine::Math::ToFloat(concrete.extentY->first) << " to " << Engine::Math::ToFloat(concrete.extentY->second));
	BOOST_TEST((concrete.extentY->first < concrete.extentY->second));

	const auto tsingMa = shell.game.bridgeDieEffects.find("TsingMaLandmarkBridge");
	BOOST_TEST_REQUIRE((tsingMa != shell.game.bridgeDieEffects.end()));
	const auto &effects = tsingMa->second;
	BOOST_TEST_REQUIRE(effects.size() >= 4u);
	// In the order written: the two columns at once from the bridge itself, then the first explosion's FX at 45000 ms.
	BOOST_TEST(effects[0].creationList);
	BOOST_TEST(effects[0].name == "OCL_TsingMaTankColumn");
	BOOST_TEST(effects[0].delayTicks == 0u);
	BOOST_TEST((effects[0].where == content::BridgeDieEffect::Where::Parent));
	BOOST_TEST(!effects[2].creationList);
	BOOST_TEST(effects[2].name == "FX_TsingMaExplosion");
	BOOST_TEST(effects[2].delayTicks == 1350u);
	BOOST_TEST((effects[2].where == content::BridgeDieEffect::Where::Bone));
}

// TerrainLogic.cpp Bridge::Bridge(Object *) / createTower, ActiveBody::calcDamageState and BridgeBehavior with
// TerrainLogic::updateBridgeDamageStates / isBridgeBroken / isBridgeRepaired, on the shipped EuropeanLandmarkBridge
// (StructureBody 2000, a 105 by 40 box): its deck the box's corners at its height; its Roads.ini towers at the corners,
// pushed out across the deck by their major radius, on its team; hurt to really damaged its state is recorded but no
// script hears of it (not into or out of rubble); killed it is rubble: its towers are killed (GenericBridgeTower's
// ImmortalBody keeps them), and only the next tick's scripts see it broken.
BOOST_AUTO_TEST_CASE(legacy_parity_a_landmark_bridge_breaks)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell, "Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	game.Tick();
	const ecs::Entity bridge = game.Place("EuropeanLandmarkBridge", {Fixed::FromInt(1000), Fixed::FromInt(1000)}, {}, *game.Teams().FindTeam("team"));
	BOOST_TEST_REQUIRE(world.IsAlive(bridge));
	ga::AddLandmarkBridge(game.Game(), bridge);
	const auto *state = world.Get<ga::Bridge>(bridge);
	BOOST_TEST_REQUIRE(state != nullptr);
	BOOST_TEST(state->landmark == 1);
	const auto &at = world.Get<gp::Transform>(bridge)->position;
	// Unturned: from the west end to the east, left to the north.
	BOOST_TEST((state->fromLeft.x == at.x - Fixed::FromInt(105)));
	BOOST_TEST((state->fromLeft.y == at.y + Fixed::FromInt(40)));
	BOOST_TEST((state->toRight.x == at.x + Fixed::FromInt(105)));
	BOOST_TEST((state->toRight.y == at.y - Fixed::FromInt(40)));
	BOOST_TEST((state->width == Fixed::FromInt(80)));
	BOOST_TEST(ga::PointOnBridge(*state, at.XY()));
	BOOST_TEST(!ga::PointOnBridge(*state, {at.x, at.y + Fixed::FromInt(41)}));
	BOOST_TEST((ga::BridgeHeight(*state, at.XY()) == at.z));
	std::size_t towers = 0;
	for (const ecs::Entity tower : state->towers)
		if (world.IsAlive(tower))
		{
			++towers;
			BOOST_TEST((world.Get<ga::BridgeTower>(tower)->bridge == bridge));
			BOOST_TEST(world.Get<gp::TeamMember>(tower)->team == world.Get<gp::TeamMember>(bridge)->team);
		}
	BOOST_TEST(towers == 4u);

	// Really damaged (under 35% of 2000): recorded, no script hears of it.
	world.Get<gp::Health>(bridge)->current = Fixed::FromInt(600);
	game.Tick();
	BOOST_TEST(world.Get<ga::Bridge>(bridge)->bodyState == ga::body_state::ReallyDamaged);
	BOOST_TEST(world.Get<ga::Bridge>(bridge)->curDamageState == ga::body_state::ReallyDamaged);
	BOOST_TEST(world.Get<ga::Bridge>(bridge)->changed == 0);
	game.Tick();
	BOOST_TEST(!ga::BridgeBroken(game.Game(), bridge, true));

	// Killed: rubble, its towers killed; the next tick's scripts see it broken, the one after no more.
	ga::KillNow(game.Game(), bridge);
	game.Tick();
	BOOST_TEST(world.Get<ga::Bridge>(bridge)->curDamageState == ga::body_state::Rubble);
	BOOST_TEST(world.Get<ga::Bridge>(bridge)->changed == 1);
	BOOST_TEST(world.Get<ga::Bridge>(bridge)->deathTick == game.CurrentTick());
	BOOST_TEST(!ga::BridgeBroken(game.Game(), bridge, true)); // this tick's scripts ran before it broke
	game.Tick();
	BOOST_TEST(ga::BridgeBroken(game.Game(), bridge, true)); // what the scripts of this tick saw
	BOOST_TEST(!ga::BridgeBroken(game.Game(), bridge, false));
	// Its towers were killed (onDie: tower->kill()), but GenericBridgeTower's ImmortalBody keeps them (kill is damage it
	// keeps a point of).
	for (const ecs::Entity tower : world.Get<ga::Bridge>(bridge)->towers)
		if (tower != ecs::Entity{})
			BOOST_TEST((world.IsAlive(tower) && !ga::EffectivelyDead(game.Game(), tower)));
	game.Tick();
	BOOST_TEST(!ga::BridgeBroken(game.Game(), bridge, true));
}

// Pathfinder::addBridge / PathfindLayer::classifyCells and the movers' layers (AIUpdate's pathfinder->updateLayer from its
// path, TerrainLogic::getLayerHeight) on Winding River's map-drawn Kandahar bridges: each has a deck layer of its own,
// its entries linked to the ground; a Ranger ordered from beyond one end of a bridge to beyond the other walks over the
// deck (on its layer, at its height, over its middle) and gets there; back on the ground at the far side. The same on 4
// workers, and a checkpoint taken on the deck carries on exactly.
BOOST_AUTO_TEST_CASE(legacy_parity_units_cross_on_a_bridge_deck)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell, "Maps/Winding River/Winding River.map");
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	session::Session four(match->skirmish.level, shell.game, match->Options(4));
	auto &world = game.World();
	const auto &grid = world.Resource<gp::NavigationGrid>();
	const auto made = Bridges(game);
	BOOST_TEST_REQUIRE(!made.empty());
	for (const ecs::Entity entity : made)
		BOOST_TEST(world.Get<ga::Bridge>(entity)->layer != 0);
	BOOST_TEST(grid.Decks().size() == made.size());
	// The first bridge made: its ends and which way it runs.
	ecs::Entity chosen = made.front();
	for (const ecs::Entity entity : made)
		if (world.Get<ga::Bridge>(entity)->layer == 1)
			chosen = entity;
	const ga::Bridge bridge = *world.Get<ga::Bridge>(chosen);
	const Engine::Math::FixedVector2 along = bridge.to.XY() - bridge.from.XY();
	const Fixed length = Engine::Math::Length(along);
	const Engine::Math::FixedVector2 unit{along.x / length, along.y / length};
	const Engine::Math::FixedVector2 start = bridge.from.XY() - unit * Fixed::FromInt(60);
	const Engine::Math::FixedVector2 goal = bridge.to.XY() + unit * Fixed::FromInt(60);
	const Engine::Math::FixedVector2 middle{(bridge.from.x + bridge.to.x) / Fixed::FromInt(2), (bridge.from.y + bridge.to.y) / Fixed::FromInt(2)};
	const std::uint32_t team = *game.Teams().FindTeam(match->skirmish.players[0].team);
	game.Tick();
	four.Tick();
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", start, {}, team);
	const ecs::Entity rangerFour = four.Place("AmericaInfantryRanger", start, {}, *four.Teams().FindTeam(match->skirmish.players[0].team));
	BOOST_TEST_REQUIRE(world.IsAlive(ranger));
	ga::OrderMove(game.Game(), ranger, goal, true);
	ga::OrderMove(four.Game(), rangerFour, goal, true);
	bool wasOnDeck = false, overMiddle = false;
	std::optional<std::vector<std::byte>> checkpoint;
	int ticks = 0;
	for (; ticks < 1200 && world.Get<gp::MoveOrder>(ranger)->mode != gp::MoveMode::Idle; ++ticks)
	{
		game.Tick();
		four.Tick();
		const auto &at = world.Get<gp::Transform>(ranger)->position;
		if (const auto *layer = world.Get<gp::SurfaceLayer>(ranger); layer != nullptr && layer->layer == bridge.layer)
		{
			wasOnDeck = true;
			if (Engine::Math::DistanceSquared(at.XY(), middle) < Fixed::FromInt(30 * 30))
			{
				overMiddle = true;
				// At the deck's height there (it floats over the river).
				BOOST_TEST((Engine::Math::Abs(at.z - ga::BridgeHeight(bridge, at.XY())) <= Fixed::FromInt(1)));
				if (!checkpoint)
					checkpoint = game.Checkpoint();
			}
		}
	}
	BOOST_TEST_MESSAGE("crossed in " << ticks << " ticks");
	BOOST_TEST(wasOnDeck);
	BOOST_TEST(overMiddle);
	BOOST_TEST((world.Get<gp::MoveOrder>(ranger)->mode == gp::MoveMode::Idle));
	BOOST_TEST((Engine::Math::DistanceSquared(world.Get<gp::Transform>(ranger)->position.XY(), goal) < Fixed::FromInt(20 * 20)));
	BOOST_TEST(world.Get<gp::SurfaceLayer>(ranger) == nullptr);
	BOOST_TEST(game.StateHash() == four.StateHash());
	BOOST_TEST_REQUIRE(checkpoint.has_value());
	auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), *checkpoint);
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->World().Resource<gp::NavigationGrid>().Decks().size() == grid.Decks().size());
}

BOOST_AUTO_TEST_SUITE_END()
