// Skirmish and LAN games' starts, apart from the shell map's tests (one module
// set per translation unit keeps within the compiler's source-location limit).
using namespace generalszh;

namespace
{
struct Install
{
	engine::filesystem::VirtualFileSystem files;
	engine::config::Diagnostics grammarDiagnostics;
	std::optional<content::ContentLoader> loader;
	content::GameContent game;
	bool loaded{false};

	Install()
	{
		const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
		if (install == nullptr || !std::filesystem::exists(install))
			return;
		content::MountInstall(files, install);
		loader.emplace(files, content::ZeroHourIniGrammar(grammarDiagnostics));
		game = content::LoadGameContent(*loader, engine::time::FixedStep{30});
		loaded = true;
	}
};

Install &Data()
{
	static Install install;
	return install;
}
}

BOOST_AUTO_TEST_SUITE(skirmish_start)

// GameLogic::startNewGame for a skirmish (prepareForMP_or_Skirmish, placeNetworkBuildingsForPlayer) on a
// shipped map: the map's sides give way to player0 (a human, America) and player1 (an AI, the GLA), enemies
// on no team; each gets the setup's cash and its faction's StartingBuilding at Player_<n>_Start with its
// StartingUnits near it; the game runs, and a checkpoint of it restores exactly (without placing twice).
BOOST_AUTO_TEST_CASE(legacy_parity_a_skirmish_starts_each_player_at_its_spot)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	int spots = 0;
	for (const auto &marker : read->level.markers)
		spots += marker.name.starts_with("Player_") && marker.name.ends_with("_Start") ? 1 : 0;
	BOOST_TEST_REQUIRE(spots == 4);
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 1234;
	setup.startingCash = 20000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionGLA");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, spots);
	BOOST_TEST_REQUIRE(skirmish.players.size() == 2u);
	session::SessionOptions options{77, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const auto &money = game.World().Resource<engine::gameplay::PlayerMoney>();
	const auto &roster = game.Teams();
	const std::uint32_t america = *roster.FindPlayer("player0");
	const std::uint32_t gla = *roster.FindPlayer("player1");
	BOOST_TEST(money.Balance(america) == 20000);
	BOOST_TEST(money.Balance(gla) == 20000);
	const auto marker = [&](std::string_view name) {
		for (const auto &m : skirmish.level.markers)
			if (m.name == name)
				return m.position.XY();
		return Engine::Math::FixedVector2{};
	};
	std::map<std::string, std::pair<std::uint32_t, Engine::Math::FixedVector2>> owned;
	game.Visible().ForEach([&](const engine::gameplay::VisibleObject &object) {
		const auto *owner = game.World().Get<engine::gameplay::Owner>(object.entity);
		const auto *ref = game.World().Get<engine::gameplay::DefinitionRef>(object.entity);
		if (owner != nullptr && ref != nullptr && (owner->player == america || owner->player == gla))
			owned[std::string(game.DefinitionName(ref->index))] = {owner->player, game.TransformOf(object.entity)->position.XY()};
	});
	for (const auto &[name, where] : owned)
		BOOST_TEST_MESSAGE("  " << name << " (player " << where.first << ")");
	BOOST_TEST_REQUIRE(owned.contains("AmericaCommandCenter"));
	BOOST_TEST_REQUIRE(owned.contains("GLACommandCenter"));
	BOOST_TEST(owned["AmericaCommandCenter"].first == america);
	BOOST_TEST(owned["GLACommandCenter"].first == gla);
	BOOST_TEST((owned["AmericaCommandCenter"].second == marker("Player_1_Start")));
	BOOST_TEST((owned["GLACommandCenter"].second == marker("Player_3_Start")));
	BOOST_TEST(owned.contains("AmericaVehicleDozer"));
	BOOST_TEST(owned.contains("GLAInfantryWorker"));
	// placeNetworkBuildingsForPlayer: the dozer at a legal spot between 0.7 and 1.3 of the command centre's
	// bounding sphere from Player_1_Rally (else half that radius short of the start spot).
	{
		const auto *center = shell.game.objects.Find("AmericaCommandCenter");
		const double sphere = static_cast<double>(content::BoundingSphereRadius(center->geometry).Raw()) / 65536.0;
		Engine::Math::FixedVector2 around = marker("Player_1_Start");
		bool rally = false;
		for (const auto &m : skirmish.level.markers)
			if (m.name == "Player_1_Rally")
			{
				around = m.position.XY();
				rally = true;
			}
		if (!rally)
			around.y -= content::BoundingSphereRadius(center->geometry) / Engine::Math::Fixed::FromInt(2);
		const double distance = static_cast<double>(Engine::Math::Length(owned["AmericaVehicleDozer"].second - around).Raw()) / 65536.0;
		BOOST_TEST_MESSAGE("dozer " << distance << " from its search centre (sphere " << sphere << ")");
		BOOST_TEST(distance >= sphere * 0.7 - 0.05);
		BOOST_TEST(distance <= sphere * 1.3 + 0.05);
	}
	BOOST_TEST(owned.size() >= 4u);
	for (int tick = 0; tick < 300; ++tick)
		game.Tick();
	const auto restored = session::Session::Restore(skirmish.level, shell.game, options, game.Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == game.StateHash());
	BOOST_TEST(restored->EntityCount() == game.EntityCount());

	// The player's dozer goes where it is ordered, routed over the grid (seat 0 plays America).
	ecs::Entity dozer;
	game.Visible().ForEach([&](const engine::gameplay::VisibleObject &object) {
		const auto *ref = game.World().Get<engine::gameplay::DefinitionRef>(object.entity);
		if (ref != nullptr && game.DefinitionName(ref->index) == "AmericaVehicleDozer")
			dozer = object.entity;
	});
	BOOST_TEST_REQUIRE((dozer != ecs::Entity{}));
	const auto from = game.TransformOf(dozer)->position.XY();
	const Engine::Math::FixedVector2 to{from.x + Engine::Math::Fixed::FromInt(60), from.y - Engine::Math::Fixed::FromInt(80)};
	auto move = commands::Encode(commands::MoveTo{{dozer}, to});
	move.player = 0;
	game.Tick(std::span(&move, 1));
	for (int tick = 0; tick < 300; ++tick)
		game.Tick();
	const auto *route = game.World().Get<engine::gameplay::Route>(dozer);
	BOOST_TEST_MESSAGE("dozer route: " << (route ? int(route->count) : -1) << " points, next " << (route ? int(route->next) : -1) << ", complete "
		<< (route ? route->complete : false));
	BOOST_TEST((Engine::Math::Distance(game.TransformOf(dozer)->position.XY(), to) < Engine::Math::Fixed::FromInt(10)));
}

// The supply economy on real data (SupplyTruckAIUpdate, SupplyWarehouseDockUpdate, SupplyCenterDockUpdate): a China
// supply truck (MaxBoxes 4; SupplyWarehouseActionDelay 1000 ms and SupplyCenterActionDelay 400 ms, whole frames:
// 30 and 12; SupplyWarehouseScanDistance 700) told to harvest fills up at a supply dock (StartingBoxes 400, a
// boneless dock taking any number: NumberApproachPositions -1, AllowsPassthrough No) and delivers its four boxes
// to its supply centre at ValuePerSupplyBox (75): 300 credits a round; a player's stop ends its rounds.
BOOST_AUTO_TEST_CASE(legacy_parity_a_supply_truck_harvests_on_real_data)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 99;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionChina");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionGLA");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{5, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	auto &world = game.World();
	const std::uint32_t china = *game.Teams().FindPlayer("player0");
	const std::uint32_t team = *game.Teams().FindTeam(skirmish.players[0].team);
	Engine::Math::FixedVector2 start;
	for (const auto &marker : read->level.markers)
		if (marker.name == "Player_1_Start")
			start = marker.position.XY();
	using Engine::Math::Fixed;
	const auto at = [&](int dx, int dy) { return Engine::Math::FixedVector2{start.x + Fixed::FromInt(dx), start.y + Fixed::FromInt(dy)}; };
	const ecs::Entity center = game.Place("ChinaSupplyCenter", at(0, -180), {}, team);
	const ecs::Entity warehouse = game.Place("SupplyDock", at(-200, -180), {}, team);
	const ecs::Entity truck = game.Place("ChinaVehicleSupplyTruck", at(-100, -120), {}, team);
	BOOST_TEST_REQUIRE(world.IsAlive(center));
	BOOST_TEST_REQUIRE(world.IsAlive(warehouse));
	BOOST_TEST_REQUIRE(world.IsAlive(truck));
	const auto *harvester = world.Get<engine::gameplay::Harvester>(truck);
	BOOST_TEST_REQUIRE(harvester != nullptr);
	BOOST_TEST(harvester->maxBoxes == 4u);
	BOOST_TEST(harvester->storeDelay == 30u);
	BOOST_TEST(harvester->depotDelay == 12u);
	BOOST_TEST(harvester->scanDistance.Raw() == Fixed::FromInt(700).Raw());
	const auto *store = world.Get<engine::gameplay::ResourceStore>(warehouse);
	BOOST_TEST_REQUIRE(store != nullptr);
	BOOST_TEST(store->boxes == 400u);
	const auto *dock = world.Get<engine::gameplay::Dock>(warehouse);
	BOOST_TEST_REQUIRE(dock != nullptr);
	BOOST_TEST(dock->dynamic);
	BOOST_TEST(!dock->passthrough);
	BOOST_TEST(world.Has<engine::gameplay::ResourceDepot>(center));
	world.Get<engine::gameplay::Harvester>(truck)->forceWanting = true;
	const auto &money = world.Resource<engine::gameplay::PlayerMoney>();
	const std::int64_t before = money.Balance(china);
	int ticks = 0;
	while (money.Balance(china) == before && ticks < 3000)
	{
		game.Tick();
		++ticks;
	}
	BOOST_TEST_MESSAGE("first delivery after " << ticks << " ticks");
	BOOST_TEST(money.Balance(china) - before == 300);
	// Its four boxes came off the warehouse; so did any other truck's aboard (the supply centre's own truck arrives too).
	{
		std::uint32_t aboard = 0;
		ecs::Query<ecs::Read<engine::gameplay::Harvester>> trucks(world);
		trucks.ForEachChunk([&](auto chunk) {
			const auto rows = chunk.template Get<engine::gameplay::Harvester>();
			const auto entities = chunk.Entities();
			for (std::size_t row = 0; row < rows.size(); ++row)
				if (entities[row] != truck && world.Get<engine::gameplay::Owner>(entities[row])->player == china)
					aboard += rows[row].boxes;
		});
		BOOST_TEST(world.Get<engine::gameplay::ResourceStore>(warehouse)->boxes + aboard == 396u);
	}
	// Round and round: a second delivery.
	while (money.Balance(china) - before < 600 && ticks < 6000)
	{
		game.Tick();
		++ticks;
	}
	BOOST_TEST(money.Balance(china) - before == 600);
	// The player stops it: it idles and stays idle.
	auto stop = commands::Encode(commands::Stop{{truck}});
	stop.player = 0; // seat 0 plays China
	game.Tick(std::span(&stop, 1));
	for (int tick = 0; tick < 200; ++tick)
		game.Tick();
	BOOST_TEST((world.Get<engine::gameplay::Harvester>(truck)->state == engine::gameplay::HarvesterState::Idle));
	BOOST_TEST(!engine::gameplay::IsDocking(*world.Get<engine::gameplay::Docking>(truck)));
	const std::int64_t stopped = money.Balance(china);
	// Sent back to the warehouse, it takes it as its own and goes round again.
	auto send = commands::Encode(commands::Dock{{truck}, warehouse});
	send.player = 0;
	game.Tick(std::span(&send, 1));
	for (int tick = 0; tick < 3000 && money.Balance(china) == stopped; ++tick)
		game.Tick();
	BOOST_TEST((world.Get<engine::gameplay::Harvester>(truck)->preferredDock == warehouse));
	BOOST_TEST(money.Balance(china) - stopped == 300);
}


// The supply round is deterministic: the same on 1 and 4 workers, and a checkpoint taken mid-round (a truck at
// its dock, boxes aboard) restores and runs on to the same state.
BOOST_AUTO_TEST_CASE(supply_rounds_are_deterministic_and_checkpoint_exactly)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 99;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionChina");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionGLA");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	Engine::Math::FixedVector2 start;
	for (const auto &marker : read->level.markers)
		if (marker.name == "Player_1_Start")
			start = marker.position.XY();
	using Engine::Math::Fixed;
	const auto at = [&](int dx, int dy) { return Engine::Math::FixedVector2{start.x + Fixed::FromInt(dx), start.y + Fixed::FromInt(dy)}; };
	const auto optionsFor = [&](std::size_t workers) {
		session::SessionOptions options{5, workers, {}, {"player0", "player1"}};
		for (const auto &player : skirmish.players)
			options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
		return options;
	};
	const auto build = [&](std::size_t workers) {
		auto game = std::make_unique<session::Session>(skirmish.level, shell.game, optionsFor(workers));
		const std::uint32_t team = *game->Teams().FindTeam(skirmish.players[0].team);
		game->Place("ChinaSupplyCenter", at(0, -180), {}, team);
		game->Place("SupplyDock", at(-200, -180), {}, team);
		for (int truck = 0; truck < 3; ++truck)
		{
			const ecs::Entity entity = game->Place("ChinaVehicleSupplyTruck", at(-100 + truck * 30, -120), {}, team);
			game->World().Get<engine::gameplay::Harvester>(entity)->forceWanting = true;
		}
		return game;
	};
	auto one = build(1);
	auto four = build(4);
	for (int tick = 0; tick < 200; ++tick)
	{
		one->Tick();
		four->Tick();
	}
	BOOST_TEST(one->StateHash() == four->StateHash());
	std::size_t docked = 0;
	ecs::Query<ecs::Read<engine::gameplay::Docking>> query(one->World());
	query.ForEachChunk([&](auto chunk) {
		for (const auto &docking : chunk.template Get<engine::gameplay::Docking>())
			docked += engine::gameplay::IsDocking(docking) ? 1u : 0u;
	});
	BOOST_TEST(docked > 0u);
	const auto restored = session::Session::Restore(skirmish.level, shell.game, optionsFor(1), one->Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == one->StateHash());
	for (int tick = 0; tick < 400; ++tick)
	{
		one->Tick();
		four->Tick();
		restored->Tick();
	}
	BOOST_TEST(one->StateHash() == four->StateHash());
	BOOST_TEST(restored->StateHash() == one->StateHash());
	BOOST_TEST(restored->World().Resource<engine::gameplay::PlayerMoney>().Balance(*one->Teams().FindPlayer("player0")) ==
		one->World().Resource<engine::gameplay::PlayerMoney>().Balance(*one->Teams().FindPlayer("player0")));
}

// WorkerAIUpdate carries supplies as a supply truck does (MaxBoxes 1, SupplyWarehouseActionDelay 150 ms and
// SupplyCenterActionDelay 150 ms: 5 frames each): a GLA worker told to harvest brings one box to its supply stash at
// ValuePerSupplyBox (75); once its player has Upgrade_GLAWorkerShoes, each delivery brings its UpgradedSupplyBoost (8)
// more (getUpgradedSupplyBoostValue: 8 x 1 box / 1).
BOOST_AUTO_TEST_CASE(legacy_parity_a_gla_worker_harvests_and_its_shoes_pay)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 99;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionChina");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{5, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	auto &world = game.World();
	const std::uint32_t gla = *game.Teams().FindPlayer("player0");
	const std::uint32_t team = *game.Teams().FindTeam(skirmish.players[0].team);
	Engine::Math::FixedVector2 start;
	for (const auto &marker : read->level.markers)
		if (marker.name == "Player_1_Start")
			start = marker.position.XY();
	using Engine::Math::Fixed;
	const auto at = [&](int dx, int dy) { return Engine::Math::FixedVector2{start.x + Fixed::FromInt(dx), start.y + Fixed::FromInt(dy)}; };
	game.Place("GLASupplyStash", at(0, -180), {}, team);
	game.Place("SupplyDock", at(-200, -180), {}, team);
	const ecs::Entity worker = game.Place("GLAInfantryWorker", at(-100, -120), {}, team);
	auto *harvester = world.Get<engine::gameplay::Harvester>(worker);
	BOOST_TEST_REQUIRE(harvester != nullptr);
	BOOST_TEST(harvester->maxBoxes == 1u);
	BOOST_TEST(harvester->boost == 8);
	BOOST_TEST(harvester->boostUpgrade == *shell.game.upgrades.Find("Upgrade_GLAWorkerShoes"));
	harvester->forceWanting = true;
	const auto &money = world.Resource<engine::gameplay::PlayerMoney>();
	std::int64_t before = money.Balance(gla);
	int ticks = 0;
	while (money.Balance(gla) == before && ticks < 3000)
	{
		game.Tick();
		++ticks;
	}
	BOOST_TEST(money.Balance(gla) - before == 75);
	world.Resource<engine::gameplay::PlayerUpgrades>().Grant(gla, *shell.game.upgrades.Find("Upgrade_GLAWorkerShoes"));
	before = money.Balance(gla);
	while (money.Balance(gla) == before && ticks < 6000)
	{
		game.Tick();
		++ticks;
	}
	BOOST_TEST(money.Balance(gla) - before == 83);
}

// ChinookAIUpdate is a SupplyTruckAIUpdate that flies: told to harvest, a supply Chinook brings its full load to its
// supply centre at ValuePerSupplyBox (75) each, and its UpgradedSupplyBoost more once its player has Supply Lines.
BOOST_AUTO_TEST_CASE(legacy_parity_a_supply_chinook_ferries_supplies)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 99;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionChina");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{5, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	auto &world = game.World();
	const std::uint32_t usa = *game.Teams().FindPlayer("player0");
	const std::uint32_t team = *game.Teams().FindTeam(skirmish.players[0].team);
	Engine::Math::FixedVector2 start;
	for (const auto &marker : read->level.markers)
		if (marker.name == "Player_1_Start")
			start = marker.position.XY();
	using Engine::Math::Fixed;
	const auto at = [&](int dx, int dy) { return Engine::Math::FixedVector2{start.x + Fixed::FromInt(dx), start.y + Fixed::FromInt(dy)}; };
	game.Place("AmericaSupplyCenter", at(0, -180), {}, team);
	game.Place("SupplyDock", at(-200, -180), {}, team);
	const ecs::Entity worker = game.Place("AmericaVehicleChinook", at(-100, -120), {}, team);
	auto *harvester = world.Get<engine::gameplay::Harvester>(worker);
	BOOST_TEST_REQUIRE(harvester != nullptr);
	BOOST_TEST_MESSAGE("chinook: " << harvester->maxBoxes << " boxes, boost " << harvester->boost);
	BOOST_TEST(harvester->boostUpgrade == *shell.game.upgrades.Find("Upgrade_AmericaSupplyLines"));
	const std::int64_t full = static_cast<std::int64_t>(harvester->maxBoxes) * 75;
	const std::int64_t boost = harvester->boost;
	harvester->forceWanting = true;
	const auto &money = world.Resource<engine::gameplay::PlayerMoney>();
	std::int64_t before = money.Balance(usa);
	int ticks = 0;
	while (money.Balance(usa) == before && ticks < 3000)
	{
		game.Tick();
		++ticks;
	}
	BOOST_TEST_MESSAGE("first delivery after " << ticks << " ticks");
	BOOST_TEST(money.Balance(usa) - before == full);
	world.Resource<engine::gameplay::PlayerUpgrades>().Grant(usa, *shell.game.upgrades.Find("Upgrade_AmericaSupplyLines"));
	before = money.Balance(usa);
	while (money.Balance(usa) == before && ticks < 6000)
	{
		game.Tick();
		++ticks;
	}
	BOOST_TEST(money.Balance(usa) - before == full + boost);
}

// WorkerAIUpdate / DozerAIUpdate: a player's starting worker left alone stays where placeNetworkBuildingsForPlayer
// put it (it harvests only when told to, supplyTruckSubMachineWantsToEnter; bored, it only looks for its own damaged
// structures to repair, and there are none).
BOOST_AUTO_TEST_CASE(legacy_parity_an_idle_starting_worker_stays_put)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 7;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::EasyAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{7, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t gla = *game.Teams().FindPlayer("player0");
	ecs::Entity worker;
	game.Visible().ForEach([&](const engine::gameplay::VisibleObject &object) {
		const auto *owner = game.World().Get<engine::gameplay::Owner>(object.entity);
		const auto *ref = game.World().Get<engine::gameplay::DefinitionRef>(object.entity);
		if (owner != nullptr && owner->player == gla && ref != nullptr && game.DefinitionName(ref->index) == "GLAInfantryWorker")
			worker = object.entity;
	});
	BOOST_TEST_REQUIRE((worker != ecs::Entity{}));
	const auto placed = game.TransformOf(worker)->position.XY();
	for (int tick = 1; tick <= 300; ++tick)
	{
		game.Tick();
		const auto now = game.TransformOf(worker)->position.XY();
		if (now != placed)
		{
			const auto *harvester = game.World().Get<engine::gameplay::Harvester>(worker);
			BOOST_TEST_MESSAGE("worker moved on tick " << tick << " (harvester " << (harvester != nullptr) << ")");
			break;
		}
	}
	BOOST_TEST((game.TransformOf(worker)->position.XY() == placed));
}

// VictoryConditions::update in a skirmish (VICTORY_NOBUILDINGS) on real data: the America player's command centre is
// its only structure that counts (KINDOF_MP_COUNT_FOR_VICTORY); killed, America is defeated on that very tick, the
// GLA's is the single alliance left (the match ends then, the GLA won), and killPlayer takes the rest of America with
// it (its dozer dies). The same on 1 and 4 workers; a checkpoint after it restores exactly.
BOOST_AUTO_TEST_CASE(legacy_parity_losing_the_last_counted_structure_ends_a_skirmish)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 11;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::EasyAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	const auto optionsFor = [&](std::size_t workers) {
		session::SessionOptions options{11, workers, {}, {"player0", "player1"}};
		for (const auto &player : skirmish.players)
			options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
		return options;
	};
	const auto play = [&](std::size_t workers) {
		auto game = std::make_unique<session::Session>(skirmish.level, shell.game, optionsFor(workers));
		for (int tick = 0; tick < 30; ++tick)
			game->Tick();
		return game;
	};
	auto game = play(1);
	const std::uint32_t gla = *game->Teams().FindPlayer("player0");
	const std::uint32_t america = *game->Teams().FindPlayer("player1");
	const auto &outcome = game->World().Resource<engine::gameplay::MatchOutcome>();
	BOOST_TEST(outcome.enabled);
	BOOST_TEST(outcome.players.size() == 2u);
	BOOST_TEST(!outcome.singleAllianceRemaining);
	std::vector<ecs::Entity> counted;
	ecs::Entity dozer;
	const auto find = [&](session::Session &session) {
		counted.clear();
		session.Visible().ForEach([&](const engine::gameplay::VisibleObject &object) {
			const auto *owner = session.World().Get<engine::gameplay::Owner>(object.entity);
			const auto *role = session.World().Get<engine::gameplay::VictoryRole>(object.entity);
			const auto *ref = session.World().Get<engine::gameplay::DefinitionRef>(object.entity);
			if (owner == nullptr || owner->player != america)
				return;
			if (role != nullptr && role->Has(engine::gameplay::victory_role::CountsForVictory))
				counted.push_back(object.entity);
			if (ref != nullptr && session.DefinitionName(ref->index) == "AmericaVehicleDozer")
				dozer = object.entity;
		});
	};
	find(*game);
	BOOST_TEST_REQUIRE(counted.size() == 1u); // its command centre
	BOOST_TEST_REQUIRE((dozer != ecs::Entity{}));
	const auto defeat = [&](session::Session &session) {
		find(session);
		for (const ecs::Entity entity : counted)
			session.World().Resource<engine::gameplay::KillRequests>().entities.push_back(entity);
		session.Tick();
	};
	defeat(*game);
	BOOST_TEST(outcome.Eliminated(america));
	BOOST_TEST(!outcome.Eliminated(gla));
	BOOST_TEST(outcome.singleAllianceRemaining);
	BOOST_TEST(outcome.endTick == 31u);
	BOOST_TEST(outcome.HasWon(gla));
	BOOST_TEST(outcome.HasLost(america));
	BOOST_TEST((outcome.fallen == std::vector<std::uint32_t>{america}));
	game->Tick();
	BOOST_TEST((!game->World().IsAlive(dozer) || game->World().Get<engine::gameplay::Dying>(dozer) != nullptr));
	const auto restored = session::Session::Restore(skirmish.level, shell.game, optionsFor(1), game->Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == game->StateHash());
	BOOST_TEST(restored->World().Resource<engine::gameplay::MatchOutcome>().HasWon(gla));

	auto wide = play(4);
	defeat(*wide);
	wide->Tick();
	BOOST_TEST(wide->StateHash() == game->StateHash());
}

// The shipped Data/Scripts/MultiplayerScripts.scb reads (ReadScriptFile): its one list of victory and defeat scripts.
BOOST_AUTO_TEST_CASE(the_multiplayer_scripts_read)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto bytes = shell.files.Read("Data/Scripts/MultiplayerScripts.scb");
	BOOST_TEST_REQUIRE(bytes.has_value());
	const auto file = engine::level::generals_map::ReadScriptFile(*bytes);
	BOOST_TEST_REQUIRE(file.has_value(), (file ? std::string{} : file.error()));
	BOOST_TEST_REQUIRE(!file->lists.empty());
	const auto dump = [](const engine::level::Script &script) {
		std::string text = "  " + script.name + (script.active ? "" : " (inactive)") + (script.oneShot ? " once" : "") + ": if";
		for (const auto &clause : script.conditions)
		{
			text += " (";
			for (const auto &call : clause)
			{
				text += " " + call.name;
				for (const auto &p : call.parameters)
					text += " [" + std::to_string(p.integer) + "/" + p.text + "]";
			}
			text += " )";
		}
		text += " then";
		for (const auto &call : script.actions)
		{
			text += " " + call.name;
			for (const auto &p : call.parameters)
				text += " [" + std::to_string(p.integer) + "/" + p.text + "]";
		}
		return text;
	};
	for (const auto &list : file->lists)
	{
		for (const auto &script : list.scripts)
			BOOST_TEST_MESSAGE(dump(script));
		for (const auto &group : list.groups)
		{
			BOOST_TEST_MESSAGE(" group " << group.name << (group.active ? "" : " (inactive)"));
			for (const auto &script : group.scripts)
				BOOST_TEST_MESSAGE(dump(script));
		}
	}
	BOOST_TEST_MESSAGE("players: " << file->players.size() << ", teams: " << file->teams.size());
}

// The shipped Data/Scripts/SkirmishScripts.scb reads: its script lists by player, and the calls they make.
BOOST_AUTO_TEST_CASE(the_skirmish_scripts_read)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto bytes = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	BOOST_TEST_REQUIRE(bytes.has_value());
	const auto file = engine::level::generals_map::ReadScriptFile(*bytes);
	BOOST_TEST_REQUIRE(file.has_value(), (file ? std::string{} : file.error()));
	BOOST_TEST(file->lists.size() == file->players.size());
	std::map<std::string, int> conditions, actions;
	std::size_t scripts = 0;
	const auto count = [&](const engine::level::Script &script) {
		++scripts;
		for (const auto &clause : script.conditions)
			for (const auto &call : clause)
				++conditions[call.name];
		for (const auto &call : script.actions)
			++actions[call.name];
		for (const auto &call : script.falseActions)
			++actions[call.name];
	};
	for (const auto &list : file->lists)
	{
		for (const auto &script : list.scripts)
			count(script);
		for (const auto &group : list.groups)
			for (const auto &script : group.scripts)
				count(script);
	}
	for (std::size_t index = 0; index < file->players.size(); ++index)
		BOOST_TEST_MESSAGE("player " << file->players[index] << ": " << file->lists[index].scripts.size() << " scripts, " << file->lists[index].groups.size() << " groups");
	if (const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map"))
		if (const auto read = engine::level::generals_map::Read(*map))
			for (const auto &side : read->level.scenario.participants)
				BOOST_TEST_MESSAGE("map side " << side.properties.Get<std::string>("playerName").value_or("?") << " "
					<< side.properties.Get<std::string>("playerFaction").value_or("?") << " scripts " << side.scripts.scripts.size() + side.scripts.groups.size());
	BOOST_TEST_MESSAGE(scripts << " scripts, " << file->teams.size() << " teams");
	// What the skirmish teams set (keys and how many teams set each), and one full team.
	std::map<std::string, int> keys;
	for (const auto &team : file->teams)
		for (const auto &[key, value] : team)
			++keys[key];
	for (const auto &[key, count] : keys)
		BOOST_TEST_MESSAGE("team key " << key << " " << count);
	for (const auto &team : file->teams)
		if (team.Get<std::string>("teamOwner").value_or("") == "SkirmishAmerica" && team.Get<std::string>("teamName").value_or("").find("Tank") != std::string::npos)
		{
			for (const auto &[key, value] : team)
				BOOST_TEST_MESSAGE("  " << key << " = " << std::visit([](const auto &v) {
					std::ostringstream out;
					if constexpr (std::is_same_v<std::decay_t<decltype(v)>, Engine::Math::Fixed>)
						out << v.Raw() / 65536.0;
					else
						out << v;
					return out.str();
				}, value));
			break;
		}
	for (const auto &[name, uses] : conditions)
		BOOST_TEST_MESSAGE("condition " << name << " " << uses);
	for (const auto &[name, uses] : actions)
		BOOST_TEST_MESSAGE("action " << name << " " << uses);
}

// Player::initFromDict on real data (SkirmishScripts.scb, Tournament Continent): the computer player (America, start
// spot 2) takes SkirmishAmerica's script groups and teams qualified with "2" (a SIDE parameter naming SkirmishAmerica2
// become its own name), and its default team is teamSkirmishAmerica2; the human takes the civilian side's scripts,
// qualified "0". The session starts and runs with them.
BOOST_AUTO_TEST_CASE(legacy_parity_computer_players_take_their_sides_skirmish_scripts)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE((scb.has_value() && map.has_value()));
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	const engine::level::Participant *ai = nullptr, *human = nullptr;
	for (const auto &side : skirmish.level.scenario.participants)
	{
		const auto name = side.properties.Get<std::string>("playerName").value_or("");
		if (name == "player1")
			ai = &side;
		if (name == "player0")
			human = &side;
	}
	BOOST_TEST_REQUIRE((ai != nullptr && human != nullptr));
	BOOST_TEST(ai->scripts.groups.size() == 32u);
	BOOST_TEST(ai->properties.Get<std::int64_t>("skirmishDifficulty").value_or(-1) == 2);
	bool qualified = true, sideRenamed = false;
	for (const auto &group : ai->scripts.groups)
	{
		qualified = qualified && group.name.ends_with("2");
		for (const auto &script : group.scripts)
			for (const auto &clause : script.conditions)
				for (const auto &call : clause)
					for (const auto &parameter : call.parameters)
						sideRenamed = sideRenamed || (parameter.kind == 11 && parameter.text == "player1");
	}
	BOOST_TEST(qualified);
	// Its scripts name their player as <This Player> and <This Player's Enemy> (resolved as they run), not by side.
	BOOST_TEST(!sideRenamed);
	BOOST_TEST(human->scripts.scripts.size() + human->scripts.groups.size() == 11u); // PlyrCivilian: 4 scripts, 7 groups
	BOOST_TEST(!human->scripts.groups.empty());
	BOOST_TEST(human->scripts.groups.front().name.ends_with("0"));
	bool defaultTeam = false;
	std::size_t aiTeams = 0;
	for (const auto &team : skirmish.level.scenario.groups)
		if (team.Get<std::string>("teamOwner").value_or("") == "player1")
		{
			++aiTeams;
			defaultTeam = defaultTeam || team.Get<std::string>("teamName").value_or("") == "teamSkirmishAmerica2";
		}
	BOOST_TEST(defaultTeam);
	BOOST_TEST_MESSAGE("the computer player's teams: " << aiTeams);
	for (const auto &player : skirmish.players)
		if (player.name == "player1")
			BOOST_TEST(player.team == "teamSkirmishAmerica2");

	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	for (int tick = 0; tick < 90; ++tick)
		game.Tick();
	BOOST_TEST_MESSAGE("unported: " << game.UnportedSummary());
}

// AISkirmishPlayer::newMap / adjustBuildList / computeCenterAndRadiusOfBase on real data: the computer player
// (America at start spot 2 of Tournament Continent) has its starting command centre taken away and put up again from
// its side's skirmish build list, which is moved so its command centre stands on the start spot and turned 135
// degrees about it: the first power plant, planned at (770.43, 727.79) with the command centre at (501.22, 546.25),
// goes to the start + (-318.73, 61.99) (to within 0.05 for fixed point); every entry but the command centre gets a
// rebuild more; the base centre is the plan's middle; the enemy it picks is the human (its only enemy).
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_player_lays_out_its_base)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::EasyAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	const std::uint32_t gla = *game.Teams().FindPlayer("player0");
	auto &ais = game.World().Resource<gameplay::AiPlayers>();
	const gameplay::AiPlayer *ai = ais.Of(america);
	BOOST_TEST_REQUIRE(ai != nullptr);
	BOOST_TEST(ais.Of(gla) == nullptr);
	BOOST_TEST(ai->difficulty == 0);
	BOOST_TEST(ai->side == "America");
	BOOST_TEST_REQUIRE(ai->buildList.size() == 18u);
	Engine::Math::FixedVector2 start;
	for (const auto &marker : skirmish.level.markers)
		if (marker.name == "Player_3_Start")
			start = marker.position.XY();
	const auto near = [](Engine::Math::FixedVector2 a, Engine::Math::FixedVector2 b) {
		return Engine::Math::Abs(a.x - b.x) < Engine::Math::Fixed::FromRatio(5, 100) && Engine::Math::Abs(a.y - b.y) < Engine::Math::Fixed::FromRatio(5, 100);
	};
	const auto &center = ai->buildList[0];
	BOOST_TEST(center.structure == "AmericaCommandCenter");
	BOOST_TEST(center.initiallyBuilt);
	BOOST_TEST(near(center.location, start));
	BOOST_TEST(center.rebuilds == 0);
	BOOST_TEST_REQUIRE(game.World().IsAlive(center.built));
	BOOST_TEST(near(game.TransformOf(center.built)->position.XY(), start));
	const auto &plant = ai->buildList[1];
	BOOST_TEST(plant.structure == "AmericaPowerPlant");
	BOOST_TEST(near(plant.location, start + Engine::Math::FixedVector2{Engine::Math::Fixed::FromRatio(-31873, 100), Engine::Math::Fixed::FromRatio(6199, 100)}));
	BOOST_TEST(plant.rebuilds == 1);
	BOOST_TEST(!game.World().IsAlive(plant.built));
	BOOST_TEST(ai->baseCenterSet);
	// computeCenterAndRadiusOfBase: the farthest plan entry's |dx| + 0.4 r, |dy| + 0.4 r from the plan's middle.
	{
		double best = 0;
		for (const auto &slot : ai->buildList)
			if (const auto *plan = shell.game.objects.Find(slot.structure))
			{
				const double grow = generalszh::content::BoundingSphereRadius(plan->geometry).Raw() / 65536.0 * 0.4;
				const double dx = std::abs((slot.location.x - ai->baseCenter.x).Raw() / 65536.0) + grow;
				const double dy = std::abs((slot.location.y - ai->baseCenter.y).Raw() / 65536.0) + grow;
				best = std::max(best, dx * dx + dy * dy);
			}
		BOOST_TEST(std::abs(ai->baseRadius.Raw() / 65536.0 - std::sqrt(best)) < 0.1);
	}
	// The only command centre of America's is the one put up again.
	int centers = 0;
	game.Visible().ForEach([&](const engine::gameplay::VisibleObject &object) {
		const auto *ref = game.World().Get<engine::gameplay::DefinitionRef>(object.entity);
		if (ref != nullptr && game.DefinitionName(ref->index) == "AmericaCommandCenter")
			++centers;
	});
	BOOST_TEST(centers == 1);
	const auto restored = session::Session::Restore(skirmish.level, shell.game, options, game.Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == game.StateHash());
}

// The computer player at work on real data (Tournament Continent, a hard America on start spot 2 against a GLA human,
// SkirmishScripts.scb): its scripts ask for buildings (SKIRMISH_BUILD_BUILDING) and it puts them up with its dozers
// (processBaseBuilding, buildStructureWithDozer), a dozer ordered when it has none free. Four minutes: since units put
// out of the way of a new building walk out of it (moveObjectsForConstruction, tunnelling) instead of the dozers being
// teleported from inside footprints, its war factory comes at about 150 s (after the airfield the scripts ask for).
BOOST_AUTO_TEST_CASE(a_computer_player_builds_its_base)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	const auto owned = [&] {
		std::map<std::string, int> counts;
		game.Visible().ForEach([&](const engine::gameplay::VisibleObject &object) {
			const auto *owner = game.World().Get<engine::gameplay::Owner>(object.entity);
			const auto *ref = game.World().Get<engine::gameplay::DefinitionRef>(object.entity);
			if (owner != nullptr && ref != nullptr && owner->player == america)
				++counts[std::string(game.DefinitionName(ref->index))];
		});
		return counts;
	};
	for (int second = 1; second <= 240; ++second)
	{
		for (int tick = 0; tick < 30; ++tick)
			game.Tick();
		if (second % 20 == 0)
		{
			std::string line;
			for (const auto &[name, count] : owned())
				line += " " + name + "x" + std::to_string(count);
			BOOST_TEST_MESSAGE(second << "s: $" << game.World().Resource<engine::gameplay::PlayerMoney>().Balance(america) << line);
		}
	}
	const auto final = owned();
	BOOST_TEST(final.contains("AmericaSupplyCenter"));
	BOOST_TEST(final.contains("AmericaBarracks"));
	BOOST_TEST(final.contains("AmericaWarFactory"));
	BOOST_TEST(final.contains("AmericaPowerPlant"));
	BOOST_TEST_MESSAGE("unported: " << game.UnportedSummary());

	// The same on 4 workers; a checkpoint taken mid-build restores and plays on the same.
	session::SessionOptions wide = options;
	wide.workers = 4;
	session::Session other(skirmish.level, shell.game, wide);
	for (int tick = 0; tick < 240 * 30; ++tick)
		other.Tick();
	BOOST_TEST(other.StateHash() == game.StateHash());
	session::Session again(skirmish.level, shell.game, options);
	for (int tick = 0; tick < 100 * 30; ++tick)
		again.Tick();
	const auto restored = session::Session::Restore(skirmish.level, shell.game, options, again.Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	for (int tick = 0; tick < 20 * 30; ++tick)
	{
		again.Tick();
		restored->Tick();
	}
	BOOST_TEST(restored->StateHash() == again.StateHash());
}

// AIPlayer / AISkirmishPlayer team building (AIPlayer.cpp: doTeamBuilding, selectTeamToBuild, buildSpecificAITeam,
// queueUnits, queueSupplyTruck, onUnitProduced, checkQueuedTeams, checkReadyTeams; AISkirmishPlayer.cpp:
// doTeamBuilding): the team timer starts at 2 (AIPlayer's constructor) and the look delay at 0, so tick 1 looks
// (delay back to 2 s = 60) without being ready, tick 2 runs the timer out and looks again at once (ready), and the looks
// then come every 60 ticks. A hard America on Tournament Continent then orders its supply centre's trucks and picks
// teams its SkirmishScripts production conditions allow, builds each as a new inactive instance whose units join it as
// they come out of its factories, and starts it (active) once built; deterministic on 1 and 4 workers and across a
// checkpoint.
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_player_builds_its_teams)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	const auto &roster = game.Teams();
	{
		const auto &ais = game.World().Resource<generalszh::gameplay::AiPlayers>();
		BOOST_TEST_REQUIRE(ais.Of(america) != nullptr);
		BOOST_TEST(ais.Of(america)->skirmish);
		BOOST_TEST(ais.Of(america)->teamTimer == 2);
		BOOST_TEST(ais.Of(america)->teamDelay == 0);
		game.Tick(); // tick 1
		BOOST_TEST(!ais.Of(america)->readyToBuildTeam);
		BOOST_TEST(ais.Of(america)->teamTimer == 1);
		BOOST_TEST(ais.Of(america)->teamDelay == 60);
		game.Tick(); // tick 2: ready, and it looks at once
		BOOST_TEST(ais.Of(america)->teamDelay == 60);
		const bool picked = !ais.Of(america)->readyToBuildTeam;
		for (int tick = 3; tick <= 60; ++tick)
			game.Tick();
		BOOST_TEST(ais.Of(america)->teamDelay == 2); // the next look on tick 62
		BOOST_TEST_MESSAGE("a team picked on tick 2: " << picked);
	}
	std::set<std::string> started;
	std::size_t mostQueued = 0;
	for (int second = 3; second <= 300; ++second)
	{
		for (int tick = 0; tick < 30; ++tick)
		{
			game.Tick();
			for (std::uint32_t team = 0; team < roster.TeamCount(); ++team)
			{
				const auto &record = roster.TeamAt(team);
				if (record.owner == america && record.prototype != engine::gameplay::Team::Own && record.active && !record.members.empty())
					started.insert(record.name);
			}
		}
		const auto *ai = game.World().Resource<generalszh::gameplay::AiPlayers>().Of(america);
		BOOST_TEST_REQUIRE(ai != nullptr);
		mostQueued = std::max(mostQueued, ai->buildQueue.size());
		if (second % 30 == 0)
		{
			std::string queued;
			for (const auto &entry : ai->buildQueue)
				queued += " " + roster.TeamAt(entry.team).name;
			std::string ready;
			for (const auto &entry : ai->readyQueue)
				ready += " " + roster.TeamAt(entry.team).name;
			std::string out;
			for (const auto &name : started)
				out += " " + name;
			BOOST_TEST_MESSAGE(second << "s: $" << game.World().Resource<engine::gameplay::PlayerMoney>().Balance(america) << " building:" << queued
									  << " ready:" << ready << " started:" << out);
		}
	}
	BOOST_TEST(mostQueued > 0u);
	BOOST_TEST(!started.empty());
	BOOST_TEST_MESSAGE("unported: " << game.UnportedSummary());

	session::SessionOptions wide = options;
	wide.workers = 4;
	session::Session other(skirmish.level, shell.game, wide);
	for (int tick = 0; tick < 300 * 30; ++tick)
		other.Tick();
	BOOST_TEST(other.StateHash() == game.StateHash());
	session::Session again(skirmish.level, shell.game, options);
	for (int tick = 0; tick < 150 * 30; ++tick)
		again.Tick();
	const auto restored = session::Session::Restore(skirmish.level, shell.game, options, again.Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == again.StateHash());
	for (int tick = 0; tick < 60 * 30; ++tick)
	{
		again.Tick();
		restored->Tick();
	}
	BOOST_TEST(restored->StateHash() == again.StateHash());
}

// AISkirmishPlayer::buildAIBaseDefense / buildAIBaseDefenseStructure: front defences go on the circle of the base's reach
// plus SkirmishBaseDefenseExtraDistance, the first aimed at the start's "Center" approach waypoint nearest the base, the
// next ones alternately right and left of it by 4 x bounding radius / that radius (radians), each into the plan first,
// flagged for priority; a flank one takes the "Backdoor" path first. Float sin/cos versus fixed point: within a unit.
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_player_places_its_base_defenses)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	auto &ais = game.World().Resource<generalszh::gameplay::AiPlayers>();
	auto &ai = *ais.Of(america);
	const std::size_t planned = ai.buildList.size();
	const std::string patriot = shell.game.aiData.Side("America")->baseDefenseStructure;
	const auto *plan = shell.game.objects.Find(patriot);
	BOOST_TEST_REQUIRE(plan != nullptr);
	for (int count = 0; count < 3; ++count)
		generalszh::gameplay::BuildAiBaseDefense(game.Game(), ais, ai, 2, false);
	BOOST_TEST_REQUIRE(ai.buildList.size() >= planned + 1);
	// The reference geometry, in doubles.
	const auto &waypoints = game.Game().waypoints;
	const auto way = waypoints.ClosestOnPath(ai.baseCenter, "Center3");
	BOOST_TEST_REQUIRE(way != engine::gameplay::WaypointGraph::None);
	const double cx = ai.baseCenter.x.Raw() / 65536.0, cy = ai.baseCenter.y.Raw() / 65536.0;
	const double gx = waypoints.Position(way).x.Raw() / 65536.0 - cx, gy = waypoints.Position(way).y.Raw() / 65536.0 - cy;
	const double distance = ai.baseRadius.Raw() / 65536.0 + shell.game.aiData.skirmishBaseDefenseExtraDistance.Raw() / 65536.0;
	const double length = std::sqrt(gx * gx + gy * gy);
	const double ox = gx / length * distance, oy = gy / length * distance;
	const double step = 4 * generalszh::content::BoundingSphereRadius(plan->geometry).Raw() / 65536.0 / distance;
	// Tries 1, 2, 3 at angles 0, -step, +step; each legal one is prepended.
	std::vector<std::pair<double, double>> expected;
	for (const double angle : {0.0, -step, step})
		expected.emplace_back(cx + ox * std::cos(angle) - oy * std::sin(angle), cy + oy * std::cos(angle) + ox * std::sin(angle));
	BOOST_TEST(ai.frontDefenses >= 3);
	std::size_t matched = 0;
	for (std::size_t index = 0; index + planned < ai.buildList.size(); ++index)
	{
		const auto &slot = ai.buildList[ai.buildList.size() - planned - 1 - index];
		BOOST_TEST(slot.priorityBuild);
		BOOST_TEST(slot.structure == patriot);
		const bool found = std::any_of(expected.begin(), expected.end(), [&](const auto &point) {
			return std::abs(slot.location.x.Raw() / 65536.0 - point.first) < 1.0 && std::abs(slot.location.y.Raw() / 65536.0 - point.second) < 1.0;
		});
		BOOST_TEST(found);
		matched += found ? 1 : 0;
	}
	BOOST_TEST_MESSAGE("front defences placed: " << matched << " of 3 tries");
}

// Player::resetRank / resetSciences at the start, AIPlayer::doUpgradesAndSkills: every general starts at rank 1 with
// rank 1's purchase point (Rank.ini) and its side's sciences plus SCIENCE_Rank1; from tick 2 the skirmish AI, having a
// point to spend, picks one of its side's skill sets (AIData.ini SkillSet1..5) and buys, in the set's order, what it can
// afford and has the prerequisites for; the human's point stays unspent.
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_general_spends_its_first_point)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	BOOST_TEST_REQUIRE(shell.game.ranks.size() >= 5u);
	BOOST_TEST(shell.game.ranks[1].skillPointsNeeded == 800);
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t human = *game.Teams().FindPlayer("player0");
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	BOOST_TEST_REQUIRE(game.RankOf(america) != nullptr);
	BOOST_TEST(game.RankOf(america)->level == 1);
	const std::int32_t start = game.RankOf(america)->purchasePoints;
	BOOST_TEST(start >= 1);
	BOOST_TEST(game.KnowsScience(america, "SCIENCE_Rank1"));
	BOOST_TEST(game.KnowsScience(america, "SCIENCE_AMERICA"));
	game.Tick(); // tick 1: too early
	BOOST_TEST(game.RankOf(america)->purchasePoints == start);
	game.Tick(); // tick 2
	const auto &ai = *game.World().Resource<generalszh::gameplay::AiPlayers>().Of(america);
	BOOST_TEST_REQUIRE(ai.skillset >= 0);
	const auto &set = shell.game.aiData.Side("America")->skillSets[static_cast<std::size_t>(ai.skillset)];
	std::vector<std::string> bought;
	for (const std::string &science : set)
		if (game.KnowsScience(america, science))
			bought.push_back(science);
	BOOST_TEST(!bought.empty());
	BOOST_TEST(game.RankOf(america)->purchasePoints < start);
	BOOST_TEST_MESSAGE("skill set " << ai.skillset + 1 << " bought " << (bought.empty() ? std::string("nothing") : bought.front()));
	BOOST_TEST(game.RankOf(human)->purchasePoints == 1);
}

// AIPlayer::getPlayerSuperweaponValue / computeSuperweaponTarget and ScriptActions::doSkirmishFireSpecialPowerAtMostCost:
// the value around the GLA command centre is its objects' build costs scaled from 1 at the middle to 0.5 at the edge
// (the command centre a tenth), which a double reference matches within one credit per object; with SCIENCE_Paradrop1
// learnt (the power ready at once) the American AI's paradrop goes to a spot inside the GLA's structure bounds, and the
// shared timer then waits the full 240 s.
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_player_aims_its_power_at_the_richest_spot)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t gla = *game.Teams().FindPlayer("player0");
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	game.Tick();
	// The value around the GLA command centre.
	Engine::Math::FixedVector2 center;
	double reference = 0;
	const double radius = 100;
	std::vector<std::pair<Engine::Math::FixedVector2, std::string>> objects;
	for (std::uint32_t team = 0; team < game.Teams().TeamCount(); ++team)
		if (game.Teams().TeamAt(team).owner == gla)
			for (const auto member : game.Teams().TeamAt(team).members)
				if (game.World().IsAlive(member))
					objects.emplace_back(game.TransformOf(member)->position.XY(), std::string(game.DefinitionName(game.World().Get<engine::gameplay::DefinitionRef>(member)->index)));
	for (const auto &[at, name] : objects)
		if (name == "GLACommandCenter")
			center = at;
	for (const auto &[at, name] : objects)
	{
		const double dx = (center.x - at.x).Raw() / 65536.0, dy = (center.y - at.y).Raw() / 65536.0;
		const double distance = std::sqrt(dx * dx + dy * dy);
		if (distance >= radius)
			continue;
		const auto *kind = shell.game.objects.Find(name);
		double value = kind->buildCost;
		if (kind->Is("COMMANDCENTER") || kind->Is("FS_SUPERWEAPON"))
			value /= 10;
		reference += (1.0 - distance / (2 * radius)) * value;
	}
	const std::int64_t value = generalszh::gameplay::PlayerSuperweaponValue(game.Game(), center, gla, Engine::Math::Fixed::FromInt(100), true);
	BOOST_TEST(std::abs(static_cast<double>(value) - reference) <= static_cast<double>(objects.size()) + 1.0);
	BOOST_TEST(value > 0);
	// The paradrop, aimed.
	const auto science = shell.game.Science("SCIENCE_Paradrop1");
	BOOST_TEST_REQUIRE(science.has_value());
	generalszh::gameplay::GrantScience(game.Game(), america, *science);
	auto &ais = game.World().Resource<generalszh::gameplay::AiPlayers>();
	const auto bounds = generalszh::gameplay::PlayerStructureBounds(game.Game(), gla);
	const auto target = generalszh::gameplay::ComputeSuperweaponTarget(game.Game(), false, gla, Engine::Math::Fixed::FromInt(50));
	BOOST_TEST_REQUIRE(target.has_value());
	BOOST_TEST((target->x >= bounds[0].x - Engine::Math::Fixed::FromInt(60) && target->x <= bounds[1].x + Engine::Math::Fixed::FromInt(60)));
	BOOST_TEST((target->y >= bounds[0].y - Engine::Math::Fixed::FromInt(60) && target->y <= bounds[1].y + Engine::Math::Fixed::FromInt(60)));
	const std::int64_t planes = game.PlayerObjectCount("player1", "AmericaJetCargoPlane");
	generalszh::gameplay::SkirmishFireSpecialPowerAtMostCost(game.Game(), ais, america, america, "SuperweaponParadropAmerica");
	BOOST_TEST(game.PlayerObjectCount("player1", "AmericaJetCargoPlane") > planes);
	const auto power = shell.game.powers.Template("SuperweaponParadropAmerica");
	auto &shared = game.World().Resource<engine::gameplay::SharedPowerTimers>();
	BOOST_TEST_REQUIRE(shared.Find(america, *power) != nullptr);
	BOOST_TEST(shared.Find(america, *power)->readyOn == game.CurrentTick() + 7200u);
}

// AIPlayer::recruitSpecificAITeam (RECRUIT_TEAM) with Team::tryToRecruit, and TeamPrototype::increaseAIPriorityForSuccess /
// decreaseAIPriorityForFailure: recruiting the AI's "USA Replace Dozer" team from anywhere (radius 0) takes its dozer
// from the default team when the team outranks it (the default team is always recruitable), into a new instance put
// first in the ready queue; with nothing taken the instance goes. Success raises the priority by its
// ProductionPrioritySuccessIncrease, failure lowers it by its ProductionPriorityFailureDecrease.
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_player_recruits_a_team)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	game.Tick();
	auto &ais = game.World().Resource<generalszh::gameplay::AiPlayers>();
	auto &ai = *ais.Of(america);
	const auto dozers = game.Teams().FindTeam("USA Replace Dozer2");
	BOOST_TEST_REQUIRE(dozers.has_value());
	const auto &info = game.Game().teams.At(*dozers);
	const std::int64_t priority = info.Get<std::int64_t>("teamProductionPriority").value_or(0);
	const auto defaultTeam = *game.Teams().DefaultTeam(america);
	const std::int64_t defaultPriority = game.Game().teams.At(defaultTeam).Get<std::int64_t>("teamProductionPriority").value_or(0);
	const auto before = game.Teams().TeamCount();
	const std::size_t ready = ai.readyQueue.size();
	generalszh::gameplay::AiScriptHooks hooks;
	hooks.actions = [](const std::string &, std::optional<std::uint32_t>) {};
	generalszh::gameplay::RecruitSpecificAiTeam(game.Game(), ais, ai, *dozers, Engine::Math::Fixed{}, hooks);
	BOOST_TEST_MESSAGE("priorities: team " << priority << " default " << defaultPriority);
	if (priority > defaultPriority)
	{
		BOOST_TEST_REQUIRE(ai.readyQueue.size() == ready + 1);
		const std::uint32_t instance = ai.readyQueue.front().team;
		BOOST_TEST(game.Teams().PrototypeOf(instance) == *dozers);
		BOOST_TEST(!game.Teams().TeamAt(instance).members.empty());
	}
	else
	{
		BOOST_TEST(ai.readyQueue.size() == ready);
		BOOST_TEST(game.Teams().TeamCount() == before + 1);
		BOOST_TEST(!game.Teams().TeamAt(before).alive); // the instance made went again
	}
	// Raised above the default team (as successes would), it takes the dozer: into a new instance, ready first.
	ais.Production(*dozers) = {true, static_cast<std::int32_t>(defaultPriority) + 5, ais.Production(*dozers).evaluateAt};
	generalszh::gameplay::RecruitSpecificAiTeam(game.Game(), ais, ai, *dozers, Engine::Math::Fixed{}, hooks);
	BOOST_TEST_REQUIRE(!ai.readyQueue.empty());
	const std::uint32_t recruited = ai.readyQueue.front().team;
	BOOST_TEST(game.Teams().PrototypeOf(recruited) == *dozers);
	BOOST_TEST_REQUIRE(game.Teams().TeamAt(recruited).members.size() == 1u);
	BOOST_TEST(game.DefinitionName(game.World().Get<engine::gameplay::DefinitionRef>(game.Teams().TeamAt(recruited).members.front())->index) == "AmericaVehicleDozer");
	ais.Production(*dozers).priorityChanged = false;
	const std::int64_t up = info.Get<std::int64_t>("teamProductionPrioritySuccessIncrease").value_or(0);
	const std::int64_t down = info.Get<std::int64_t>("teamProductionPriorityFailureDecrease").value_or(0);
	generalszh::gameplay::ChangeProductionPriority(game.Game(), ais, *dozers, true);
	BOOST_TEST(ais.Production(*dozers).priority == priority + up);
	generalszh::gameplay::ChangeProductionPriority(game.Game(), ais, *dozers, false);
	BOOST_TEST(ais.Production(*dozers).priority == priority + up - down);
}

// RebuildHoleExposeDie / RebuildHoleBehavior: the GLA command centre killed leaves a GLAHoleCommandCenter where it stood
// (its health 500 of HoleMaxHealth 500 at most); WorkerRespawnDelay later a worker comes out of the hole and starts the
// command centre again, free; once it stands, the hole and its worker are gone. The hole counts for victory (the
// original checks at the tick's end), so its player is not defeated meanwhile.
BOOST_AUTO_TEST_CASE(legacy_parity_a_gla_structure_leaves_a_hole_that_rebuilds_it)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::Player, u"Other");
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t gla = *game.Teams().FindPlayer("player0");
	game.Tick();
	ecs::Entity center;
	for (std::uint32_t team = 0; team < game.Teams().TeamCount(); ++team)
		if (game.Teams().TeamAt(team).owner == gla)
			for (const auto member : game.Teams().TeamAt(team).members)
				if (game.DefinitionName(game.World().Get<engine::gameplay::DefinitionRef>(member)->index) == "GLACommandCenter")
					center = member;
	BOOST_TEST_REQUIRE(game.World().IsAlive(center));
	const auto where = game.TransformOf(center)->position;
	game.World().Resource<engine::gameplay::KillRequests>().entities.push_back(center);
	game.Tick();
	const std::uint64_t killed = game.CurrentTick();
	const auto hole = generalszh::gameplay::HoleOf(game.Game(), center);
	BOOST_TEST_REQUIRE(game.World().IsAlive(hole));
	// VictoryConditions::update at the tick's end: the hole counts for victory, so GLA is still in.
	for (const auto &standing : game.World().Resource<engine::gameplay::MatchOutcome>().players)
		if (standing.player == gla)
			BOOST_TEST(!standing.defeated);
	BOOST_TEST(game.DefinitionName(game.World().Get<engine::gameplay::DefinitionRef>(hole)->index) == "GLAHoleCommandCenter");
	BOOST_TEST((game.TransformOf(hole)->position.XY() == where.XY()));
	const auto &health = *game.World().Get<engine::gameplay::Health>(hole);
	BOOST_TEST((health.maximum == Engine::Math::Fixed::FromInt(500)));
	BOOST_TEST_MESSAGE("hole health " << health.current.Floor() << "/" << health.maximum.Floor() << ", worker due in " << game.World().Get<generalszh::gameplay::RebuildHole>(hole)->workerWait);
	// The worker comes, and the command centre goes up again, free.
	const std::int64_t money = game.World().Resource<engine::gameplay::PlayerMoney>().Balance(gla);
	std::uint64_t workerAt = 0, rebuilt = 0;
	ecs::Entity again;
	for (int tick = 0; tick < 30 * 240 && rebuilt == 0; ++tick)
	{
		game.Tick();
		if (workerAt == 0 && game.World().IsAlive(hole) && game.World().IsAlive(game.World().Get<generalszh::gameplay::RebuildHole>(hole)->worker))
		{
			workerAt = game.CurrentTick();
			again = game.World().Get<generalszh::gameplay::RebuildHole>(hole)->reconstructing;
			BOOST_TEST(game.World().IsAlive(again));
			BOOST_TEST(game.World().Resource<engine::gameplay::PlayerMoney>().Balance(gla) == money);
		}
		if (workerAt != 0 && !game.World().IsAlive(hole))
			rebuilt = game.CurrentTick();
	}
	BOOST_TEST_MESSAGE("killed at " << killed << ", worker at " << workerAt << ", standing again at " << rebuilt);
	BOOST_TEST_REQUIRE(workerAt > killed);
	BOOST_TEST(workerAt == killed + 599u); // WorkerRespawnDelay 20 s: 600 ticks counted down from the hole's first tick
	BOOST_TEST_REQUIRE(rebuilt > workerAt);
	BOOST_TEST(game.World().IsAlive(again));
	BOOST_TEST(game.DefinitionName(game.World().Get<engine::gameplay::DefinitionRef>(again)->index) == "GLACommandCenter");
}

// AIPlayer::repairStructure / updateBridgeRepair (PLAYER_REPAIR_NAMED_STRUCTURE): the AI's damaged command centre (half
// health: not pristine) joins its repair list once. Asked before its first tick, its dozer is still idle: the first look
// (the countdown starts at 0) sends it to repair; once it has no task left and the building is pristine the list is
// empty and it goes back to the base.
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_player_repairs_a_damaged_structure)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	auto &ai = *game.World().Resource<generalszh::gameplay::AiPlayers>().Of(america);
	const ecs::Entity center = ai.buildList.front().built;
	BOOST_TEST_REQUIRE(game.World().IsAlive(center));
	auto &health = *game.World().Get<engine::gameplay::Health>(center);
	health.current = health.maximum / Engine::Math::Fixed::FromInt(2);
	// A pristine one is not taken; a damaged one once.
	generalszh::gameplay::RepairStructure(game.Game(), ai, center);
	generalszh::gameplay::RepairStructure(game.Game(), ai, center);
	BOOST_TEST(ai.toRepair.size() == 1u);
	game.Tick(); // tick 1: the look
	BOOST_TEST_REQUIRE(game.World().IsAlive(ai.repairDozer));
	BOOST_TEST(ai.dozerIsRepairing);
	std::uint64_t done = 0;
	for (int tick = 0; tick < 30 * 180 && done == 0; ++tick)
	{
		game.Tick();
		if (ai.toRepair.empty())
			done = game.CurrentTick();
	}
	BOOST_TEST_MESSAGE("repaired by tick " << done << " health " << game.World().Get<engine::gameplay::Health>(center)->current.Floor());
	BOOST_TEST_REQUIRE(done > 0u);
	const auto &after = *game.World().Get<engine::gameplay::Health>(center);
	BOOST_TEST((after.current > after.maximum * shell.game.gameData.unitDamaged));
	const auto *order = game.World().Get<engine::gameplay::MoveOrder>(ai.repairDozer);
	BOOST_TEST_REQUIRE(order != nullptr);
	BOOST_TEST((order->mode != engine::gameplay::MoveMode::Idle));
}

// AIPlayer::onUnitProduced / updateBridgeRepair: asked while its dozer is busy, the AI queues a dozer for the repair
// and hands it the job as it is made. (The retail VS6 build started onUnitProduced's supplyTruck flag true, an
// uninitialised value, so the new dozer never got the job and the repair waited for good; fixed as the original's
// later builds have it.)
BOOST_AUTO_TEST_CASE(legacy_parity_a_dozer_queued_for_a_repair_takes_the_job)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	auto &ai = *game.World().Resource<generalszh::gameplay::AiPlayers>().Of(america);
	game.Tick();
	game.Tick(); // its dozer is off building
	const ecs::Entity center = ai.buildList.front().built;
	auto &health = *game.World().Get<engine::gameplay::Health>(center);
	health.current = health.maximum / Engine::Math::Fixed::FromInt(2);
	generalszh::gameplay::RepairStructure(game.Game(), ai, center);
	game.Tick();
	BOOST_TEST_REQUIRE(ai.dozerQueuedForRepair);
	bool handed = false;
	std::uint64_t repaired = 0;
	for (int tick = 0; tick < 30 * 240 && repaired == 0; ++tick)
	{
		game.Tick();
		handed = handed || (!ai.dozerQueuedForRepair && game.World().IsAlive(ai.repairDozer));
		if (ai.toRepair.empty())
			repaired = game.CurrentTick();
	}
	BOOST_TEST(handed);
	BOOST_TEST(repaired > 0u);
	const auto &after = *game.World().Get<engine::gameplay::Health>(center);
	BOOST_TEST((after.current > after.maximum * shell.game.gameData.unitDamaged));
}

