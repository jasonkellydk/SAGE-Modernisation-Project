// Object::look at the start (PartitionManager::update after the starting objects are placed): each player's command
// centre and dozer clear the shroud around them for their own player (and allies: none here), not for the enemy across
// the map, whose own start is clear to it alone; the shroud rides through a checkpoint.
BOOST_AUTO_TEST_CASE(legacy_parity_starting_objects_clear_their_own_shroud)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::Player, u"Other");
	setup.slots[1].playerTemplate = templateOf("FactionGLA");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	game.Tick();
	const std::uint32_t us = *game.Teams().FindPlayer("player0");
	const std::uint32_t them = *game.Teams().FindPlayer("player1");
	const auto &shroud = game.World().Resource<engine::gameplay::ShroudMap>();
	BOOST_TEST((shroud.CellSize() == Engine::Math::Fixed::FromInt(40))); // PartitionCellSize
	BOOST_TEST(shroud.UnlookPersist() == 150u); // UnlookPersistDuration 5000 ms
	std::uint32_t lookers = 0;
	ecs::Query<ecs::Read<engine::gameplay::Vision>, ecs::Read<engine::gameplay::Owner>, ecs::Read<engine::gameplay::Transform>> query(game.World());
	query.ForEachChunk([&](auto chunk) {
		const auto visions = chunk.template Get<engine::gameplay::Vision>();
		const auto owners = chunk.template Get<engine::gameplay::Owner>();
		const auto transforms = chunk.template Get<engine::gameplay::Transform>();
		for (std::size_t row = 0; row < visions.size(); ++row)
		{
			const std::uint32_t owner = owners[row].player;
			if ((owner != us && owner != them) || visions[row].clearingRange <= Engine::Math::Fixed{})
				continue;
			++lookers;
			const auto &at = transforms[row].position;
			BOOST_TEST((shroud.StatusAt(owner, at.x, at.y) == engine::gameplay::CellShroud::Clear));
			BOOST_TEST((shroud.StatusAt(owner == us ? them : us, at.x, at.y) == engine::gameplay::CellShroud::Shrouded));
		}
	});
	BOOST_TEST(lookers >= 4u); // a command centre and a dozer (or worker) each
	const auto restored = session::Session::Restore(skirmish.level, shell.game, options, game.Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == game.StateHash());
}

// The shroud's script actions through the session (ScriptActions doRevealMapEntire / doRevealMapEntirePermanently /
// doShroudMapEntire over PartitionManager's revealMapForPlayer and the rest, doRevealMapAtWaypoint, and
// ScriptEngine's named reveals): the map revealed for every human fogs the far corner nobody looks at; shrouded for
// one player, only its corner goes back; a permanent reveal clears and its undo fogs again; a quick reveal at a
// waypoint leaves fog; a named reveal holds the cells clear until undone (and a second of the same name changes nothing).
BOOST_AUTO_TEST_CASE(legacy_parity_script_shroud_actions)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::Player, u"Other");
	setup.slots[1].playerTemplate = templateOf("FactionGLA");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	game.Tick();
	const std::uint32_t us = *game.Teams().FindPlayer("player0");
	const std::uint32_t them = *game.Teams().FindPlayer("player1");
	BOOST_TEST_REQUIRE(game.Teams().PlayerAt(us).human);
	BOOST_TEST_REQUIRE(game.Teams().PlayerAt(them).human);
	const auto &shroud = game.World().Resource<engine::gameplay::ShroudMap>();
	using engine::gameplay::CellShroud;
	session::ScriptBridge bridge(game.Game());
	using MapShroud = generalszh::scripting::PlayerScriptHost::MapShroud;
	BOOST_TEST((shroud.Status(us, 0, 0) == CellShroud::Shrouded));
	bridge.ShroudEntireMap(std::nullopt, MapShroud::RevealAll);
	BOOST_TEST((shroud.Status(us, 0, 0) == CellShroud::Fogged));
	BOOST_TEST((shroud.Status(them, 0, 0) == CellShroud::Fogged));
	bridge.ShroudEntireMap(them, MapShroud::ShroudAll);
	BOOST_TEST((shroud.Status(them, 0, 0) == CellShroud::Shrouded));
	BOOST_TEST((shroud.Status(us, 0, 0) == CellShroud::Fogged));
	bridge.ShroudEntireMap(us, MapShroud::RevealAllPermanently);
	BOOST_TEST((shroud.Status(us, 0, 0) == CellShroud::Clear));
	bridge.ShroudEntireMap(us, MapShroud::UndoRevealAllPermanently);
	BOOST_TEST((shroud.Status(us, 0, 0) == CellShroud::Fogged));

	// Player 2's start, far from ours: a quick look fogs it for us; a named reveal clears it until undone.
	const auto &waypoints = game.World().Resource<engine::gameplay::WaypointGraph>();
	const std::uint32_t start = waypoints.Find("Player_2_Start");
	BOOST_TEST_REQUIRE(start != engine::gameplay::WaypointGraph::None);
	const auto at = waypoints.Position(start);
	BOOST_TEST((shroud.StatusAt(us, at.x, at.y) == CellShroud::Fogged)); // the whole map fogged above
	bridge.ShroudEntireMap(us, MapShroud::ShroudAll);
	BOOST_TEST((shroud.StatusAt(us, at.x, at.y) == CellShroud::Shrouded));
	bridge.ShroudAtWaypoint("Player_2_Start", Engine::Math::Fixed::FromInt(100), us, false);
	BOOST_TEST((shroud.StatusAt(us, at.x, at.y) == CellShroud::Fogged));
	bridge.RevealNamed("Look", "Player_2_Start", Engine::Math::Fixed::FromInt(100), us);
	BOOST_TEST((shroud.StatusAt(us, at.x, at.y) == CellShroud::Clear));
	bridge.RevealNamed("Look", "Player_1_Start", Engine::Math::Fixed::FromInt(100), them); // the name is taken: the first reveal again
	bridge.UndoRevealNamed("Look");
	BOOST_TEST((shroud.StatusAt(us, at.x, at.y) == CellShroud::Clear)); // looked at twice, undone once
	BOOST_TEST(shroud.FindNamedReveal("Look") == nullptr);
	bridge.UndoRevealNamed("Look"); // gone: nothing
	BOOST_TEST((shroud.StatusAt(us, at.x, at.y) == CellShroud::Clear));
}


// AIPlayer::buildSpecificBuildingNearestTeam (AI_PLAYER_BUILD_TYPE_NEAREST_TEAM): the structure is planned, at the front of
// the plan and for priority, where the team's newest member stands (getEstimateTeamPosition) when nothing is in the way
// there (the original then built nothing: its `valid` only came from the wiggle; fixed); a member standing in the way of
// such a spot (a Ranger on a Command Center's footprint) makes it the first legal spot of the wiggle (rings of two cells,
// bottom row first), which is legal with a clear path; an empty team plans nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_computer_player_builds_nearest_a_team)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto scb = shell.files.Read("Data/Scripts/SkirmishScripts.scb");
	const auto map = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	const auto file = engine::level::generals_map::ReadScriptFile(*scb);
	auto read = engine::level::generals_map::Read(*map);
	BOOST_TEST_REQUIRE((file.has_value() && read.has_value()));
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 3;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionGLA");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionAmerica");
	setup.slots[1].startPos = 2;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4, &*file);
	session::SessionOptions options{3, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	const std::uint32_t america = *game.Teams().FindPlayer("player1");
	auto &ai = *game.World().Resource<generalszh::gameplay::AiPlayers>().Of(america);
	const std::uint32_t team = *game.Teams().FindTeam(skirmish.players[1].team);
	const std::string patriot = shell.game.aiData.Side("America")->baseDefenseStructure;
	const auto *plan = shell.game.objects.Find(patriot);
	BOOST_TEST_REQUIRE(plan != nullptr);
	auto &world = game.World();
	const auto start = world.Get<engine::gameplay::Transform>(game.Teams().TeamAt(team).members.front())->position.XY();
	const Engine::Math::FixedVector2 open{start.x + Engine::Math::Fixed::FromInt(300), start.y + Engine::Math::Fixed::FromInt(300)};
	const ecs::Entity scout = game.Place("AmericaInfantryRanger", open, {}, team);
	generalszh::gameplay::BuildNearestTeam(game.Game(), ai, patriot, team);
	BOOST_TEST_REQUIRE(!ai.buildList.empty());
	BOOST_TEST(ai.buildList.front().structure == patriot);
	BOOST_TEST(ai.buildList.front().priorityBuild);
	BOOST_TEST(ai.buildList.front().rebuilds == 1);
	BOOST_TEST((ai.buildList.front().location == open));

	// In the way: on a Command Center (its footprint) the Ranger makes the wiggle's first legal spot the one.
	const std::size_t planned = ai.buildList.size();
	const ecs::Entity blocker = game.Place("AmericaCommandCenter", {open.x + Engine::Math::Fixed::FromInt(400), open.y}, {}, team);
	world.Get<engine::gameplay::Transform>(scout)->position = world.Get<engine::gameplay::Transform>(blocker)->position;
	generalszh::gameplay::BuildNearestTeam(game.Game(), ai, patriot, team);
	BOOST_TEST_REQUIRE(ai.buildList.size() == planned + 1);
	const auto spot = ai.buildList.front().location;
	BOOST_TEST(!(spot == world.Get<engine::gameplay::Transform>(blocker)->position.XY()));
	const auto angle = Engine::Math::TurnFromDegrees(plan->placementViewAngleDegrees);
	namespace bc = generalszh::gameplay::build_check;
	BOOST_TEST((generalszh::gameplay::CheckBuildLocation(game.Game(), *plan, spot, angle, {}, bc::ClearPath | bc::TerrainRestrictions | bc::NoObjectOverlap) ==
		generalszh::gameplay::LegalBuild::Ok));

	// An empty team: nothing planned.
	std::optional<std::uint32_t> idle;
	for (std::uint32_t other = 0; other < game.Teams().TeamCount() && !idle; ++other)
		if (game.Teams().TeamAt(other).members.empty())
			idle = other;
	BOOST_TEST_REQUIRE(idle.has_value());
	generalszh::gameplay::BuildNearestTeam(game.Game(), ai, patriot, *idle);
	BOOST_TEST(ai.buildList.size() == planned + 1);
}

// Legacy parity (QuitMenu.cpp surrenderQuitMenu -> GameLogic::onSelfDestruct, Player::transferAssetsFromThat,
// Player::killPlayer): two humans on one team against a hard AI. The first surrenders: on that tick its command centre
// and dozer go to its ally (onto its default team) with all its money, the ally's own money not counted as earned, and it
// has nothing left: the next victory check beats it. Then the ally surrenders with no ally left standing: everything of
// its (its own and what it was given) dies on that tick (what their deaths leave, their debris, is still its).
BOOST_AUTO_TEST_CASE(legacy_parity_a_surrender_hands_everything_to_an_ally_else_kills_it)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	BOOST_TEST_REQUIRE(bytes.has_value());
	auto read = engine::level::generals_map::Read(*bytes);
	BOOST_TEST_REQUIRE(read.has_value());
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.seed = 7;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"First");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[0].team = 0;
	setup.slots[1].SetState(session::setup::SlotState::Player, u"Second");
	setup.slots[1].playerTemplate = templateOf("FactionChina");
	setup.slots[1].startPos = 1;
	setup.slots[1].team = 0;
	setup.slots[2].SetState(session::setup::SlotState::HardAI);
	setup.slots[2].playerTemplate = templateOf("FactionGLA");
	setup.slots[2].startPos = 2;
	setup.slots[2].team = 1;
	const auto skirmish = session::setup::PrepareSkirmishLevel(read->level, setup, shell.game.playerTemplates, 4);
	session::SessionOptions options{5, 1, {}, {"player0", "player1"}};
	for (const auto &player : skirmish.players)
		options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
	session::Session game(skirmish.level, shell.game, options);
	auto &world = game.World();
	const std::uint32_t first = *game.Teams().FindPlayer("player0");
	const std::uint32_t second = *game.Teams().FindPlayer("player1");
	const std::uint32_t secondHome = *game.Teams().DefaultTeam(second);
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	const auto ownedBy = [&](std::uint32_t player) {
		std::vector<ecs::Entity> owned;
		for (std::uint32_t team = 0; team < game.Teams().TeamCount(); ++team)
			if (game.Teams().TeamAt(team).owner == player)
				for (const ecs::Entity member : game.Teams().TeamAt(team).members)
					if (world.IsAlive(member) && !world.Has<engine::gameplay::Dying>(member))
						owned.push_back(member);
		return owned;
	};
	const std::vector<ecs::Entity> firsts = ownedBy(first);
	const std::vector<ecs::Entity> seconds = ownedBy(second);
	BOOST_TEST_REQUIRE(firsts.size() == 2u); // its command centre and dozer
	BOOST_TEST_REQUIRE(seconds.size() == 2u);
	auto &money = world.Resource<engine::gameplay::PlayerMoney>();
	const std::int64_t firstMoney = money.Balance(first), secondMoney = money.Balance(second), secondEarned = money.Earned(second);
	BOOST_TEST(firstMoney == 10000);

	auto surrender = commands::Encode(commands::SelfDestruct{true});
	surrender.player = 0; // seat 0 plays the first
	game.Tick(std::span(&surrender, 1));
	BOOST_TEST(ownedBy(first).empty());
	BOOST_TEST(ownedBy(second).size() == 4u);
	for (const ecs::Entity entity : firsts)
	{
		BOOST_TEST(world.Get<engine::gameplay::Owner>(entity)->player == second);
		BOOST_TEST(world.Get<engine::gameplay::TeamMember>(entity)->team == secondHome);
	}
	BOOST_TEST(money.Balance(first) == 0);
	BOOST_TEST(money.Balance(second) == secondMoney + firstMoney);
	BOOST_TEST(money.Earned(second) == secondEarned);
	game.Tick();
	const auto *standing = world.Resource<engine::gameplay::MatchOutcome>().Of(first);
	BOOST_TEST_REQUIRE(standing != nullptr);
	BOOST_TEST(standing->defeated);

	// The second has no ally standing: it is killed.
	surrender.player = 1;
	game.Tick(std::span(&surrender, 1));
	for (const ecs::Entity entity : firsts)
		BOOST_TEST((!world.IsAlive(entity) || world.Has<engine::gameplay::Dying>(entity)));
	for (const ecs::Entity entity : seconds)
		BOOST_TEST((!world.IsAlive(entity) || world.Has<engine::gameplay::Dying>(entity)));
	BOOST_TEST(money.Balance(second) == secondMoney + firstMoney); // killPlayer takes no money
}

BOOST_AUTO_TEST_SUITE_END()
