	std::vector<engine::net::CommandEnvelope> attack{commands::Encode(commands::Attack{{humvee}, target})};
	attack.front().player = 0;
	game.Tick(std::span(attack));
	BOOST_TEST((world.Get<gp::AttackTarget>(humvee)->target == target));
	for (const ecs::Entity ranger : rangers)
		BOOST_TEST((world.Get<gp::AttackTarget>(ranger)->target == target));
