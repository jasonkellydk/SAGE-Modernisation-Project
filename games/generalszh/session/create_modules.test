// Create modules on real data (VeterancyGainCreate, LockWeaponCreate), in a
// skirmish: player0 America (a human), player1 the GLA (an AI).
using namespace generalszh;
using Engine::Math::Fixed;

namespace
{
struct Install
{
	engine::filesystem::VirtualFileSystem files;
	engine::config::Diagnostics grammarDiagnostics;
	std::optional<content::ContentLoader> loader;
	content::GameContent game;
	bool loaded{false};

	Install()
	{
		const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
		if (install == nullptr || !std::filesystem::exists(install))
			return;
		content::MountInstall(files, install);
		loader.emplace(files, content::ZeroHourIniGrammar(grammarDiagnostics));
		game = content::LoadGameContent(*loader, engine::time::FixedStep{30});
		loaded = true;
	}
};

Install &Data()
{
	static Install install;
	return install;
}

struct Match
{
	std::optional<engine::level::generals_map::ReadResult> read;
	session::setup::SkirmishLevel skirmish;
	Engine::Math::FixedVector2 start;

	std::uint32_t Team(const session::Session &game, std::size_t player) const { return *game.Teams().FindTeam(skirmish.players[player].team); }
	Engine::Math::FixedVector2 At(int dx, int dy) const { return {start.x + Fixed::FromInt(dx), start.y + Fixed::FromInt(dy)}; }

	session::SessionOptions Options(std::size_t workers) const
	{
		session::SessionOptions options{11, workers, {}, {"player0", "player1"}};
		for (const auto &player : skirmish.players)
			options.starts.push_back({player.name, player.team, player.playerTemplate, player.startPosition});
		return options;
	}
};

std::optional<Match> Prepare(Install &shell, std::uint16_t superweaponRestriction = 0)
{
	const auto bytes = shell.files.Read("Maps/Tournament Continent/Tournament Continent.map");
	if (!bytes)
		return std::nullopt;
	Match match;
	auto read = engine::level::generals_map::Read(*bytes);
	if (!read)
		return std::nullopt;
	match.read = std::move(*read);
	const auto templateOf = [&](std::string_view name) {
		for (std::size_t index = 0; index < shell.game.playerTemplates.templates.size(); ++index)
			if (shell.game.playerTemplates.templates[index].name == name)
				return static_cast<int>(index);
		return -1;
	};
	session::setup::GameSetup setup;
	setup.superweaponRestriction = superweaponRestriction;
	setup.seed = 7;
	setup.startingCash = 10000;
	setup.slots[0].SetState(session::setup::SlotState::Player, u"Jason");
	setup.slots[0].playerTemplate = templateOf("FactionAmerica");
	setup.slots[0].startPos = 0;
	setup.slots[1].SetState(session::setup::SlotState::HardAI);
	setup.slots[1].playerTemplate = templateOf("FactionGLA");
	setup.slots[1].startPos = 2;
	match.skirmish = session::setup::PrepareSkirmishLevel(match.read->level, setup, shell.game.playerTemplates, 4);
	for (const auto &marker : match.read->level.markers)
		if (marker.name == "Player_1_Start")
			match.start = marker.position.XY();
	return match;
}

std::vector<ecs::Entity> Named(session::Session &game, std::string_view name)
{
	std::vector<ecs::Entity> found;
	ecs::Query<ecs::Read<engine::gameplay::DefinitionRef>> query(game.World());
	query.ForEachChunk([&](auto chunk) {
		const auto refs = chunk.template Get<engine::gameplay::DefinitionRef>();
		const auto entities = chunk.Entities();
		for (std::size_t row = 0; row < refs.size(); ++row)
			if (game.DefinitionName(refs[row].index) == name)
				found.push_back(entities[row]);
	});
	return found;
}

bool Shows(session::Session &game, ecs::Entity entity, std::string_view condition)
{
	const auto *look = game.World().Get<engine::gameplay::Appearance>(entity);
	return look != nullptr && look->Test(content::ModelConditionBit(condition));
}
}

BOOST_AUTO_TEST_SUITE(create_modules)

// LockWeaponCreate::onBuildComplete (SlotToLock PRIMARY): a Ranger holds its rifle for good (setWeaponLock
// LOCKED_PERMANENTLY; chooseBestWeaponForTarget keeps a locked weapon). Its flash-bang set (PLAYER_UPGRADE,
// WeaponLockSharedAcrossSets Yes) keeps the lock as it takes it (updateWeaponSet), the grenades beside the rifle.
BOOST_AUTO_TEST_CASE(legacy_parity_a_ranger_keeps_its_rifle_locked_through_its_upgrade)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const std::uint32_t america = *game.Teams().FindPlayer("player0");
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(0, -200), {}, match->Team(game, 0));
	const auto *slots = world.Get<engine::gameplay::WeaponSlots>(ranger);
	BOOST_TEST_REQUIRE(slots != nullptr);
	BOOST_TEST(slots->locked == 0u);
	BOOST_TEST(slots->current == 0u);
	world.Resource<engine::gameplay::PlayerUpgrades>().Grant(america, *shell.game.upgrades.Find("Upgrade_AmericaRangerFlashBangGrenade"));
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	slots = world.Get<engine::gameplay::WeaponSlots>(ranger);
	BOOST_TEST_REQUIRE(slots != nullptr);
	BOOST_TEST(slots->slots[1].weapon != 0xFFFFFFFFu); // the grenades
	BOOST_TEST(slots->locked == 0u);
	// Near an enemy it keeps firing its rifle.
	game.Place("GLAInfantryRebel", match->At(0, -120), {}, match->Team(game, 1));
	for (int tick = 0; tick < 90; ++tick)
	{
		game.Tick();
		BOOST_TEST_REQUIRE(world.Get<engine::gameplay::WeaponSlots>(ranger)->current == 0u);
	}
}

// LockWeaponCreate locks its slot only in onBuildComplete, which an object creation list never calls
// (ObjectCreationList.cpp's GenericObjectCreationNugget only creates the object): the two Rangers an American Power
// Plant leaves as it dies (CreateObjectDie OCL_AmericanRangerDebris02, ExemptStatus UNDER_CONSTRUCTION) hold no weapon
// lock, while one placed as a map places its objects (built) has PRIMARY locked.
BOOST_AUTO_TEST_CASE(legacy_parity_rangers_a_creation_list_makes_hold_no_weapon_lock)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity placed = game.Place("AmericaInfantryRanger", match->At(-200, -200), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.Get<gp::WeaponSlots>(placed) != nullptr);
	BOOST_TEST(world.Get<gp::WeaponSlots>(placed)->locked == 0u);
	const ecs::Entity plant = game.Place("AmericaPowerPlant", match->At(300, 0), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(plant));
	game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(plant);
	std::vector<ecs::Entity> made;
	for (int tick = 0; tick < 30 && made.size() < 3u; ++tick)
	{
		game.Tick();
		made = Named(game, "AmericaInfantryRanger");
	}
	made.erase(std::remove(made.begin(), made.end(), placed), made.end());
	BOOST_TEST_REQUIRE(made.size() == 2u);
	for (const ecs::Entity ranger : made)
	{
		const auto *slots = world.Get<gp::WeaponSlots>(ranger);
		BOOST_TEST((slots == nullptr || slots->locked == gp::WeaponSlots::Unlocked));
	}
}

// VeterancyGainCreate::onCreate (StartingLevel VETERAN, ScienceRequired SCIENCE_TechnicalTraining): a Technical is
// made a veteran only when its player knows Technical Training.
BOOST_AUTO_TEST_CASE(legacy_parity_technical_training_makes_technicals_veterans)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const std::uint32_t gla = *game.Teams().FindPlayer("player1");
	const ecs::Entity green = game.Place("GLAVehicleTechnical", match->At(0, -200), {}, match->Team(game, 1));
	BOOST_TEST(world.Get<engine::gameplay::Experience>(green)->level == 0u);
	const auto science = shell.game.Science("SCIENCE_TechnicalTraining");
	BOOST_TEST_REQUIRE(science.has_value());
	world.Resource<engine::gameplay::PlayerSciences>().Grant(gla, *science);
	const ecs::Entity trained = game.Place("GLAVehicleTechnical", match->At(40, -200), {}, match->Team(game, 1));
	BOOST_TEST(world.Get<engine::gameplay::Experience>(trained)->level == 1u);
}

// GrantUpgradeCreate (UpgradeToGrant Upgrade_AmericaRadar, an OBJECT upgrade) on a command centre made complete, then
// RadarUpgrade -> RadarUpdate::extendRadar (RadarExtendTime 4000 ms: 120 frames): RADAR_EXTENDING from the upgrade
// pass (the tick after it is made; the original's upgrade modules run within the frame) until the tick after it is
// done (getFrame() > m_extendDoneFrame), then RADAR_UPGRADED.
BOOST_AUTO_TEST_CASE(legacy_parity_a_command_centre_raises_its_radar)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const ecs::Entity center = game.Place("AmericaCommandCenter", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(center));
	const auto shows = [&](const char *condition) { return world.Get<engine::gameplay::Appearance>(center)->Test(content::ModelConditionBit(condition)); };
	BOOST_TEST(!shows("RADAR_EXTENDING"));
	game.Tick();
	const std::uint64_t upgraded = game.CurrentTick();
	BOOST_TEST(shows("RADAR_EXTENDING"));
	BOOST_TEST(!shows("RADAR_UPGRADED"));
	while (game.CurrentTick() < upgraded + 120)
		game.Tick();
	BOOST_TEST(shows("RADAR_EXTENDING"));
	game.Tick();
	BOOST_TEST(!shows("RADAR_EXTENDING"));
	BOOST_TEST(shows("RADAR_UPGRADED"));
}

// PowerPlantUpgrade (Upgrade_AmericaAdvancedControlRods) -> PowerPlantUpdate::extendRods (RodsExtendTime 600 ms:
// 18 frames): POWER_PLANT_UPGRADING from the upgrade pass until its wake frame 18 ticks on, then POWER_PLANT_UPGRADED.
BOOST_AUTO_TEST_CASE(legacy_parity_a_power_plant_extends_its_control_rods)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const ecs::Entity plant = game.Place("AmericaPowerPlant", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(plant));
	const auto shows = [&](const char *condition) { return world.Get<engine::gameplay::Appearance>(plant)->Test(content::ModelConditionBit(condition)); };
	game.Tick();
	BOOST_TEST(!shows("POWER_PLANT_UPGRADING"));
	auto *upgradable = world.Get<engine::gameplay::Upgradable>(plant);
	BOOST_TEST_REQUIRE(upgradable != nullptr);
	upgradable->completed.Set(*shell.game.upgrades.Find("Upgrade_AmericaAdvancedControlRods"));
	upgradable->stale = 1;
	game.Tick();
	const std::uint64_t upgraded = game.CurrentTick();
	BOOST_TEST(shows("POWER_PLANT_UPGRADING"));
	while (game.CurrentTick() < upgraded + 17)
		game.Tick();
	BOOST_TEST(shows("POWER_PLANT_UPGRADING"));
	game.Tick();
	BOOST_TEST(!shows("POWER_PLANT_UPGRADING"));
	BOOST_TEST(shows("POWER_PLANT_UPGRADED"));
}

// BaseRegenerateUpdate with GameData's BaseRegenHealthPercentPerSecond 0.3% and BaseRegenDelay 3000 ms (90 frames):
// damaged on tick d, a power plant heals nothing until tick d + 90 (onDamage: wake after the delay), then
// 3 * max * 0.003 / 30 every 3 ticks (HEAL_RATE) until whole.
BOOST_AUTO_TEST_CASE(legacy_parity_a_damaged_building_regenerates_after_a_quiet_spell)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const ecs::Entity plant = game.Place("AmericaPowerPlant", match->At(300, 300), {}, match->Team(game, 0));
	game.Tick();
	auto *health = world.Get<engine::gameplay::Health>(plant);
	const Engine::Math::Fixed maximum = health->maximum;
	const Engine::Math::Fixed half = maximum / Engine::Math::Fixed::FromInt(2);
	health->current = half;
	health->lastDamageTick = game.CurrentTick();
	const std::uint64_t damaged = game.CurrentTick();
	while (game.CurrentTick() < damaged + 89)
		game.Tick();
	BOOST_TEST((world.Get<engine::gameplay::Health>(plant)->current == half));
	game.Tick(); // d + 90
	const Engine::Math::Fixed step = Engine::Math::Fixed::FromInt(3) * maximum * Engine::Math::Fixed::FromRatio(3, 1000) / Engine::Math::Fixed::FromInt(30);
	BOOST_TEST((world.Get<engine::gameplay::Health>(plant)->current == half + step));
	game.Tick();
	game.Tick();
	BOOST_TEST((world.Get<engine::gameplay::Health>(plant)->current == half + step));
	game.Tick(); // d + 93
	BOOST_TEST((world.Get<engine::gameplay::Health>(plant)->current == half + step + step));
}

// SpawnBehavior on a China supply centre (SpawnNumber 1, SpawnTemplateName ChinaVehicleSupplyTruck, OneShot): on its
// first update (tick 1: frame 1 > slot 0) one free truck comes out of it (SupplyCenterProductionExitUpdate: its
// create point, on to its rally point) wanting to harvest; never another, even once that one is lost.
BOOST_AUTO_TEST_CASE(legacy_parity_a_supply_centre_makes_one_free_truck)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const std::size_t before = Named(game, "ChinaVehicleSupplyTruck").size();
	game.Place("ChinaSupplyCenter", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST(Named(game, "ChinaVehicleSupplyTruck").size() == before);
	game.Tick();
	const auto trucks = Named(game, "ChinaVehicleSupplyTruck");
	BOOST_TEST_REQUIRE(trucks.size() == before + 1);
	BOOST_TEST(world.Get<engine::gameplay::Harvester>(trucks.back())->forceWanting);
	world.Destroy(trucks.back());
	for (int tick = 0; tick < 300; ++tick)
		game.Tick();
	BOOST_TEST(Named(game, "ChinaVehicleSupplyTruck").size() == before);
}

// SpawnBehavior on an angry mob nexus (SpawnNumber 10, ExitByBudding, AggregateHealth) through its
// QueueProductionExitUpdate (InitialBurst 5, ExitDelay 5000): on its first update five come out (the exit's burst; the
// rest one by one later), each on the one nearest the nexus (the first on the nexus); the nexus's health is theirs over
// a whole mob of ten at their average most (computeAggregateStates: five of ten, half of it; three, three tenths); once
// the last is lost it goes (onSpawnDeath: destroyObject). It is no target (MASKED), and it and its members share the
// highest veterancy among them.
BOOST_AUTO_TEST_CASE(legacy_parity_an_angry_mob_buds_and_lives_in_its_members)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const ecs::Entity nexus = game.Place("GLAInfantryAngryMobNexus", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(nexus));
	game.Tick();
	const auto *spawner = world.Get<engine::gameplay::Spawner>(nexus);
	BOOST_TEST_REQUIRE(spawner != nullptr);
	BOOST_TEST(spawner->spawnedCount == 5u);
	const auto where = game.TransformOf(nexus)->position.XY();
	for (std::size_t index = 0; index < spawner->spawnedCount; ++index)
		BOOST_TEST((Engine::Math::Distance(game.TransformOf(spawner->spawned[index])->position.XY(), where) < Engine::Math::Fixed::FromInt(60)));
	game.Tick();
	const auto maximum = world.Get<engine::gameplay::Health>(nexus)->maximum;
	BOOST_TEST(std::abs(world.Get<engine::gameplay::Health>(nexus)->current.Raw() - (maximum / Engine::Math::Fixed::FromInt(2)).Raw()) <= 16);
	const std::vector<ecs::Entity> members(spawner->spawned.begin(), spawner->spawned.begin() + spawner->spawnedCount);
	// OBJECT_STATUS_MASKED: no target for anyone's weapons.
	BOOST_TEST((world.Get<engine::gameplay::Targetable>(nexus)->classes & engine::gameplay::target_class::Unattackable) != 0u);
	// One member made elite: the nexus rises to it, and the rest to the nexus.
	world.Get<engine::gameplay::Experience>(members[3])->level = 2;
	game.Tick();
	BOOST_TEST(world.Get<engine::gameplay::Experience>(nexus)->level == 2u);
	BOOST_TEST(world.Get<engine::gameplay::Experience>(members[0])->level == 0u); // before it in the list: next update
	BOOST_TEST(world.Get<engine::gameplay::Experience>(members[4])->level == 2u);
	game.Tick();
	for (const ecs::Entity member : members)
		BOOST_TEST(world.Get<engine::gameplay::Experience>(member)->level == 2u);
	for (std::size_t index = 0; index < 2; ++index)
		world.Destroy(members[index]);
	game.Tick();
	const auto three = world.Get<engine::gameplay::Health>(nexus)->current;
	const auto most = world.Get<engine::gameplay::Health>(nexus)->maximum; // grown with its veterancy
	// Within 1/256: the fixed-point average most times ten against tenths rounds apart (the original's floats too).
	BOOST_TEST(std::abs(three.Raw() - (most * Engine::Math::Fixed::FromInt(3) / Engine::Math::Fixed::FromInt(10)).Raw()) <= 256);
	for (std::size_t index = 2; index < members.size(); ++index)
		world.Destroy(members[index]);
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	BOOST_TEST(!world.IsAlive(nexus));
}

// AIAttackApproachTargetState::update (EA GeneralsMD/Code/GameEngine/Source/GameLogic/AI/AIStates.cpp): on its first
// approach (m_isInitialApproach) a unit whose current weapon is on a turret (getWhichTurretForCurWeapon) gives that
// turret a temporary target, getNextMoodTarget(true, false) (on its mood timer; a human player's unit only at what its
// weapons reach), and the turret's FIRE state shoots at it while the unit drives on at its own victim; in reach of the
// victim the approach is over (onExit) and the turret is back on it. A Crusader ordered at a Scorpion 700 away passes a
// Technical 100 off its way: the tick its mood check is due the turret takes the Technical, which it hits while still
// closing on the Scorpion. A Tomahawk (AutoAcquireEnemiesWhenIdle No NotWhileAttacking: getNextMoodTarget returns none
// while isAttacking) gives its turret nothing on the way.
BOOST_AUTO_TEST_CASE(legacy_parity_a_turret_takes_a_temporary_target_on_the_first_approach)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace gp = engine::gameplay;
	struct Run
	{
		std::uint64_t firstTemporary{0};
		std::uint64_t dueBefore{0};
		ecs::Entity temporary;
		bool hitOnTheWay{false};
		bool approached{false};
		bool turret{false};
	};
	const auto run = [&](const char *unit, int victimX, int bystanderX, int ticks) {
		Run out;
		session::Session game(match->skirmish.level, shell.game, match->Options(1));
		auto &world = game.World();
		// Westward over the land by the start (east of it the ground ends in a cliff over the sea).
		const ecs::Entity tank = game.Place(unit, match->At(400, -200), {}, match->Team(game, 0));
		const ecs::Entity victim = game.Place("GLATankScorpion", match->At(400 - victimX, -200), {}, match->Team(game, 1));
		const ecs::Entity bystander = game.Place("GLAVehicleTechnical", match->At(400 - bystanderX, -140), {}, match->Team(game, 1));
		for (const ecs::Entity enemy : {victim, bystander})
		{
			auto &health = *world.Get<gp::Health>(enemy);
			health.maximum = health.current = Fixed::FromInt(100000);
			world.Get<gp::Armament>(enemy)->weapon = gp::WeaponCatalog::None;
		}
		game.Tick();
		out.turret = world.Get<gp::Armament>(tank)->turret;
		gameplay::OrderAttack(game.Game(), tank, victim);
		for (int tick = 0; tick < ticks; ++tick)
		{
			const std::uint64_t due = world.Get<gp::Aggression>(tank)->nextScan;
			game.Tick();
			const gp::AttackTarget &attack = *world.Get<gp::AttackTarget>(tank);
			if (attack.temporary != ecs::Entity{} && out.firstTemporary == 0)
			{
				out.firstTemporary = game.CurrentTick();
				out.dueBefore = due;
				out.temporary = attack.temporary;
				BOOST_TEST(attack.temporaryTick == game.CurrentTick());
				BOOST_TEST((attack.target == victim)); // its own attack goes on
			}
			if (attack.approached == 0 && attack.target == victim && world.Get<gp::Health>(bystander)->current < Fixed::FromInt(100000))
				out.hitOnTheWay = true;
			if (attack.approached != 0)
			{
				out.approached = true;
				BOOST_TEST((attack.temporary == ecs::Entity{}));
				break;
			}
		}
		if (out.temporary != ecs::Entity{})
			BOOST_TEST((out.temporary == bystander));
		return out;
	};
	const Run crusader = run("AmericaTankCrusader", 700, 80, 900);
	BOOST_TEST_REQUIRE(crusader.turret);
	BOOST_TEST_REQUIRE(crusader.firstTemporary != 0u);
	BOOST_TEST(crusader.firstTemporary >= crusader.dueBefore); // on its mood timer
	BOOST_TEST(crusader.hitOnTheWay);
	BOOST_TEST(crusader.approached);
	const Run tomahawk = run("AmericaVehicleTomahawk", 800, 160, 200);
	BOOST_TEST_REQUIRE(tomahawk.turret);
	BOOST_TEST(tomahawk.firstTemporary == 0u);
	BOOST_TEST(!tomahawk.hitOnTheWay);
}

// SpawnBehavior::createSpawn (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Behavior/SpawnBehavior.cpp): each new
// spawn is made from the template m_templateNameIterator points at, which then moves on through the module's
// SpawnTemplateName list (all of it: the angry mob nexus lists seven, Molotov02 twice) and loops back to its start.
// A mob of ten: Pistol01 Rock02 Molotov02 Pistol03 Rock04 Molotov02 Pistol05, then Pistol01 Rock02 Molotov02 again.
BOOST_AUTO_TEST_CASE(legacy_parity_an_angry_mob_takes_all_its_spawn_templates_in_turn)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const ecs::Entity nexus = game.Place("GLAInfantryAngryMobNexus", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(nexus));
	BOOST_TEST(world.Get<engine::gameplay::Spawner>(nexus)->templateCount == 7u);
	for (int tick = 0; tick < 1500 && world.Get<engine::gameplay::Spawner>(nexus)->spawnedCount < 10; ++tick)
		game.Tick();
	const auto *spawner = world.Get<engine::gameplay::Spawner>(nexus);
	BOOST_TEST_REQUIRE(spawner->spawnedCount == 10u);
	std::vector<std::string> made;
	for (std::size_t index = 0; index < spawner->spawnedCount; ++index)
		made.push_back(game.Game().templates.DefinitionAt(world.Get<engine::gameplay::DefinitionRef>(spawner->spawned[index])->index).name);
	const std::vector<std::string> expected{"GLAInfantryAngryMobPistol01", "GLAInfantryAngryMobRock02", "GLAInfantryAngryMobMolotov02",
		"GLAInfantryAngryMobPistol03", "GLAInfantryAngryMobRock04", "GLAInfantryAngryMobMolotov02", "GLAInfantryAngryMobPistol05",
		"GLAInfantryAngryMobPistol01", "GLAInfantryAngryMobRock02", "GLAInfantryAngryMobMolotov02"};
	BOOST_TEST((made == expected));
}

// SpawnBehavior::createSpawn's m_initialBurstCountdown (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Behavior/
// SpawnBehavior.cpp; set to InitialBurst in the constructor): an angry mob nexus made by a GLA Barracks (getProducerID, a
// STRUCTURE with an exit) sends its first InitialBurst (5) spawns out of the barracks' door (exitObjectViaDoor:
// DefaultProductionExitUpdate::exitObjectViaDoor, at UnitCreatePoint 0,0 on the ground facing the barracks' way, out to
// NaturalRallyPoint 42,0 through the barracks), each spawn still the nexus's (setProducer(parent)); the countdown spent,
// the sixth (after the nexus exit's 5 s ExitDelay) buds off the member nearest the nexus as usual.
BOOST_AUTO_TEST_CASE(legacy_parity_a_produced_mobs_first_spawns_leave_through_its_barracks)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity barracks = game.Place("GLABarracks", match->At(300, 300), {}, match->Team(game, 1));
	const ecs::Entity nexus = game.Place("GLAInfantryAngryMobNexus", match->At(300, 450), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(barracks));
	BOOST_TEST_REQUIRE(world.IsAlive(nexus));
	BOOST_TEST_REQUIRE(world.Get<gp::Spawner>(nexus) != nullptr);
	BOOST_TEST(world.Get<gp::Spawner>(nexus)->initialBurstLeft == 5u);
	// ProductionUpdate: the nexus's producer is the barracks.
	if (!world.Has<gp::Producer>(nexus))
		world.Add<gp::Producer>(nexus);
	world.Get<gp::Producer>(nexus)->entity = barracks;
	game.Tick();
	const auto *spawner = world.Get<gp::Spawner>(nexus);
	BOOST_TEST_REQUIRE(spawner->spawnedCount == 5u);
	BOOST_TEST(spawner->initialBurstLeft == 0u);
	const auto door = game.TransformOf(barracks)->position.XY(); // UnitCreatePoint 0,0
	for (std::size_t index = 0; index < spawner->spawnedCount; ++index)
	{
		const ecs::Entity member = spawner->spawned[index];
		// Within 2 units: made at the door this tick, they may have taken their first step out (infantry speed < 2/frame).
		BOOST_TEST((Engine::Math::Distance(game.TransformOf(member)->position.XY(), door) <= Engine::Math::Fixed::FromInt(2)));
		BOOST_TEST((world.Get<gp::Producer>(member)->entity == nexus));
		BOOST_TEST((world.Get<gp::IgnoredObstacle>(member)->obstacle == barracks));
	}
	// The sixth: budded off the member nearest the nexus, not out of the barracks.
	std::vector<Engine::Math::FixedVector2> before;
	for (int tick = 0; tick < 400 && world.Get<gp::Spawner>(nexus)->spawnedCount < 6; ++tick)
	{
		before.clear();
		for (std::size_t index = 0; index < world.Get<gp::Spawner>(nexus)->spawnedCount; ++index)
			before.push_back(game.TransformOf(world.Get<gp::Spawner>(nexus)->spawned[index])->position.XY());
		game.Tick();
	}
	spawner = world.Get<gp::Spawner>(nexus);
	BOOST_TEST_REQUIRE(spawner->spawnedCount == 6u);
	BOOST_TEST(spawner->initialBurstLeft == 0u);
	const auto sixth = game.TransformOf(spawner->spawned[5])->position.XY();
	Engine::Math::Fixed nearest = Engine::Math::Fixed::FromInt(100000);
	for (const auto &host : before)
		nearest = (std::min)(nearest, Engine::Math::Distance(sixth, host));
	BOOST_TEST((nearest <= Engine::Math::Fixed::FromInt(4))); // its host's place a tick before, plus a step each
	BOOST_TEST((Engine::Math::Distance(sixth, door) > Engine::Math::Fixed::FromInt(30)));
}

// GarrisonContain on a civilian apartment (ContainMax 10): three rangers who go in make it their player's
// (recalcApparentControllingPlayer: their default team) and it shows GARRISONED; inside they have
// WEAPONBONUSCONDITION_GARRISONED. Really damaged (onBodyDamageStateChange), it sends them all out and takes nobody
// in (isValidContainerFor); empty, it is the civilians' again and they lose the bonus.
BOOST_AUTO_TEST_CASE(legacy_parity_rangers_garrison_a_building_and_leave_it_really_damaged)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity building = game.Place("AsianApartment01", match->At(300, 300), {}, 0);
	BOOST_TEST_REQUIRE(world.IsAlive(building));
	BOOST_TEST_REQUIRE(world.Get<gp::Garrison>(building) != nullptr);
	const std::uint32_t original = world.Get<gp::TeamMember>(building)->team;
	const std::uint32_t america = *game.Teams().FindPlayer("player0");
	std::vector<ecs::Entity> rangers;
	for (int index = 0; index < 3; ++index)
	{
		const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(260 + index * 10, 230), {}, match->Team(game, 0));
		world.Add<gp::Boarding>(ranger);
		*world.Get<gp::Boarding>(ranger) = {building};
		rangers.push_back(ranger);
	}
	const auto &manifest = world.Resource<gp::CargoManifest>();
	for (int tick = 0; tick < 900 && manifest.Count(building) < 3u; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(manifest.Count(building) == 3u);
	game.Tick();
	BOOST_TEST(world.Get<gp::Owner>(building)->player == america);
	BOOST_TEST(world.Get<gp::Appearance>(building)->Test(content::ModelConditionBit("GARRISONED")));
	// evaluateSkirmishPlayerHasComparisonGarrisoned: America's one garrison with anyone inside.
	BOOST_TEST(gameplay::CountGarrisonedBuildings(game.Game(), america) == 1);
	for (const ecs::Entity ranger : rangers)
		BOOST_TEST((world.Get<gp::WeaponBonusConditions>(ranger)->flags & content::weapon_bonus::Garrisoned) != 0u);
	// Damaged (70% or less: findConditionIndex), its occupants shoot from the damaged model's fire points.
	BOOST_TEST(world.Get<gp::GarrisonPoints>(building)->condition == gp::garrison_condition::Pristine);
	auto *health = world.Get<gp::Health>(building);
	health->current = health->maximum * Engine::Math::Fixed::FromRatio(6, 10);
	game.Tick();
	BOOST_TEST(world.Get<gp::GarrisonPoints>(building)->condition == gp::garrison_condition::Damaged);
	BOOST_TEST(manifest.Count(building) == 3u);
	// Really damaged: out they come, and nobody gets back in.
	health->current = health->maximum * Engine::Math::Fixed::FromRatio(3, 10);
	for (int tick = 0; tick < 600 && manifest.Count(building) > 0u; ++tick)
		game.Tick();
	game.Tick();
	BOOST_TEST(manifest.Count(building) == 0u);
	BOOST_TEST(gameplay::CountGarrisonedBuildings(game.Game(), america) == 0);
	BOOST_TEST(world.Get<gp::Transport>(building)->closed);
	BOOST_TEST(world.Get<gp::TeamMember>(building)->team == original);
	BOOST_TEST(!world.Get<gp::Appearance>(building)->Test(content::ModelConditionBit("GARRISONED")));
	for (const ecs::Entity ranger : rangers)
		BOOST_TEST((world.Get<gp::WeaponBonusConditions>(ranger)->flags & content::weapon_bonus::Garrisoned) == 0u);
	world.Add<gp::Boarding>(rangers[0]);
	*world.Get<gp::Boarding>(rangers[0]) = {building};
	for (int tick = 0; tick < 200; ++tick)
		game.Tick();
	BOOST_TEST(manifest.Count(building) == 0u);
}

// The control bar's EVACUATE (MSG_EVACUATE -> GameLogic::onEvacuate -> AIGroup::groupEvacuate, CMD_FROM_PLAYER): a
// garrisoned apartment (a STRUCTURE with no AI) of the player's orders all its riders out (orderAllPassengersToExit);
// another player's order is ignored.
BOOST_AUTO_TEST_CASE(legacy_parity_a_players_evacuate_empties_its_building)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity building = game.Place("AsianApartment01", match->At(300, 300), {}, 0);
	BOOST_TEST_REQUIRE(world.IsAlive(building));
	for (int index = 0; index < 2; ++index)
	{
		const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(260 + index * 10, 230), {}, match->Team(game, 0));
		world.Add<gp::Boarding>(ranger);
		*world.Get<gp::Boarding>(ranger) = {building};
	}
	const auto &manifest = world.Resource<gp::CargoManifest>();
	for (int tick = 0; tick < 900 && manifest.Count(building) < 2u; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(manifest.Count(building) == 2u);
	const auto order = [&](commands::GameCommand command, std::uint32_t seat) {
		std::vector<engine::net::CommandEnvelope> envelopes{std::visit([](const auto &c) { return commands::Encode(c); }, command)};
		envelopes.front().player = seat;
		game.Tick(std::span(envelopes));
	};
	order(commands::Evacuate{{building}}, 1); // not this seat's
	for (int tick = 0; tick < 60; ++tick)
		game.Tick();
	BOOST_TEST(manifest.Count(building) == 2u);
	order(commands::Evacuate{{building}}, 0);
	for (int tick = 0; tick < 300 && manifest.Count(building) > 0u; ++tick)
		game.Tick();
	BOOST_TEST(manifest.Count(building) == 0u);
}

// OpenContain::onContaining / onRemoving (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Contain/OpenContain.cpp):
// each ranger going into the apartment is one rider in (heard as the building's SoundEnter), and each sent out as it
// is really damaged one rider out (its SoundExit, and the ranger's SoundFallingFromPlane), each on the tick it happens,
// with the building's and the ranger's definitions and places.
BOOST_AUTO_TEST_CASE(legacy_parity_riders_in_and_out_are_heard_on_their_tick)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity building = game.Place("AsianApartment01", match->At(300, 300), {}, 0);
	BOOST_TEST_REQUIRE(world.IsAlive(building));
	const std::uint32_t apartment = world.Get<gp::DefinitionRef>(building)->index;
	std::uint32_t ranger = 0;
	for (int index = 0; index < 3; ++index)
	{
		const ecs::Entity unit = game.Place("AmericaInfantryRanger", match->At(260 + index * 10, 230), {}, match->Team(game, 0));
		ranger = world.Get<gp::DefinitionRef>(unit)->index;
		world.Add<gp::Boarding>(unit);
		*world.Get<gp::Boarding>(unit) = {building};
	}
	const auto &manifest = world.Resource<gp::CargoManifest>();
	std::size_t in = 0, out = 0;
	for (int tick = 0; tick < 900 && manifest.Count(building) < 3u; ++tick)
	{
		const std::size_t before = manifest.Count(building);
		game.Tick();
		const auto moves = game.CargoMoves();
		BOOST_TEST(moves.size() == manifest.Count(building) - before); // only this tick's
		for (const session::CargoMove &move : moves)
		{
			BOOST_TEST(move.entered);
			BOOST_TEST(move.hasContainer);
			BOOST_TEST(move.containerDefinition == apartment);
			BOOST_TEST(move.riderDefinition == ranger);
			BOOST_TEST((move.containerAt == world.Get<gp::Transform>(building)->position));
			++in;
		}
	}
	BOOST_TEST(in == 3u);
	auto *health = world.Get<gp::Health>(building);
	health->current = health->maximum * Engine::Math::Fixed::FromRatio(3, 10);
	for (int tick = 0; tick < 600 && manifest.Count(building) > 0u; ++tick)
	{
		game.Tick();
		for (const session::CargoMove &move : game.CargoMoves())
		{
			BOOST_TEST(!move.entered);
			BOOST_TEST(move.containerDefinition == apartment);
			BOOST_TEST(move.hasRider);
			BOOST_TEST(move.riderDefinition == ranger);
			++out;
		}
	}
	BOOST_TEST(out == 3u);
	game.Tick();
	BOOST_TEST(game.CargoMoves().empty());
}

// JetAIUpdate's findSuitableAirfield (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Update/AIUpdate/JetAIUpdate.cpp):
// a MiG out of ammo with no airfield takes the nearest allied one with room, passing over one still under construction
// (OBJECT_STATUS_UNDER_CONSTRUCTION) or being sold (OBJECT_STATUS_SOLD).
BOOST_AUTO_TEST_CASE(legacy_parity_a_homeless_jet_takes_the_nearest_finished_airfield)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity nearest = game.Place("ChinaAirfield", match->At(300, 300), {}, team);
	const ecs::Entity farther = game.Place("ChinaAirfield", match->At(700, 300), {}, team);
	const ecs::Entity mig = game.Place("ChinaJetMIG", match->At(250, 250), {}, team);
	BOOST_TEST_REQUIRE((world.IsAlive(nearest) && world.IsAlive(farther) && world.IsAlive(mig)));
	BOOST_TEST_REQUIRE(world.Get<gp::Airfield>(nearest) != nullptr);
	world.Add<gp::UnderConstruction>(nearest);
	world.Get<gp::Armament>(mig)->readyTick = gp::OutOfAmmo;
	game.Tick();
	BOOST_TEST((world.Get<gp::Jet>(mig)->airfield == farther));
	// Finished, but being sold: passed over too.
	world.Remove<gp::UnderConstruction>(nearest);
	world.Add<gp::Sale>(nearest);
	const ecs::Entity other = game.Place("ChinaJetMIG", match->At(250, 260), {}, team);
	world.Get<gp::Armament>(other)->readyTick = gp::OutOfAmmo;
	game.Tick();
	BOOST_TEST((world.Get<gp::Jet>(other)->airfield == farther));
	// Left alone, it is the nearest.
	world.Remove<gp::Sale>(nearest);
	const ecs::Entity third = game.Place("ChinaJetMIG", match->At(250, 270), {}, team);
	world.Get<gp::Armament>(third)->readyTick = gp::OutOfAmmo;
	game.Tick();
	BOOST_TEST((world.Get<gp::Jet>(third)->airfield == nearest));
}

// ScriptActions::doTeamGarrisonNearestBuilding: from the first member, garrisons nearest first, each filled with the
// team's infantry in team order (a Humvee is passed over): the nearer (room made 2) takes the first two rangers, the
// farther the rest.
BOOST_AUTO_TEST_CASE(legacy_parity_a_team_garrisons_the_nearest_buildings_in_order)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity nearer = game.Place("AsianApartment01", match->At(300, 250), {}, 0);
	const ecs::Entity farther = game.Place("AsianApartment01", match->At(300, 500), {}, 0);
	world.Get<gp::Transport>(nearer)->definition.slots = 2;
	const std::uint32_t team = match->Team(game, 0);
	std::vector<ecs::Entity> members;
	members.push_back(game.Place("AmericaInfantryRanger", match->At(200, 200), {}, team));
	members.push_back(game.Place("AmericaVehicleHumvee", match->At(180, 200), {}, team));
	for (int index = 0; index < 3; ++index)
		members.push_back(game.Place("AmericaInfantryRanger", match->At(200 + index * 10, 180), {}, team));
	generalszh::gameplay::GarrisonNearest(game.Game(), members);
	const auto boarding = [&](ecs::Entity unit) {
		const auto *board = world.Get<gp::Boarding>(unit);
		return board != nullptr ? board->transport : ecs::Entity{};
	};
	BOOST_TEST((boarding(members[0]) == nearer));
	BOOST_TEST((boarding(members[1]) == ecs::Entity{})); // not infantry
	BOOST_TEST((boarding(members[2]) == nearer));
	BOOST_TEST((boarding(members[3]) == farther));
	BOOST_TEST((boarding(members[4]) == farther));
}

// GarrisonContain::onObjectCreated (InitialRoster = GLAInfantryTerrorist 10): a caboose full of terrorists has its ten
// inside, made on its team, from its first tending; they may fire out (isPassengerAllowedToFire), but not while the
// caboose is subdued.
BOOST_AUTO_TEST_CASE(legacy_parity_a_caboose_comes_full_of_terrorists)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity caboose = game.Place("CabooseFullOfTerrorists", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(caboose));
	game.Tick();
	const auto &manifest = world.Resource<gp::CargoManifest>();
	BOOST_TEST_REQUIRE(manifest.Count(caboose) == 10u);
	for (const ecs::Entity terrorist : manifest.Aboard(caboose))
	{
		BOOST_TEST(game.DefinitionName(world.Get<gp::DefinitionRef>(terrorist)->index) == "GLAInfantryTerrorist");
		BOOST_TEST(world.Get<gp::TeamMember>(terrorist)->team == match->Team(game, 1));
		BOOST_TEST(world.Get<gp::OffMap>(terrorist)->armed);
	}
	if (!world.Has<gp::Disabled>(caboose))
		world.Add<gp::Disabled>(caboose);
	world.Get<gp::Disabled>(caboose)->mask |= gp::disabled_type::Subdued;
	game.Tick();
	for (const ecs::Entity terrorist : manifest.Aboard(caboose))
		BOOST_TEST(!world.Get<gp::OffMap>(terrorist)->armed);
}

// GarrisonContain::onObjectCreated (parseInitialRoster: a name, then a count): a caboose's InitialRoster
// (GLAInfantryTerrorist 10) is made as the caboose is (TheThingFactory->newObject), on its controlling player's default
// team, and put inside (isValidContainerFor, addToContain): ten aboard before any tick. TrainCar04's (GLAInfantryTerrorist
// 0): none. Its MobileGarrison (moveObjectsWithMe; the shipped mobile garrisons all set it) keeps them where it is as it
// moves.
BOOST_AUTO_TEST_CASE(legacy_parity_an_initial_roster_is_made_with_its_garrison_and_moves_with_it)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const auto &manifest = world.Resource<gp::CargoManifest>();
	const ecs::Entity caboose = game.Place("CabooseFullOfTerrorists", match->At(300, 300), {}, match->Team(game, 1));
	const ecs::Entity car = game.Place("TrainCar04", match->At(300, 400), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE((world.IsAlive(caboose) && world.IsAlive(car)));
	BOOST_TEST_REQUIRE(manifest.Count(caboose) == 10u);
	BOOST_TEST(manifest.Count(car) == 0u);
	const std::uint32_t gla = world.Get<gp::Owner>(caboose)->player;
	const auto team = game.Teams().DefaultTeam(gla);
	BOOST_TEST_REQUIRE(team.has_value());
	for (const ecs::Entity terrorist : manifest.Aboard(caboose))
		BOOST_TEST(world.Get<gp::TeamMember>(terrorist)->team == *team);
	world.Get<gp::Transform>(caboose)->position.x += Fixed::FromInt(50);
	game.Tick();
	const auto at = world.Get<gp::Transform>(caboose)->position;
	for (const ecs::Entity terrorist : manifest.Aboard(caboose))
		BOOST_TEST((world.Get<gp::Transform>(terrorist)->position.XY() == at.XY()));
}

// A fire base (GarrisonContain IsEnclosingContainer No, ContainMax 4) does not enclose its occupants
// (isEnclosingContainerFor false): OpenContain::addToContain leaves them in the world (in the partition, drawn), so they
// may be attacked there (WeaponSet::getAbleToAttackSpecificObject only refuses an enclosed victim); each stands at its
// station (loadStationGarrisonPoints: the STATION bones of its GARRISONED model, at most ContainMax), given in order of
// entry (redeployOccupants then positionObjectsAtStationGarrisonPoints / pickAStationForMe).
BOOST_AUTO_TEST_CASE(legacy_parity_a_fire_base_keeps_its_occupants_at_its_stations)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const auto &manifest = world.Resource<gp::CargoManifest>();
	const ecs::Entity base = game.Place("AmericaFireBase", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(base));
	const auto *stations = world.Get<gp::GarrisonStations>(base);
	BOOST_TEST_REQUIRE(stations != nullptr);
	BOOST_TEST_MESSAGE("fire base stations: " << stations->count);
	BOOST_TEST(stations->count >= 2u);
	BOOST_TEST(stations->count <= 4u);
	std::vector<ecs::Entity> rangers;
	for (int index = 0; index < 2; ++index)
	{
		const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(260 + index * 10, 230), {}, match->Team(game, 0));
		world.Add<gp::Boarding>(ranger);
		*world.Get<gp::Boarding>(ranger) = {base};
		rangers.push_back(ranger);
	}
	for (int tick = 0; tick < 900 && manifest.Count(base) < 2u; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(manifest.Count(base) == 2u);
	game.Tick();
	game.Tick();
	stations = world.Get<gp::GarrisonStations>(base);
	const gp::Transform frame = *world.Get<gp::Transform>(base);
	const auto aboard = manifest.Aboard(base);
	for (std::size_t index = 0; index < aboard.size(); ++index)
	{
		const ecs::Entity ranger = aboard[index];
		BOOST_TEST(world.Get<gp::OffMap>(ranger)->reason == gp::off_map_reason::Stationed);
		BOOST_TEST((stations->occupants[index] == ranger));
		BOOST_TEST((world.Get<gp::Transform>(ranger)->position == gp::StationPosition(*stations, index, frame)));
		BOOST_TEST(world.Resource<gp::SpatialIndex>().Find(ranger) != nullptr);
		// Object::look: in a garrisonable container it still looks, from where it stands (its partition cell: its station).
		auto &shroud = world.Resource<gp::ShroudMap>();
		const gp::Looker *looker = shroud.LookerAt(world.Get<gp::Vision>(ranger)->slot);
		BOOST_TEST_REQUIRE(looker != nullptr);
		const auto cell = shroud.CellOf(world.Get<gp::Transform>(ranger)->position.x, world.Get<gp::Transform>(ranger)->position.y);
		BOOST_TEST(looker->keyCellX == cell[0]);
		BOOST_TEST(looker->keyCellY == cell[1]);
		// In the partition, it is seen through the shroud as anything there (Object::getShroudedStatus): the GLA, far off,
		// does not see it clear (enclosed riders are clear to everyone).
		BOOST_TEST(!world.Get<gp::ObjectShroud>(ranger)->ClearTo(*game.Teams().FindPlayer("player1")));
	}
}

// ControlBar::getCommandAvailability for upgrade buttons: an OBJECT_UPGRADE the object would do nothing with
// (Object::affectedByUpgrade false: China's mines on a War Factory) is COMMAND_CANT_AFFORD like one it has, one it would
// take (the Power Plant's Advanced Control Rods) is available; an upgrade button with a Science list (the MOAB's
// SCIENCE_DaisyCutter) is restricted until every one of them is owned.
BOOST_AUTO_TEST_CASE(legacy_parity_upgrade_buttons_need_their_object_affected_and_their_sciences)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	using generalszh::gameplay::ButtonState;
	const auto &buttons = shell.game.commands.buttons;
	const ecs::Entity factory = game.Place("AmericaWarFactory", match->At(300, 300), {}, match->Team(game, 0));
	const ecs::Entity plant = game.Place("AmericaPowerPlant", match->At(500, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE((world.IsAlive(factory) && world.IsAlive(plant)));
	game.Tick();
	BOOST_TEST((generalszh::gameplay::CommandAvailability(game.Game(), factory, buttons.at("Command_UpgradeChinaMines")) == ButtonState::Done));
	BOOST_TEST((generalszh::gameplay::CommandAvailability(game.Game(), plant, buttons.at("Command_UpgradeAmericaAdvancedControlRods")) ==
		ButtonState::Available));
	const auto &moab = buttons.at("Command_UpgradeAmericaMOAB");
	BOOST_TEST((generalszh::gameplay::CommandAvailability(game.Game(), factory, moab) == ButtonState::Restricted));
	const auto daisy = shell.game.Science("SCIENCE_DaisyCutter");
	BOOST_TEST_REQUIRE(daisy.has_value());
	world.Resource<gp::PlayerSciences>().Grant(*game.Teams().FindPlayer("player0"), *daisy);
	BOOST_TEST((generalszh::gameplay::CommandAvailability(game.Game(), factory, moab) == ButtonState::Available));
}

// GUI_COMMAND_SPECIAL_POWER_CONSTRUCT (the sneak attack) through PlaceEventTranslator: the placed tunnel's power goes
// off with MSG_DO_SPECIAL_POWER_AT_LOCATION carrying the placement's angle; OCLSpecialPower::doSpecialPowerAtLocation
// makes its list there by position (ObjectCreationList::create(ocl, source, &pos, &target, angle)), so its LIKE_EXISTING
// GLASneakAttackTunnelNetworkStart faces that angle, not its command centre's way. Any other order sends INVALID_ANGLE,
// which GenericObjectCreationNugget::create takes as 0.
BOOST_AUTO_TEST_CASE(legacy_parity_a_sneak_attack_tunnel_faces_its_placement)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	const auto tunnelFacing = [&](std::optional<Engine::Math::TurnAngle> angle) -> std::optional<std::uint32_t> {
		session::Session game(match->skirmish.level, shell.game, match->Options(1));
		auto &world = game.World();
		const ecs::Entity centre = game.Place("GLACommandCenter", match->At(400, -300), Engine::Math::TurnFromDegrees(45), match->Team(game, 1));
		BOOST_TEST_REQUIRE(world.IsAlive(centre));
		game.Tick();
		const auto spot = match->At(200, -300);
		if (angle)
			gameplay::FireSpecialPower(game.Game(), centre, "SuperweaponSneakAttack", spot, true, true, 0, *angle);
		else
			gameplay::FireSpecialPower(game.Game(), centre, "SuperweaponSneakAttack", spot, true);
		for (int tick = 0; tick < 3; ++tick)
			game.Tick();
		const auto made = Named(game, "GLASneakAttackTunnelNetworkStart");
		if (made.empty())
			return std::nullopt;
		return world.Get<engine::gameplay::Transform>(made.front())->facing.units;
	};
	const auto placed = tunnelFacing(Engine::Math::TurnFromDegrees(90));
	BOOST_TEST_REQUIRE(placed.has_value());
	BOOST_TEST(*placed == Engine::Math::TurnFromDegrees(90).units);
	const auto plain = tunnelFacing(std::nullopt);
	BOOST_TEST_REQUIRE(plain.has_value());
	BOOST_TEST(*plain == 0u);
}

// Object::look: "dont look, 'cause you are in a tunnel": anything contained by a container that is not garrisonable
// (ContainModuleInterface::isGarrisonable: only GarrisonContain says yes; OverlordContain asks its redirected contain, the
// Battle Bunker's TransportContain) unlooks as it goes in (its contained-by changed: handlePartitionCellMaintenance)
// and does not look again: a Ranger in a Humvee or a Chinook, a Rebel in a tunnel network, a Red Guard in an Overlord's
// Battle Bunker, and the bunker itself on the Overlord. One in a garrisoned apartment or a fire base still looks.
BOOST_AUTO_TEST_CASE(legacy_parity_riders_look_only_from_a_garrison)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t us = match->Team(game, 0), them = match->Team(game, 1);
	const auto inside = [&](const char *container, const char *rider, int x, std::uint32_t team) {
		const ecs::Entity holder = game.Place(container, match->At(x, 300), {}, team);
		const ecs::Entity passenger = game.Place(rider, match->At(x, 260), {}, team);
		BOOST_TEST_REQUIRE((world.IsAlive(holder) && world.IsAlive(passenger)));
		gameplay::PutInside(game.Game(), holder, passenger);
		return std::pair{holder, passenger};
	};
	const auto humvee = inside("AmericaVehicleHumvee", "AmericaInfantryRanger", 0, us);
	const auto chinook = inside("AmericaVehicleChinook", "AmericaInfantryRanger", 150, us);
	const auto tunnel = inside("GLATunnelNetwork", "GLAInfantryRebel", 300, them);
	const auto apartment = inside("AsianApartment01", "AmericaInfantryRanger", 450, us);
	const auto base = inside("AmericaFireBase", "AmericaInfantryRanger", 600, us);
	const ecs::Entity overlord = game.Place("ChinaTankOverlord", match->At(750, 300), {}, us);
	const ecs::Entity bunker = game.Place("ChinaTankOverlordBattleBunker", match->At(750, 300), {}, us);
	BOOST_TEST_REQUIRE((world.IsAlive(overlord) && world.IsAlive(bunker)));
	gameplay::MountOn(game.Game(), overlord, bunker);
	const ecs::Entity guard = game.Place("ChinaInfantryRedguard", match->At(750, 260), {}, us);
	gameplay::PutInside(game.Game(), overlord, guard);
	for (int tick = 0; tick < 3; ++tick)
		game.Tick();
	auto &shroud = world.Resource<gp::ShroudMap>();
	const auto looking = [&](ecs::Entity entity) {
		const gp::Vision *vision = world.Get<gp::Vision>(entity);
		BOOST_TEST_REQUIRE(vision != nullptr);
		const gp::Looker *looker = shroud.LookerAt(vision->slot);
		return looker != nullptr && looker->entity == entity && looker->look.valid != 0;
	};
	BOOST_TEST(!looking(humvee.second));
	BOOST_TEST(!looking(chinook.second));
	BOOST_TEST(!looking(tunnel.second));
	BOOST_TEST(!looking(guard));
	BOOST_TEST(!looking(bunker));
	BOOST_TEST(looking(apartment.second));
	BOOST_TEST(looking(base.second));
	BOOST_TEST(looking(humvee.first)); // the containers themselves look
	BOOST_TEST(looking(overlord));
}

// TunnelContain / TunnelTracker: two GLA tunnels are one network of MaxTunnelCapacity (10) heads: eleven rebels sent in
// (six to one, five to the other) leave the last outside, and each tunnel counts all ten. Each tunnel standing heals
// everyone inside by max health over its TimeForFullHeal (5000 ms: 150 frames) a frame (retail heal stacking: two
// tunnels, twice that). Unloading one lets out the whole network through it. A lost tunnel hands its riders to the
// other (onTunnelDestroyed); with the last one they cave in.
BOOST_AUTO_TEST_CASE(legacy_parity_a_tunnel_network_shares_room_heals_and_caves_in)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t gla = match->Team(game, 1);
	const ecs::Entity first = game.Place("GLATunnelNetwork", match->At(300, 300), {}, gla);
	const ecs::Entity second = game.Place("GLATunnelNetwork", match->At(500, 300), {}, gla);
	BOOST_TEST_REQUIRE(world.Get<gp::Transport>(first) != nullptr);
	BOOST_TEST(world.Get<gp::Transport>(first)->definition.slots == 10u);
	std::vector<ecs::Entity> rebels;
	for (int index = 0; index < 11; ++index)
	{
		const ecs::Entity rebel = game.Place("GLAInfantryRebel", match->At(380 + (index % 4) * 10, 240 + (index / 4) * 10), {}, gla);
		world.Add<gp::Boarding>(rebel);
		*world.Get<gp::Boarding>(rebel) = {index < 6 ? first : second};
		rebels.push_back(rebel);
	}
	const auto &manifest = world.Resource<gp::CargoManifest>();
	for (int tick = 0; tick < 900; ++tick)
		game.Tick();
	BOOST_TEST(manifest.Count(first) + manifest.Count(second) == 10u);
	BOOST_TEST(world.Get<gp::Transport>(first)->occupied == 10u);
	BOOST_TEST(world.Get<gp::Transport>(second)->occupied == 10u);
	BOOST_TEST(std::count_if(rebels.begin(), rebels.end(), [&](ecs::Entity rebel) { return world.Has<gp::Passenger>(rebel); }) == 10);

	// Healing: max / 150 a frame from each of the two tunnels.
	const ecs::Entity hurt = manifest.Aboard(first).front();
	auto *body = world.Get<gp::Health>(hurt);
	world.Get<gp::Passenger>(hurt)->since = game.Game().tick; // just got in: no full heal yet
	body->current = body->maximum / Fixed::FromInt(2);
	const Fixed before = body->current;
	game.Tick();
	const Fixed step = body->maximum / Fixed::FromInt(150);
	BOOST_TEST(body->current.Raw() == (before + step + step).Raw());

	// The first lost: its riders are the second's.
	game.World().Resource<gp::KillRequests>().entities.push_back(first);
	game.Tick();
	game.Tick();
	BOOST_TEST(manifest.Count(second) == 10u);
	BOOST_TEST((world.Get<gp::Passenger>(hurt)->transport == second));
	BOOST_TEST(world.IsAlive(hurt));
	// Unloading the second lets them all out through it.
	world.Get<gp::Transport>(second)->state = gp::TransportState::Unloading;
	for (int tick = 0; tick < 300 && manifest.Count(second) > 0u; ++tick)
		game.Tick();
	BOOST_TEST(manifest.Count(second) == 0u);
	BOOST_TEST(!world.Has<gp::Passenger>(hurt));
	// Back in, and the last lost: they cave in with it.
	world.Add<gp::Boarding>(hurt);
	*world.Get<gp::Boarding>(hurt) = {second};
	for (int tick = 0; tick < 600 && manifest.Count(second) == 0u; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(manifest.Count(second) == 1u);
	game.World().Resource<gp::KillRequests>().entities.push_back(second);
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	BOOST_TEST((!world.IsAlive(hurt) || world.Has<gp::Dying>(hurt)));
}

// Issue #52, as a player plays it: tunnels a GLA worker builds (DozerAIUpdate's construction, the tunnels' TunnelContain
// running once they are finished) are one network; rebels told to enter the first (MSG_ENTER: groupEnter -> aiEnter) go
// in, and the second's evacuate (MSG_EVACUATE) lets them out of the second.
BOOST_AUTO_TEST_CASE(legacy_parity_built_tunnels_take_rebels_in_and_out_by_orders)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t team = match->Team(game, 1);
	const ecs::Entity worker = game.Place("GLAInfantryWorker", match->At(400, 250), {}, team);
	const std::uint32_t gla = world.Get<gp::Owner>(worker)->player;
	world.Resource<gp::PlayerMoney>().Deposit(gla, 100000);
	game.Tick();
	const auto finish = [&](ecs::Entity site) {
		for (int tick = 0; tick < 30 * 120 && world.IsAlive(site) && world.Has<gp::UnderConstruction>(site); ++tick)
			game.Tick();
		return world.IsAlive(site) && !world.Has<gp::UnderConstruction>(site);
	};
	const ecs::Entity first = generalszh::gameplay::BeginConstruction(game.Game(), worker, "GLATunnelNetwork", match->At(300, 300), {});
	BOOST_TEST_REQUIRE(world.IsAlive(first));
	BOOST_TEST_REQUIRE(finish(first));
	const ecs::Entity second = generalszh::gameplay::BeginConstruction(game.Game(), worker, "GLATunnelNetwork", match->At(600, 300), {});
	BOOST_TEST_REQUIRE(world.IsAlive(second));
	BOOST_TEST_REQUIRE(finish(second));
	std::vector<ecs::Entity> rebels;
	for (int index = 0; index < 3; ++index)
		rebels.push_back(game.Place("GLAInfantryRebel", match->At(380 + index * 12, 380), {}, team));
	game.Tick();
	auto enter = commands::Encode(commands::Enter{rebels, first});
	enter.player = 1; // the command's seat (player1's)
	game.Tick(std::span(&enter, 1));
	const auto &manifest = world.Resource<gp::CargoManifest>();
	for (int tick = 0; tick < 30 * 30 && manifest.Count(first) < rebels.size(); ++tick)
		game.Tick();
	// One network: in through the first, counted by both (TunnelTracker's list).
	BOOST_TEST(manifest.Count(first) == rebels.size());
	BOOST_TEST(world.Get<gp::Transport>(second)->occupied == rebels.size());
	auto out = commands::Encode(commands::Evacuate{{second}});
	out.player = 1;
	game.Tick(std::span(&out, 1));
	for (int tick = 0; tick < 30 * 30 && manifest.Count(first) + manifest.Count(second) > 0u; ++tick)
		game.Tick();
	BOOST_TEST(manifest.Count(first) + manifest.Count(second) == 0u);
	for (const ecs::Entity rebel : rebels)
	{
		BOOST_TEST(!world.Has<gp::Passenger>(rebel));
		const auto spot = world.Get<gp::Transform>(rebel)->position.XY();
		const auto exit = world.Get<gp::Transform>(second)->position.XY();
		BOOST_TEST((Engine::Math::Abs(spot.x - exit.x) < Fixed::FromInt(100) && Engine::Math::Abs(spot.y - exit.y) < Fixed::FromInt(100)));
	}
}

// Issue #54 (AIUpdateInterface::doLocomotor -> chooseGoodLocomotorFromCurrentSet; EA AIPathfind.cpp
// Pathfinder::chooseBestLocomotorForPosition / validLocomotorSurfacesForCellType; LocomotorSet::getValidSurfaces): the
// Combat Cycle's SET_NORMAL is CombatBikeGroundLocomotor then CombatBikeCliffLocomotor (Surfaces = CLIFF). It is routed
// over ground and cliff alike, moves on its cliff locomotor from the first tick it stands in a cliff cell and on its
// ground one again the first tick it is back on clear ground; its rider's set changes keep both.
BOOST_AUTO_TEST_CASE(legacy_parity_a_combat_cycle_takes_its_cliff_locomotor_on_cliffs)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity bike = game.Place("GLAVehicleCombatBike", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.Has<gp::LocomotorChoice>(bike));
	const auto &choice = *world.Get<gp::LocomotorChoice>(bike);
	BOOST_TEST(choice.count == 2u);
	BOOST_TEST(choice.options[1].surfaces == gp::locomotor_surface::Cliff);
	// Routed over both locomotors' surfaces: the ground one's GROUND RUBBLE and the cliff one's CLIFF.
	const std::uint8_t surfaces = choice.options[0].surfaces | choice.options[1].surfaces;
	BOOST_TEST((surfaces & gp::locomotor_surface::Cliff) != 0);
	BOOST_TEST(world.Get<gp::NavigationAgent>(bike)->surfaces == surfaces);
	const auto &grid = world.Resource<gp::NavigationGrid>();
	BOOST_TEST_REQUIRE(grid.ClearanceFor(surfaces) != nullptr);
	// A cliff cell, and a clear one, of the map.
	std::optional<Engine::Math::FixedVector2> cliff, clear;
	for (std::int32_t y = 0; y < grid.Height() && (!cliff || !clear); ++y)
		for (std::int32_t x = 0; x < grid.Width(); ++x)
		{
			const Engine::Math::FixedVector2 centre{Fixed::FromInt(x * 10 + 5), Fixed::FromInt(y * 10 + 5)};
			if (!cliff && grid.Type(x, y) == gp::PathfindCellType::Cliff)
				cliff = centre;
			if (!clear && grid.Type(x, y) == gp::PathfindCellType::Clear && x > 20 && y > 20)
				clear = centre;
		}
	BOOST_TEST_REQUIRE((cliff.has_value() && clear.has_value()));
	game.Tick();
	BOOST_TEST(world.Get<gp::Locomotion>(bike)->locomotor.surfaces == choice.options[0].surfaces);
	world.Get<gp::Transform>(bike)->position = {cliff->x, cliff->y, game.Game().ground.At(*cliff)};
	game.Tick();
	BOOST_TEST(world.Get<gp::Locomotion>(bike)->locomotor.surfaces == choice.options[1].surfaces);
	BOOST_TEST(world.Get<gp::LocomotorChoice>(bike)->current == 1u);
	world.Get<gp::Transform>(bike)->position = {clear->x, clear->y, game.Game().ground.At(*clear)};
	game.Tick();
	BOOST_TEST(world.Get<gp::Locomotion>(bike)->locomotor.surfaces == choice.options[0].surfaces);
	BOOST_TEST(world.Get<gp::LocomotorChoice>(bike)->current == 0u);
}

// TunnelTracker::isValidContainerFor: no aircraft in a tunnel network.
BOOST_AUTO_TEST_CASE(legacy_parity_aircraft_do_not_enter_tunnels)
{
	Install &shell = Data();
	if (!shell.loaded)
