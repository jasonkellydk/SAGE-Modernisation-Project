// LocomotorSetUpgrade (AIUpdateInterface::setLocomotorUpgrade) and GrantScienceUpgrade::upgradeImplementation: with
// Upgrade_GLAWorkerShoes a GLA worker walks on its SET_NORMAL_UPGRADED locomotor (WorkerShoesLocomotor: faster); with
// Upgrade_AmericaMOAB an American command centre grants its player SCIENCE_MOAB.
BOOST_AUTO_TEST_CASE(legacy_parity_upgrades_change_locomotors_and_grant_sciences)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity worker = game.Place("GLAInfantryWorker", match->At(300, 300), {}, match->Team(game, 0));
	const ecs::Entity center = game.Place("AmericaCommandCenter", match->At(500, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE((world.IsAlive(worker) && world.IsAlive(center)));
	game.Tick();
	const Fixed walking = world.Get<gp::Locomotion>(worker)->locomotor.maxSpeed;
	const auto moab = *shell.game.Science("SCIENCE_MOAB");
	const std::uint32_t america = world.Get<gp::Owner>(center)->player;
	BOOST_TEST(!world.Resource<gp::PlayerSciences>().Has(america, moab));
	auto &upgrades = world.Resource<gp::PlayerUpgrades>();
	upgrades.Grant(world.Get<gp::Owner>(worker)->player, *shell.game.upgrades.Find("Upgrade_GLAWorkerShoes"));
	upgrades.Grant(america, *shell.game.upgrades.Find("Upgrade_AmericaMOAB"));
	for (int tick = 0; tick < 3; ++tick)
		game.Tick();
	BOOST_TEST((world.Get<gp::Locomotion>(worker)->locomotor.maxSpeed > walking));
	BOOST_TEST(world.Resource<gp::PlayerSciences>().Has(america, moab));
}

// A veteran Comanche shot down: as its blades come off (HelicopterSlowDeathBehavior, OCLEjectPilot) its pilot bails out
// by parachute (OCL_EjectPilotViaParachute: AmericaInfantryPilot, PutInContainer AmericaParachute, InvulnerableTime).
// ParachuteContain::onContaining: the pilot is held, falling (FREEFALL) at the chute's harness; the chute opens once it
// has dropped its ParachuteOpenDist (25) and the pilot hangs (PARACHUTING), as does the chute; on the ground the pilot
// lets go (no longer held) and the chute dies (its SlowDeathBehavior drops it).
BOOST_AUTO_TEST_CASE(legacy_parity_a_shot_down_comanche_pilot_bails_out_by_parachute)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity comanche = game.Place("AmericaVehicleComanche", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(comanche));
	world.Get<gp::Experience>(comanche)->level = 1;
	world.Get<gp::Transform>(comanche)->position.z += Fixed::FromInt(200);
	game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(comanche);
	ecs::Entity pilot{}, chute{};
	for (int tick = 0; tick < 300 && !world.IsAlive(pilot); ++tick)
	{
		game.Tick();
		const auto pilots = Named(game, "AmericaInfantryPilot");
		if (!pilots.empty())
			pilot = pilots.front();
	}
	BOOST_TEST_REQUIRE(world.IsAlive(pilot));
	// Its blades come off as debris trailing BuggyDebrisTireTrail (OCL_HelicopterBladeExplosion: ParticleSystem, attachToObject).
	std::size_t trailing = 0;
	for (const ecs::Entity piece : Named(game, "GenericDebris"))
		if (const auto *look = world.Get<gp::DebrisLook>(piece); look != nullptr && look->particleSystem != 0)
		{
			BOOST_TEST(game.ModelName(look->particleSystem) == "BuggyDebrisTireTrail");
			++trailing;
		}
	BOOST_TEST(trailing >= 1u);
	const auto chutes = Named(game, "AmericaParachute");
	BOOST_TEST_REQUIRE(chutes.size() == 1u);
	chute = chutes.front();
	BOOST_TEST_REQUIRE(world.Get<gp::ParachuteRider>(pilot) != nullptr);
	BOOST_TEST((world.Get<gp::ParachuteRider>(pilot)->chute == chute));
	BOOST_TEST((world.Get<gp::Parachute>(chute)->rider == pilot));
	BOOST_TEST((world.Get<gp::Disabled>(pilot)->mask & gp::disabled_type::Held) != 0u);
	BOOST_TEST(world.Get<gp::UndetectedDefector>(pilot) != nullptr);
	std::optional<std::uint64_t> opened, landed;
	bool fell = false;
	for (int tick = 0; tick < 1500 && !landed; ++tick)
	{
		game.Tick();
		if (!opened && world.Get<gp::Parachute>(chute)->Has(gp::parachute_flag::Opened))
		{
			opened = game.CurrentTick();
			BOOST_TEST(fell); // it fell first
		}
		if (!opened && world.Get<gp::ParachuteRider>(pilot) != nullptr)
			fell = fell || Shows(game, pilot, "FREEFALL");
		if (opened && world.Get<gp::ParachuteRider>(pilot) != nullptr && game.CurrentTick() == *opened + 1)
		{
			BOOST_TEST(Shows(game, pilot, "PARACHUTING"));
			BOOST_TEST(!Shows(game, pilot, "FREEFALL"));
			BOOST_TEST(Shows(game, chute, "PARACHUTING"));
		}
		if (world.Get<gp::ParachuteRider>(pilot) == nullptr)
			landed = game.CurrentTick();
	}
	BOOST_TEST_REQUIRE(opened.has_value());
	BOOST_TEST_REQUIRE(landed.has_value());
	BOOST_TEST(world.IsAlive(pilot));
	game.Tick();
	BOOST_TEST((world.Get<gp::Disabled>(pilot)->mask & gp::disabled_type::Held) == 0u);
	BOOST_TEST(world.Get<gp::Dying>(chute) != nullptr);
}

// CreateObjectDie TransferPreviousHealth on the Sneak Attack (GLA.ini: GLASneakAttackTunnelNetworkStart, LifetimeUpdate
// 5000 ms, CreationList OCL_CreateSneakAttackTunnel): damaged while it digs, it runs out of life after 150 frames and
// its tunnel takes over its subdual damage (SUBDUAL_UNRESISTABLE, first), its damage (its maximum less its health before
// it died, UNRESISTABLE) and its attackers (AIUpdateInterface::transferAttack).
BOOST_AUTO_TEST_CASE(legacy_parity_a_sneak_attack_tunnel_keeps_the_damage_it_took_digging)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity start = game.Place("GLASneakAttackTunnelNetworkStart", match->At(300, -300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(start));
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(-900, 900), {}, match->Team(game, 0));
	game.Tick();
	world.Get<gp::Health>(start)->current -= Fixed::FromInt(300);
	BOOST_TEST_REQUIRE(world.Has<gp::Subdual>(start));
	world.Get<gp::Subdual>(start)->damage = Fixed::FromInt(200); // its SubdualDamageHelper asleep: it keeps it
	*world.Get<gp::AttackTarget>(ranger) = {start, true};
	// Held (DISABLED_HELD) far off: it keeps its target without reaching it, so only the damage done here counts.
	if (!world.Has<gp::Disabled>(ranger))
		world.Add<gp::Disabled>(ranger);
	world.Get<gp::Disabled>(ranger)->mask = gp::disabled_type::Held;
	const std::uint64_t placed = game.CurrentTick();
	ecs::Entity tunnel{};
	Fixed lastHealth = world.Get<gp::Health>(start)->current, startMaximum = world.Get<gp::Health>(start)->maximum;
	for (int tick = 0; tick < 200 && !world.IsAlive(tunnel); ++tick)
	{
		if (world.IsAlive(start))
			lastHealth = world.Get<gp::Health>(start)->current;
		game.Tick();
		const auto made = Named(game, "GLASneakAttackTunnelNetwork");
		if (!made.empty())
			tunnel = made.front();
	}
	BOOST_TEST_REQUIRE(world.IsAlive(tunnel));
	BOOST_TEST_MESSAGE("tunnel after " << game.CurrentTick() - placed << " ticks");
	const gp::Health &health = *world.Get<gp::Health>(tunnel);
	BOOST_TEST((startMaximum - lastHealth).Raw() == Fixed::FromInt(300).Raw()); // its own shockwaves spare it (no SELF)
	BOOST_TEST(health.current.Raw() == (health.maximum - (startMaximum - lastHealth)).Raw());
	BOOST_TEST((world.Get<gp::AttackTarget>(ranger)->target == tunnel));
	BOOST_TEST_REQUIRE(world.Has<gp::Subdual>(tunnel));
	BOOST_TEST((world.Get<gp::Subdual>(tunnel)->damage == std::min(Fixed::FromInt(200), world.Get<gp::Subdual>(tunnel)->cap)));
	BOOST_TEST(world.Get<gp::Subdual>(tunnel)->awake == 1u);
}

// FireWeaponCollide on the shell map's trees (NatureProp.ini GenericTree: CollideWeapon TreeFireDealDamageWeapon,
// RequiredStatus AFLAME): a unit that moves into a burning tree is fired at by it as they collide (5 FLAME damage a
// frame: PartitionContactList collides bodies that moved); one walking past a tree that is not burning is not.
BOOST_AUTO_TEST_CASE(legacy_parity_a_burning_tree_burns_those_who_run_into_it)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const ecs::Entity burning = game.Place("GenericTree", match->At(60, -200), {}, neutral);
	const ecs::Entity green = game.Place("GenericTree", match->At(60, -80), {}, neutral);
	BOOST_TEST_REQUIRE(world.Get<gp::CollideWeapon>(burning) != nullptr);
	BOOST_TEST(world.Get<gp::CollideWeapon>(burning)->requiresAflame == 1u);
	const auto walker = [&](int y) { return game.Place("AmericaInfantryRanger", match->At(0, y), {}, match->Team(game, 0)); };
	const ecs::Entity past = walker(-200), control = walker(-80);
	std::vector<engine::net::CommandEnvelope> moves{commands::Encode(commands::MoveTo{{past}, match->At(120, -200)}),
		commands::Encode(commands::MoveTo{{control}, match->At(120, -80)})};
	for (auto &move : moves)
		move.player = 0;
	gp::Flammable &flames = *world.Get<gp::Flammable>(burning);
	flames.state = gp::FlameState::Aflame;
	flames.aflameEnd = ~std::uint64_t{0} / 2;
	const Fixed pastStart = world.Get<gp::Health>(past)->current, controlStart = world.Get<gp::Health>(control)->current;
	for (int tick = 0; tick < 150; ++tick)
	{
		world.Get<gp::Flammable>(burning)->state = gp::FlameState::Aflame;
		if (tick == 0)
			game.Tick(std::span(moves));
		else
			game.Tick();
	}
	// Burned (it catches fire too, and may burn to death).
	BOOST_TEST((!world.IsAlive(past) || world.Get<gp::Dying>(past) != nullptr || world.Get<gp::Health>(past)->current < pastStart));
	BOOST_TEST(world.Get<gp::Health>(control)->current.Raw() == controlStart.Raw());
	(void)green;
}

// FireWeaponUpdate (FireFieldSmall: SmallFireFieldWeapon, 5 FLAME within 30, DelayBetweenShots 250 ms = 8 frames) and
// FlammableUpdate::onDamage (FlameDamageLimit unset: 20; TruckArmor takes FLAME whole): a napalm fire field dropped on a
// GLA Technical sets it alight with its fourth shot (20 of flame damage).
BOOST_AUTO_TEST_CASE(legacy_parity_a_fire_field_sets_a_technical_alight)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	game.Tick();
	const ecs::Entity technical = game.Place("GLAVehicleTechnicalChassisOne", match->At(0, -200), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.Get<gp::Flammable>(technical) != nullptr);
	const Fixed start = world.Get<gp::Health>(technical)->current;
	const ecs::Entity field = game.Place("FireFieldSmall", match->At(0, -200), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(field));
	const std::uint64_t placed = game.CurrentTick();
	std::vector<std::uint64_t> hurt;
	std::uint64_t alight = 0;
	Fixed last = start;
	for (int tick = 0; tick < 60 && alight == 0; ++tick)
	{
		game.Tick();
		const Fixed now = world.Get<gp::Health>(technical)->current;
		if (now < last)
			hurt.push_back(game.CurrentTick() - placed);
		last = now;
		if (world.Get<gp::Flammable>(technical)->state == gp::FlameState::Aflame)
			alight = game.CurrentTick() - placed;
	}
	// Its first shot on its first update (the tick after it is made), then every 8 frames.
	BOOST_TEST((hurt == std::vector<std::uint64_t>{1, 9, 17, 25}));
	BOOST_TEST(alight == 25u);
	BOOST_TEST(((start - last).Raw() == Fixed::FromInt(20).Raw()));
}

// ParachuteContain::onDie (AmericaMiscUnit.ini AmericaParachute: FreeFallDamagePercent unset, so the module's 50%): a
// Comanche pilot's chute killed well above the ground lets it go where it hangs (removeAllContained -> onRemoving: no
// longer HELD, allowed to fall) in free fall (setIsInFreeFall: DISABLED_FREEFALL and FREEFALL while it is up), and it
// takes half its maximum (a veteran's 120) as falling damage (DAMAGE_FALLING, DEATH_SPLATTED). Down, it is no longer in free fall.
// The port takes the damage with the next tick's damage pass (the original in the same frame): one tick later.
BOOST_AUTO_TEST_CASE(legacy_parity_a_pilot_whose_chute_is_shot_away_falls_hurt)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity comanche = game.Place("AmericaVehicleComanche", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(comanche));
	world.Get<gp::Experience>(comanche)->level = 1; // a veteran ejects its pilot
	world.Get<gp::Transform>(comanche)->position.z += Fixed::FromInt(300);
	game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(comanche);
	ecs::Entity pilot{};
	for (int tick = 0; tick < 300 && !world.IsAlive(pilot); ++tick)
	{
		game.Tick();
		const auto pilots = Named(game, "AmericaInfantryPilot");
		if (!pilots.empty())
			pilot = pilots.front();
	}
	BOOST_TEST_REQUIRE(world.IsAlive(pilot));
	const auto chutes = Named(game, "AmericaParachute");
	BOOST_TEST_REQUIRE(chutes.size() == 1u);
	const ecs::Entity chute = chutes.front();
	for (int tick = 0; tick < 200 && !world.Get<gp::Parachute>(chute)->Has(gp::parachute_flag::Opened); ++tick)
	{
		game.Tick();
	}
	// Wherever it was ejected (the Comanche's crash decides that): lifted well up, then set so the rider, hanging from its
	// harness, is 251.6 above the ground under it after the next tick.
	world.Get<gp::Transform>(chute)->position.z += Fixed::FromInt(200);
	game.Tick();
	const Fixed before = world.Get<gp::Transform>(pilot)->position.z;
	game.Tick();
	{
		// (It sinks with its chute as it hangs: one tick's sinking on top, as the next tick hangs it lower.)
		const auto &hanging = world.Get<gp::Transform>(pilot)->position;
		const Fixed sinking = before - hanging.z;
		auto &at = world.Get<gp::Transform>(chute)->position;
		at.z = game.Game().ground.At(hanging.XY()) + Fixed::FromRatio(2516, 10) + sinking + (at.z - hanging.z);
	}
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::ParachuteRider>(pilot) != nullptr);
	const Fixed up = world.Get<gp::Transform>(pilot)->position.z;
	BOOST_TEST_MESSAGE("the pilot hangs " << up.Raw() / 65536.0 << " up");
	// It hangs from the chute's harness (positionRider), not standing on the ground below: 11.6 under the chute
	// (PARA_ATTCH less the pilot's PARA_MAN).
	BOOST_TEST((world.Get<gp::Transform>(chute)->position.z - up).Raw() < Fixed::FromInt(12).Raw());
	const Fixed maximum = world.Get<gp::Health>(pilot)->maximum;
	BOOST_TEST(world.Get<gp::Health>(pilot)->current.Raw() == maximum.Raw());
	world.Resource<gp::KillRequests>().entities.push_back(chute);
	game.Tick();
	const std::uint64_t released = game.CurrentTick();
	// Let go at once, falling freely.
	BOOST_TEST(world.Get<gp::ParachuteRider>(pilot) == nullptr);
	BOOST_TEST((world.Get<gp::Disabled>(pilot)->mask & gp::disabled_type::Held) == 0u);
	BOOST_TEST(world.Get<gp::PhysicsBody>(pilot)->Has(gp::physics_flag::InFreeFall));
	BOOST_TEST(world.Get<gp::PhysicsBody>(pilot)->Has(gp::physics_flag::AllowToFall));
	BOOST_TEST_REQUIRE(world.Get<gp::PendingDamage>(pilot) != nullptr);
	BOOST_TEST(world.Get<gp::PendingDamage>(pilot)->amount.Raw() == (maximum / Fixed::FromInt(2)).Raw());
	game.Tick();
	BOOST_TEST(world.Get<gp::PendingDamage>(pilot) == nullptr);
	BOOST_TEST(world.Get<gp::Health>(pilot)->current.Raw() == (maximum / Fixed::FromInt(2)).Raw());
	BOOST_TEST((world.Get<gp::Disabled>(pilot)->mask & gp::disabled_type::Freefall) != 0u);
	BOOST_TEST(Shows(game, pilot, "FREEFALL"));
	std::optional<std::uint64_t> down;
	for (int tick = 0; tick < 300 && !down && world.IsAlive(pilot); ++tick)
	{
		game.Tick();
		if (world.IsAlive(pilot) && !world.Get<gp::PhysicsBody>(pilot)->Has(gp::physics_flag::InFreeFall))
			down = game.CurrentTick();
	}
	BOOST_TEST_REQUIRE(down.has_value());
	BOOST_TEST(world.Get<gp::Transform>(pilot)->position.z.Raw() <= (up - Fixed::FromInt(50)).Raw());
	BOOST_TEST((world.Get<gp::Disabled>(pilot)->mask & gp::disabled_type::Freefall) == 0u);
	// Down 84 frames after it was let go, from 249.3 above the ground (it hangs at 251.6 and sinks with its chute until let
	// go) at Gravity -64/s^2 (from rest: n(n+1)/2 * 64/900 >= 249.3), landing at 84 * 64/900 = 5.973 a frame; less MinFallHeightForDamage 40's speed (sqrt(2 * 64/900 * 40) =
	// 2.385) times Mass 5 is 17.94 falling damage (HumanArmor: FALLING 100%). Fixed point lands within 0.01 of it.
	BOOST_TEST(*down - released == 84u);
	const double left = world.Get<gp::Health>(pilot)->current.Raw() / 65536.0;
	BOOST_TEST(std::abs(left - (maximum.Raw() / 65536.0 / 2.0 - 17.941)) < 0.01);
}

// TechBuildingBehavior (TechBuildings.ini TechArtilleryPlatform, as China holds one on the shell map): held by a playable
// side it shows CAPTURED (update: getControllingPlayer()->isPlayableSide()); the neutral player's is not; killed, it goes
// to the neutral player's default team (onDie: setTeam) and shows CAPTURED no more.
BOOST_AUTO_TEST_CASE(legacy_parity_a_tech_building_is_captured_while_a_side_holds_it)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const ecs::Entity held = game.Place("TechArtilleryPlatform", match->At(300, -300), {}, match->Team(game, 1));
	const ecs::Entity free = game.Place("TechArtilleryPlatform", match->At(-300, -300), {}, neutral);
	BOOST_TEST_REQUIRE(world.IsAlive(held));
	BOOST_TEST_REQUIRE(world.IsAlive(free));
	game.Tick();
	BOOST_TEST(Shows(game, held, "CAPTURED"));
	BOOST_TEST(!Shows(game, free, "CAPTURED"));
	world.Resource<gp::KillRequests>().entities.push_back(held);
	game.Tick();
	BOOST_TEST(world.IsAlive(held)); // its rubble stays (KeepObjectDie)
	BOOST_TEST(world.Get<gp::TeamMember>(held)->team == neutral);
	BOOST_TEST(world.Get<gp::Owner>(held)->player == game.Teams().TeamAt(neutral).owner);
	game.Tick();
	BOOST_TEST(!Shows(game, held, "CAPTURED"));
}

// TransportAIUpdate::privateAttackObject (AmericaVehicle.ini AmericaVehicleHumvee: TransportAIUpdate, TransportContain
// PassengersAllowedToFire Yes): a player's attack order to a Humvee passes on to the Rangers inside it (CMD_FROM_PLAYER),
// who take the same target; its own attack is set too.
BOOST_AUTO_TEST_CASE(legacy_parity_a_humvee_ordered_to_attack_sends_its_passengers_too)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(0, -200), {}, match->Team(game, 0));
	std::array<ecs::Entity, 2> rangers{};
	for (std::size_t index = 0; index < rangers.size(); ++index)
	{
		rangers[index] = game.Place("AmericaInfantryRanger", match->At(10 + 10 * static_cast<int>(index), -200), {}, match->Team(game, 0));
		world.Add<gp::Boarding>(rangers[index]);
		*world.Get<gp::Boarding>(rangers[index]) = {humvee};
