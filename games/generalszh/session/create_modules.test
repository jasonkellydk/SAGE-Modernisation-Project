// Weapon::preFireWeapon (Weapon.ini TomahawkMissileWeapon: PreAttackDelay 250, 8 frames; PreAttackType unset, PER_SHOT):
// the fire state starts on frame F (AIAttackFireWeaponState::onEnter -> preFireCurrentWeapon), the weapon is PRE_ATTACK
// until F + 8 (getStatus) and fires then; the port's shot without a wind-up goes on F + 1, so it winds up 7 ticks
// (showing PREATTACK_A) and fires on the 8th.
BOOST_AUTO_TEST_CASE(legacy_parity_a_tomahawk_winds_up_before_it_fires)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity tomahawk = game.Place("AmericaVehicleTomahawk", match->At(0, -200), {}, match->Team(game, 0));
	const ecs::Entity target = game.Place("GLABarracks", match->At(0, -500), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(tomahawk));
	BOOST_TEST_REQUIRE(world.IsAlive(target));
	std::vector<engine::net::CommandEnvelope> attack{commands::Encode(commands::Attack{{tomahawk}, target})};
	attack.front().player = 0;
	game.Tick(std::span(attack));
	std::optional<std::uint64_t> windUp, fired;
	int shown = 0;
	for (int tick = 0; tick < 600 && !fired; ++tick)
	{
		game.Tick();
		const gp::Armament &armament = *world.Get<gp::Armament>(tomahawk);
		if (armament.firedTick != 0)
			fired = armament.firedTick;
		else if (armament.preAttackUntil != 0)
		{
			if (!windUp)
				windUp = game.CurrentTick();
			shown += Shows(game, tomahawk, "PREATTACK_A") ? 1 : 0;
		}
	}
	BOOST_TEST_REQUIRE(windUp.has_value());
	BOOST_TEST_REQUIRE(fired.has_value());
	BOOST_TEST_MESSAGE("wound up on tick " << *windUp << ", fired on " << *fired);
	BOOST_TEST(*fired - *windUp == 7u);
	BOOST_TEST(shown == 7);
}

// HelicopterSlowDeathBehavior::update (hitATree) with PhysicsBehavior::onCollide: a Comanche wreck spiralling 10 above
// the ground over a tree (NatureProp.ini GenericTree: SHRUBBERY IMMOBILE, a cylinder 4 across and 15 high) runs into it
// (a dead body meets what stands firm; bounding spheres overlap), and on its next update comes down there, held where it
// is above the ground (hit-ground effects, SPECIAL_DAMAGED); one shot down as low over open ground falls to it first.
BOOST_AUTO_TEST_CASE(legacy_parity_a_crashing_helicopter_comes_down_in_a_tree)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const auto copter = [&](int x) {
		const ecs::Entity comanche = game.Place("AmericaVehicleComanche", match->At(x, -300), {}, match->Team(game, 0));
		world.Get<gp::Transform>(comanche)->position.z += Fixed::FromInt(10);
		return comanche;
	};
	const ecs::Entity tree = game.Place("GenericTree", match->At(-300, -300), {}, neutral);
	BOOST_TEST_REQUIRE(world.Get<gp::BoundingVolume>(tree) != nullptr);
	BOOST_TEST(world.Get<gp::BoundingVolume>(tree)->snag == 1u);
	// (Away from the tree until its wreck is put over it below: no collision before.)
	const ecs::Entity snagged = copter(-150), open = copter(300);
	game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(snagged);
	world.Resource<gp::KillRequests>().entities.push_back(open);
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Crash>(snagged) != nullptr);
	// Its wreck brought down low: 10 over the tree, and as low over open ground (its flight held it high till it died).
	const Fixed low = world.Get<gp::Transform>(tree)->position.z + Fixed::FromInt(10);
	world.Get<gp::Transform>(snagged)->position = {world.Get<gp::Transform>(tree)->position.x, world.Get<gp::Transform>(tree)->position.y, low};
	world.Get<gp::Transform>(open)->position.z = low;
	const std::uint64_t killed = game.CurrentTick();
	std::optional<std::uint64_t> treeDown, openDown;
	Fixed treeHeight, openHeight;
	ecs::Entity struck{};
	for (int tick = 0; tick < 200 && (!treeDown || !openDown); ++tick)
	{
		game.Tick();
		for (auto [body, down, height] : {std::tuple{snagged, &treeDown, &treeHeight}, std::tuple{open, &openDown, &openHeight}})
			if (!*down && world.IsAlive(body))
				if (const gp::Crash *crash = world.Get<gp::Crash>(body); crash != nullptr && crash->groundTick != 0)
				{
					*down = crash->groundTick;
					if (body == snagged)
						struck = crash->lastCollidee;
					const auto &at = world.Get<gp::Transform>(body)->position;
					*height = at.z - world.Resource<gp::GroundHeight>().At(at.XY());
				}
	}
	BOOST_TEST_REQUIRE(treeDown.has_value());
	BOOST_TEST_REQUIRE(openDown.has_value());
	BOOST_TEST_MESSAGE("in the tree " << *treeDown - killed << " ticks after dying, " << treeHeight.Raw() / 65536.0 << " up; in the open "
									  << *openDown - killed << " ticks, " << openHeight.Raw() / 65536.0 << " up");
	BOOST_TEST((struck == tree));
	BOOST_TEST(treeHeight.Raw() > Fixed::One().Raw()); // held above the ground, in the tree
	BOOST_TEST(openHeight.Raw() <= Fixed::One().Raw());
	// It moves over the tree on the tick after it is placed there (collisions at the end of it) and comes down on the next.
	BOOST_TEST(*treeDown - killed == 2u);
	BOOST_TEST(*treeDown < *openDown);
}

// JetSlowDeathBehavior::update (hitATree) with PhysicsBehavior::onCollide: a MiG wreck falling 10 above a tree
// (GenericTree: SHRUBBERY IMMOBILE) runs into it and comes down there on its next update (hit-ground effects, its
// timer on the ground started), then falls on to the ground as it slides; one as low over open ground falls to it first.
BOOST_AUTO_TEST_CASE(legacy_parity_a_crashing_jet_comes_down_in_a_tree)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const ecs::Entity tree = game.Place("GenericTree", match->At(-300, -300), {}, neutral);
	const ecs::Entity snagged = game.Place("ChinaJetMIG", match->At(-300, -300), {}, match->Team(game, 1));
	const ecs::Entity open = game.Place("ChinaJetMIG", match->At(300, -300), {}, match->Team(game, 1));
	// Flying (a jet killed on the ground does not crash): sent off, killed once well up.
	std::vector<engine::net::CommandEnvelope> fly{commands::Encode(commands::MoveTo{{snagged, open}, match->At(0, 300)})};
	fly.front().player = 1;
	game.Tick(std::span(fly));
	for (int tick = 0; tick < 300 && world.Get<gp::Transform>(snagged)->position.z - world.Resource<gp::GroundHeight>().At(world.Get<gp::Transform>(snagged)->position.XY()) < Fixed::FromInt(60); ++tick)
		game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(snagged);
	world.Resource<gp::KillRequests>().entities.push_back(open);
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Crash>(snagged) != nullptr);
	BOOST_TEST_REQUIRE(world.Get<gp::Crash>(open) != nullptr);
	const Fixed low = world.Get<gp::Transform>(tree)->position.z + Fixed::FromInt(10);
	world.Get<gp::Transform>(snagged)->position = {world.Get<gp::Transform>(tree)->position.x, world.Get<gp::Transform>(tree)->position.y, low};
	world.Get<gp::Transform>(open)->position.z = low;
	const std::uint64_t placed = game.CurrentTick();
	std::optional<std::uint64_t> treeDown, openDown;
	Fixed treeHeight;
	ecs::Entity struck{};
	for (int tick = 0; tick < 200 && (!treeDown || !openDown); ++tick)
	{
		game.Tick();
		if (const gp::Crash *crash = world.IsAlive(snagged) ? world.Get<gp::Crash>(snagged) : nullptr; !treeDown && crash != nullptr && crash->groundTick != 0)
		{
			treeDown = crash->groundTick;
			struck = crash->lastCollidee;
			const auto &at = world.Get<gp::Transform>(snagged)->position;
			treeHeight = at.z - world.Resource<gp::GroundHeight>().At(at.XY());
		}
		if (const gp::Crash *crash = world.IsAlive(open) ? world.Get<gp::Crash>(open) : nullptr; !openDown && crash != nullptr && crash->groundTick != 0)
			openDown = crash->groundTick;
	}
	BOOST_TEST_REQUIRE(treeDown.has_value());
	BOOST_TEST_REQUIRE(openDown.has_value());
	BOOST_TEST_MESSAGE("in the tree " << *treeDown - placed << " ticks after, " << treeHeight.Raw() / 65536.0 << " up; in the open " << *openDown - placed);
	BOOST_TEST((struck == tree));
	BOOST_TEST(*treeDown - placed == 2u);
	BOOST_TEST(treeHeight.Raw() > 0);
	BOOST_TEST(*treeDown < *openDown);
	// Sliding on, it falls on to the ground.
	for (int tick = 0; tick < 30 && world.IsAlive(snagged); ++tick)
		game.Tick();
	if (world.IsAlive(snagged))
	{
		const auto &at = world.Get<gp::Transform>(snagged)->position;
		BOOST_TEST(at.z.Raw() == world.Resource<gp::GroundHeight>().At(at.XY()).Raw());
	}
}

// Locomotor::getMaxSpeedForCondition (Locomotor.ini HumveeLocomotor: Speed 60, SpeedDamaged 30; GameData
// MovementPenaltyDamageState REALLYDAMAGED, UnitReallyDamagedThreshold 0.35): a Humvee at 30% health (REALLYDAMAGED) tops
// out at 30 a second (1 a frame), a whole one at 60 (2 a frame); healed, the hurt one speeds up again.
BOOST_AUTO_TEST_CASE(legacy_parity_a_badly_hurt_humvee_drives_at_its_damaged_speed)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity hurt = game.Place("AmericaVehicleHumvee", match->At(0, -200), {}, match->Team(game, 0));
	const ecs::Entity whole = game.Place("AmericaVehicleHumvee", match->At(0, -100), {}, match->Team(game, 0));
	gp::Health &health = *world.Get<gp::Health>(hurt);
	health.current = health.maximum * Fixed::FromRatio(30, 100);
	std::vector<engine::net::CommandEnvelope> drive{commands::Encode(commands::MoveTo{{hurt}, match->At(400, -200)}),
		commands::Encode(commands::MoveTo{{whole}, match->At(400, -100)})};
	for (auto &order : drive)
		order.player = 0;
	game.Tick(std::span(drive));
	Fixed hurtTop, wholeTop;
	for (int tick = 0; tick < 90; ++tick)
	{
		game.Tick();
		hurtTop = std::max(hurtTop, world.Get<gp::Locomotion>(hurt)->speed);
		wholeTop = std::max(wholeTop, world.Get<gp::Locomotion>(whole)->speed);
	}
	BOOST_TEST_MESSAGE("top speeds: hurt " << hurtTop.Raw() / 65536.0 << ", whole " << wholeTop.Raw() / 65536.0);
	BOOST_TEST(hurtTop.Raw() == Fixed::One().Raw());
	BOOST_TEST(wholeTop.Raw() == Fixed::FromInt(2).Raw());
	world.Get<gp::Health>(hurt)->current = world.Get<gp::Health>(hurt)->maximum;
	std::vector<engine::net::CommandEnvelope> back{commands::Encode(commands::MoveTo{{hurt}, match->At(0, -200)})};
	back.front().player = 0;
	game.Tick(std::span(back));
	Fixed healedTop;
	for (int tick = 0; tick < 90; ++tick)
	{
		game.Tick();
		healedTop = std::max(healedTop, world.Get<gp::Locomotion>(hurt)->speed);
	}
	BOOST_TEST(healedTop.Raw() == Fixed::FromInt(2).Raw());
}

// WanderAIUpdate with PanicHumanLocomotor (the burning man a BURNED infantry death leaves: OCL_FlamingInfantry): idle,
// it sets off for where it is plus 5 to 50 on each axis, and walks weaving off its goal (moveTowardsPositionLegs:
// WanderWidthFactor 1.25, its offset swinging within pi/8 x 1.25 once there, from a start within pi/6); its
// LifetimeUpdate (3000 ms) ends it after 90 frames.
BOOST_AUTO_TEST_CASE(legacy_parity_a_burning_man_runs_about_weaving)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const ecs::Entity man = game.Place("FlamingInfantry", match->At(0, -200), {}, neutral);
	BOOST_TEST_REQUIRE(world.IsAlive(man));
	BOOST_TEST_REQUIRE(world.Get<gp::Wanderer>(man) != nullptr);
	const auto start = world.Get<gp::Transform>(man)->position;
	const std::uint64_t born = game.CurrentTick();
	game.Tick();
	const gp::MoveOrder &order = *world.Get<gp::MoveOrder>(man);
	BOOST_TEST_REQUIRE((order.mode != gp::MoveMode::Idle));
	const Fixed dx = order.destination.x - start.x, dy = order.destination.y - start.y;
	BOOST_TEST((dx >= Fixed::FromInt(5) && dx <= Fixed::FromInt(50) && dy >= Fixed::FromInt(5) && dy <= Fixed::FromInt(50)));
	const std::int64_t limit = std::int64_t{1} << 28; // pi/8
	const std::int64_t width = limit * 5 / 4;
	bool withinOnceThere = true, reached = false, moved = false;
	std::optional<std::uint64_t> died;
	for (int tick = 0; tick < 120 && !died; ++tick)
	{
		game.Tick();
		if (!world.IsAlive(man) || world.Has<gp::Dying>(man))
		{
			died = game.CurrentTick();
			break;
		}
		const gp::Locomotion &motion = *world.Get<gp::Locomotion>(man);
		moved = moved || motion.speed > Fixed{};
		const std::int64_t offset = motion.wanderOffset;
		reached = reached || std::llabs(offset) <= width;
		if (reached)
			withinOnceThere = withinOnceThere && std::llabs(offset) <= width + (motion.wanderStep * 4);
	}
	BOOST_TEST(moved);
	BOOST_TEST(withinOnceThere);
	BOOST_TEST_REQUIRE(died.has_value());
	BOOST_TEST_MESSAGE("died " << *died - born << " ticks after it was made");
	BOOST_TEST(*died - born == 90u);
}

// End to end: a Ranger burned to death (running into a burning tree: TreeFireDealDamageWeapon, FLAME / BURNED) dies by
// its BURNED SlowDeathBehavior (OCL INITIAL OCL_FlamingInfantry): a burning man runs off from where it fell.
BOOST_AUTO_TEST_CASE(legacy_parity_a_ranger_burned_to_death_leaves_a_burning_man)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const ecs::Entity tree = game.Place("GenericTree", match->At(60, -200), {}, neutral);
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(0, -200), {}, match->Team(game, 0));
	world.Get<gp::Health>(ranger)->current = Fixed::FromInt(3);
	std::vector<engine::net::CommandEnvelope> run{commands::Encode(commands::MoveTo{{ranger}, match->At(120, -200)})};
	run.front().player = 0;
	std::vector<ecs::Entity> burning;
	for (int tick = 0; tick < 200 && burning.empty(); ++tick)
	{
		gp::Flammable &flames = *world.Get<gp::Flammable>(tree);
		flames.state = gp::FlameState::Aflame;
		flames.aflameEnd = ~std::uint64_t{0} / 2;
		if (tick == 0)
			game.Tick(std::span(run));
		else
			game.Tick();
		burning = Named(game, "FlamingInfantry");
	}
	BOOST_TEST_REQUIRE(burning.size() == 1u);
	game.Tick();
	game.Tick();
	BOOST_TEST((world.Get<gp::MoveOrder>(burning.front())->mode != gp::MoveMode::Idle));
}

// OpenContain::onDie (processDamageToContained) on a Humvee (AmericaVehicle.ini: TransportContain DamagePercentToUnits
// 100%, BurnedDeathToUnits unset: Yes): killed with two Rangers inside, both die BURNED where they ride: at its
// FIREPOINT bones (OpenContain::redeployOccupants), 9 above the ground. Their BURNED slow death's OCL_FlamingInfantry
// has SkipIfSignificantlyAirborne (ObjectCreationList: isSignificantlyAboveTerrain, more than three frames' fall), so
// no burning men come of them.
BOOST_AUTO_TEST_CASE(legacy_parity_riders_burn_with_their_humvee)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(0, -200), {}, match->Team(game, 0));
	std::array<ecs::Entity, 2> rangers{};
	for (std::size_t index = 0; index < rangers.size(); ++index)
	{
		rangers[index] = game.Place("AmericaInfantryRanger", match->At(10 + 10 * static_cast<int>(index), -200), {}, match->Team(game, 0));
		world.Add<gp::Boarding>(rangers[index]);
		*world.Get<gp::Boarding>(rangers[index]) = {humvee};
	}
	for (int tick = 0; tick < 100 && (world.Get<gp::Passenger>(rangers[0]) == nullptr || world.Get<gp::Passenger>(rangers[1]) == nullptr); ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Passenger>(rangers[1]) != nullptr);
	game.Tick();
	for (const ecs::Entity ranger : rangers)
		BOOST_TEST((world.Get<gp::Transform>(ranger)->position.z - world.Get<gp::Transform>(humvee)->position.z > Fixed::FromInt(5)));
	world.Resource<gp::KillRequests>().entities.push_back(humvee);
	game.Tick();
	// Their BURNED slow death has no delay (DestructionDelay 0): the bodies go at once, the burning men run from there.
	game.Tick();
	for (const ecs::Entity ranger : rangers)
		BOOST_TEST(!world.IsAlive(ranger));
	BOOST_TEST(Named(game, "FlamingInfantry").empty());
}

// TransportContain HealthRegen%PerSec and OpenContain::onDie on an ambulance (AmericaVehicle.ini AmericaVehicleMedic:
// HealthRegen%PerSec 25, DamagePercentToUnits 10%): a hurt Ranger inside regains a 120th of its maximum a frame (25% a
// second); killed, the ambulance lets it out alive where it was, 10% of its maximum lighter (unresistable).
BOOST_AUTO_TEST_CASE(legacy_parity_an_ambulance_heals_its_rider_and_lets_it_out_when_killed)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity ambulance = game.Place("AmericaVehicleMedic", match->At(0, -200), {}, match->Team(game, 0));
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(10, -200), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(ambulance));
	world.Add<gp::Boarding>(ranger);
	*world.Get<gp::Boarding>(ranger) = {ambulance};
	for (int tick = 0; tick < 100 && world.Get<gp::Passenger>(ranger) == nullptr; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Passenger>(ranger) != nullptr);
	const Fixed maximum = world.Get<gp::Health>(ranger)->maximum;
	world.Get<gp::Health>(ranger)->current = maximum / Fixed::FromInt(4);
	const Fixed before = world.Get<gp::Health>(ranger)->current;
	game.Tick();
	const Fixed step = maximum * (Fixed::FromInt(25) / Fixed::FromInt(100 * 30));
	BOOST_TEST((world.Get<gp::Health>(ranger)->current - before).Raw() == step.Raw());
	const Fixed inside = world.Get<gp::Health>(ranger)->current;
	world.Resource<gp::KillRequests>().entities.push_back(ambulance);
	game.Tick();
	BOOST_TEST_REQUIRE(world.IsAlive(ranger));
	BOOST_TEST(!world.Has<gp::Dying>(ranger));
	BOOST_TEST(!world.Has<gp::OffMap>(ranger));
	BOOST_TEST(!world.Has<gp::Passenger>(ranger));
	// It heals once more in the tick the ambulance dies (its update runs before the tick's deaths).
	BOOST_TEST(world.Get<gp::Health>(ranger)->current.Raw() == (inside + step - maximum * Fixed::FromRatio(10, 100)).Raw());
}

// PhysicsBehavior::onCollide against what stands firm (GenericDebris, which collides, thrown at a GLA barracks,
// IMMOBILE): once they overlap, its velocity is thrown away and it bounces straight back from the barracks' centre at
// its speed x mass x StructureStiffness 0.3 (felt on its next physics step), so it never passes through; a piece that
// ignores the barracks (IgnorePrimaryObstacle: made by it) slides on into it.
BOOST_AUTO_TEST_CASE(legacy_parity_debris_bounces_off_a_building)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t neutral = *game.Teams().FindTeam("team");
	const ecs::Entity barracks = game.Place("GLABarracks", match->At(0, -300), {}, match->Team(game, 1));
	const auto thrown = [&](int y, bool ignoring) {
		const ecs::Entity piece = game.Place("GenericDebris", match->At(-80, y), {}, neutral);
		BOOST_TEST_REQUIRE(world.Get<gp::BodyCollision>(piece) != nullptr);
		if (ignoring)
			world.Get<gp::BodyCollision>(piece)->ignored = barracks;
		gp::PhysicsBody &body = *world.Get<gp::PhysicsBody>(piece);
		body.velocity = {Fixed::FromInt(3), {}, {}};
		body.Set(gp::physics_flag::AllowToFall, true);
		return piece;
	};
	const ecs::Entity bounced = thrown(-300, false);
	const ecs::Entity through = thrown(-300, true);
	const Fixed centre = world.Get<gp::Transform>(barracks)->position.x;
	Fixed furthest = world.Get<gp::Transform>(bounced)->position.x;
	bool turned = false;
	for (int tick = 0; tick < 60; ++tick)
	{
		game.Tick();
		const auto &body = *world.Get<gp::PhysicsBody>(bounced);
		furthest = std::max(furthest, world.Get<gp::Transform>(bounced)->position.x);
		turned = turned || body.velocity.x < Fixed{};
	}
	BOOST_TEST_MESSAGE("got to " << (furthest - centre).Raw() / 65536.0 << " of the barracks' centre");
	BOOST_TEST(turned);
	BOOST_TEST(furthest.Raw() < centre.Raw());
	// The ignoring piece goes on into the barracks' footprint until ground friction stops it.
	BOOST_TEST(world.Get<gp::Transform>(through)->position.x.Raw() > furthest.Raw() + Fixed::FromInt(5).Raw());
}

// The control bar's UNIT_BUILD (MSG_QUEUE_UNIT_CREATE -> ProductionUpdate::queueCreateUnit): a player's order to its
// GLA command center queues a worker, paid when queued (BuildCost 200), with the factory's first production id; the
// cancel (MSG_CANCEL_UNIT_CREATE) by that id gives the money back and empties the queue; another player's order is
// ignored; a full queue takes no more.
BOOST_AUTO_TEST_CASE(legacy_parity_a_player_queues_and_cancels_a_unit)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity center = game.Place("GLACommandCenter", match->At(300, -300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.Get<gp::ProductionQueue>(center) != nullptr);
	const std::uint32_t player = world.Get<gp::Owner>(center)->player;
	auto &money = world.Resource<gp::PlayerMoney>();
	const auto before = money.Balance(player);
	const auto order = [&](commands::GameCommand command, std::uint32_t seat) {
		std::vector<engine::net::CommandEnvelope> envelopes{std::visit([](const auto &c) { return commands::Encode(c); }, command)};
		envelopes.front().player = seat;
		game.Tick(std::span(envelopes));
	};
	order(commands::QueueUnit{center, "GLAInfantryWorker"}, 1); // not this seat's
	BOOST_TEST(world.Get<gp::ProductionQueue>(center)->count == 0u);
	order(commands::QueueUnit{center, "GLAInfantryWorker"}, 0);
	const gp::ProductionQueue &queue = *world.Get<gp::ProductionQueue>(center);
	BOOST_TEST_REQUIRE(queue.count == 1u);
	BOOST_TEST(queue.entries[0].productionId == 1u);
	BOOST_TEST(money.Balance(player) == before - 200);
	order(commands::CancelUnit{center, 1}, 0);
	BOOST_TEST(world.Get<gp::ProductionQueue>(center)->count == 0u);
	BOOST_TEST(money.Balance(player) == before);
	for (int index = 0; index < 12; ++index)
		order(commands::QueueUnit{center, "GLAInfantryWorker"}, 0);
	BOOST_TEST(world.Get<gp::ProductionQueue>(center)->count <= gp::ProductionQueue::MaxEntries);
	BOOST_TEST(money.Balance(player) <= before - 200 * static_cast<std::int64_t>(world.Get<gp::ProductionQueue>(center)->count) + 200);
}

// GameLogic::onSetRallyPoint / doSetRallyPoint and DefaultProductionExitUpdate::exitObjectViaDoor: a player's rally point
// for its GLA command center (MSG_SET_RALLY_POINT) takes where a BasicHumanLocomotor could path (the setter told either
// way), another player's order is ignored, and a worker it then makes walks out to its natural rally point and on to it
// (aiFollowExitProductionPath), the rally point adjusted for it first (Pathfinder::adjustDestination: nobody's claim
// there; a worker, two cells across, goes about a cell corner: the cell of the point half a cell up and right, its low
// corner plus 0.05 of a cell). A point no path reaches (beyond the map) is refused and the old one kept.
BOOST_AUTO_TEST_CASE(legacy_parity_a_factorys_rally_point_takes_its_units_on_there)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity center = game.Place("GLACommandCenter", match->At(300, -300), {}, match->Team(game, 0));
	const auto order = [&](commands::GameCommand command, std::uint32_t seat) {
		std::vector<engine::net::CommandEnvelope> envelopes{std::visit([](const auto &c) { return commands::Encode(c); }, command)};
		envelopes.front().player = seat;
		game.Tick(std::span(envelopes));
	};
	const Engine::Math::FixedVector2 spot = match->At(420, -300);
	order(commands::SetRallyPoint{center, spot}, 1); // not this seat's
	BOOST_TEST(world.Get<gp::RallyPoint>(center) == nullptr);
	order(commands::SetRallyPoint{center, spot}, 0);
	BOOST_TEST_REQUIRE(world.Get<gp::RallyPoint>(center) != nullptr);
	BOOST_TEST((world.Get<gp::RallyPoint>(center)->at == spot));
	const auto &notices = world.Resource<gameplay::RallyNotices>().list;
	BOOST_TEST_REQUIRE(notices.size() == 1u);
	BOOST_TEST(notices[0].set);
	BOOST_TEST((notices[0].factory == center));
	order(commands::SetRallyPoint{center, {Fixed::FromInt(-100000), Fixed::FromInt(-100000)}}, 0);
	BOOST_TEST_REQUIRE(notices.size() == 1u);
	BOOST_TEST(!notices[0].set);
	BOOST_TEST((world.Get<gp::RallyPoint>(center)->at == spot));
	order(commands::QueueUnit{center, "GLAInfantryWorker"}, 0);
	const auto worker = game.DefinitionIndex("GLAInfantryWorker");
	BOOST_TEST_REQUIRE(worker.has_value());
	std::optional<ecs::Entity> made;
	for (int tick = 0; tick < 600 && !made; ++tick)
	{
		game.Tick();
		game.Visible().ForEach([&](const gp::VisibleObject &object) {
			if (object.definition == *worker && world.Get<gp::MovePath>(object.entity) != nullptr)
				made = object.entity;
		});
	}
	BOOST_TEST_REQUIRE(made.has_value());
	const gp::MovePath &path = *world.Get<gp::MovePath>(*made);
	BOOST_TEST(path.count == 2u);
	const auto corner = [](Fixed value) { return Fixed::FromInt(((value + Fixed::FromInt(5)) / Fixed::FromInt(10)).Floor() * 10) + Fixed::FromRatio(1, 2); };
	BOOST_TEST((path.kind == gp::MovePathKind::ExitProduction)); // AI_FOLLOW_EXITPRODUCTION_PATH, not a waypoint path
	BOOST_TEST((gp::MovePathPoint(world.Resource<gp::PathPoints>(), path, 1) == Engine::Math::FixedVector2{corner(spot.x), corner(spot.y)}));
}

// The user's "units spawn at the same place and intersect", against Pathfinder::adjustDestination / updateGoal /
// getRadiusAndCenter (AIPathfind.cpp), DefaultProductionExitUpdate::exitObjectViaDoor and AIFollowPathState (AIStates.cpp):
// workers made one after another at a GLA command center with a rally point on open ground each have the rally point
// adjusted around the cells those before them claimed. A worker is two cells across (bounding radius 10), so it goes
// about a cell corner: its cell C is the rally point's half a cell up and right, its footprint the 2 x 2 cells C - 1..C.
// The first takes C. For the second, the spiral from C (right, up, two left, two down, three right, ...) meets the
// first's cells until its ninth step, (C.x + 2, C.y - 1). For the third, both taken, the eleventh, (C.x + 2, C.y + 1).
// Each stops on its cell's point (its low corner plus 0.05 of a cell) and keeps its claim there.
BOOST_AUTO_TEST_CASE(legacy_parity_units_made_one_after_another_stop_on_their_own_cells)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity center = game.Place("GLACommandCenter", match->At(300, -300), {}, match->Team(game, 0));
	const auto order = [&](commands::GameCommand command) {
		std::vector<engine::net::CommandEnvelope> envelopes{std::visit([](const auto &c) { return commands::Encode(c); }, command)};
		envelopes.front().player = 0;
		game.Tick(std::span(envelopes));
	};
	world.Resource<gp::PlayerMoney>().Deposit(world.Get<gp::Owner>(center)->player, 10000);
	const Engine::Math::FixedVector2 spot = match->At(180, -300);
	order(commands::SetRallyPoint{center, spot});
	BOOST_TEST_REQUIRE(world.Get<gp::RallyPoint>(center) != nullptr);
	const std::int64_t cellX = ((spot.x + Fixed::FromInt(5)) / Fixed::FromInt(10)).Floor(), cellY = ((spot.y + Fixed::FromInt(5)) / Fixed::FromInt(10)).Floor();
	// Open ground about it: nothing but the workers' claims moves them.
	const auto &grid = world.Resource<gp::NavigationGrid>();
	for (std::int64_t y = cellY - 3; y <= cellY + 3; ++y)
		for (std::int64_t x = cellX - 3; x <= cellX + 4; ++x)
			BOOST_TEST_REQUIRE((grid.Type(static_cast<std::int32_t>(x), static_cast<std::int32_t>(y)) == gp::PathfindCellType::Clear));
	for (int count = 0; count < 3; ++count)
		order(commands::QueueUnit{center, "GLAInfantryWorker"});
	const auto worker = game.DefinitionIndex("GLAInfantryWorker");
	BOOST_TEST_REQUIRE(worker.has_value());
	std::vector<ecs::Entity> made;
	const auto settled = [&] {
		return made.size() == 3u && std::all_of(made.begin(), made.end(), [&](ecs::Entity entity) {
			return world.Get<gp::MovePath>(entity) == nullptr && world.Get<gp::MoveOrder>(entity)->mode == gp::MoveMode::Idle;
		});
	};
	for (int tick = 0; tick < 30 * 120 && !settled(); ++tick)
	{
		game.Tick();
		game.Visible().ForEach([&](const gp::VisibleObject &object) {
			if (object.definition == *worker && world.Get<gp::MovePath>(object.entity) != nullptr && std::find(made.begin(), made.end(), object.entity) == made.end())
				made.push_back(object.entity);
		});
	}
	BOOST_TEST_REQUIRE(settled());
	std::sort(made.begin(), made.end(), [](ecs::Entity a, ecs::Entity b) { return a.index < b.index; });
	// getRadiusAndCenter: floor(20 / 10 + 0.3) = 2 cells across, even: reach 1, about a corner.
	const auto *agent = world.Get<gp::NavigationAgent>(made[0]);
	BOOST_TEST_REQUIRE(agent != nullptr);
	BOOST_TEST_REQUIRE((agent->radius == 1 && agent->centered == 0));
	const std::array<std::pair<std::int64_t, std::int64_t>, 3> cells{std::pair{cellX, cellY}, std::pair{cellX + 2, cellY - 1}, std::pair{cellX + 2, cellY + 1}};
	for (std::size_t index = 0; index < made.size(); ++index)
	{
		const Engine::Math::FixedVector2 expected{Fixed::FromInt(cells[index].first * 10) + Fixed::FromRatio(1, 2),
			Fixed::FromInt(cells[index].second * 10) + Fixed::FromRatio(1, 2)};
		const auto *goal = world.Get<gp::MoveGoal>(made[index]);
		const auto *claim = world.Get<gp::PathfindGoal>(made[index]);
		BOOST_TEST_REQUIRE(goal != nullptr);
		BOOST_TEST((goal->goal == expected), "worker " << index);
		BOOST_TEST((claim->x == cells[index].first && claim->y == cells[index].second), "worker " << index);
		BOOST_TEST((Engine::Math::Distance(game.TransformOf(made[index])->position.XY(), expected) < Fixed::One()), "worker " << index);
	}
}

// The control bar over a real session (ControlBar::populateCommand, getCommandAvailability, populateBuildQueue): the
// local player's GLA command center selected shows its command set by slot (CommandSet.ini GLACommandCenterCommandSet:
// 1 the worker, available, art SUWorker; 14 sell), the player's money; queued, the worker shows on the queue with its
// production id; another player's object shows no commands.
BOOST_AUTO_TEST_CASE(legacy_parity_the_control_bar_shows_a_command_center)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity center = game.Place("GLACommandCenter", match->At(300, -300), {}, match->Team(game, 0));
	const ecs::Entity theirs = game.Place("GLACommandCenter", match->At(-300, -300), {}, match->Team(game, 1));
	const std::uint32_t player = world.Get<gp::Owner>(center)->player;
	session::SessionView &view = game;
	const std::array<ecs::Entity, 1> selection{center};
	hud::ControlBarState bar = hud::ReadControlBar(view, player, selection);
	BOOST_TEST(bar.hasPlayer);
	BOOST_TEST(bar.money == world.Resource<gp::PlayerMoney>().Balance(player));
	BOOST_TEST((bar.selected == center));
	BOOST_TEST_REQUIRE(bar.slots[0].button != nullptr);
	BOOST_TEST(bar.slots[0].button->object == "GLAInfantryWorker");
	BOOST_TEST((bar.slots[0].state == gameplay::ButtonState::Available));
	BOOST_TEST(bar.slots[0].image == "SUWorker");
	BOOST_TEST(bar.slots[1].button == nullptr);
	BOOST_TEST_REQUIRE(bar.slots[13].button != nullptr);
	BOOST_TEST((bar.slots[13].button->command == content::ButtonCommand::Sell));
	std::vector<engine::net::CommandEnvelope> queue{commands::Encode(commands::QueueUnit{center, "GLAInfantryWorker"})};
	queue.front().player = 0;
	game.Tick(std::span(queue));
	bar = hud::ReadControlBar(view, player, selection);
	BOOST_TEST_REQUIRE(bar.queue.size() == 1u);
	BOOST_TEST(bar.queue[0].image == "SUWorker");
	BOOST_TEST(bar.queue[0].productionId == 1u);
	const std::array<ecs::Entity, 1> other{theirs};
	bar = hud::ReadControlBar(view, player, other);
	BOOST_TEST(bar.slots[0].button == nullptr);
	BOOST_TEST((bar.selected == ecs::Entity{}));
}

// ControlBar::getCommandAvailability's option checks, over real buttons: NEED_UPGRADE (Command_RadarVanScan,
// Upgrade_GLARadarVanScan, a player upgrade: greyed until the player has it); MUST_BE_STOPPED (Command_ScuttleCombatBike:
// greyed while the bike moves); IGNORES_UNDERPOWERED (Command_UpgradeChinaUraniumShells at the nuclear missile silo
// stays usable when the silo is only underpowered, but not when also EMP-disabled); NOT_QUEUEABLE
// (Command_UpgradeChinaOverlordGattlingCannon: greyed while anything is in the Overlord's production).
BOOST_AUTO_TEST_CASE(legacy_parity_command_buttons_follow_their_options)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	using State = gameplay::ButtonState;
	session::SessionView &view = game;
	const auto button = [&](std::string_view name) -> const content::CommandButtonContent & {
		const content::CommandButtonContent *found = shell.game.commands.Button(name);
		BOOST_TEST_REQUIRE(found != nullptr);
		return *found;
	};
	const ecs::Entity van = game.Place("GLAVehicleRadarVan", match->At(300, -300), {}, match->Team(game, 0));
	const std::uint32_t player = world.Get<gp::Owner>(van)->player;
	const content::CommandButtonContent &scan = button("Command_RadarVanScan");
	BOOST_TEST((view.CommandAvailability(van, scan) == State::Restricted));
	world.Resource<gp::PlayerUpgrades>().Grant(player, *shell.game.upgrades.Find("Upgrade_GLARadarVanScan"));
	BOOST_TEST((view.CommandAvailability(van, scan) != State::Restricted));

	const ecs::Entity bike = game.Place("GLAVehicleCombatBike", match->At(250, -250), {}, match->Team(game, 0));
	game.Tick();
	const content::CommandButtonContent &scuttle = button("Command_ScuttleCombatBike");
	BOOST_TEST((view.CommandAvailability(bike, scuttle) == State::Available));
	gameplay::OrderMove(game.Game(), bike, match->At(100, -100));
	BOOST_TEST((view.CommandAvailability(bike, scuttle) == State::Restricted));

	const ecs::Entity silo = game.Place("ChinaNuclearMissileLauncher", match->At(-300, 300), {}, match->Team(game, 0));
	game.Tick();
	const content::CommandButtonContent &shells = button("Command_UpgradeChinaUraniumShells");
	world.Resource<gp::PlayerMoney>().Deposit(player, 100000);
	if (world.Get<gp::Disabled>(silo) == nullptr)
		world.Add<gp::Disabled>(silo);
	world.Get<gp::Disabled>(silo)->mask = 0;
	BOOST_TEST((view.CommandAvailability(silo, shells) == State::Available));
	world.Get<gp::Disabled>(silo)->mask = gp::disabled_type::Underpowered;
	BOOST_TEST((view.CommandAvailability(silo, shells) == State::Available));
	world.Get<gp::Disabled>(silo)->mask = gp::disabled_type::Underpowered | gp::disabled_type::Emp;
	BOOST_TEST((view.CommandAvailability(silo, shells) == State::Restricted));
	world.Get<gp::Disabled>(silo)->mask = 0;
	const ecs::Entity overlord = game.Place("ChinaTankOverlord", match->At(-200, 200), {}, match->Team(game, 0));
	game.Tick();
	const content::CommandButtonContent &gattling = button("Command_UpgradeChinaOverlordGattlingCannon");
	BOOST_TEST((view.CommandAvailability(overlord, gattling) == State::Available));
	auto *queue = world.Get<gp::ProductionQueue>(overlord);
	BOOST_TEST_REQUIRE(queue != nullptr);
	queue->entries[0] = {};
	queue->entries[0].kind = gp::ProductionKind::Upgrade;
	queue->entries[0].definition = *shell.game.upgrades.Find("Upgrade_ChinaOverlordPropagandaTower");
	queue->count = 1;
	BOOST_TEST((view.CommandAvailability(overlord, gattling) == State::Restricted));
}

// Player::canBuild (ObjectTypes::canBuildAny for SKIRMISH_PLAYER_HAS_PREREQUISITE_TO_BUILD): at the start America may
// build a barracks (its prerequisite, the command centre, standing) but no Strategy Center (it needs a war factory);
// with unit building off (PLAYER_DISABLE_UNIT_CONSTRUCTION: setCanBuildUnits(false), allowedToBuild) no Ranger, and its
// barracks may not make one either (canMakeUnit), though structures still may be built; with base building off no
// structure. evaluateSkirmishPlayerHasDiscoveredPlayer: none of China's things (across the map) is shown to America
// until a Chinese tank stands beside America's command centre.
BOOST_AUTO_TEST_CASE(legacy_parity_a_player_may_build_what_its_prerequisites_and_scripts_allow)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t america = *game.Teams().FindPlayer("player0");
	const std::uint32_t china = *game.Teams().FindPlayer("player1");
	const auto kind = [&](std::string_view name) -> const content::ObjectDefinition & { return *shell.game.objects.Find(name); };
	BOOST_TEST(gameplay::PlayerCanBuild(game.Game(), america, kind("AmericaBarracks")));
	BOOST_TEST(!gameplay::PlayerCanBuild(game.Game(), america, kind("AmericaStrategyCenter")));
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(200, -200), {}, match->Team(game, 0));
	game.Tick();
	BOOST_TEST(gameplay::PlayerCanBuild(game.Game(), america, kind("AmericaInfantryRanger")));
	BOOST_TEST((gameplay::CanMakeUnit(game.Game(), barracks, kind("AmericaInfantryRanger")) == gameplay::CanMake::Ok));
	auto &record = game.Game().roster.PlayerAt(america);
	record.unitConstructionEnabled = false;
	BOOST_TEST(!gameplay::PlayerCanBuild(game.Game(), america, kind("AmericaInfantryRanger")));
	BOOST_TEST((gameplay::CanMakeUnit(game.Game(), barracks, kind("AmericaInfantryRanger")) == gameplay::CanMake::NoPrerequisites));
	BOOST_TEST(gameplay::PlayerCanBuild(game.Game(), america, kind("AmericaBarracks")));
	record.unitConstructionEnabled = true;
	record.canBuildBase = false;
	BOOST_TEST(!gameplay::PlayerCanBuild(game.Game(), america, kind("AmericaBarracks")));
	record.canBuildBase = true;

	BOOST_TEST(!gameplay::DiscoveredBy(game.Game(), china, america));
	game.Place("ChinaTankBattleMaster", match->At(60, 0), {}, match->Team(game, 1));
	for (int tick = 0; tick < 10; ++tick)
		game.Tick();
	BOOST_TEST(gameplay::DiscoveredBy(game.Game(), china, america));
}

// Player::setObjectsEnabled (PLAYER_DISABLE_FACTORIES / PLAYER_ENABLE_FACTORIES): every one of America's barracks is
// script-disabled (its commands hidden) while the other player's barracks is not, then enabled again. Locomotor::setCloseEnoughDist (NAMED_SET_STOPPING_DISTANCE): a tank's stopping distance is set; one under 0.5
// changes nothing; a structure (no AI) is left alone.
BOOST_AUTO_TEST_CASE(legacy_parity_scripts_switch_factories_and_stopping_distances)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t america = *game.Teams().FindPlayer("player0");
	const ecs::Entity first = game.Place("AmericaBarracks", match->At(200, -200), {}, match->Team(game, 0));
	const ecs::Entity second = game.Place("AmericaBarracks", match->At(300, -200), {}, match->Team(game, 0));
	const ecs::Entity theirs = game.Place("AmericaBarracks", match->At(-300, 300), {}, match->Team(game, 1));
	const auto disabled = [&](ecs::Entity entity) {
		const auto *off = world.Get<gp::Disabled>(entity);
		return off != nullptr && (off->mask & gp::disabled_type::ScriptDisabled) != 0;
	};
	gameplay::SetPlayerObjectsEnabled(game.Game(), america, "AmericaBarracks", false);
	BOOST_TEST(disabled(first));
	BOOST_TEST(disabled(second));
	BOOST_TEST(!disabled(theirs));
	session::SessionView &view = game;
	const content::CommandButtonContent *ranger = shell.game.commands.Button("Command_ConstructAmericaInfantryRanger");
	BOOST_TEST_REQUIRE(ranger != nullptr);
	BOOST_TEST((view.CommandAvailability(first, *ranger) == gameplay::ButtonState::Hidden));
	gameplay::SetPlayerObjectsEnabled(game.Game(), america, "AmericaBarracks", true);
	BOOST_TEST(!disabled(first));
	BOOST_TEST(!disabled(second));

	const ecs::Entity tank = game.Place("AmericaTankCrusader", match->At(250, -300), {}, match->Team(game, 0));
	BOOST_TEST(gameplay::SetStoppingDistance(game.Game(), tank, Engine::Math::Fixed::FromInt(25)));
	BOOST_TEST((world.Get<gp::Locomotion>(tank)->locomotor.closeEnough == Engine::Math::Fixed::FromInt(25)));
	BOOST_TEST(gameplay::SetStoppingDistance(game.Game(), tank, Engine::Math::Fixed::FromRatio(1, 4)));
	BOOST_TEST((world.Get<gp::Locomotion>(tank)->locomotor.closeEnough == Engine::Math::Fixed::FromInt(25)));
	BOOST_TEST(!gameplay::SetStoppingDistance(game.Game(), first, Engine::Math::Fixed::FromInt(25)));
}

// Legacy parity (ActionManager::canResumeConstructionOf, DozerAIUpdate::newTask, AIPlayer::processBaseBuilding): a dozer
// ordered to build is the structure's builder at once (newTask: setBuilder), and a resume of that construction while it
// has its build task on it does nothing: the computer player's every-pass aiResumeConstruction leaves its dozer's
// picked spot and its way there alone (re-sent with a new spot each pass, a worker never got there and circled).
BOOST_AUTO_TEST_CASE(legacy_parity_resuming_a_build_already_under_way_does_nothing)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(dozer));
	const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
	world.Resource<gp::PlayerMoney>().Deposit(america, shell.game.objects.Find("AmericaPowerPlant")->buildCost);
	auto envelope = commands::Encode(commands::BuildStructure{dozer, "AmericaPowerPlant", match->At(400, 250), 0});
	envelope.player = 0;
	game.Tick(std::span(&envelope, 1));
	const gp::Builder *task = world.Get<gp::Builder>(dozer);
	BOOST_TEST_REQUIRE(task != nullptr);
	const ecs::Entity plant = task->target;
	BOOST_TEST_REQUIRE(world.Has<gp::UnderConstruction>(plant));
	BOOST_TEST((world.Get<gp::UnderConstruction>(plant)->builder == dozer));
	const auto dock = task->dock;
	const auto destination = world.Get<gp::MoveOrder>(dozer)->destination;
	game.Tick();
	BOOST_TEST(!gameplay::OrderWork(game.Game(), dozer, plant));
	BOOST_TEST((world.Get<gp::Builder>(dozer)->dock == dock));
	BOOST_TEST((world.Get<gp::MoveOrder>(dozer)->destination == destination));
}

// ProductionUpdate::update with ThingTemplate::calcTimeToBuild, on real data: America's Ranger queued at its barracks
// while a War Factory leaves it short of power (no power made, some used: MinLowEnergyProductionSpeed, twice its
// build time) counts its updates; a Cold Fusion Reactor put up partway through gives it full power, and it comes out on
// the update its count reaches its full-power build time (BuildTime * 30), as the original's m_framesUnderConstruction
// against the build time as the power now stands. The match runs alike on 1 and 4 workers, and a checkpoint taken
// while the Ranger is slowed restores to the same game.
BOOST_AUTO_TEST_CASE(legacy_parity_a_unit_slowed_by_low_power_finishes_once_power_returns)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace gp = engine::gameplay;
	const std::uint64_t base = content::BuildFrames(shell.game.objects.Find("AmericaInfantryRanger")->buildTimeSeconds, 30);
	struct Run
	{
		std::unique_ptr<session::Session> game;
		ecs::Entity barracks;
		std::uint64_t queued{0};
	};
	const auto start = [&](std::size_t workers) {
		Run run;
		run.game = std::make_unique<session::Session>(match->skirmish.level, shell.game, match->Options(workers));
		auto &game = *run.game;
		const std::uint32_t team = match->Team(game, 0);
		run.barracks = game.Place("AmericaBarracks", match->At(300, 300), {}, team);
		game.Place("AmericaWarFactory", match->At(500, 300), {}, team);
		auto &world = game.World();
		world.Resource<gp::PlayerMoney>().Deposit(world.Get<gp::Owner>(run.barracks)->player, 10000);
		game.Tick();
		auto envelope = commands::Encode(commands::QueueUnit{run.barracks, "AmericaInfantryRanger"});
		envelope.player = 0;
		run.queued = game.CurrentTick() + 1;
		game.Tick(std::span(&envelope, 1));
		return run;
	};
	Run one = start(1);
	Run four = start(4);
	auto &world = one.game->World();
	const std::uint32_t america = world.Get<gp::Owner>(one.barracks)->player;
	BOOST_TEST_REQUIRE(world.Get<gp::ProductionQueue>(one.barracks)->count == 1u);
	BOOST_TEST_REQUIRE(!world.Resource<gp::PlayerEnergy>().Sufficient(america));
	// Short of power for 60% of its full-power time: its percent is its updates over twice that.
	const std::uint64_t slowed = base * 6 / 10;
	while (one.game->CurrentTick() - one.queued + 1 < slowed)
	{
		one.game->Tick();
		four.game->Tick();
	}
	const gp::ProductionEntry &front = world.Get<gp::ProductionQueue>(one.barracks)->entries[0];
	BOOST_TEST(front.frames == slowed);
	BOOST_TEST(front.ticksNow == 2 * base);
	const auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), one.game->Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == one.game->StateHash());
	const auto power = [&](session::Session &game) { game.Place("AmericaPowerPlant", match->At(300, 500), {}, match->Team(game, 0)); };
	power(*one.game);
	power(*four.game);
	power(*restored);
	std::optional<std::uint64_t> done;
	for (int tick = 0; tick < 600 && !done; ++tick)
	{
		one.game->Tick();
		four.game->Tick();
		restored->Tick();
		if (world.Get<gp::ProductionQueue>(one.barracks)->count == 0u)
			done = one.game->CurrentTick();
	}
	BOOST_TEST_REQUIRE(done.has_value());
	BOOST_TEST_MESSAGE("Ranger queued on " << one.queued << ", " << base << " frames at full power, out on " << *done);
	// Its update count reaches the full-power build time: the base-th update since it was queued.
	BOOST_TEST(*done - one.queued + 1 == base);
	BOOST_TEST(one.game->StateHash() == four.game->StateHash());
	BOOST_TEST(restored->StateHash() == one.game->StateHash());
}

// ProductionUpdate::update's allowedToBuild check (Player::allowedToBuild, PLAYER_DISABLE_UNIT_CONSTRUCTION): with
// America's unit construction turned off while its barracks trains two Rangers, the first update after cancels the front
// Ranger (cancelUnitCreate: its cost back) and does nothing more, the next update cancels the second; its command
// centre's Dozer (KINDOF_DOZER) is never cancelled and comes out on time. Turned back on, a Ranger queued then is
// trained as usual. The match runs alike on 1 and 4 workers and restores from a checkpoint exactly.
BOOST_AUTO_TEST_CASE(legacy_parity_units_no_longer_allowed_leave_the_queue_but_dozers_stay)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace gp = engine::gameplay;
	const auto &ranger = *shell.game.objects.Find("AmericaInfantryRanger");
	const std::uint64_t dozerFrames = content::BuildFrames(shell.game.objects.Find("AmericaVehicleDozer")->buildTimeSeconds, 30);
	struct Run
	{
		std::unique_ptr<session::Session> game;
		ecs::Entity barracks, center;
		std::uint32_t america{0};
	};
	const auto order = [](Run &run, const commands::GameCommand &command) {
		auto envelope = commands::Encode(command);
		envelope.player = 0;
		run.game->Tick(std::span(&envelope, 1));
	};
	const auto start = [&](std::size_t workers) {
		Run run;
		run.game = std::make_unique<session::Session>(match->skirmish.level, shell.game, match->Options(workers));
		auto &game = *run.game;
		const std::uint32_t team = match->Team(game, 0);
		run.barracks = game.Place("AmericaBarracks", match->At(300, 300), {}, team);
		run.center = game.Place("AmericaCommandCenter", match->At(600, 300), {}, team);
		game.Place("AmericaPowerPlant", match->At(300, 600), {}, team);
		auto &world = game.World();
		run.america = world.Get<gp::Owner>(run.barracks)->player;
		world.Resource<gp::PlayerMoney>().Deposit(run.america, 20000);
		game.Tick();
		std::vector<engine::net::CommandEnvelope> orders{commands::Encode(commands::QueueUnit{run.barracks, "AmericaInfantryRanger"}),
			commands::Encode(commands::QueueUnit{run.barracks, "AmericaInfantryRanger"}), commands::Encode(commands::QueueUnit{run.center, "AmericaVehicleDozer"})};
		for (auto &envelope : orders)
			envelope.player = 0;
		game.Tick(std::span(orders));
		for (int tick = 0; tick < 10; ++tick)
			game.Tick();
		return run;
	};
	Run one = start(1);
	Run four = start(4);
	auto &world = one.game->World();
	auto &money = world.Resource<gp::PlayerMoney>();
	const std::uint64_t dozerQueued = one.game->CurrentTick() - 10;
	BOOST_TEST_REQUIRE(world.Get<gp::ProductionQueue>(one.barracks)->count == 2u);
	BOOST_TEST_REQUIRE(world.Get<gp::ProductionQueue>(one.center)->count == 1u);
	const std::int64_t before = money.Balance(one.america);
	for (Run *run : {&one, &four})
		run->game->Game().roster.PlayerAt(run->america).unitConstructionEnabled = false;
	one.game->Tick();
	four.game->Tick();
	// The front Ranger cancelled and paid back; the update spent (the second has not started).
	BOOST_TEST(world.Get<gp::ProductionQueue>(one.barracks)->count == 1u);
	BOOST_TEST(world.Get<gp::ProductionQueue>(one.barracks)->entries[0].frames == 0u);
	BOOST_TEST(money.Balance(one.america) == before + ranger.buildCost);
	one.game->Tick();
	four.game->Tick();
	BOOST_TEST(world.Get<gp::ProductionQueue>(one.barracks)->count == 0u);
	BOOST_TEST(money.Balance(one.america) == before + 2 * ranger.buildCost);
	// The dozer stays, counting every update since it was queued, and comes out.
	BOOST_TEST_REQUIRE(world.Get<gp::ProductionQueue>(one.center)->count == 1u);
	BOOST_TEST(world.Get<gp::ProductionQueue>(one.center)->entries[0].frames == one.game->CurrentTick() - dozerQueued + 1);
	std::optional<std::uint64_t> dozerOut;
	for (int tick = 0; tick < 2000 && !dozerOut; ++tick)
	{
		one.game->Tick();
		four.game->Tick();
		if (world.Get<gp::ProductionQueue>(one.center)->count == 0u)
			dozerOut = one.game->CurrentTick();
	}
	BOOST_TEST_REQUIRE(dozerOut.has_value());
	BOOST_TEST(*dozerOut - dozerQueued + 1 >= dozerFrames); // done at its frames, out once its door is open
	// Allowed again: trained as usual.
	for (Run *run : {&one, &four})
	{
		run->game->Game().roster.PlayerAt(run->america).unitConstructionEnabled = true;
		order(*run, commands::QueueUnit{run->barracks, "AmericaInfantryRanger"});
	}
	BOOST_TEST(world.Get<gp::ProductionQueue>(one.barracks)->count == 1u);
	for (int tick = 0; tick < 20; ++tick)
	{
		one.game->Tick();
		four.game->Tick();
	}
	BOOST_TEST(world.Get<gp::ProductionQueue>(one.barracks)->count == 1u);
	BOOST_TEST(world.Get<gp::ProductionQueue>(one.barracks)->entries[0].frames == 21u);
	BOOST_TEST(one.game->StateHash() == four.game->StateHash());
	const auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), one.game->Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == one.game->StateHash());
}

// Legacy parity (AIGroup::groupAttackObject / groupAttackPosition, SpawnBehavior::orderSlavesToAttackTarget /
// orderSlavesToAttackPosition, GLAInfantryAngryMobNexus' SlavesHaveFreeWill No): its player's attack order to the mob's
// nexus sends its members after the target too; with free will they would stay out of it.
BOOST_AUTO_TEST_CASE(legacy_parity_a_mob_without_free_will_attacks_with_its_nexus)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const ecs::Entity nexus = game.Place("GLAInfantryAngryMobNexus", match->At(300, 300), {}, match->Team(game, 1));
	const ecs::Entity tank = game.Place("AmericaTankCrusader", match->At(500, 300), {}, match->Team(game, 0));
	game.Tick();
	const auto *spawner = world.Get<engine::gameplay::Spawner>(nexus);
	BOOST_TEST_REQUIRE(spawner != nullptr);
	BOOST_TEST_REQUIRE(spawner->spawnedCount == 5u);
	BOOST_TEST(!spawner->freeWill);
	const std::uint32_t player = world.Get<engine::gameplay::Owner>(nexus)->player;
	gameplay::ApplyCommand(game.Game(), player, commands::Attack{{nexus}, tank});
	for (std::size_t index = 0; index < spawner->spawnedCount; ++index)
		BOOST_TEST((world.Get<engine::gameplay::AttackTarget>(spawner->spawned[index])->target == tank));
	// With free will: nobody but the nexus is sent.
	const std::vector<ecs::Entity> members(spawner->spawned.begin(), spawner->spawned.begin() + spawner->spawnedCount);
	for (const ecs::Entity member : members)
		*world.Get<engine::gameplay::AttackTarget>(member) = {};
	world.Get<engine::gameplay::Spawner>(nexus)->freeWill = true;
	gameplay::ApplyCommand(game.Game(), player, commands::Attack{{nexus}, tank});
	for (const ecs::Entity member : members)
		BOOST_TEST(!world.Get<engine::gameplay::AttackTarget>(member)->target.IsValid());
}

// Legacy parity (ObjectCreationList.cpp GenericObjectCreationNugget::reallyCreate / doStuffToObj; PartitionManager::
// findPositionAround): the Rebel Ambush (SUPERWEAPON_RebelAmbush1: four GLAInfantryRebel, SpreadFormation, MinDistanceA/B
// 20 / 30, MaxDistanceFormation 400, FadeIn over FadeTime 3000 = 90 frames, DiesOnBadLand) called in on open ground puts
// each rebel on its own spot found around the point (the first on the first ring, 20 to 30 out), none on another, each
// fading in over 90 frames; called in off the map, the spots are its centre and every rebel is killed there with the next
// tick's damage. RequiresLivePlayer: a scout drone's list (OCL_AmericanScoutDrone) makes it for a live player, nothing
// once its player is dead (killPlayer).
BOOST_AUTO_TEST_CASE(legacy_parity_a_rebel_ambush_spreads_and_fades_in_its_rebels)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace ga = generalszh::gameplay;
	namespace gp = engine::gameplay;
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	game.Tick();
	auto &world = game.World();
	const std::uint32_t gla = match->Team(game, 1);
	const auto rebels = [&] {
		std::vector<ecs::Entity> found;
		ecs::Query<ecs::Read<gp::DefinitionRef>> query(world);
		query.ForEachChunk([&](auto chunk) {
			const auto refs = chunk.template Get<gp::DefinitionRef>();
			const auto entities = chunk.Entities();
			for (std::size_t row = 0; row < refs.size(); ++row)
				if (game.DefinitionName(refs[row].index) == "GLAInfantryRebel")
					found.push_back(entities[row]);
		});
		return found;
	};
	const Engine::Math::FixedVector2 spot = match->At(250, -250);
	ga::CreationSource source;
	source.position = {spot.x, spot.y, game.Game().ground.At(spot)};
	source.team = gla;
	world.Resource<ga::EffectCues>().list.clear();
	ga::RunCreationList(game.Game(), "SUPERWEAPON_RebelAmbush1", source);
	const auto made = rebels();
	BOOST_TEST_REQUIRE(made.size() == 4u);
	std::vector<Engine::Math::FixedVector2> at;
	for (const ecs::Entity rebel : made)
		at.push_back(world.Get<gp::Transform>(rebel)->position.XY());
	for (std::size_t one = 0; one < at.size(); ++one)
	{
		const Fixed out = Engine::Math::Distance(at[one], spot);
		BOOST_TEST((out >= Fixed::FromInt(20) - Fixed::FromRatio(1, 100) && out <= Fixed::FromInt(400)));
		for (std::size_t other = one + 1; other < at.size(); ++other)
			BOOST_TEST((Engine::Math::Distance(at[one], at[other]) >= Fixed::FromInt(5)));
	}
	const Fixed first = Engine::Math::Distance(at[0], spot);
	BOOST_TEST((first >= Fixed::FromInt(20) - Fixed::FromRatio(1, 100) && first <= Fixed::FromInt(30) + Fixed::FromRatio(1, 100)));
	std::size_t fades = 0;
	for (const ga::EffectCue &cue : world.Resource<ga::EffectCues>().list)
		if (cue.fade == 1)
		{
			++fades;
			BOOST_TEST(cue.fadeTicks == 90u);
			BOOST_TEST(cue.effect.empty()); // its FadeSound is commented out
		}
	BOOST_TEST(fades == 4u);
	game.Tick();
	for (const ecs::Entity rebel : made)
		BOOST_TEST(world.Get<gp::Dying>(rebel) == nullptr);

	// Off the map: at its centre, killed (DiesOnBadLand).
	ga::CreationSource away = source;
	away.position = {Fixed::FromInt(-200), Fixed::FromInt(-200), Fixed{}};
	ga::RunCreationList(game.Game(), "SUPERWEAPON_RebelAmbush1", away);
	std::vector<ecs::Entity> lost;
	for (const ecs::Entity rebel : rebels())
		if (std::ranges::find(made, rebel) == made.end())
			lost.push_back(rebel);
	BOOST_TEST_REQUIRE(lost.size() == 4u);
	for (const ecs::Entity rebel : lost)
		BOOST_TEST((world.Get<gp::Transform>(rebel)->position.XY() == Engine::Math::FixedVector2{Fixed::FromInt(-200), Fixed::FromInt(-200)}));
	game.Tick();
	for (const ecs::Entity rebel : lost)
		BOOST_TEST((!world.IsAlive(rebel) || world.Get<gp::Dying>(rebel) != nullptr || gp::IsDead(*world.Get<gp::Health>(rebel))));

	// RequiresLivePlayer.
	const std::uint32_t usa = match->Team(game, 0);
	const auto drones = [&] {
		std::size_t count = 0;
		ecs::Query<ecs::Read<gp::DefinitionRef>> query(world);
		query.ForEachChunk([&](auto chunk) {
			for (const auto &ref : chunk.template Get<gp::DefinitionRef>())
				count += game.DefinitionName(ref.index) == "AmericaVehicleScoutDrone" ? 1u : 0u;
		});
		return count;
	};
	ga::CreationSource scout;
	scout.position = {spot.x, spot.y + Fixed::FromInt(200), game.Game().ground.At(spot)};
	scout.team = usa;
	ga::RunCreationList(game.Game(), "OCL_AmericanScoutDrone", scout);
	BOOST_TEST(drones() == 1u);
	ga::PlayerKill(game.Game(), game.Game().roster.TeamAt(usa).owner);
	ga::RunCreationList(game.Game(), "OCL_AmericanScoutDrone", scout);
	BOOST_TEST(drones() == 1u); // the first one (it may be dying), no new one
}

// MaxHealthUpgrade::upgradeImplementation (MaxHealthUpgrade.cpp) on the shipped AirF_AmericaTankAvenger (MaxHealth 300;
// Upgrade_AmericaCompositeArmor: AddMaxHealth 100, ADD_CURRENT_HEALTH_TOO): a hurt Avenger (150/300) is 250/400 the tick
// after its player has the upgrade (ActiveBody::setMaxHealth); one made afterwards gets it as it is made (400/400).
BOOST_AUTO_TEST_CASE(legacy_parity_composite_armor_adds_to_an_avengers_health)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	const std::uint32_t america = *game.Teams().FindPlayer("player0");
	using Engine::Math::Fixed;
	const ecs::Entity hurt = game.Place("AirF_AmericaTankAvenger", match->At(0, -200), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.Get<engine::gameplay::Health>(hurt) != nullptr);
	BOOST_TEST((world.Get<engine::gameplay::Health>(hurt)->maximum == Fixed::FromInt(300)));
	world.Get<engine::gameplay::Health>(hurt)->current = Fixed::FromInt(150);
	game.Tick();
	world.Resource<engine::gameplay::PlayerUpgrades>().Grant(america, *shell.game.upgrades.Find("Upgrade_AmericaCompositeArmor"));
	game.Tick();
	BOOST_TEST((world.Get<engine::gameplay::Health>(hurt)->maximum == Fixed::FromInt(400)));
	BOOST_TEST((world.Get<engine::gameplay::Health>(hurt)->current == Fixed::FromInt(250)));
	game.Tick();
	BOOST_TEST((world.Get<engine::gameplay::Health>(hurt)->maximum == Fixed::FromInt(400))); // once only
	const ecs::Entity later = game.Place("AirF_AmericaTankAvenger", match->At(60, -200), {}, match->Team(game, 0));
	game.Tick();
	BOOST_TEST((world.Get<engine::gameplay::Health>(later)->maximum == Fixed::FromInt(400)));
	BOOST_TEST((world.Get<engine::gameplay::Health>(later)->current == Fixed::FromInt(400)));
}

BOOST_AUTO_TEST_SUITE_END()
