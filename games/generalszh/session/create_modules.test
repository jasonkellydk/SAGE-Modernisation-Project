// StructureCollapseUpdate on MogadishuHighrise01 (collapse after 500-1000 ms: 15-30 frames; bursts every 250-800 ms;
// GeometryHeight 75): killed, it plays FX_StructureCollapseInitial and OCL_StructureCollapseInitial, shudders, then
// falls for 46 frames (the fall reaching 75 units on the 47th, as the engine's parity test), bursting on the way, plays
// FX_StructureCollapseFinal and OCL_StructureCollapseFinal and shows POST_COLLAPSE instead of RUBBLE, drawn at its
// place again. Its garrison lets everyone out first.
BOOST_AUTO_TEST_CASE(legacy_parity_a_highrise_collapses_when_it_dies)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity highrise = game.Place("MogadishuHighrise01", match->At(300, 300), {}, 0);
	BOOST_TEST_REQUIRE(world.IsAlive(highrise));
	game.Tick();
	const auto named = [&](const gp::DeathEvent &event) { return std::string(game.DeathEffectName(event.kind, event.id)); };
	const auto phaseNames = [&] {
		std::vector<std::string> names;
		for (const gp::DeathEvent &event : game.DeathEvents())
			if (event.entity == highrise)
				names.push_back(named(event));
		return names;
	};
	const auto has = [](const std::vector<std::string> &names, std::string_view name) { return std::find(names.begin(), names.end(), name) != names.end(); };
	world.Resource<gp::KillRequests>().entities.push_back(highrise);
	game.Tick();
	const std::uint64_t died = game.CurrentTick();
	const auto initial = phaseNames();
	BOOST_TEST(has(initial, "FX_StructureCollapseInitial"));
	BOOST_TEST(has(initial, "OCL_StructureCollapseInitial"));
	BOOST_TEST(has(initial, "FX_BuildingDie"));
	BOOST_TEST_REQUIRE(world.Get<gp::Collapse>(highrise) != nullptr);
	const gp::Collapse waiting = *world.Get<gp::Collapse>(highrise);
	BOOST_TEST(waiting.collapseTick >= died + 14);
	BOOST_TEST(waiting.collapseTick <= died + 31);
	BOOST_TEST(world.Get<gp::DrawOffset>(highrise)->shudder.Raw() == Fixed::FromRatio(6, 10).Raw());
	std::optional<std::uint64_t> fell, down;
	std::size_t bursts = 0;
	for (int tick = 0; tick < 200 && !down; ++tick)
	{
		game.Tick();
		const auto names = phaseNames();
		const gp::Collapse &now = *world.Get<gp::Collapse>(highrise);
		if (!fell && now.state != gp::CollapseState::Waiting)
			fell = game.CurrentTick();
		bursts += std::count_if(names.begin(), names.end(), [](const std::string &name) { return name == "FX_StructureCollapseBurst" || name == "FX_StructureCollapseDelay"; });
		if (now.state == gp::CollapseState::Done)
		{
			down = game.CurrentTick();
			BOOST_TEST(has(names, "FX_StructureCollapseFinal"));
			BOOST_TEST(has(names, "OCL_StructureCollapseFinal"));
		}
		else if (now.state == gp::CollapseState::Collapsing && fell && game.CurrentTick() > *fell)
			BOOST_TEST(world.Get<gp::DrawOffset>(highrise)->z.Raw() < 0);
	}
	BOOST_TEST_REQUIRE(fell.has_value());
	BOOST_TEST_REQUIRE(down.has_value());
	BOOST_TEST(*down - *fell == 46u);
	BOOST_TEST(bursts >= 2u); // one as it starts falling, more on the way down (every 8-24 frames)
	game.Tick();
	BOOST_TEST(world.Get<gp::Appearance>(highrise)->Test(content::ModelConditionBit("POST_COLLAPSE")));
	BOOST_TEST(!world.Get<gp::Appearance>(highrise)->Test(content::ModelConditionBit("RUBBLE")));
	BOOST_TEST(world.Get<gp::DrawOffset>(highrise)->z.Raw() == 0);
	BOOST_TEST(world.Get<gp::DrawOffset>(highrise)->shudder.Raw() == 0);
	BOOST_TEST(world.IsAlive(highrise)); // the post-collapse ruin stays
}

// StructureToppleUpdate.cpp (beginStructureTopple, update, applyCrushingDamage, doDamageLine, doToppleDoneStuff) on
// StanTallTower (MinToppleDelay 250 / MaxToppleDelay 500 ms: 8-15 frames; StructuralIntegrity 0.75, StructuralDecay 1.0;
// GeometryHeight 80, radii 7; AngleFX 20 degrees; CrushingWeaponName ToppledStructureWeapon). Killed by a power plant's
// damage from the west it plays FX_DefaultStructureToppleStart and waits; on its topple frame it starts to go over,
// east give or take pi/8. The original's float loop (0.02 x sin(angle) x 0.25 a frame on an angle nudged to 0.001)
// passes 20 degrees on its 93rd toppling frame (FX_StructureToppleAngle20), comes within pi/6 of the ground on its
// 109th (the crushing shots and FX_DefaultStructureCrushing start) and lies flat on its 115th (ToppleDoneFX): the
// same frames here, the lean in Q32 radians with the shared Q1.30 sine (no tolerance needed at frame granularity).
// Flat, it stands again turned to its fall, POST_COLLAPSE, not RUBBLE; a Ranger under it is crushed. The same on 4
// workers, and a checkpoint mid-fall carries on exactly.
BOOST_AUTO_TEST_CASE(legacy_parity_a_tall_tower_topples_away_from_its_killer_and_crushes_what_it_lands_on)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace gp = engine::gameplay;
	struct Game
	{
		std::unique_ptr<session::Session> game;
		ecs::Entity tower, plant, ranger;
	};
	const auto stage = [&](std::size_t workers) {
		Game made;
		made.game = std::make_unique<session::Session>(match->skirmish.level, shell.game, match->Options(workers));
		made.game->Tick();
		made.tower = made.game->Place("StanTallTower", match->At(300, 300), {}, 0);
		made.plant = made.game->Place("AmericaPowerPlant", match->At(200, 300), {}, match->Team(*made.game, 0));
		made.ranger = made.game->Place("AmericaInfantryRanger", match->At(330, 300), {}, match->Team(*made.game, 0));
		made.game->Tick();
		return made;
	};
	Game one = stage(1), four = stage(4);
	auto &game = *one.game;
	auto &world = game.World();
	BOOST_TEST_REQUIRE(world.IsAlive(one.tower));
	const auto tick = [&] {
		game.Tick();
		four.game->Tick();
	};
	const auto names = [&] {
		std::vector<std::string> list;
		for (const gp::DeathEvent &event : game.DeathEvents())
			if (event.entity == one.tower)
				list.push_back(std::string(game.DeathEffectName(event.kind, event.id)));
		return list;
	};
	const auto has = [](const std::vector<std::string> &list, std::string_view name) { return std::find(list.begin(), list.end(), name) != list.end(); };
	const std::uint32_t explosion = *content::DamageTypeIndex("EXPLOSION");
	const std::uint32_t normal = *content::DeathTypeIndex("NORMAL");
	for (Game *g : {&one, &four})
	{
		auto &w = g->game->World();
		w.Add<gp::PendingDamage>(g->tower);
		*w.Get<gp::PendingDamage>(g->tower) = gp::PendingDamage{g->plant, Fixed::FromInt(5000), explosion, normal};
	}
	tick();
	std::uint64_t died = game.CurrentTick();
	if (world.Get<gp::StructureTopple>(one.tower) == nullptr)
	{
		tick(); // the damage lands, then it dies
		died = game.CurrentTick();
	}
	BOOST_TEST_REQUIRE(world.Get<gp::StructureTopple>(one.tower) != nullptr);
	BOOST_TEST(has(names(), "FX_DefaultStructureToppleStart"));
	const gp::StructureTopple waiting = *world.Get<gp::StructureTopple>(one.tower);
	BOOST_TEST_MESSAGE("died on " << died << ", topples on " << waiting.toppleTick);
	BOOST_TEST(waiting.toppleTick >= died + 8);
	BOOST_TEST(waiting.toppleTick <= died + 15);
	// Away from the plant (east), give or take pi/8 (1/16 of a turn).
	const std::int32_t off = static_cast<std::int32_t>(waiting.toppleAngle.units);
	BOOST_TEST(std::abs(static_cast<std::int64_t>(off)) <= (std::int64_t{1} << 28));
	const std::uint64_t start = waiting.toppleTick;
	std::optional<std::uint64_t> angleFx, crushing, flat;
	std::int64_t lean = 0;
	bool restoredOnce = false;
	for (int n = 0; n < 200 && !flat; ++n)
	{
		tick();
		const auto list = names();
		const gp::StructureTopple &now = *world.Get<gp::StructureTopple>(one.tower);
		if (now.state == gp::StructureToppleState::Toppling)
		{
			BOOST_TEST(now.Lean() >= lean);
			lean = now.Lean();
		}
		if (!angleFx && has(list, "FX_StructureToppleAngle20"))
			angleFx = game.CurrentTick();
		if (!crushing && has(list, "ToppledStructureWeapon"))
		{
			crushing = game.CurrentTick();
			BOOST_TEST(has(list, "FX_DefaultStructureCrushing"));
		}
		if (now.state == gp::StructureToppleState::Done)
		{
			flat = game.CurrentTick();
			BOOST_TEST(has(list, "FX_DefaultStructureToppleDone"));
			BOOST_TEST(world.Get<gp::Transform>(one.tower)->facing.units == now.toppleAngle.units);
		}
		if (!restoredOnce && game.CurrentTick() == start + 60)
		{
			restoredOnce = true;
			BOOST_TEST((game.StateHash() == four.game->StateHash()));
			auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), game.Checkpoint());
			BOOST_TEST_REQUIRE(restored != nullptr);
			BOOST_TEST((restored->StateHash() == game.StateHash()));
			for (int more = 0; more < 5; ++more)
			{
				restored->Tick();
				game.Tick();
				four.game->Tick();
			}
			BOOST_TEST((restored->StateHash() == game.StateHash()));
		}
	}
	BOOST_TEST_REQUIRE(angleFx.has_value());
	BOOST_TEST_REQUIRE(crushing.has_value());
	BOOST_TEST_REQUIRE(flat.has_value());
	BOOST_TEST(*angleFx - start + 1 == 93u);
	BOOST_TEST(*crushing - start + 1 == 109u);
	BOOST_TEST(*flat - start + 1 == 115u);
	tick();
	tick();
	BOOST_TEST(world.Get<gp::Appearance>(one.tower)->Test(content::ModelConditionBit("POST_COLLAPSE")));
	BOOST_TEST(!world.Get<gp::Appearance>(one.tower)->Test(content::ModelConditionBit("RUBBLE")));
	BOOST_TEST(world.IsAlive(one.tower)); // its ruin stays
	BOOST_TEST((!world.IsAlive(one.ranger) || world.Get<gp::Dying>(one.ranger) != nullptr));
	BOOST_TEST((game.StateHash() == four.game->StateHash()));
}

// BoneFXUpdate.cpp (initTimes, update, doFXListAtBone, computeNextLogicFXTime, changeBodyDamageState, stopAllBoneFX) and
// BoneFXDamage::onBodyDamageStateChange on MogadishuTower04 (RubbleFXList1 = bone:Smoke02 OnlyOnce:Yes 3000 3000
// FXList:FX_DefaultStructureSecondary; RubbleParticleSystem1 = bone:Fire02 ... PSys:StructureToppleSmokeTrail;
// DamageFXTypes and DamageParticleTypes ALL -WATER; no pristine slots): standing it plays nothing; the tick its health
// reaches none it is rubble (ActiveBody::calcDamageState) and its rubble FX list is timed 90 ticks on (3000 ms at 30 a
// second, no spread: parseDurationReal); on that tick FX_DefaultStructureSecondary plays once at its Smoke02 bone turned
// and moved with it (transformBoneToWorld; its topple has not laid it flat yet), and never again (OnlyOnce); lying flat
// stops its bone effects (doToppleDoneStuff: stopAllBoneFX). Its last damage WATER when the slot comes due, the FX list
// is skipped and not tried again. The same on 1 and 4 workers, and a checkpoint on the way carries on exactly. The Dragon
// Tank's flame projectile's content: its six pristine particle systems at bone NULL (not in its model: the origin), once.
BOOST_AUTO_TEST_CASE(legacy_parity_a_tower_plays_its_rubble_bone_fx_once_before_it_lies_flat)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace gp = engine::gameplay;
	const auto &tower = shell.game.boneFx.at("MogadishuTower04");
	const content::BoneFxEntry &rubbleFx = tower.fx[3][0];
	BOOST_TEST(rubbleFx.name == "FX_DefaultStructureSecondary");
	BOOST_TEST(rubbleFx.bone == "Smoke02");
	BOOST_TEST(rubbleFx.onlyOnce);
	BOOST_TEST((rubbleFx.minDelay == Fixed::FromInt(90) && rubbleFx.maxDelay == Fixed::FromInt(90)));
	BOOST_TEST((rubbleFx.at.x != Fixed{} || rubbleFx.at.y != Fixed{} || rubbleFx.at.z != Fixed{})); // found in its model
	BOOST_TEST(tower.particles[3][0].name == "StructureToppleSmokeTrail");
	BOOST_TEST((tower.fxTypes & (std::uint64_t{1} << *content::DamageTypeIndex("WATER"))) == 0u);
	for (std::size_t state = 0; state < 3; ++state)
		for (const auto &slot : tower.fx[state])
			BOOST_TEST(!slot.Used());
	const auto &flame = shell.game.boneFx.at("DragonTankFlameProjectile");
	for (std::size_t slot = 0; slot < 6; ++slot)
	{
		BOOST_TEST(flame.particles[0][slot].Used());
		BOOST_TEST(flame.particles[0][slot].bone == "NULL");
		BOOST_TEST((flame.particles[0][slot].at.x == Fixed{} && flame.particles[0][slot].at.y == Fixed{} && flame.particles[0][slot].at.z == Fixed{}));
	}
	BOOST_TEST(flame.particles[0][0].name == "FlameThrowerTrail01");

	struct Game
	{
		std::unique_ptr<session::Session> game;
		ecs::Entity tower, plant;
	};
	const std::uint32_t explosion = *content::DamageTypeIndex("EXPLOSION");
	const std::uint32_t normal = *content::DeathTypeIndex("NORMAL");
	const auto stage = [&](std::size_t workers) {
		Game made;
		made.game = std::make_unique<session::Session>(match->skirmish.level, shell.game, match->Options(workers));
		made.game->Tick();
		made.tower = made.game->Place("MogadishuTower04", match->At(300, 300), {}, 0);
		made.plant = made.game->Place("AmericaPowerPlant", match->At(200, 300), {}, match->Team(*made.game, 0));
		made.game->Tick();
		return made;
	};
	const auto secondaries = [&](Game &g) {
		std::vector<gameplay::EffectCue> found;
		for (const gameplay::EffectCue &cue : g.game->World().Resource<gameplay::EffectCues>().list)
			if (cue.effect == "FX_DefaultStructureSecondary")
				found.push_back(cue);
		return found;
	};
	const auto kill = [&](Game &g) {
		auto &w = g.game->World();
		w.Add<gp::PendingDamage>(g.tower);
		*w.Get<gp::PendingDamage>(g.tower) = gp::PendingDamage{g.plant, Fixed::FromInt(5000), explosion, normal};
	};
	Game one = stage(1), four = stage(4), wet = stage(1);
	auto &world = one.game->World();
	BOOST_TEST_REQUIRE(world.Get<gameplay::BoneFx>(one.tower) != nullptr);
	for (int n = 0; n < 30; ++n)
	{
		one.game->Tick();
		four.game->Tick();
		wet.game->Tick();
		BOOST_TEST(secondaries(one).empty());
	}
	BOOST_TEST(world.Get<gameplay::BoneFx>(one.tower)->state == 0u);
	BOOST_TEST(world.Get<gameplay::BoneFx>(one.tower)->active == 1u);
	for (Game *g : {&one, &four, &wet})
		kill(*g);
	std::optional<std::uint64_t> died;
	for (int n = 0; n < 5 && !died; ++n)
	{
		one.game->Tick();
		four.game->Tick();
		wet.game->Tick();
		if (world.Get<gameplay::BoneFx>(one.tower)->state == 3u)
			died = one.game->CurrentTick();
	}
	BOOST_TEST_REQUIRE(died.has_value());
	BOOST_TEST(wet.game->World().Get<gameplay::BoneFx>(wet.tower)->state == 3u);
	const auto &timed = *world.Get<gameplay::BoneFx>(one.tower);
	BOOST_TEST(timed.nextFx[0] == static_cast<std::int64_t>(*died + 90));
	for (std::size_t slot = 1; slot < 8; ++slot)
		BOOST_TEST(timed.nextFx[slot] == gameplay::BoneFx::Off);
	// Its last damage WATER when the slot comes due.
	wet.game->World().Get<gp::Health>(wet.tower)->lastDamageType = *content::DamageTypeIndex("WATER");
	std::optional<std::uint64_t> played, flat;
	std::optional<gameplay::EffectCue> cue;
	std::unique_ptr<session::Session> restored;
	for (int n = 0; n < 250 && !flat; ++n)
	{
		one.game->Tick();
		four.game->Tick();
		wet.game->Tick();
		if (restored)
			restored->Tick();
		BOOST_TEST(secondaries(wet).empty());
		const auto list = secondaries(one);
		if (!list.empty())
		{
			BOOST_TEST(!played.has_value()); // once
			played = one.game->CurrentTick();
			cue = list.front();
			// transformBoneToWorld: the bone at rest turned and moved with it.
			const auto &frame = *world.Get<gp::Transform>(one.tower);
			const Fixed c = Engine::Math::Cos(frame.facing), s = Engine::Math::Sin(frame.facing);
			BOOST_TEST((cue->at.x == frame.position.x + rubbleFx.at.x * c - rubbleFx.at.y * s));
			BOOST_TEST((cue->at.y == frame.position.y + rubbleFx.at.x * s + rubbleFx.at.y * c));
			BOOST_TEST((cue->at.z == frame.position.z + rubbleFx.at.z));
			BOOST_TEST(world.Get<gameplay::BoneFx>(one.tower)->nextFx[0] == gameplay::BoneFx::Off);
			BOOST_TEST((world.Get<gp::StructureTopple>(one.tower)->state != gp::StructureToppleState::Done));
		}
		if (one.game->CurrentTick() == *died + 45)
		{
			BOOST_TEST((one.game->StateHash() == four.game->StateHash()));
			restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), one.game->Checkpoint());
			BOOST_TEST_REQUIRE(restored != nullptr);
			BOOST_TEST((restored->StateHash() == one.game->StateHash()));
		}
		if (const auto *topple = world.Get<gp::StructureTopple>(one.tower); topple != nullptr && topple->state == gp::StructureToppleState::Done)
			flat = one.game->CurrentTick();
	}
	BOOST_TEST_REQUIRE(played.has_value());
	BOOST_TEST(*played == *died + 90);
	BOOST_TEST_REQUIRE(flat.has_value());
	BOOST_TEST(*flat > *played);
	one.game->Tick();
	four.game->Tick();
	BOOST_TEST(world.Get<gameplay::BoneFx>(one.tower)->stops == 1u);
	BOOST_TEST(world.Get<gameplay::BoneFx>(one.tower)->done == 1u);
	BOOST_TEST((one.game->StateHash() == four.game->StateHash()));
	BOOST_TEST_REQUIRE(restored != nullptr);
	restored->Tick();
	BOOST_TEST((restored->StateHash() == one.game->StateHash()));
}

// GarrisonContain::recalcApparentControllingPlayer / getApparentControllingPlayer: two Pathfinders
// (KINDOF_STEALTH_GARRISON) inside an apartment make it America's, but to players America is not allied with (the GLA)
// it still looks empty and the civilians'; not to America itself. A Ranger (not a stealthy garrisoner) joining them, or
// the first of them detected, gives it away.
BOOST_AUTO_TEST_CASE(legacy_parity_stealthy_garrisoners_hide_the_garrison_from_non_allies)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity building = game.Place("AsianApartment01", match->At(300, 300), {}, 0);
	const std::uint32_t civilians = world.Get<gp::Owner>(building)->player;
	const std::uint32_t america = *game.Teams().FindPlayer("player0");
	const std::uint32_t gla = *game.Teams().FindPlayer("player1");
	const auto board = [&](const char *type, int x) {
		const ecs::Entity unit = game.Place(type, match->At(x, 240), {}, match->Team(game, 0));
		world.Add<gp::Boarding>(unit);
		*world.Get<gp::Boarding>(unit) = {building};
		return unit;
	};
	board("AmericaInfantryPathfinder", 280);
	board("AmericaInfantryPathfinder", 300);
	const auto &manifest = world.Resource<gp::CargoManifest>();
	for (int tick = 0; tick < 900 && manifest.Count(building) < 2u; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(manifest.Count(building) == 2u);
	game.Tick();
	const gp::Garrison &garrison = *world.Get<gp::Garrison>(building);
	BOOST_TEST(world.Get<gp::Owner>(building)->player == america);
	BOOST_TEST(garrison.originalPlayer == civilians);
	BOOST_TEST(((garrison.hiddenFrom >> gla) & 1u) == 1u);
	BOOST_TEST(((garrison.hiddenFrom >> america) & 1u) == 0u);
	// The first inside found out: no longer hidden.
	if (auto *stealth = world.Get<gp::Stealth>(manifest.Aboard(building).front()))
	{
		stealth->detectedUntil = game.CurrentTick() + 3;
		game.Tick();
		BOOST_TEST(world.Get<gp::Garrison>(building)->hiddenFrom == 0u);
		for (int tick = 0; tick < 5; ++tick)
			game.Tick();
		BOOST_TEST(world.Get<gp::Garrison>(building)->hiddenFrom != 0u);
	}
	board("AmericaInfantryRanger", 320);
	for (int tick = 0; tick < 900 && manifest.Count(building) < 3u; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(manifest.Count(building) == 3u);
	game.Tick();
	BOOST_TEST(world.Get<gp::Garrison>(building)->hiddenFrom == 0u);
}

// BuildAssistant::sellObject / update: America sells its barracks (the GLA may not). Sold at S, its scaffold is up
// (PARTIALLY_CONSTRUCTED), it shows as SOLD from S + 134 and is gone after S + 179, paying back SellPercentage (50%) of
// its cost.
BOOST_AUTO_TEST_CASE(legacy_parity_a_sold_structure_comes_down_and_pays_half_back)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(barracks));
	const std::uint32_t america = world.Get<gp::Owner>(barracks)->player;
	const auto send = [&](const commands::GameCommand &command, std::uint32_t seat) {
		auto envelope = commands::Encode(command);
		envelope.player = seat;
		game.Tick(std::span(&envelope, 1));
	};
	send(commands::Sell{barracks}, 1);
	BOOST_TEST(!world.Has<gp::Sale>(barracks)); // not the GLA's
	auto &money = world.Resource<gp::PlayerMoney>();
	const std::int64_t before = money.Balance(america);
	send(commands::Sell{barracks}, 0);
	BOOST_TEST_REQUIRE(world.Has<gp::Sale>(barracks));
	const std::uint64_t sold = world.Get<gp::Sale>(barracks)->since;
	BOOST_TEST(world.Get<gp::Appearance>(barracks)->Test(content::ModelConditionBit("PARTIALLY_CONSTRUCTED")));
	std::optional<std::uint64_t> shownSold, gone;
	for (int tick = 0; tick < 400 && !gone; ++tick)
	{
		game.Tick();
		const std::uint64_t ran = game.CurrentTick(); // the tick just run
		if (!world.IsAlive(barracks))
			gone = ran;
		else if (!shownSold && world.Get<gp::Sale>(barracks)->sunk != 0)
			shownSold = ran;
	}
	BOOST_TEST_REQUIRE(shownSold.has_value());
	BOOST_TEST_REQUIRE(gone.has_value());
	BOOST_TEST(*shownSold - sold == 134u);
	BOOST_TEST(*gone - sold == 179u);
	BOOST_TEST(money.Balance(america) - before == shell.game.objects.Find("AmericaBarracks")->buildCost / 2);
}

// TunnelContain::onSelling: selling one of two tunnels hands its riders to the other (onTunnelDestroyed); selling the
// last puts them all out at once (removeAllContained).
BOOST_AUTO_TEST_CASE(legacy_parity_selling_tunnels_hands_over_then_empties_the_network)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t gla = match->Team(game, 1);
	const ecs::Entity first = game.Place("GLATunnelNetwork", match->At(300, 300), {}, gla);
	const ecs::Entity second = game.Place("GLATunnelNetwork", match->At(500, 300), {}, gla);
	const ecs::Entity rebel = game.Place("GLAInfantryRebel", match->At(380, 240), {}, gla);
	world.Add<gp::Boarding>(rebel);
	*world.Get<gp::Boarding>(rebel) = {first};
	const auto &manifest = world.Resource<gp::CargoManifest>();
	for (int tick = 0; tick < 900 && manifest.Count(first) == 0u; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(manifest.Count(first) == 1u);
	const auto send = [&](const commands::GameCommand &command, std::uint32_t seat) {
		auto envelope = commands::Encode(command);
		envelope.player = seat;
		game.Tick(std::span(&envelope, 1));
	};
	send(commands::Sell{first}, 1);
	BOOST_TEST(manifest.Count(second) == 1u);
	BOOST_TEST((world.Get<gp::Passenger>(rebel)->transport == second));
	send(commands::Sell{second}, 1);
	BOOST_TEST(manifest.Count(second) == 0u);
	BOOST_TEST(!world.Has<gp::Passenger>(rebel));
	BOOST_TEST(!world.Has<gp::OffMap>(rebel));
	BOOST_TEST(world.IsAlive(rebel));
}

// BuildAssistant::sellObject: selling America's airfield kills its Raptor parked in its space (killAllParkedUnits:
// Object::kill), while its Raptor in the air (isAboveTerrain, not taking off or landing) flies on; selling a China
// Gattling Cannon destroys the minefield it laid (each KINDOF_MINE whose producer it is: destroyObject, no death), at once;
// both leave every selection (deselectObject, then OBJECT_STATUS_UNSELECTABLE). The match runs alike on 1 and 4
// workers and restores from a checkpoint exactly.
BOOST_AUTO_TEST_CASE(legacy_parity_selling_kills_parked_jets_and_takes_away_the_mines)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace gp = engine::gameplay;
	struct Run
	{
		std::unique_ptr<session::Session> game;
		ecs::Entity airfield, parked, flying, cannon;
		std::vector<ecs::Entity> mines;
	};
	const auto start = [&](std::size_t workers) {
		Run run;
		run.game = std::make_unique<session::Session>(match->skirmish.level, shell.game, match->Options(workers));
		auto &game = *run.game;
		auto &world = game.World();
		game.Tick();
		const std::uint32_t team = match->Team(game, 0);
		run.airfield = game.Place("AmericaAirfield", match->At(-300, -400), {}, team);
		run.parked = game.Place("AmericaJetRaptor", match->At(-300, -400), {}, team);
		run.flying = game.Place("AmericaJetRaptor", match->At(200, -200), {}, team);
		run.cannon = game.Place("ChinaGattlingCannon", match->At(300, 300), {}, team);
		game.Tick();
		{
			auto &jet = *world.Get<gp::Jet>(run.parked);
			jet.airfield = run.airfield;
			jet.space = 0;
			jet.state = gp::JetState::Parked;
			world.Get<gp::Transform>(run.parked)->position = world.Get<gp::Airfield>(run.airfield)->spaces[0].parking;
			auto &flier = *world.Get<gp::Jet>(run.flying);
			flier.airfield = run.airfield;
			flier.space = 1;
			flier.state = gp::JetState::Flying;
			world.Get<gp::Transform>(run.flying)->position.z = game.Game().ground.At(world.Get<gp::Transform>(run.flying)->position.XY()) + Fixed::FromInt(100);
		}
		auto *upgradable = world.Get<gp::Upgradable>(run.cannon);
		upgradable->completed.Set(*shell.game.upgrades.Find("Upgrade_ChinaMines"));
		upgradable->stale = 1;
		game.Tick();
		game.Tick();
		run.mines = Named(game, "ChinaStandardMine");
		return run;
	};
	Run one = start(1);
	Run four = start(4);
	auto &world = one.game->World();
	BOOST_TEST_REQUIRE(world.Has<gp::Airfield>(one.airfield));
	BOOST_TEST_REQUIRE(!one.mines.empty());
	const auto send = [](Run &run, const commands::GameCommand &command) {
		auto envelope = commands::Encode(command);
		envelope.player = 0;
		run.game->Tick(std::span(&envelope, 1));
	};
	const std::uint64_t soldTick = one.game->CurrentTick() + 1;
	send(one, commands::Sell{one.cannon});
	send(four, commands::Sell{four.cannon});
	// The mines are gone the tick of the sale, none of them dying.
	for (const ecs::Entity mine : one.mines)
		BOOST_TEST(!world.IsAlive(mine));
	BOOST_TEST(Named(*one.game, "ChinaStandardMine").empty());
	const auto &deselected = world.Resource<generalszh::gameplay::Deselections>().list;
	BOOST_TEST((std::ranges::find(deselected, one.cannon) != deselected.end()));
	send(one, commands::Sell{one.airfield});
	send(four, commands::Sell{four.airfield});
	BOOST_TEST((std::ranges::find(deselected, one.airfield) != deselected.end()));
	std::optional<std::uint64_t> parkedDown;
	for (int tick = 0; tick < 10 && !parkedDown; ++tick)
	{
		if (!world.IsAlive(one.parked) || world.Has<gp::Dying>(one.parked) || gp::IsDead(*world.Get<gp::Health>(one.parked)))
			parkedDown = one.game->CurrentTick();
		else
		{
			one.game->Tick();
			four.game->Tick();
		}
	}
	BOOST_TEST_REQUIRE(parkedDown.has_value());
	BOOST_TEST_MESSAGE("cannon sold on " << soldTick << ", airfield on " << soldTick + 1 << ", parked raptor down by " << *parkedDown);
	// Object::kill in sellObject, before the airfield's frame: dead the tick the airfield is sold.
	BOOST_TEST(*parkedDown == soldTick + 1);
	BOOST_TEST(world.IsAlive(one.flying));
	BOOST_TEST(!world.Has<gp::Dying>(one.flying));
	BOOST_TEST(!gp::IsDead(*world.Get<gp::Health>(one.flying)));
	for (int tick = 0; tick < 5; ++tick)
	{
		one.game->Tick();
		four.game->Tick();
	}
	BOOST_TEST(one.game->StateHash() == four.game->StateHash());
	const auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), one.game->Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == one.game->StateHash());
}

// BuildAssistant::buildObjectNow -> moveObjectsForConstruction: an idle Ranger of the builder's player standing where the
// power plant goes is told to move out (aiMoveToPositionEvenIfSleeping) to a spot 0.5 to 1.5 times the plant's reach
// (its box's corner distance * 1.4) from the site; the build goes ahead.
BOOST_AUTO_TEST_CASE(legacy_parity_a_new_building_moves_the_builders_units_out_of_its_way)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, match->Team(game, 0));
	const auto site = match->At(330, 250);
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", site, {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE((world.IsAlive(dozer) && world.IsAlive(ranger)));
	const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
	const auto &plant = *shell.game.objects.Find("AmericaPowerPlant");
	world.Resource<gp::PlayerMoney>().Deposit(america, plant.buildCost);
	auto envelope = commands::Encode(commands::BuildStructure{dozer, "AmericaPowerPlant", site, 0});
	envelope.player = 0;
	game.Tick(std::span(&envelope, 1));
	BOOST_TEST_REQUIRE(world.Get<gp::Builder>(dozer) != nullptr); // built
	const auto &order = *world.Get<gp::MoveOrder>(ranger);
	BOOST_TEST_REQUIRE((order.mode == gp::MoveMode::Point));
	const Fixed major = plant.geometry.majorRadius;
	const Fixed minor = plant.geometry.shape == content::GeometryShape::Box ? plant.geometry.minorRadius : major;
	const double reach = std::sqrt(Engine::Math::ToFloat(major * major + minor * minor)) * 1.4;
	const double dx = Engine::Math::ToFloat(order.destination.x - site.x), dy = Engine::Math::ToFloat(order.destination.y - site.y);
	const double away = std::sqrt(dx * dx + dy * dy);
	BOOST_TEST(away >= 0.5 * reach - 0.01);
	BOOST_TEST(away <= 1.5 * reach + 0.01);
	// Stamped inside the plant's cells, it tunnels out (Pathfinder's tunneling from an invalid start) and ends outside the
	// plant's box (a destination inside it goes to the nearest open cell: adjustDestination).
	for (int tick = 0; tick < 300 && world.Get<gp::MoveOrder>(ranger)->mode != gp::MoveMode::Idle; ++tick)
		game.Tick();
	BOOST_TEST((world.Get<gp::MoveOrder>(ranger)->mode == gp::MoveMode::Idle));
	const auto at = world.Get<gp::Transform>(ranger)->position.XY();
	BOOST_TEST((Engine::Math::Abs(at.x - site.x) > major || Engine::Math::Abs(at.y - site.y) > minor));
	BOOST_TEST(Engine::Math::ToFloat(Engine::Math::Distance(at, order.destination)) < 10.0);
}

// DozerAIUpdate::construct / DozerActionDoActionState: America's dozer (the GLA may not order it) places a power plant:
// its cost is withdrawn, it stands at 0% with one hit point awaiting construction and gives no power; the dozer drives to
// its edge and, stopped there, builds it (ACTIVELY_CONSTRUCTING; the plant PARTIALLY_CONSTRUCTED and
// ACTIVELY_BEING_CONSTRUCTED) a step a tick: calcTimeToBuild frames (BuildTime * 30 over the power-short speed) after it
// starts, it stands at full health and its power counts.
BOOST_AUTO_TEST_CASE(legacy_parity_a_dozer_builds_a_power_plant)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(dozer));
	const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
	const auto &plant = *shell.game.objects.Find("AmericaPowerPlant");
	auto &money = world.Resource<gp::PlayerMoney>();
	money.Deposit(america, plant.buildCost);
	const std::int64_t before = money.Balance(america);
	const std::int64_t powerBefore = world.Resource<gp::PlayerEnergy>().Production(america);
	const auto send = [&](const commands::GameCommand &command, std::uint32_t seat) {
		auto envelope = commands::Encode(command);
		envelope.player = seat;
		game.Tick(std::span(&envelope, 1));
	};
	const auto site = match->At(330, 250);
	send(commands::BuildStructure{dozer, "AmericaPowerPlant", site, 0}, 1);
	BOOST_TEST(money.Balance(america) == before); // not the GLA's dozer
	send(commands::BuildStructure{dozer, "AmericaPowerPlant", site, 0}, 0);
	BOOST_TEST(money.Balance(america) == before - plant.buildCost);
	BOOST_TEST_REQUIRE(world.Get<gp::Builder>(dozer) != nullptr);
	const ecs::Entity built = world.Get<gp::Builder>(dozer)->target;
	BOOST_TEST_REQUIRE(world.IsAlive(built));
	BOOST_TEST(world.Get<gp::Health>(built)->current.Raw() == Fixed::One().Raw());
	BOOST_TEST(world.Get<gp::ConstructionProgress>(built)->percent.Raw() == 0);
	game.Tick();
	BOOST_TEST(world.Get<gp::Appearance>(built)->Test(content::ModelConditionBit("AWAITING_CONSTRUCTION")));
	BOOST_TEST(world.Resource<gp::PlayerEnergy>().Production(america) == powerBefore);
	std::optional<std::uint64_t> started, standing;
	bool seenActive = false;
	for (int tick = 0; tick < 2000 && !standing; ++tick)
	{
		game.Tick();
		const auto *site = world.Get<gp::UnderConstruction>(built);
		if (!started && site != nullptr && site->started != 0)
			started = game.CurrentTick();
		if (site != nullptr && site->started != 0 && world.Get<gp::Appearance>(dozer)->Test(content::ModelConditionBit("ACTIVELY_CONSTRUCTING")) &&
			world.Get<gp::Appearance>(built)->Test(content::ModelConditionBit("ACTIVELY_BEING_CONSTRUCTED")) &&
			world.Get<gp::Appearance>(built)->Test(content::ModelConditionBit("PARTIALLY_CONSTRUCTED")))
			seenActive = true;
		if (site == nullptr)
			standing = game.CurrentTick();
	}
	BOOST_TEST_REQUIRE(started.has_value());
	BOOST_TEST_REQUIRE(standing.has_value());
	BOOST_TEST(seenActive);
	BOOST_TEST_MESSAGE("power plant: started " << *started << ", standing " << *standing);
	const std::uint64_t buildTicks = static_cast<std::uint64_t>((plant.buildTimeSeconds * Fixed::FromInt(30)).Floor());
	// America has no power yet (none made, none used: getEnergySupplyRatio 0), so it builds at MinLowEnergyProductionSpeed
	// (0.5): twice its build time, from the tick of its first step to the one it stands on.
	BOOST_TEST(*standing - *started + 1 == 2 * buildTicks);
	const auto &health = *world.Get<gp::Health>(built);
	BOOST_TEST(health.maximum.Raw() - health.current.Raw() <= Fixed::FromInt(1).Raw());
	game.Tick();
	BOOST_TEST(world.Resource<gp::PlayerEnergy>().Production(america) == powerBefore + plant.energyProduction);
	BOOST_TEST(!world.Get<gp::Appearance>(built)->Test(content::ModelConditionBit("PARTIALLY_CONSTRUCTED")));
	BOOST_TEST(!world.Has<gp::Builder>(dozer));
}

// GameLogic::onDozerCancelConstruct (MSG_DOZER_CANCEL_CONSTRUCT, ControlBar's Command_CancelConstruction): another
// player's cancel does nothing; the owner's refunds the plant's cost to build at once and kills it (Object::kill: its
// death modules run, it dies), and its dozer leaves off building it; a rebuild hole's reconstruction
// (OBJECT_STATUS_RECONSTRUCTING) is not refunded; a standing building is not under construction and is left alone. The
// match runs alike on 1 and 4 workers and restores from a checkpoint exactly.
BOOST_AUTO_TEST_CASE(legacy_parity_cancelling_a_construction_refunds_it_and_destroys_it)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	namespace gp = engine::gameplay;
	const auto &plant = *shell.game.objects.Find("AmericaPowerPlant");
	struct Run
	{
		std::unique_ptr<session::Session> game;
		ecs::Entity dozer, built;
		std::uint32_t america{0};
	};
	const auto start = [&](std::size_t workers) {
		Run run;
		run.game = std::make_unique<session::Session>(match->skirmish.level, shell.game, match->Options(workers));
		auto &world = run.game->World();
		run.dozer = run.game->Place("AmericaVehicleDozer", match->At(250, 250), {}, match->Team(*run.game, 0));
		run.america = world.Get<gp::Owner>(run.dozer)->player;
		world.Resource<gp::PlayerMoney>().Deposit(run.america, plant.buildCost);
		auto envelope = commands::Encode(commands::BuildStructure{run.dozer, "AmericaPowerPlant", match->At(330, 250), 0});
		envelope.player = 0;
		run.game->Tick(std::span(&envelope, 1));
		run.built = world.Get<gp::Builder>(run.dozer)->target;
		for (int tick = 0; tick < 90; ++tick)
			run.game->Tick();
		return run;
	};
	Run one = start(1);
	Run four = start(4);
	auto &world = one.game->World();
	auto &money = world.Resource<gp::PlayerMoney>();
	BOOST_TEST_REQUIRE(world.Has<gp::UnderConstruction>(one.built));
	BOOST_TEST(world.Get<gp::UnderConstruction>(one.built)->started != 0);
	const std::int64_t before = money.Balance(one.america);
	const auto send = [](Run &run, const commands::GameCommand &command, std::uint32_t seat) {
		auto envelope = commands::Encode(command);
		envelope.player = seat;
		run.game->Tick(std::span(&envelope, 1));
	};
	send(one, commands::CancelConstruction{one.built}, 1); // the GLA's seat
	BOOST_TEST(money.Balance(one.america) == before);
	BOOST_TEST(world.IsAlive(one.built));
	BOOST_TEST(!world.Has<gp::Dying>(one.built));
	send(four, commands::CancelConstruction{four.built}, 1);
	const std::uint64_t cancelTick = one.game->CurrentTick() + 1;
	send(one, commands::CancelConstruction{one.built}, 0);
	send(four, commands::CancelConstruction{four.built}, 0);
	BOOST_TEST(money.Balance(one.america) == before + plant.buildCost);
	BOOST_TEST((!world.IsAlive(one.built) || world.Has<gp::Dying>(one.built)));
	std::optional<std::uint64_t> builderLeft, gone;
	for (int tick = 0; tick < 300 && (!builderLeft || !gone); ++tick)
	{
		if (!builderLeft && !world.Has<gp::Builder>(one.dozer))
			builderLeft = one.game->CurrentTick();
		if (!gone && !world.IsAlive(one.built))
			gone = one.game->CurrentTick();
		one.game->Tick();
		four.game->Tick();
	}
	BOOST_TEST_REQUIRE(builderLeft.has_value());
	BOOST_TEST_REQUIRE(gone.has_value());
	BOOST_TEST_MESSAGE("cancelled at " << cancelTick << ": builder left at " << *builderLeft << ", plant gone at " << *gone);
	// DestroyDie's destroyObject at the end of the cancel's frame; the dozer's DozerActionDoActionState finds its goal
	// object gone the frame after (STATE_FAILURE).
	BOOST_TEST(*gone - cancelTick == 0u);
	BOOST_TEST(*builderLeft - cancelTick == 1u);
	BOOST_TEST(one.game->StateHash() == four.game->StateHash());
	const auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), one.game->Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->StateHash() == one.game->StateHash());

	// A reconstruction costs nothing and gives nothing back; a building standing is not cancelled.
	Run again = start(1);
	auto &world2 = again.game->World();
	world2.Get<gp::ConstructionProgress>(again.built)->rebuild = 1;
	const std::int64_t held = world2.Resource<gp::PlayerMoney>().Balance(again.america);
	send(again, commands::CancelConstruction{again.built}, 0);
	BOOST_TEST(world2.Resource<gp::PlayerMoney>().Balance(again.america) == held);
	BOOST_TEST((!world2.IsAlive(again.built) || world2.Has<gp::Dying>(again.built)));
	const ecs::Entity standing = again.game->Place("AmericaPowerPlant", match->At(450, 250), {}, match->Team(*again.game, 0));
	send(again, commands::CancelConstruction{standing}, 0);
	BOOST_TEST(world2.IsAlive(standing));
	BOOST_TEST(!world2.Has<gp::Dying>(standing));
	BOOST_TEST(world2.Resource<gp::PlayerMoney>().Balance(again.america) == held);
}

// BuildAssistant::isLocationLegalToBuild for DozerAIUpdate::construct (TERRAIN_RESTRICTIONS | NO_OBJECT_OVERLAP): not on
// top of a structure or an enemy, not off the map or within MinDistFromEdgeOfMapForBuild (30) of its edge, a supply
// centre (CANNOT_BUILD_NEAR_SUPPLIES) not within SupplyBuildBorder (20) of a supply source; nothing is paid for a refused
// spot. Shrubbery under a structure is cleared (clearRemovableForConstruction).
BOOST_AUTO_TEST_CASE(legacy_parity_structures_go_only_where_they_may)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, team);
	const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
	world.Resource<gp::PlayerMoney>().Deposit(america, 100000);
	game.Tick();
	const auto build = [&](const std::string &what, Engine::Math::FixedVector2 at) {
		const std::int64_t before = world.Resource<gp::PlayerMoney>().Balance(america);
		const ecs::Entity placed = generalszh::gameplay::BeginConstruction(game.Game(), dozer, what, at, {});
		BOOST_TEST((world.IsAlive(placed) == (world.Resource<gp::PlayerMoney>().Balance(america) < before)));
		return world.IsAlive(placed);
	};
	// On a structure: refused.
	game.Place("AmericaBarracks", match->At(400, 250), {}, team);
	game.Tick();
	BOOST_TEST(!build("AmericaPowerPlant", match->At(410, 250)));
	// On an enemy: refused.
	game.Place("GLATankScorpion", match->At(400, 450), {}, match->Team(game, 1));
	game.Tick();
	BOOST_TEST(!build("AmericaPowerPlant", match->At(400, 450)));
	// Off the map, or at its very edge: refused.
	BOOST_TEST(!build("AmericaPowerPlant", {Fixed::FromInt(-100), Fixed::FromInt(-100)}));
	const auto &grid = world.Resource<gp::NavigationGrid>();
	const Fixed middle = Fixed::FromInt(grid.Height() * 5);
	BOOST_TEST(!build("AmericaPowerPlant", {Fixed::FromInt(20), middle}));
	// A supply centre hard by a supply warehouse: refused; with room: built.
	game.Place("SupplyWarehouse", match->At(250, 650), {}, 0);
	game.Tick();
	const auto *center = shell.game.objects.Find("AmericaSupplyCenter");
	const auto why = [&](const content::ObjectDefinition &what, Engine::Math::FixedVector2 at) {
		return generalszh::gameplay::CheckBuildLocation(game.Game(), what, at, {}, dozer);
	};
	// Clear of the warehouse itself but within the border of it: too close to supplies.
	const auto *warehouse = shell.game.objects.Find("SupplyWarehouse");
	const Fixed gap = warehouse->geometry.minorRadius + center->geometry.majorRadius + Fixed::FromInt(10);
	const auto near = match->At(250, 650) - Engine::Math::FixedVector2{{}, gap};
	BOOST_TEST((why(*center, near) == generalszh::gameplay::LegalBuild::TooCloseToSupplies));
	BOOST_TEST(!build("AmericaSupplyCenter", near));
	BOOST_TEST((why(*shell.game.objects.Find("AmericaPowerPlant"), near) == generalszh::gameplay::LegalBuild::Ok)); // others may
	BOOST_TEST((why(*center, match->At(410, 250)) == generalszh::gameplay::LegalBuild::ObjectsInTheWay));
	BOOST_TEST((why(*center, {Fixed::FromInt(20), middle}) == generalszh::gameplay::LegalBuild::RestrictedTerrain));
	// Over a tree: built, the tree cleared.
	const ecs::Entity tree = game.Place("GenericTree", match->At(600, 250), {}, 0);
	game.Tick();
	BOOST_TEST_REQUIRE(world.IsAlive(tree));
	BOOST_TEST(build("AmericaPowerPlant", match->At(600, 250)));
	BOOST_TEST(!world.IsAlive(tree));
}

// BuildAssistant::isLocationClearOfObjects, its "Check for overlapping exit areas" part: a war factory (box, major 53,
// minor 60, FactoryExitWidth 25) keeps a 25-deep strip in front of it (centred 53 + 12.5 ahead along its facing, 60 to
// either side) clear of an IMMOBILE structure; nothing behind it. A power plant (box 22 x 30) whose box starts 5 into that
// strip (centre 80 ahead) is in the way, 1 past it (101 ahead) is not; 76 behind is not; the same for a factory turned
// half round, mirrored. A skirmish AI builder keeps 3 cells (30) of extra width round what it places (its own exit width
// less that, 0 here): 101 ahead is then in the way (its grown box reaches the factory's), 129 is in the way of the
// factory's exit, 131 is not; beside it the original grows the factory's minor radius by the BUILDER'S extra width (30,
// not the factory's own 0): 140 to the side is in the way, 151 is not (60 + 30 + 30 + 30 = 150).
BOOST_AUTO_TEST_CASE(legacy_parity_factory_exits_stay_clear)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace bc = generalszh::gameplay::build_check;
	using generalszh::gameplay::LegalBuild;
	const auto *factory = shell.game.objects.Find("AmericaWarFactory");
	const auto *plant = shell.game.objects.Find("AmericaPowerPlant");
	BOOST_TEST_REQUIRE(factory != nullptr);
	BOOST_TEST_REQUIRE(plant != nullptr);
	BOOST_TEST((factory->factoryExitWidth == Fixed::FromInt(25)));
	BOOST_TEST((factory->factoryExtraBibWidth == Fixed{}));
	BOOST_TEST((factory->geometry.majorRadius == Fixed::FromInt(53)));
	BOOST_TEST((factory->geometry.minorRadius == Fixed::FromInt(60)));
	BOOST_TEST((plant->factoryExitWidth == Fixed{}));
	BOOST_TEST((plant->geometry.majorRadius == Fixed::FromInt(22)));
	BOOST_TEST((plant->geometry.minorRadius == Fixed::FromInt(30)));
	const std::uint32_t team = match->Team(game, 0);
	// Over open ground south-west of the start, clear of structures within the check's reach (the start's command centre
	// and riverside houses would otherwise be in the way).
	const auto at = [&](int dx, int dy) { return match->At(dx - 1050, dy - 500); };
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", at(250, 250), {}, team);
	game.Place("AmericaWarFactory", at(450, 250), {}, team);
	game.Place("AmericaWarFactory", at(450, 650), Engine::Math::TurnAngle::Half_Turn(), team);
	game.Tick();
	const auto why = [&](int dx, int dy) {
		return generalszh::gameplay::CheckBuildLocation(game.Game(), *plant, at(dx, dy), {}, dozer, bc::NoObjectOverlap);
	};
	BOOST_TEST((why(450 + 80, 250) == LegalBuild::ObjectsInTheWay));
	BOOST_TEST((why(450 + 101, 250) == LegalBuild::Ok));
	BOOST_TEST((why(450 - 76, 250) == LegalBuild::Ok));
	BOOST_TEST((why(450 - 80, 650) == LegalBuild::ObjectsInTheWay));
	BOOST_TEST((why(450 - 101, 650) == LegalBuild::Ok));
	BOOST_TEST((why(450 + 76, 650) == LegalBuild::Ok));
	BOOST_TEST((why(450, 250 + 140) == LegalBuild::Ok)); // a human's: no extra width
	// Only enemies (NO_ENEMY_OBJECT_OVERLAP alone) never looks at exits.
	BOOST_TEST((generalszh::gameplay::CheckBuildLocation(game.Game(), *plant, at(450 + 80, 250), {}, dozer, bc::NoEnemyObjectOverlap) ==
		LegalBuild::Ok));
	// The same builder's player made a skirmish AI.
	const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
	auto *ais = world.FindResource<generalszh::gameplay::AiPlayers>();
	if (ais == nullptr)
		ais = &world.EmplaceResource<generalszh::gameplay::AiPlayers>();
	if (auto *ai = ais->Of(america); ai != nullptr)
		ai->skirmish = true;
	else
	{
		generalszh::gameplay::AiPlayer added;
		added.player = america;
		added.skirmish = true;
		ais->players.push_back(added);
	}
	BOOST_TEST((why(450 + 101, 250) == LegalBuild::ObjectsInTheWay));
	BOOST_TEST((why(450 + 129, 250) == LegalBuild::ObjectsInTheWay));
	BOOST_TEST((why(450 + 131, 250) == LegalBuild::Ok));
	BOOST_TEST((why(450, 250 + 140) == LegalBuild::ObjectsInTheWay));
	BOOST_TEST((why(450, 250 + 151) == LegalBuild::Ok));
}

// A builder sent to a structure (canRepairObject / DOZER_TASK_REPAIR): America's dozer repairs its damaged barracks
// at RepairHealthPercentPerSecond (2%) of its most health a second (a thirtieth of that a frame) until whole; a GLA
// dozer may not repair it (an enemy's). A build stopped by the player's Stop waits where it got to; sent back to it
// (canResumeConstructionOf) the dozer finishes it.
BOOST_AUTO_TEST_CASE(legacy_parity_dozers_repair_and_resume)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, team);
	const ecs::Entity enemyDozer = game.Place("ChinaVehicleDozer", match->At(250, 350), {}, match->Team(game, 1));
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(350, 250), {}, team);
	const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
	world.Resource<gp::PlayerMoney>().Deposit(america, 100000);
	const auto send = [&](const commands::GameCommand &command, std::uint32_t seat) {
		auto envelope = commands::Encode(command);
		envelope.player = seat;
		game.Tick(std::span(&envelope, 1));
	};
	auto &health = *world.Get<gp::Health>(barracks);
	health.current = health.maximum / Fixed::FromInt(2);
	send(commands::WorkOn{enemyDozer, barracks}, 1);
	BOOST_TEST(!world.Has<gp::Builder>(enemyDozer));
	send(commands::WorkOn{dozer, barracks}, 0);
	BOOST_TEST_REQUIRE(world.Has<gp::Builder>(dozer));
	BOOST_TEST(world.Get<gp::Builder>(dozer)->repair == 1u);
	// Once at work: 2% / 30 of its most health a frame.
	for (int tick = 0; tick < 600 && world.Get<gp::Builder>(dozer)->atWork == 0; ++tick)
		game.Tick();
	game.Tick();
	// Every frame 2% / 30 of its most health; every third frame its base regeneration adds its own (BaseRegenerateUpdate:
	// BaseRegenHealthPercentPerSecond 0.3%, three frames' worth, once damage-free BaseRegenDelay).
	const Fixed step = world.Get<gp::Health>(barracks)->maximum * (Fixed::FromRatio(2, 100) / Fixed::FromInt(30));
	std::vector<std::int64_t> deltas;
	for (int tick = 0; tick < 3; ++tick)
	{
		const Fixed was = world.Get<gp::Health>(barracks)->current;
		game.Tick();
		deltas.push_back((world.Get<gp::Health>(barracks)->current - was).Raw());
	}
	BOOST_TEST(std::count(deltas.begin(), deltas.end(), step.Raw()) == 2);
	BOOST_TEST(*std::max_element(deltas.begin(), deltas.end()) > step.Raw());
	for (int tick = 0; tick < 3000 && world.Has<gp::Builder>(dozer); ++tick)
		game.Tick();
	BOOST_TEST(!world.Has<gp::Builder>(dozer));
	BOOST_TEST(world.Get<gp::Health>(barracks)->current.Raw() == world.Get<gp::Health>(barracks)->maximum.Raw());

	// Build, stop, resume.
	send(commands::BuildStructure{dozer, "AmericaPowerPlant", match->At(250, 450), 0}, 0);
	BOOST_TEST_REQUIRE(world.Has<gp::Builder>(dozer));
	const ecs::Entity plant = world.Get<gp::Builder>(dozer)->target;
	for (int tick = 0; tick < 2000 && world.Get<gp::ConstructionProgress>(plant)->percent < Fixed::FromInt(20); ++tick)
		game.Tick();
	send(commands::Stop{{dozer}}, 0);
	BOOST_TEST(!world.Has<gp::Builder>(dozer));
	const Fixed stopped = world.Get<gp::ConstructionProgress>(plant)->percent;
	for (int tick = 0; tick < 60; ++tick)
		game.Tick();
	BOOST_TEST(world.Get<gp::ConstructionProgress>(plant)->percent.Raw() == stopped.Raw()); // waits
	BOOST_TEST(world.Has<gp::UnderConstruction>(plant));
	send(commands::WorkOn{dozer, plant}, 0);
	BOOST_TEST_REQUIRE(world.Has<gp::Builder>(dozer));
	BOOST_TEST(world.Get<gp::Builder>(dozer)->repair == 0u);
	for (int tick = 0; tick < 3000 && world.Has<gp::UnderConstruction>(plant); ++tick)
		game.Tick();
	BOOST_TEST(!world.Has<gp::UnderConstruction>(plant));
}

// BuildAssistant::canMakeUnit: America's dozer may not make a war factory until its player owns a supply centre (its
// Prerequisites), nor anything its command set has no DOZER_CONSTRUCT button for (China's power plant), nor what it
// cannot pay for; Colonel Burton (MaxSimultaneousOfType 1) is maxed out while one stands; and a structure refused
// costs nothing and is not placed.
BOOST_AUTO_TEST_CASE(legacy_parity_what_a_builder_may_make)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	using generalszh::gameplay::CanMake;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, team);
	const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
	auto &money = world.Resource<gp::PlayerMoney>();
	money.Deposit(america, 100000);
	const auto can = [&](ecs::Entity builder, const char *what) {
		return generalszh::gameplay::CanMakeUnit(game.Game(), builder, *shell.game.objects.Find(what));
	};
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::NoPrerequisites));
	const std::int64_t before = money.Balance(america);
	BOOST_TEST(!world.IsAlive(generalszh::gameplay::BeginConstruction(game.Game(), dozer, "AmericaWarFactory", match->At(400, 400), {})));
	BOOST_TEST(money.Balance(america) == before);
	// ProductionPrerequisite::calcNumPrereqUnitsOwned -> countObjectsByThingTemplate(ignoreUnderConstruction TRUE): a
	// Supply Center still being built is no prerequisite; finished, it is.
	const ecs::Entity center = game.Place("AmericaSupplyCenter", match->At(600, 600), {}, team);
	world.Add<gp::UnderConstruction>(center);
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::NoPrerequisites));
	world.Remove<gp::UnderConstruction>(center);
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::Ok));
	BOOST_TEST((can(dozer, "ChinaPowerPlant") == CanMake::NoPrerequisites)); // not in its command set
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(700, 300), {}, team);
	game.Place("AmericaInfantryColonelBurton", match->At(300, 700), {}, team);
	BOOST_TEST((can(barracks, "AmericaInfantryColonelBurton") == CanMake::MaxedOut));
	money.Withdraw(america, money.Balance(america));
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::NoMoney));
}

// ScriptActions::doModifyBuildableStatus -> GameLogic::setBuildableStatusOverride, read through ThingTemplate::getBuildable
// by Player::canBuild: a script makes the Ranger unbuildable (No) at America's barracks; Ignore_Prerequisites lets the
// dozer make a war factory with no supply centre; Only_By_AI keeps a human player from it (a computer may); Yes again
// gives back the prerequisites. A checkpoint keeps what the scripts set.
BOOST_AUTO_TEST_CASE(legacy_parity_scripts_change_what_may_be_built)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	engine::level::Level level = match->skirmish.level;
	engine::level::Script script;
	script.name = "techtree";
	script.oneShot = true;
	engine::level::ScriptCall always;
	always.name = "CONDITION_TRUE";
	script.conditions = {{always}};
	engine::level::ScriptCall modify;
	modify.name = "TECHTREE_MODIFY_BUILDABILITY_OBJECT";
	engine::level::ScriptParameter type, status;
	type.text = "AmericaInfantryRanger";
	status.integer = 2;
	modify.parameters = {type, status};
	script.actions = {modify};
	level.scenario.participants.front().scripts.scripts.push_back(script);
	session::Session game(level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	using generalszh::gameplay::CanMake;
	using Buildable = generalszh::content::ObjectDefinition::Buildable;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, team);
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(700, 300), {}, team);
	world.Resource<gp::PlayerMoney>().Deposit(world.Get<gp::Owner>(dozer)->player, 100000);
	const auto can = [&](ecs::Entity builder, const char *what) {
		return generalszh::gameplay::CanMakeUnit(game.Game(), builder, *shell.game.objects.Find(what));
	};
	BOOST_TEST((can(barracks, "AmericaInfantryRanger") == CanMake::Ok));
	game.Tick();
	auto &overrides = world.Resource<generalszh::gameplay::BuildableOverrides>();
	BOOST_TEST_REQUIRE(overrides.types.count("AmericaInfantryRanger") == 1u);
	BOOST_TEST((can(barracks, "AmericaInfantryRanger") == CanMake::NoPrerequisites));
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::NoPrerequisites)); // no supply centre
	overrides.types["AmericaWarFactory"] = Buildable::IgnorePrerequisites;
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::Ok));
	overrides.types["AmericaWarFactory"] = Buildable::OnlyByAI;
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::NoPrerequisites));
	const auto saved = game.Checkpoint();
	auto restored = session::Session::Restore(level, shell.game, match->Options(1), saved);
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST((restored->World().Resource<generalszh::gameplay::BuildableOverrides>().types == overrides.types));
	overrides.types["AmericaWarFactory"] = Buildable::Yes;
	BOOST_TEST((can(dozer, "AmericaWarFactory") == CanMake::NoPrerequisites));
}

// Legacy parity (ScriptActions::doOverrideHulkLifetime, LifetimeUpdate::LifetimeUpdate): a Tomahawk hulk lives 45 to 48
// ticks (MinLifetime 1500, MaxLifetime 1600 ms); once a script overrides hulks to 2 seconds, one made lives exactly 60
// ticks; a checkpoint keeps the override; below zero gives them their own again.
BOOST_AUTO_TEST_CASE(legacy_parity_a_script_overrides_how_long_hulks_last)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	engine::level::Level level = match->skirmish.level;
	engine::level::Script script;
	script.name = "hulks";
	script.oneShot = true;
	engine::level::ScriptCall always;
	always.name = "CONDITION_TRUE";
	script.conditions = {{always}};
	engine::level::ScriptCall overrideHulks;
	overrideHulks.name = "SCRIPTING_OVERRIDE_HULK_LIFETIME";
	engine::level::ScriptParameter seconds;
	seconds.number = Engine::Math::Fixed::FromInt(2);
	overrideHulks.parameters = {seconds};
	script.actions = {overrideHulks};
	level.scenario.participants.front().scripts.scripts.push_back(script);
	session::Session game(level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity before = game.Place("AmericaVehicleTomahawkHulk", match->At(250, 250), {}, team);
	const std::uint64_t made = game.Game().tick;
	BOOST_TEST_REQUIRE(world.Get<gp::Lifetime>(before) != nullptr);
	const std::uint64_t own = world.Get<gp::Lifetime>(before)->expiresTick - made;
	BOOST_TEST((own >= 45u && own <= 48u));
	game.Tick();
	BOOST_TEST(world.Resource<gp::HulkLifetime>().overrideTicks == 60);
	const ecs::Entity after = game.Place("AmericaVehicleTomahawkHulk", match->At(300, 250), {}, team);
	BOOST_TEST(world.Get<gp::Lifetime>(after)->expiresTick - game.Game().tick == 60u);
	auto restored = session::Session::Restore(level, shell.game, match->Options(1), game.Checkpoint());
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->World().Resource<gp::HulkLifetime>().overrideTicks == 60);
}

// CommandSetUpgrade::upgradeImplementation on China's internet centre: Upgrade_ChinaMines (its player's) gives it
// ChinaInternetCenterCommandSetOneUpgrade; then Upgrade_ChinaSatelliteHackOne (its own) fires the other module, whose
// TriggerAlt (the mines) is had, so it takes the alternative, ChinaInternetCenterCommandSetTwoUpgrade.
BOOST_AUTO_TEST_CASE(legacy_parity_upgrades_swap_command_sets)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity center = game.Place("ChinaInternetCenter", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(center));
	game.Tick();
	BOOST_TEST(!world.Has<generalszh::gameplay::CommandSetOverride>(center));
	const std::uint32_t player = world.Get<gp::Owner>(center)->player;
	world.Resource<gp::PlayerUpgrades>().Grant(player, *shell.game.upgrades.Find("Upgrade_ChinaMines"));
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	const auto set = [&] {
		const auto *swapped = world.Get<generalszh::gameplay::CommandSetOverride>(center);
		return swapped != nullptr ? std::string(game.Game().templates.CommandSetName(swapped->id)) : std::string{};
	};
	BOOST_TEST(set() == "ChinaInternetCenterCommandSetOneUpgrade");
	auto &own = *world.Get<gp::Upgradable>(center);
	own.completed.Set(*shell.game.upgrades.Find("Upgrade_ChinaSatelliteHackOne"));
	own.stale = 1;
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	BOOST_TEST(set() == "ChinaInternetCenterCommandSetTwoUpgrade");
}

// DozerAIUpdate::findGoodBuildOrRepairPosition / newTask: a dozer's dock for a barracks is findPositionAround's first
// spot within 100 of the point half the barracks' major radius from its centre towards the dozer, clear of every object
// but the dozer within 5 (so off the barracks' own footprint), within 10 in height of that point; its end dock point is
// 5 cells (50) further out from the barracks.
BOOST_AUTO_TEST_CASE(legacy_parity_a_dozer_docks_beside_its_structure)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(400, 300), {}, team);
	const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(600, 300), {}, team);
	game.Tick();
	const auto docks = generalszh::gameplay::FindDocks(game.Game(), dozer, barracks);
	const auto centre = world.Get<gp::Transform>(barracks)->position;
	const auto &definition = *shell.game.objects.Find("AmericaBarracks");
	const auto toward = Engine::Math::Normalize(world.Get<gp::Transform>(dozer)->position - centre);
	const auto working = (centre + toward * (definition.geometry.majorRadius / Fixed::FromInt(2))).XY();
	BOOST_TEST(Engine::Math::DistanceSquared(docks.action, working).Raw() <= (Fixed::FromInt(100) * Fixed::FromInt(100)).Raw());
	const gp::Footprint probe{gp::FootprintShape::Circle, Fixed::FromInt(5), Fixed::FromInt(5)};
	BOOST_TEST(!gp::FootprintsOverlap(probe, docks.action, {}, generalszh::gameplay::FootprintOf(definition), centre.XY(), world.Get<gp::Transform>(barracks)->facing));
	const auto away = docks.leave - docks.action;
	// Fixed point: the normalize and the length each round (11 raw units here, 1/65536 each): 16 covers it.
	BOOST_TEST(std::abs((Engine::Math::Length(away) - Fixed::FromInt(50)).Raw()) <= 16);
	BOOST_TEST(Engine::Math::DistanceSquared(docks.leave, centre.XY()).Raw() > Engine::Math::DistanceSquared(docks.action, centre.XY()).Raw());
}

// A combat bike's death (GLAVehicle.ini; ObjectCreationList.ini; ObjectCreationList.cpp). Its Rebel rides it
// (RiderChangeContain::onContaining: STATUS_RIDER2), so of its slow deaths only DeathTag_06 applies (DieMuxData::
// isDieApplicable): FX_BuggyNewDeathExplosion and OCL_RebelFlyingOffBikeDeathStart at once, never another rider's list
// or the terrorist's SuicideBikeBomb. That list throws the bike (ApplyRandomForceNugget: 60-100 at 70-90 degrees
// over its mass of 15, spinning up to 120 degrees a second each way) and throws the Rebel off as debris
// (GenericObjectCreationNugget, CreateDebris): UITech_Man_SKN with one of its three animation sets, FXFinal
// FX_TechnicalGunnerHitsGround, its player's colour, mass 5, RANDOM_FORCE of 12-15 at 70-80 degrees plus the
// bike's velocity (INHERIT_VELOCITY). DestructionDelay 0: the bike goes at once and OCL_CombatBikeAirDeathStart
// throws GLACombatBikeFullDebris, whose own death (500-2000 ms later) throws its tires and scrap (OCL_CombatBikeAirDeath),
// the scrap with its BounceSound VehicleDebris each time it lands (PhysicsBehavior::doBounceSound).
// Tolerance: the force's direction goes through fixed-point sine and cosine, a few thousandths.
BOOST_AUTO_TEST_CASE(legacy_parity_a_combat_bike_throws_its_rider_as_it_dies)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity bike = game.Place("GLAVehicleCombatBike", match->At(200, 200), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(bike));
	BOOST_TEST_REQUIRE(world.Get<gp::StatusFlags>(bike) != nullptr);
	BOOST_TEST(world.Get<gp::StatusFlags>(bike)->bits == (std::uint64_t{1} << content::ObjectStatusBit("STATUS_RIDER2")));
	game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(bike);
	game.Tick();
	std::vector<std::string> played;
	for (const gp::DeathEvent &event : game.DeathEvents())
		if (event.entity == bike)
			played.emplace_back(game.DeathEffectName(event.kind, event.id));
	const auto has = [&](std::string_view name) { return std::find(played.begin(), played.end(), name) != played.end(); };
	BOOST_TEST(has("FX_BuggyNewDeathExplosion"));
	BOOST_TEST(has("OCL_RebelFlyingOffBikeDeathStart"));
	BOOST_TEST(!has("OCL_WorkerFlyingOffBikeDeathStart"));
	BOOST_TEST(!has("OCL_TerroristFlyingOffBikeDeathStart"));
	BOOST_TEST(!has("SuicideBikeBomb"));

	const auto near = [](double value, double low, double high) { return value >= low - 0.005 && value <= high + 0.005; };
	const auto toDouble = [](Fixed value) { return static_cast<double>(value.Raw()) / 65536.0; };
	constexpr double Degrees = 3.14159265358979 / 180.0;
	std::size_t riders = 0;
	for (const ecs::Entity piece : Named(game, "GenericDebris"))
	{
		const auto *look = world.Get<gp::DebrisLook>(piece);
		const auto *model = world.Get<gp::ModelOverride>(piece);
		BOOST_TEST_REQUIRE(look != nullptr);
		BOOST_TEST_REQUIRE(model != nullptr);
		if (game.ModelName(model->model) != "UITech_Man_SKN")
			continue;
		++riders;
		const std::string initial(game.ModelName(look->animations[0]));
		BOOST_TEST((initial == "UITech_Man_SKL.UITech_Man_DTA1" || initial == "UITech_Man_SKL.UITech_Man_DTB1" || initial == "UITech_Man_SKL.UITech_Man_DTC1"));
		const std::string set = initial.substr(initial.size() - 2, 1);
		BOOST_TEST(std::string(game.ModelName(look->animations[1])) == "UITech_Man_SKL.UITech_Man_DT" + set + "2");
		BOOST_TEST(std::string(game.ModelName(look->animations[2])) == "UITech_Man_SKL.UITech_Man_DT" + set + "3");
		BOOST_TEST(look->finalStop == 0u);
		BOOST_TEST(look->playerColor == 1u);
		BOOST_TEST(game.DeathEffectName(gp::DeathEffectKind::Effect, look->finalEffect) == "FX_TechnicalGunnerHitsGround");
		const auto *body = world.Get<gp::PhysicsBody>(piece);
		BOOST_TEST_REQUIRE(body != nullptr);
		BOOST_TEST(body->mass.Raw() == Fixed::FromInt(5).Raw());
		// Its throw (the bike stood still: nothing inherited) as this tick's acceleration: force / 5.
		const double ax = toDouble(body->acceleration.x), ay = toDouble(body->acceleration.y), az = toDouble(body->acceleration.z);
		const double magnitude = std::sqrt(ax * ax + ay * ay + az * az) * 5.0;
		BOOST_TEST(near(magnitude, 12.0, 15.0));
		BOOST_TEST(near(std::asin(az * 5.0 / magnitude) / Degrees, 70.0, 80.0));
		BOOST_TEST(world.Get<gp::BounceSound>(piece) == nullptr);
	}
	BOOST_TEST(riders == 1u);
	BOOST_TEST(Named(game, "GLACombatBikeFullDebris").size() == 1u);

	// The hulk comes apart in the air 500-2000 ms on (15-60 frames); the scrap bounces with its sound.
	std::size_t bounces = 0, tires = 0, scrap = 0;
	for (int tick = 0; tick < 300; ++tick)
	{
		game.Tick();
		world.Resource<gp::Landings>().ForEach([&](const gp::Landing &landing) {
			BOOST_TEST(game.DeathEffectName(gp::DeathEffectKind::Sound, landing.sound) == "VehicleDebris");
			++bounces;
		});
		std::size_t scrapNow = 0, tiresNow = 0;
		for (const ecs::Entity piece : Named(game, "GenericDebris"))
		{
			const std::string_view name = game.ModelName(world.Get<gp::ModelOverride>(piece)->model);
			const auto *sound = world.Get<gp::BounceSound>(piece);
			if (name == "UVComBike_D3")
			{
				++scrapNow;
				BOOST_TEST(sound != nullptr);
				BOOST_TEST(world.Get<gp::DebrisLook>(piece)->playerColor == 0u);
			}
			else
			{
				tiresNow += name == "UVComBike_D2" ? 1u : 0u;
				BOOST_TEST(sound == nullptr);
			}
		}
		scrap = std::max(scrap, scrapNow);
		tires = std::max(tires, tiresNow);
	}
	BOOST_TEST(tires == 2u);
	BOOST_TEST(scrap == 2u);
	BOOST_TEST(bounces >= 2u);
}

// A veteran Humvee's pilot ejects (EjectPilotDie: OCL_EjectPilotOnGround, InvulnerableTime 2000 ms = 60 frames):
// GenericObjectCreationNugget::reallyCreate calls Object::goInvulnerable, so for 60 frames the pilot is an undetected
// defector (Object::getRelationship: everyone treats it as their own) and an enemy Rebel beside it does not pick it
// (ObjectDefectionHelper::update ends the cover once now >= its end). After that the Rebel finds it on a later scan.
BOOST_AUTO_TEST_CASE(legacy_parity_an_ejected_pilot_is_not_targeted_while_invulnerable)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(400, 400), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(humvee));
	world.Get<gp::Experience>(humvee)->level = 1;
	game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(humvee);
	game.Tick();
	const std::uint64_t ejected = game.CurrentTick();
	const auto pilots = Named(game, "AmericaInfantryPilot");
	BOOST_TEST_REQUIRE(pilots.size() == 1u);
	const ecs::Entity pilot = pilots.front();
	BOOST_TEST_REQUIRE(world.Get<gp::UndetectedDefector>(pilot) != nullptr);
	BOOST_TEST(world.Get<gp::UndetectedDefector>(pilot)->until == ejected + 60);
	BOOST_TEST((world.Get<gp::Targetable>(pilot)->classes & gp::target_class::Undetected) != 0u);
	const auto &at = world.Get<gp::Transform>(pilot)->position;
	const ecs::Entity rebel = game.Place("GLAInfantryRebel", {at.x + Fixed::FromInt(40), at.y}, {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(rebel));
	std::optional<std::uint64_t> covered, targeted;
	for (int tick = 0; tick < 200 && !targeted; ++tick)
	{
		game.Tick();
		if (!covered && world.Get<gp::UndetectedDefector>(pilot) == nullptr)
			covered = game.CurrentTick();
		if (world.IsAlive(pilot) && world.Get<gp::AttackTarget>(rebel)->target == pilot)
			targeted = game.CurrentTick();
	}
	BOOST_TEST_REQUIRE(covered.has_value());
	BOOST_TEST(*covered == ejected + 60); // its cover ends on its 60th frame
	BOOST_TEST_REQUIRE(targeted.has_value());
	BOOST_TEST(*targeted >= ejected + 60);
	BOOST_TEST(*targeted <= ejected + 60 + 60); // on its next scan (MoodAttackCheckRate: 2 s at most)
}

// ObjectCreationUpgrade with OCL_OverlordGattlingCannon (ContainInsideSourceObject: ObjectCreationList.cpp
// reallyCreate) and OverlordContain: the upgraded Overlord gets its ChinaTankOverlordGattlingCannon mounted (a portable
// structure: on it, off the map for all but its own fighting, armed as PassengersAllowedToFire says), which rides where
// the Overlord is and fires at a rebel in reach, looking as damaged as the Overlord; a second creation finds it taken and
// the new cannon is stillborn. Killed,
// the Overlord takes its cannon with it that tick (OverlordContain::onDie: kill()).
BOOST_AUTO_TEST_CASE(legacy_parity_an_overlords_gattling_cannon_mounts_fights_and_dies_with_it)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity overlord = game.Place("ChinaTankOverlord", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(overlord));
	BOOST_TEST(world.Get<gp::Transport>(overlord)->definition.mountsPortable);
	game.Tick();
	auto *upgradable = world.Get<gp::Upgradable>(overlord);
	BOOST_TEST_REQUIRE(upgradable != nullptr);
	upgradable->completed.Set(*shell.game.upgrades.Find("Upgrade_ChinaOverlordGattlingCannon"));
	upgradable->stale = 1;
	for (int tick = 0; tick < 3; ++tick)
		game.Tick();
	const auto cannons = Named(game, "ChinaTankOverlordGattlingCannon");
	BOOST_TEST_REQUIRE(cannons.size() == 1u);
	const ecs::Entity cannon = cannons.front();
	BOOST_TEST_REQUIRE(world.Get<gp::Mounted>(cannon) != nullptr);
	BOOST_TEST((world.Get<gp::Mounted>(cannon)->carrier == overlord));
	BOOST_TEST((world.Get<gp::Mount>(overlord)->rider == cannon));
	BOOST_TEST_REQUIRE(world.Get<gp::OffMap>(cannon) != nullptr);
	BOOST_TEST(world.Get<gp::OffMap>(cannon)->armed);
	BOOST_TEST((world.Get<gp::Transform>(cannon)->position == world.Get<gp::Transform>(overlord)->position));
	// ExperienceSinkForRider: what it kills makes the Overlord a veteran.
	BOOST_TEST((world.Get<gp::Experience>(cannon)->sink == overlord));
	// Taken: a second cannon made for it is stillborn.
	const ecs::Entity spare = game.Place("ChinaTankOverlordGattlingCannon", match->At(360, 300), {}, match->Team(game, 0));
	BOOST_TEST(!generalszh::gameplay::ContainInSource(game.Game(), overlord, spare));
	world.Resource<gp::KillRequests>().entities.push_back(spare);
	// It fights from on top: a rebel in reach is shot at.
	const ecs::Entity rebel = game.Place("GLAInfantryRebel", match->At(300, 400), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(rebel));
	const Fixed full = world.Get<gp::Health>(rebel)->current;
	bool hurt = false;
	for (int tick = 0; tick < 150 && !hurt; ++tick)
	{
		game.Tick();
		const gp::Health *body = world.IsAlive(rebel) ? world.Get<gp::Health>(rebel) : nullptr;
		hurt = body != nullptr && body->current < full && body->lastAttacker == cannon;
	}
	BOOST_TEST(hurt);
	BOOST_TEST((world.Get<gp::Transform>(cannon)->position == world.Get<gp::Transform>(overlord)->position));
	// OverlordContain::onCapture: the cannon goes over with it (to its new player's default team).
	{
		const std::uint32_t other = match->Team(game, 1);
		generalszh::gameplay::ChangeTeam(game.Game(), overlord, other);
		game.Tick();
		BOOST_TEST(world.Get<gp::Owner>(cannon)->player == world.Get<gp::Owner>(overlord)->player);
		generalszh::gameplay::ChangeTeam(game.Game(), overlord, match->Team(game, 0));
		game.Tick();
		BOOST_TEST(world.Get<gp::Owner>(cannon)->player == world.Get<gp::Owner>(overlord)->player);
	}
	// OverlordContain::onBodyDamageStateChange: the cannon looks as damaged as the Overlord (whose health it never loses).
	const auto looks = [&](const char *condition) { return world.Get<gp::Appearance>(cannon)->Test(content::ModelConditionBit(condition)); };
	BOOST_TEST(!looks("DAMAGED"));
	world.Get<gp::Health>(overlord)->current = world.Get<gp::Health>(overlord)->maximum / Fixed::FromInt(2);
	game.Tick();
	BOOST_TEST(looks("DAMAGED"));
	BOOST_TEST(!looks("REALLYDAMAGED"));
	world.Get<gp::Health>(overlord)->current = world.Get<gp::Health>(overlord)->maximum / Fixed::FromInt(5);
	game.Tick();
	BOOST_TEST(looks("REALLYDAMAGED"));
	BOOST_TEST(!looks("DAMAGED"));
	// Killed, it takes its cannon with it.
	world.Resource<gp::KillRequests>().entities.push_back(overlord);
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Dying>(overlord) != nullptr);
	BOOST_TEST((!world.IsAlive(cannon) || world.Get<gp::Dying>(cannon) != nullptr));
}

// Legacy parity (OverlordContain::onObjectCreated -> createPayload, PayloadTemplateName): an America Avenger
// (OverlordContain PayloadTemplateName AmericaTankAvengerLaserTurret, ExperienceSinkForRider Yes) carries its laser
// turret mounted from the start, on its own team, sharing its position; the turret's experience goes to the Avenger.
// It shoots from on top: a Comanche in reach is hit by the turret.
BOOST_AUTO_TEST_CASE(legacy_parity_an_avenger_is_made_with_its_laser_turret)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity avenger = game.Place("AmericaTankAvenger", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(avenger));
	game.Tick();
	const auto turrets = Named(game, "AmericaTankAvengerLaserTurret");
	BOOST_TEST_REQUIRE(turrets.size() == 1u);
	const ecs::Entity turret = turrets.front();
	BOOST_TEST_REQUIRE(world.Get<gp::Mounted>(turret) != nullptr);
	BOOST_TEST((world.Get<gp::Mounted>(turret)->carrier == avenger));
	BOOST_TEST((world.Get<gp::Mount>(avenger)->rider == turret));
	BOOST_TEST(world.Get<gp::TeamMember>(turret)->team == world.Get<gp::TeamMember>(avenger)->team);
	BOOST_TEST((world.Get<gp::Transform>(turret)->position == world.Get<gp::Transform>(avenger)->position));
	BOOST_TEST((world.Get<gp::Experience>(turret)->sink == avenger));
	const ecs::Entity comanche = game.Place("AmericaVehicleComanche", match->At(300, 420), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(comanche));
	const Fixed full = world.Get<gp::Health>(comanche)->current;
	bool hurt = false;
	for (int tick = 0; tick < 300 && !hurt; ++tick)
	{
		game.Tick();
		const gp::Health *body = world.IsAlive(comanche) ? world.Get<gp::Health>(comanche) : nullptr;
		hurt = body != nullptr && body->current < full && body->lastAttacker == turret;
	}
	BOOST_TEST(hurt);
}

// OverlordContain::getRedirectedContain with OCL_OverlordBattleBunker: carrying its ChinaTankOverlordBattleBunker, the
// Overlord takes infantry in as the bunker does (its TransportContain: 5 slots, PassengersAllowedToFire): a Red Guard
// ordered in rides armed; killed, the Overlord takes the bunker with it, whose riders take DamagePercentToUnits 50% of
// their most and get out (TransportContain::onDie), rather than the Overlord's 100%.
BOOST_AUTO_TEST_CASE(legacy_parity_an_overlords_battle_bunker_takes_its_passengers)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity overlord = game.Place("ChinaTankOverlord", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(overlord));
	BOOST_TEST(world.Get<gp::Transport>(overlord)->definition.slots == 1u);
	game.Tick();
	// OpenContain::isValidContainerFor: bare, it takes only its portable structure (AllowInsideKindOf PORTABLE_STRUCTURE).
	const ecs::Entity early = game.Place("ChinaInfantryRedguard", match->At(330, 340), {}, match->Team(game, 0));
	generalszh::gameplay::OrderBoard(game.Game(), early, overlord);
	BOOST_TEST(!world.Has<gp::Boarding>(early));
	auto *upgradable = world.Get<gp::Upgradable>(overlord);
	upgradable->completed.Set(*shell.game.upgrades.Find("Upgrade_ChinaOverlordBattleBunker"));
	upgradable->stale = 1;
	for (int tick = 0; tick < 3; ++tick)
		game.Tick();
	const auto bunkers = Named(game, "ChinaTankOverlordBattleBunker");
	BOOST_TEST_REQUIRE(bunkers.size() == 1u);
	BOOST_TEST((world.Get<gp::Mount>(overlord)->rider == bunkers.front()));
	const gp::TransportDefinition &carrying = world.Get<gp::Transport>(overlord)->definition;
	BOOST_TEST(carrying.slots == 5u);
	BOOST_TEST(carrying.passengersFire);
	BOOST_TEST((carrying.riderDamage == Fixed::FromRatio(1, 2)));
	BOOST_TEST(carrying.mountsPortable);
	const ecs::Entity guard = game.Place("ChinaInfantryRedguard", match->At(330, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(guard));
	generalszh::gameplay::OrderBoard(game.Game(), guard, overlord);
	for (int tick = 0; tick < 300 && world.Get<gp::Passenger>(guard) == nullptr; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Passenger>(guard) != nullptr);
	BOOST_TEST((world.Get<gp::Passenger>(guard)->transport == overlord));
	BOOST_TEST(world.Get<gp::OffMap>(guard)->armed);
	const Fixed most = world.Get<gp::Health>(guard)->maximum;
	world.Resource<gp::KillRequests>().entities.push_back(overlord);
	game.Tick();
	BOOST_TEST_REQUIRE(world.IsAlive(guard));
	BOOST_TEST(world.Get<gp::Dying>(guard) == nullptr);
	BOOST_TEST(world.Get<gp::Passenger>(guard) == nullptr);
	BOOST_TEST((world.Get<gp::Health>(guard)->current == most - most / Fixed::FromInt(2)));
}

// HelixContain (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Contain/HelixContain.cpp) on the shipped
// ChinaVehicleHelix: a Red Guard aboard rides 8 above it (redeployOccupants), held (onContaining: DISABLED_HELD) and
// garrisoned (WEAPONBONUSCONDITION_GARRISONED); unloaded, it is let go and no longer garrisoned (onRemoving). Held
// units are what the AI leaves out of its teams.
BOOST_AUTO_TEST_CASE(legacy_parity_a_helix_holds_its_riders_above_it_as_garrisoned)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity helix = game.Place("ChinaVehicleHelix", match->At(300, 300), {}, match->Team(game, 0));
	const ecs::Entity guard = game.Place("ChinaInfantryRedguard", match->At(330, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(helix));
	BOOST_TEST_REQUIRE(world.IsAlive(guard));
	BOOST_TEST_REQUIRE(world.Get<gp::Transport>(helix) != nullptr);
	BOOST_TEST(world.Get<gp::Transport>(helix)->definition.garrisonsRiders);
	generalszh::gameplay::PutInside(game.Game(), helix, guard);
	game.Tick();
	game.Tick();
	const auto held = [&] {
		const auto *off = world.Get<gp::Disabled>(guard);
		return off != nullptr && (off->mask & gp::disabled_type::Held) != 0;
	};
	const auto garrisoned = [&] {
		const auto *bonus = world.Get<gp::WeaponBonusConditions>(guard);
		return bonus != nullptr && (bonus->flags & content::weapon_bonus::Garrisoned) != 0;
	};
	BOOST_TEST_REQUIRE(world.Get<gp::Passenger>(guard) != nullptr);
	BOOST_TEST((world.Get<gp::Transform>(guard)->position.z == world.Get<gp::Transform>(helix)->position.z + Fixed::FromInt(8)));
	BOOST_TEST(held());
	BOOST_TEST(garrisoned());
	generalszh::gameplay::OrderUnload(game.Game(), helix);
	for (int tick = 0; tick < 600 && world.Get<gp::Passenger>(guard) != nullptr; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Passenger>(guard) == nullptr);
	game.Tick();
	BOOST_TEST(!held());
	BOOST_TEST(!garrisoned());
}

// PassengersFireUpgrade::upgradeImplementation (getContain()->setPassengerAllowedToFire(TRUE)) on the shipped
// ChinaVehicleHelix (HelixContain PassengersAllowedToFire = No; TriggeredBy Upgrade_ChinaHelixBattleBunker): a Red Guard
// aboard may not fire out (HelixContain::isPassengerAllowedToFire: infantry ask TransportContain's flag); from the
// upgrade pass the tick after the upgrade, the flag is set and the Red Guard already aboard fires out, as does one put
// in afterwards.
BOOST_AUTO_TEST_CASE(legacy_parity_a_helixs_battle_bunker_lets_its_infantry_fire_out)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity helix = game.Place("ChinaVehicleHelix", match->At(300, 300), {}, match->Team(game, 0));
	const ecs::Entity guard = game.Place("ChinaInfantryRedguard", match->At(330, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(helix));
	BOOST_TEST_REQUIRE(world.IsAlive(guard));
	BOOST_TEST(!world.Get<gp::Transport>(helix)->definition.passengersFire);
	generalszh::gameplay::PutInside(game.Game(), helix, guard);
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::OffMap>(guard) != nullptr);
	BOOST_TEST(!world.Get<gp::OffMap>(guard)->armed);
	auto *upgradable = world.Get<gp::Upgradable>(helix);
	BOOST_TEST_REQUIRE(upgradable != nullptr);
	upgradable->completed.Set(*shell.game.upgrades.Find("Upgrade_ChinaHelixBattleBunker"));
	upgradable->stale = 1;
	game.Tick();
	BOOST_TEST(world.Get<gp::Transport>(helix)->definition.passengersFire);
	BOOST_TEST(world.Get<gp::OffMap>(guard)->armed);
	const ecs::Entity second = game.Place("ChinaInfantryRedguard", match->At(330, 330), {}, match->Team(game, 0));
	generalszh::gameplay::PutInside(game.Game(), helix, second);
	BOOST_TEST(world.Get<gp::OffMap>(second)->armed);
}

// PropagandaTowerBehavior on the shipped ChinaSpeakerTower (Radius 150, DelayBetweenUpdates 2000 ms: 60 frames,
// HealPercentEachSecond 2%, 4% with Upgrade_ChinaSubliminalMessaging): its first scan comes 60 frames into the game,
// taking in a hurt Red Guard 80 away, which is ENTHUSIASTIC from then and healed 2% of its most a second (a second
// later: 2% more), but not an enemy rebel beside it; the upgrade makes it SUBLIMINAL too and heals it twice as fast.
// 2% in 16-bit fixed point lands within 0.01 of the original's heal over a second.
BOOST_AUTO_TEST_CASE(legacy_parity_a_speaker_tower_rouses_and_heals_the_allies_around_it)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	// Powered (a POWERED tower browns out without power, and a disabled one does nothing: update isDisabled).
	game.Place("ChinaPowerPlant", match->At(600, 300), {}, match->Team(game, 0));
	const ecs::Entity tower = game.Place("ChinaSpeakerTower", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(tower));
	BOOST_TEST_REQUIRE(world.Get<gp::PropagandaTower>(tower) != nullptr);
	BOOST_TEST(world.Get<gp::PropagandaTower>(tower)->delay == 60u);
	const auto &at = world.Get<gp::Transform>(tower)->position;
	const ecs::Entity guard = game.Place("ChinaInfantryRedguard", {at.x + Fixed::FromInt(80), at.y}, {}, match->Team(game, 0));
	const ecs::Entity rebel = game.Place("GLAInfantryRebel", {at.x + Fixed::FromInt(80), at.y + Fixed::FromInt(20)}, {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(guard));
	BOOST_TEST_REQUIRE(world.IsAlive(rebel));
	world.Get<gp::Health>(guard)->current = world.Get<gp::Health>(guard)->maximum / Fixed::FromInt(2);
	const auto bonus = [&](ecs::Entity unit) { return world.Get<gp::WeaponBonusConditions>(unit)->flags; };
	while (game.CurrentTick() < 59)
	{
		game.Tick();
		BOOST_TEST_REQUIRE((bonus(guard) & content::weapon_bonus::Enthusiastic) == 0u);
	}
	game.Tick(); // frame 60: the first scan
	BOOST_TEST((bonus(guard) & content::weapon_bonus::Enthusiastic) != 0u);
	BOOST_TEST((bonus(rebel) & content::weapon_bonus::Enthusiastic) == 0u);
	// (Out of the way now, so only the tower touches the Red Guard's health.)
	world.Destroy(rebel);
	world.Get<gp::Health>(guard)->current = world.Get<gp::Health>(guard)->maximum / Fixed::FromInt(2);
	const double most = static_cast<double>(world.Get<gp::Health>(guard)->maximum.Raw()) / 65536.0;
	const auto health = [&] { return static_cast<double>(world.Get<gp::Health>(guard)->current.Raw()) / 65536.0; };
	const double before = health();
	for (int tick = 0; tick < 30; ++tick)
		game.Tick();
	BOOST_TEST(std::abs(health() - before - most * 0.02) < 0.01);
	world.Resource<gp::PlayerUpgrades>().Grant(world.Get<gp::Owner>(tower)->player, *shell.game.upgrades.Find("Upgrade_ChinaSubliminalMessaging"));
	game.Tick();
	BOOST_TEST((bonus(guard) & content::weapon_bonus::Subliminal) != 0u);
	const double upgraded = health();
	for (int tick = 0; tick < 30; ++tick)
		game.Tick();
	BOOST_TEST(std::abs(health() - upgraded - most * 0.04) < 0.01);
}

// GenerateMinefieldBehavior on a shipped China building (TriggeredBy Upgrade_ChinaMines, SmartBorder, AlwaysCircular,
// Upgradable to ChinaEMPMine by Upgrade_ChinaEMPMines) with GameData's StandardMinefieldDistance 40: the upgrade lays
// one ring of ChinaStandardMine at its bounding radius plus a mine's (30), as many as the ring's circumference holds
// mines' widths (rounded up), each made by it; Upgrade_ChinaEMPMines swaps them all for ChinaEMPMine; killed, its mines
// find it gone within a second and drain away (MinefieldBehavior StopsRegenAfterCreatorDies).
BOOST_AUTO_TEST_CASE(legacy_parity_a_china_building_lays_its_minefield_on_the_upgrade)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity building = game.Place("ChinaGattlingCannon", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(building));
	BOOST_TEST_REQUIRE(world.Get<generalszh::gameplay::MinefieldGenerator>(building) != nullptr);
	game.Tick();
	BOOST_TEST(Named(game, "ChinaStandardMine").empty());
	auto *upgradable = world.Get<gp::Upgradable>(building);
	upgradable->completed.Set(*shell.game.upgrades.Find("Upgrade_ChinaMines"));
	upgradable->stale = 1;
	game.Tick();
	game.Tick();
	const auto mines = Named(game, "ChinaStandardMine");
	const double footprint = static_cast<double>(content::BoundingCircleRadius(shell.game.objects.Find("ChinaGattlingCannon")->geometry).Raw()) / 65536.0;
	const double mine = static_cast<double>(content::BoundingCircleRadius(shell.game.objects.Find("ChinaStandardMine")->geometry).Raw()) / 65536.0;
	const double ring = footprint + mine;
	const auto expected = static_cast<std::size_t>(std::ceil(2.0 * 3.14159265358979 * ring / (2.0 * mine)));
	BOOST_TEST(mines.size() == expected);
	const auto &center = world.Get<gp::Transform>(building)->position;
	for (const ecs::Entity laid : mines)
	{
		BOOST_TEST((world.Get<gp::Minefield>(laid)->producer == building));
		const auto &at = world.Get<gp::Transform>(laid)->position;
		const double distance = static_cast<double>(Engine::Math::Length((at - center).XY()).Raw()) / 65536.0;
		BOOST_TEST(std::abs(distance - ring) < 0.01);
	}
	upgradable = world.Get<gp::Upgradable>(building); // (its first upgrade moved it: CommandSetUpgrade)
	upgradable->completed.Set(*shell.game.upgrades.Find("Upgrade_ChinaEMPMines"));
	upgradable->stale = 1;
	for (int tick = 0; tick < 3; ++tick)
		game.Tick();
	BOOST_TEST(Named(game, "ChinaStandardMine").empty());
	const auto emp = Named(game, "ChinaEMPMine");
	BOOST_TEST(emp.size() == expected);
	world.Resource<gp::KillRequests>().entities.push_back(building);
	for (int tick = 0; tick < 32; ++tick)
		game.Tick();
	for (const ecs::Entity laid : emp)
		BOOST_TEST(world.Get<gp::Minefield>(laid)->draining == 1u);
}

// Legacy parity (Object::updateUpgradeModules: nothing upgrades while OBJECT_STATUS_UNDER_CONSTRUCTION;
// DozerAIUpdate's construction finishing clears it and calls updateUpgradeModules): with China already holding
// Upgrade_ChinaMines, a Gattling Cannon a China dozer starts lays no mines while it is being built, and its minefield
// goes down the tick it is finished.
BOOST_AUTO_TEST_CASE(legacy_parity_a_building_upgrades_only_once_it_is_built)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t team = match->Team(game, 1);
	const ecs::Entity dozer = game.Place("ChinaVehicleDozer", match->At(250, 250), {}, team);
	const std::uint32_t china = world.Get<gp::Owner>(dozer)->player;
	world.Resource<gp::PlayerMoney>().Deposit(china, 100000);
	world.Resource<gp::PlayerUpgrades>().Grant(china, *shell.game.upgrades.Find("Upgrade_ChinaMines"));
	game.Tick();
	const ecs::Entity cannon = generalszh::gameplay::BeginConstruction(game.Game(), dozer, "ChinaGattlingCannon", match->At(350, 250), {});
	BOOST_TEST_REQUIRE(world.IsAlive(cannon));
	std::uint64_t built = 0, mined = 0;
	for (int tick = 0; tick < 3000 && mined == 0; ++tick)
	{
		game.Tick();
		if (built == 0 && world.IsAlive(cannon) && world.Get<gp::UnderConstruction>(cannon) == nullptr)
			built = game.CurrentTick();
		if (!Named(game, "ChinaStandardMine").empty())
			mined = game.CurrentTick();
	}
	BOOST_TEST_REQUIRE(built != 0u);
	BOOST_TEST(mined == built);
}

// Legacy parity (AI::findClosestEnemy with PartitionFilterRejectBuildings, PartitionManager.cpp): an idle unit's mood
// scan passes over enemy buildings, except a base defence (KINDOF_FS_BASE_DEFENSE) or a container able to attack; a
// computer player's units take any enemy building (m_acquireEnemies). America's (human) idle Humvee ignores an empty
// GLA barracks beside it but takes on a GLA Stinger Site; the GLA (Hard AI) player's idle Scorpion takes on an
// American barracks.
BOOST_AUTO_TEST_CASE(legacy_parity_idle_units_pass_over_buildings_unless_they_fight)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const std::uint32_t usa = match->Team(game, 0), gla = match->Team(game, 1);
	const auto targetOf = [&](ecs::Entity unit) {
		const auto *attack = world.Get<gp::AttackTarget>(unit);
		return attack != nullptr ? attack->target : ecs::Entity{};
	};
	const auto watch = [&](ecs::Entity unit, int ticks) {
		ecs::Entity seen;
		for (int tick = 0; tick < ticks && seen == ecs::Entity{}; ++tick)
		{
			game.Tick();
			seen = targetOf(unit);
		}
		return seen;
	};
	const ecs::Entity barracks = game.Place("GLABarracks", match->At(300, 700), {}, gla);
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(300, 600), {}, usa);
	BOOST_TEST_REQUIRE(world.IsAlive(barracks));
	BOOST_TEST((watch(humvee, 150) == ecs::Entity{}));
	const ecs::Entity site = game.Place("GLAStingerSite", match->At(420, 600), {}, gla);
	BOOST_TEST_REQUIRE(world.IsAlive(site));
	BOOST_TEST((watch(humvee, 150) == site));
	const ecs::Entity usaBarracks = game.Place("AmericaBarracks", match->At(-300, 700), {}, usa);
	const ecs::Entity scorpion = game.Place("GLATankScorpion", match->At(-300, 580), {}, gla);
	BOOST_TEST_REQUIRE(world.IsAlive(usaBarracks));
	BOOST_TEST((watch(scorpion, 150) == usaBarracks));
}

// Legacy parity (ThingTemplate::getMaxSimultaneousOfType with MaxSimultaneousOfType DeterminedBySuperweaponRestriction:
// GameLogic::getSuperweaponRestriction, the setup's "limit superweapons"): with the limit on (1) America may have one
// Particle Cannon at a time, so with one standing it may build no other; with it off (0) there is no limit.
BOOST_AUTO_TEST_CASE(legacy_parity_the_superweapon_limit_holds_players_to_one_each)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto *uplink = shell.game.objects.Find("AmericaParticleCannonUplink");
	BOOST_TEST_REQUIRE(uplink != nullptr);
	BOOST_TEST(uplink->maxSimultaneousBySuperweaponRestriction);
	for (const std::uint16_t limit : {std::uint16_t{1}, std::uint16_t{0}})
	{
		const auto match = Prepare(shell, limit);
		BOOST_TEST_REQUIRE(match.has_value());
		session::Session game(match->skirmish.level, shell.game, match->Options(1));
		game.Tick();
		game.Place("AmericaStrategyCenter", match->At(-300, 300), {}, match->Team(game, 0)); // its prerequisite
		const ecs::Entity first = game.Place("AmericaParticleCannonUplink", match->At(300, 300), {}, match->Team(game, 0));
		const std::uint32_t america = game.World().Get<engine::gameplay::Owner>(first)->player;
		game.Tick();
		BOOST_TEST(generalszh::gameplay::PlayerCanBuild(game.Game(), america, *uplink) == (limit == 0));
	}
}

// Legacy parity (OCLSpecialPower::doSpecialPowerAtLocation with OCLAdjustPositionToPassable: findPositionAround,
// FPF_CLEAR_CELLS_ONLY, maxRadius 500): a GLA command centre's rebel ambush (SUPERWEAPON_RebelAmbush1, CREATE_AT_LOCATION)
// aimed at the middle of an American barracks lands its rebels on clear ground beside it, never inside the building.
BOOST_AUTO_TEST_CASE(legacy_parity_a_rebel_ambush_lands_on_clear_ground)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity barracks = game.Place("AmericaBarracks", match->At(300, 300), {}, match->Team(game, 0));
	const ecs::Entity center = game.Place("GLACommandCenter", match->At(-400, -400), {}, match->Team(game, 1));
	game.Tick();
	const std::uint32_t power = *shell.game.powers.Template("SuperweaponRebelAmbush");
	gp::ResumeCountdown(*world.Get<gp::SpecialPowerTimers>(center)->Find(power), game.CurrentTick());
	world.Get<gp::SpecialPowerTimers>(center)->Find(power)->availableOn = game.CurrentTick();
	const auto before = Named(game, "GLAInfantryRebel").size();
	generalszh::gameplay::FireSpecialPower(game.Game(), center, "SuperweaponRebelAmbush", world.Get<gp::Transform>(barracks)->position.XY(), true);
	game.Tick();
	const auto rebels = Named(game, "GLAInfantryRebel");
	BOOST_TEST_REQUIRE(rebels.size() == before + 4);
	const auto &at = world.Get<gp::Transform>(barracks)->position;
	const Fixed reach = world.Get<gp::Targetable>(barracks)->radius;
	for (const ecs::Entity rebel : rebels)
		BOOST_TEST((Engine::Math::Length((world.Get<gp::Transform>(rebel)->position - at).XY()) > reach));
}

// Legacy parity (Player::init / initFromDict, PlayerList::newGame): a skirmish player starts with its game's starting
// cash (GameInfo: 10000 here; its template's StartMoney is 0) and no more; the neutral player (no name) with nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_players_start_with_the_games_cash)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	const auto &money = game.World().Resource<engine::gameplay::PlayerMoney>();
	const auto &roster = game.Game().roster;
	bool sawNeutral = false;
	for (std::uint32_t player = 0; player < roster.PlayerCount(); ++player)
	{
		const std::string &name = roster.PlayerAt(player).name;
		if (name.empty())
		{
			sawNeutral = true;
			BOOST_TEST(money.Balance(player) == 0);
		}
		else if (name == match->skirmish.players[0].name || name == match->skirmish.players[1].name)
			BOOST_TEST(money.Balance(player) == 10000);
	}
	BOOST_TEST(sawNeutral);
}

// Legacy parity (GrantUpgradeCreate::onCreate / onBuildComplete with ExemptStatus UNDER_CONSTRUCTION; DozerAIUpdate
// calling onBuildComplete as it finishes): a Command Center an American dozer starts gets its Upgrade_AmericaRadar (an
// object upgrade) only on the tick it is finished, not as it is placed. One placed whole, as the map places it,
// gives it at once.
BOOST_AUTO_TEST_CASE(legacy_parity_a_command_center_grants_its_radar_once_built)
{
	Install &shell = Data();
	if (!shell.loaded)
		return;
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	const auto radar = *shell.game.upgrades.Find("Upgrade_AmericaRadar");
	{
		session::Session game(match->skirmish.level, shell.game, match->Options(1));
		auto &world = game.World();
		namespace gp = engine::gameplay;
		const ecs::Entity dozer = game.Place("AmericaVehicleDozer", match->At(250, 250), {}, match->Team(game, 0));
		const std::uint32_t america = world.Get<gp::Owner>(dozer)->player;
		world.Resource<gp::PlayerMoney>().Deposit(america, 100000);
		game.Tick();
		const ecs::Entity center = generalszh::gameplay::BeginConstruction(game.Game(), dozer, "AmericaCommandCenter", match->At(450, 250), {});
		BOOST_TEST_REQUIRE(world.IsAlive(center));
		BOOST_TEST(!world.Get<gp::Upgradable>(center)->completed.Has(radar));
		std::uint64_t built = 0, granted = 0;
		for (int tick = 0; tick < 3000 && granted == 0; ++tick)
		{
			game.Tick();
			if (built == 0 && world.Get<gp::UnderConstruction>(center) == nullptr)
				built = game.CurrentTick();
			if (world.Get<gp::Upgradable>(center)->completed.Has(radar))
				granted = game.CurrentTick();
		}
		BOOST_TEST_REQUIRE(built != 0u);
		BOOST_TEST(granted == built);
	}
	{
		session::Session game(match->skirmish.level, shell.game, match->Options(1));
		auto &world = game.World();
		namespace gp = engine::gameplay;
		const ecs::Entity center = game.Place("AmericaCommandCenter", match->At(450, 250), {}, match->Team(game, 0));
		BOOST_TEST(world.Get<gp::Upgradable>(center)->completed.Has(radar));
	}
}

// DemoTrapUpdate on the shipped GLADemoTrap (DefaultProximityMode; PRIMARY detonates, SECONDARY proximity, TERTIARY
// manual; TriggerDetonationRange 40), switched by its player's SWITCH_WEAPON buttons (MSG_SWITCH_WEAPONS: the slot
// locked): made in proximity mode (its proximity button active); switched to manual, an enemy right beside it does not
// set it off; its Detonate button kills it that tick; another, in proximity mode, dies the tick an enemy comes within 40.
BOOST_AUTO_TEST_CASE(legacy_parity_a_demo_trap_goes_off_by_its_players_mode)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const auto send = [&](const commands::GameCommand &command) {
		auto envelope = commands::Encode(command);
		envelope.player = 0;
		game.Tick(std::span(&envelope, 1));
	};
	const ecs::Entity trap = game.Place("GLADemoTrap", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(trap));
	BOOST_TEST_REQUIRE(world.Get<gp::DemoTrap>(trap) != nullptr);
	game.Tick();
	BOOST_TEST(world.Get<gp::WeaponSlots>(trap)->locked == 1u);
	BOOST_TEST(world.Get<gp::Dying>(trap) == nullptr);
	const auto &buttons = shell.game.commands.buttons;
	BOOST_TEST((generalszh::gameplay::CommandAvailability(game.Game(), trap, buttons.at("Command_SetDemoTrapProximityDetonation")) ==
		generalszh::gameplay::ButtonState::Active));
	BOOST_TEST((generalszh::gameplay::CommandAvailability(game.Game(), trap, buttons.at("Command_SetDemoTrapManualDetonation")) ==
		generalszh::gameplay::ButtonState::Available));
	send(commands::SwitchWeapon{{trap}, 2});
	BOOST_TEST(world.Get<gp::WeaponSlots>(trap)->locked == 2u);
	const auto &at = world.Get<gp::Transform>(trap)->position;
	game.Place("GLAVehicleTechnical", {at.x + Fixed::FromInt(20), at.y}, {}, match->Team(game, 1));
	for (int tick = 0; tick < 10; ++tick)
		game.Tick();
	BOOST_TEST(world.Get<gp::Dying>(trap) == nullptr);
	send(commands::SwitchWeapon{{trap}, 0});
	BOOST_TEST((!world.IsAlive(trap) || world.Get<gp::Dying>(trap) != nullptr));

	const ecs::Entity other = game.Place("GLADemoTrap", match->At(700, 300), {}, match->Team(game, 0));
	const auto &there = world.Get<gp::Transform>(other)->position;
	game.Tick();
	BOOST_TEST(world.Get<gp::Dying>(other) == nullptr);
	game.Place("GLAVehicleTechnical", {there.x + Fixed::FromInt(35), there.y}, {}, match->Team(game, 1));
	game.Tick(); // indexed this tick, found by the next scan
	game.Tick();
	BOOST_TEST((!world.IsAlive(other) || world.Get<gp::Dying>(other) != nullptr));
}

// EMPUpdate on the shipped EMPPulseEffectSpheroid (StartFadeTime 300 ms: 9 ticks, DisabledDuration 30 s: 900 ticks,
// Lifetime 3 s: 90 ticks, EffectRadius 200): 9 ticks after it is made an enemy Crusader and GLA barracks (a faction
// structure) are DISABLED_EMP, a Ranger (infantry) and a China power plant (FS_POWER is no faction structure) are not;
// the pulse is gone 90 ticks after it was made; the tank moves again 900 ticks after it was disabled
// (Object::checkDisabledStatus).
BOOST_AUTO_TEST_CASE(legacy_parity_an_emp_pulse_disables_vehicles_and_faction_structures_for_its_duration)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const auto at = [&](int x, int y) { return match->At(x, y); };
	const ecs::Entity tank = game.Place("Lazr_AmericaTankCrusader", at(380, 300), {}, match->Team(game, 1));
	const ecs::Entity barracks = game.Place("GLABarracks", at(300, 420), {}, match->Team(game, 1));
	const ecs::Entity plant = game.Place("ChinaPowerPlant", at(180, 300), {}, match->Team(game, 1));
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", at(300, 360), {}, match->Team(game, 1));
	for (const ecs::Entity placed : {tank, barracks, plant, ranger})
		BOOST_TEST_REQUIRE(world.IsAlive(placed));
	game.Tick();
	const ecs::Entity pulse = game.Place("EMPPulseEffectSpheroid", at(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.Get<gp::EmpPulse>(pulse) != nullptr);
	const std::uint64_t made = game.CurrentTick();
	{
		// EMPUpdate::EMPUpdate: its target scale rolled within TargetScaleMin..Max.
		const auto look = generalszh::content::ReadEmpPulse(*shell.game.objects.Find("EMPPulseEffectSpheroid"), engine::time::FixedStep{30});
		BOOST_TEST_REQUIRE(look.has_value());
		const auto target = world.Get<gp::EmpPulse>(pulse)->targetScale;
		// The shipped look: StartScale 0.01, TargetScaleMin 3, TargetScaleMax 4, StartColor R:32 G:64 B:255, EndColor black.
		BOOST_TEST(look->startScale.Raw() == 655); // 0.01, parsed
		BOOST_TEST(look->targetScaleMin.Raw() == 3 * 65536);
		BOOST_TEST(look->targetScaleMax.Raw() == 4 * 65536);
		BOOST_TEST((look->startColor[0] == 32 && look->startColor[1] == 64 && look->startColor[2] == 255));
		BOOST_TEST((look->endColor[0] == 0 && look->endColor[1] == 0 && look->endColor[2] == 0));
		BOOST_TEST((look->targetScaleMin.Raw() <= target.Raw() && target.Raw() <= look->targetScaleMax.Raw()));
	}
	const auto emp = [&](ecs::Entity entity) {
		const auto *off = world.Get<gp::Disabled>(entity);
		return off != nullptr && (off->mask & gp::disabled_type::Emp) != 0;
	};
	while (game.CurrentTick() < made + 8)
	{
		game.Tick();
		BOOST_TEST_REQUIRE(!emp(tank));
	}
	game.Tick(); // made + 9
	BOOST_TEST(emp(tank));
	BOOST_TEST(emp(barracks));
	BOOST_TEST(!emp(plant));
	BOOST_TEST(!emp(ranger));
	const std::uint64_t hit = game.CurrentTick();
	while (game.CurrentTick() < made + 90)
		game.Tick();
	BOOST_TEST((!world.IsAlive(pulse) || world.Get<gp::Dying>(pulse) != nullptr));
	while (game.CurrentTick() < hit + 899)
		game.Tick();
	BOOST_TEST(emp(tank));
	game.Tick(); // hit + 900
	BOOST_TEST(!emp(tank));
}

// Object::setDisabledUntil / SpawnBehavior::orderSlavesDisabledUntil on the shipped GLAStingerSite (SPAWNS_ARE_THE_WEAPONS):
// an EMP pulse that reaches the site disables its Stinger soldiers for as long, on the same tick, though they are
// infantry the pulse itself passes over.
BOOST_AUTO_TEST_CASE(legacy_parity_an_emp_pulse_on_a_stinger_site_disables_its_soldiers)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity site = game.Place("GLAStingerSite", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(site));
	for (int step = 0; step < 5; ++step)
		game.Tick();
	const auto *spawner = world.Get<gp::Spawner>(site);
	BOOST_TEST_REQUIRE(spawner != nullptr);
	BOOST_TEST(spawner->spawnsAreWeapons);
	BOOST_TEST_REQUIRE(spawner->spawnedCount > 0u);
	const std::vector<ecs::Entity> soldiers(spawner->spawned.begin(), spawner->spawned.begin() + spawner->spawnedCount);
	const auto emp = [&](ecs::Entity entity) {
		const auto *off = world.Get<gp::Disabled>(entity);
		return off != nullptr && (off->mask & gp::disabled_type::Emp) != 0;
	};
	const ecs::Entity pulse = game.Place("EMPPulseEffectSpheroid", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(pulse));
	const std::uint64_t made = game.CurrentTick();
	while (game.CurrentTick() < made + 9)
		game.Tick();
	BOOST_TEST(emp(site));
	for (const ecs::Entity soldier : soldiers)
	{
		BOOST_TEST_REQUIRE(world.IsAlive(soldier));
		BOOST_TEST(emp(soldier));
		const auto *timers = world.Get<gp::DisabledUntil>(soldier);
		BOOST_TEST_REQUIRE(timers != nullptr);
		BOOST_TEST(timers->until[static_cast<std::size_t>(std::countr_zero(gp::disabled_type::Emp))] == made + 9 + 900);
	}
}

// AutoDepositUpdate on the shipped TechOilDerrick (DepositTiming 12 s: 360 ticks, DepositAmount 200) and GLABlackMarket
// (2 s: 60 ticks, 20): a player's derrick pays its 200 on the 360th tick after it was made, the market 20 every 60.
BOOST_AUTO_TEST_CASE(legacy_parity_oil_derricks_and_black_markets_pay_their_players)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity derrick = game.Place("TechOilDerrick", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(derrick));
	const auto *deposit = world.Get<gp::AutoDeposit>(derrick);
	BOOST_TEST_REQUIRE(deposit != nullptr);
	BOOST_TEST(deposit->period == 360u);
	BOOST_TEST(deposit->amount == 200);
	BOOST_TEST(deposit->captureBonus == 1000);
	BOOST_TEST(deposit->boostUpgrade != gp::AutoDeposit::NoUpgrade);
	const ecs::Entity market = game.Place("GLABlackMarket", match->At(500, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.Get<gp::AutoDeposit>(market) != nullptr);
	BOOST_TEST(world.Get<gp::AutoDeposit>(market)->period == 60u);
	const std::uint32_t player = world.Get<gp::Owner>(derrick)->player;
	const std::uint64_t made = game.CurrentTick();
	const auto money = [&] { return world.Resource<gp::PlayerMoney>().Balance(player); };
	const std::int64_t before = money();
	while (game.CurrentTick() < made + 60)
		game.Tick();
	BOOST_TEST(money() - before == 20);
	while (game.CurrentTick() < made + 359)
		game.Tick();
	BOOST_TEST(money() - before == 20 * 5);
	game.Tick(); // made + 360: the derrick's 200 and the market's sixth 20
	BOOST_TEST(money() - before == 20 * 6 + 200);
}

// SubObjectsUpgrade on the shipped GLAVehicleBombTruck (its bomb loads): Upgrade_GLABombTruckBioBomb shows Bombload02 (its first
// set); then Upgrade_GLABombTruckHighExplosiveBomb: its own set conflicts with the bio bomb its player has
// (upgradeImplementation's ConflictsWith check), so only the set needing both (RequiresAllTriggers: Bombload04, its
// third) follows.
BOOST_AUTO_TEST_CASE(legacy_parity_a_bomb_truck_shows_the_bomb_loads_its_upgrades_bring)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity truck = game.Place("GLAVehicleBombTruck", match->At(300, 300), {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(truck));
	const std::uint32_t player = world.Get<gp::Owner>(truck)->player;
	game.Tick();
	BOOST_TEST(world.Get<gp::PartOverrides>(truck) == nullptr);
	world.Resource<gp::PlayerUpgrades>().Grant(player, *shell.game.upgrades.Find("Upgrade_GLABombTruckBioBomb"));
	for (int tick = 0; tick < 3; ++tick)
		game.Tick();
	const auto *parts = world.Get<gp::PartOverrides>(truck);
	BOOST_TEST_REQUIRE(parts != nullptr);
	BOOST_TEST(parts->count == 1u);
	BOOST_TEST(parts->applied[0] == 0u);
	world.Resource<gp::PlayerUpgrades>().Grant(player, *shell.game.upgrades.Find("Upgrade_GLABombTruckHighExplosiveBomb"));
	for (int tick = 0; tick < 3; ++tick)
		game.Tick();
	parts = world.Get<gp::PartOverrides>(truck);
	BOOST_TEST_REQUIRE(parts->count == 2u);
	BOOST_TEST(parts->applied[1] == 2u);
}

// Team::damageTeamMembers (DAMAGE_MEMBERS_OF_TEAM): each member takes exactly the amount (DAMAGE_UNRESISTABLE: armor
// ignored) in the next tick; Team::killTeam (TEAM_KILL): its units die, its tech building goes to the neutral player's
// default team instead; Team::deleteTeam(ignoreDead) (TEAM_DELETE_LIVING): the living go at once, a dying one is left.
BOOST_AUTO_TEST_CASE(legacy_parity_script_team_damage_kill_and_delete_living)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const std::uint32_t team = match->Team(game, 1);
	const std::string name = "#" + std::to_string(team);
	const ecs::Entity tank = game.Place("ChinaTankBattleMaster", match->At(300, 300), {}, team);
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(340, 300), {}, team);
	const ecs::Entity derrick = game.Place("TechOilDerrick", match->At(500, 500), {}, team);
	game.Tick();
	const auto health = [&](ecs::Entity entity) { return world.Get<gp::Health>(entity)->current; };
	const auto tankBefore = health(tank), rangerBefore = health(ranger), derrickBefore = health(derrick);
	domain::TeamDamage(game.Game(), name, Engine::Math::Fixed::FromInt(30));
	game.Tick();
	BOOST_TEST((tankBefore - health(tank) == Engine::Math::Fixed::FromInt(30)));
	BOOST_TEST((rangerBefore - health(ranger) == Engine::Math::Fixed::FromInt(30)));
	BOOST_TEST((derrickBefore - health(derrick) == Engine::Math::Fixed::FromInt(30)));
	domain::TeamKill(game.Game(), name);
	BOOST_TEST(world.Get<gp::Owner>(derrick)->player != world.Get<gp::Owner>(tank)->player);
	game.Tick();
	const auto dead = [&](ecs::Entity entity) { return !world.IsAlive(entity) || world.Get<gp::Dying>(entity) != nullptr; };
	BOOST_TEST(dead(tank));
	BOOST_TEST(dead(ranger));
	BOOST_TEST(!dead(derrick));

	const ecs::Entity second = game.Place("ChinaTankBattleMaster", match->At(600, 300), {}, team);
	const ecs::Entity dying = game.Place("ChinaTankBattleMaster", match->At(650, 300), {}, team);
	game.Tick();
	domain::KillNow(game.Game(), dying);
	game.Tick();
	BOOST_TEST_REQUIRE(world.IsAlive(dying));
	domain::TeamDelete(game.Game(), name, true);
	BOOST_TEST(!world.IsAlive(second));
	BOOST_TEST(world.IsAlive(dying));
}

// Object::setTriggerAreaFlagsForChangeInPosition and the area conditions on the shipped Tournament Continent: its
// InnerPerimeter / OuterPerimeter areas are read; "[Skirmish]MyInnerPerimeter" names the script player's own (start
// index 0: InnerPerimeter1); a tank made at that area's middle is inside it (and entered, that tick and the next);
// its team is inside entirely; moved far off it exits (TEAM_EXITED_AREA_ENTIRELY), and is then outside.
BOOST_AUTO_TEST_CASE(legacy_parity_units_enter_and_exit_a_maps_trigger_areas)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const auto &areas = world.Resource<gp::TriggerAreas>();
	std::size_t perimeters = 0;
	for (const auto &area : areas.areas)
		perimeters += area.name.starts_with("InnerPerimeter") || area.name.starts_with("OuterPerimeter") ? 1 : 0;
	BOOST_TEST(perimeters >= 8u);
	const std::uint32_t inner = domain::QualifiedArea(areas, "[Skirmish]MyInnerPerimeter", 0, 1);
	BOOST_TEST_REQUIRE(inner == areas.Find("InnerPerimeter1"));
	BOOST_TEST(domain::QualifiedArea(areas, "[Skirmish]EnemyOuterPerimeter", 0, 1) == areas.Find("OuterPerimeter2"));
	const auto &square = areas.areas[inner];
	// Somewhere inside it: its bounds' middle, else a vertex's neighbourhood.
	std::array<std::int32_t, 2> at{(square.lo[0] + square.hi[0]) / 2, (square.lo[1] + square.hi[1]) / 2};
	for (std::int32_t step = 0; !square.Contains(at[0], at[1]) && step < 400; ++step)
		at = {square.points[0][0] + (step % 20) * 20 - 200, square.points[0][1] + (step / 20) * 20 - 200};
	BOOST_TEST_REQUIRE(square.Contains(at[0], at[1]));
	const std::uint32_t team = match->Team(game, 1);
	const std::string teamName = "#" + std::to_string(team);
	const ecs::Entity tank = game.Place("ChinaTankBattleMaster", {Engine::Math::Fixed::FromInt(at[0]), Engine::Math::Fixed::FromInt(at[1])}, {}, team);
	BOOST_TEST_REQUIRE(world.IsAlive(tank));
	game.Tick();
	const std::uint64_t now = game.CurrentTick();
	const auto *presence = world.Get<gp::AreaPresence>(tank);
	BOOST_TEST_REQUIRE(presence != nullptr);
	BOOST_TEST(presence->Inside(inner));
	BOOST_TEST(presence->Entered(inner, now));
	// The skirmish area counts (evaluatePlayerHasUnitTypeInArea / KindInArea / SkirmishPlayerHasUnitsInArea /
	// SkirmishValueInArea): the tank by its type, as a VEHICLE, as anything, and at its build cost.
	{
		const std::uint32_t owner = world.Get<gp::Owner>(tank)->player;
		const auto kindIndex = static_cast<std::int64_t>(std::ranges::find(generalszh::content::KindOfNames, std::string_view("VEHICLE")) -
			generalszh::content::KindOfNames.begin());
		BOOST_TEST(domain::CountInArea(game.Game(), domain::AreaCount::Types, owner, inner, "ChinaTankBattleMaster") == 1);
		BOOST_TEST(domain::CountInArea(game.Game(), domain::AreaCount::Kind, owner, inner, {}, kindIndex) >= 1);
		BOOST_TEST(domain::CountInArea(game.Game(), domain::AreaCount::Any, owner, inner) >= 1);
		BOOST_TEST(domain::CountInArea(game.Game(), domain::AreaCount::Value, owner, inner) >= shell.game.objects.Find("ChinaTankBattleMaster")->buildCost);
	}
	// Its whole team (the player's other things too) is inside partially at least.
	BOOST_TEST(domain::TestArea(game.Game(), domain::AreaTest::TeamInsidePartially, teamName, inner, 3, now));
	world.Get<gp::Transform>(tank)->position.x = Engine::Math::Fixed::FromInt(at[0] + 3000);
	game.Tick();
	const std::uint64_t later = game.CurrentTick();
	BOOST_TEST(world.Get<gp::AreaPresence>(tank)->Exited(inner, later));
	BOOST_TEST(!world.Get<gp::AreaPresence>(tank)->Inside(inner));
	BOOST_TEST(domain::CountInArea(game.Game(), domain::AreaCount::Types, world.Get<gp::Owner>(tank)->player, inner, "ChinaTankBattleMaster") == 0);
	BOOST_TEST(domain::TestArea(game.Game(), domain::AreaTest::TeamExitedPartially, teamName, inner, 3, later));
	for (int step = 0; step < 3; ++step)
		game.Tick();
	BOOST_TEST(!domain::TestArea(game.Game(), domain::AreaTest::TeamExitedPartially, teamName, inner, 3, game.CurrentTick()));
}

// AIGroup::groupAttackArea / AIAttackAreaState on Tournament Continent: a tank ordered to attack InnerPerimeter1 goes
// for the enemy inside it, not a nearer one outside; once none is left inside it idles. Ordered to guard the area
// (groupGuardArea: the AIGuardMachine), it heads back for the area's middle.
BOOST_AUTO_TEST_CASE(legacy_parity_units_attack_and_guard_a_maps_trigger_area)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const auto &areas = world.Resource<gp::TriggerAreas>();
	const std::uint32_t inner = areas.Find("InnerPerimeter1");
	BOOST_TEST_REQUIRE(inner != gp::TriggerAreas::None);
	const auto &square = areas.areas[inner];
	std::array<std::int32_t, 2> in{(square.lo[0] + square.hi[0]) / 2, (square.lo[1] + square.hi[1]) / 2};
	BOOST_TEST_REQUIRE(square.Contains(in[0], in[1]));
	// Outside: just past its bounds' right, level with the middle.
	const std::array<std::int32_t, 2> out{square.hi[0] + 60, in[1]};
	BOOST_TEST_REQUIRE(!square.Contains(out[0], out[1]));
	const auto point = [](std::int32_t x, std::int32_t y) { return Engine::Math::FixedVector2{Engine::Math::Fixed::FromInt(x), Engine::Math::Fixed::FromInt(y)}; };
	const ecs::Entity hunter = game.Place("ChinaTankBattleMaster", point(out[0] + 150, out[1]), {}, match->Team(game, 0));
	const ecs::Entity near = game.Place("AmericaVehicleHumvee", point(out[0], out[1]), {}, match->Team(game, 1));
	const ecs::Entity inside = game.Place("AmericaVehicleHumvee", point(in[0], in[1]), {}, match->Team(game, 1));
	for (const ecs::Entity placed : {hunter, near, inside})
		BOOST_TEST_REQUIRE(world.IsAlive(placed));
	game.Tick();
	domain::OrderAreaAttack(game.Game(), std::span(&hunter, 1), inner);
	BOOST_TEST((world.Get<gp::Aggression>(hunter)->stance == gp::Stance::Hunt));
	for (int tick = 0; tick < 40; ++tick)
		game.Tick();
	BOOST_TEST((world.Get<gp::AttackTarget>(hunter)->target == inside));
	// Its victim gone, nothing left inside: done, idle.
	domain::RetireNow(game.Game(), {inside});
	for (int tick = 0; tick < 70; ++tick)
		game.Tick();
	BOOST_TEST((world.Get<gp::Aggression>(hunter)->stance == gp::Stance::Idle));
	BOOST_TEST(world.Get<gp::Aggression>(hunter)->area == gp::TriggerAreas::None);

	// Guarding it (the AIGuardMachine): on the next tick it returns, its move for the area's middle.
	domain::OrderAreaGuard(game.Game(), std::span(&hunter, 1), inner);
	const auto *guard = world.Get<domain::Guard>(hunter);
	BOOST_TEST_REQUIRE(guard != nullptr);
	BOOST_TEST(guard->area == inner);
	game.Tick();
	BOOST_TEST((world.Get<domain::Guard>(hunter)->state == domain::GuardState::Return));
	BOOST_TEST((world.Get<gp::MoveOrder>(hunter)->destination.x == Engine::Math::Fixed::FromRaw((std::int64_t{square.lo[0]} + square.hi[0]) << 15)));
}

// evaluateSkirmishPlayerTechBuildingWithinDistancePerimeter on Tournament Continent: a neutral TechOilDerrick at
// InnerPerimeter1's middle counts for a player; given to that player, it no longer does (its own); a player's
// TechOilDerrick far from the area (beyond the area's radius and the distance) does not count for an enemy. And
// evaluateSkirmishSuppliesWithinDistancePerimeter over a neutral warehouse there (below).
BOOST_AUTO_TEST_CASE(legacy_parity_tech_buildings_near_a_skirmish_area)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const auto &areas = world.Resource<gp::TriggerAreas>();
	const std::uint32_t inner = areas.Find("InnerPerimeter1");
	BOOST_TEST_REQUIRE(inner != gp::TriggerAreas::None);
	const auto &square = areas.areas[inner];
	const Engine::Math::FixedVector2 middle{Engine::Math::Fixed::FromInt((square.lo[0] + square.hi[0]) / 2), Engine::Math::Fixed::FromInt((square.lo[1] + square.hi[1]) / 2)};
	const auto neutral = game.Teams().FindTeam("team");
	BOOST_TEST_REQUIRE(neutral.has_value());
	const ecs::Entity derrick = game.Place("TechOilDerrick", middle, {}, *neutral);
	BOOST_TEST_REQUIRE(world.IsAlive(derrick));
	const std::uint32_t mine = game.Teams().TeamAt(match->Team(game, 0)).owner;
	BOOST_TEST(domain::TechBuildingNear(game.Game(), mine, inner, Engine::Math::Fixed::FromInt(100)));
	domain::ChangeTeam(game.Game(), derrick, match->Team(game, 0));
	BOOST_TEST(!domain::TechBuildingNear(game.Game(), mine, inner, Engine::Math::Fixed::FromInt(100)));
	domain::ChangeTeam(game.Game(), derrick, *neutral);
	world.Get<gp::Transform>(derrick)->position.x = middle.x + Engine::Math::Fixed::FromInt(5000);
	BOOST_TEST(!domain::TechBuildingNear(game.Game(), mine, inner, Engine::Math::Fixed::FromInt(100)));

	// evaluateSkirmishSuppliesWithinDistancePerimeter: a neutral SupplyWarehouse at the area's middle, fuller than the map's
	// own warehouses there (its boxes worth ValuePerSupplyBox each), counts when worth more than the value asked (not when
	// worth exactly it); emptied, only the map's own count again.
	const auto near = [&](std::int64_t value) {
		return domain::SuppliesNear(game.Game(), mine, inner, Engine::Math::Fixed::FromInt(100), Engine::Math::Fixed::FromInt(value));
	};
	const ecs::Entity warehouse = game.Place("SupplyWarehouse", middle, {}, *neutral);
	BOOST_TEST_REQUIRE(world.Get<gp::ResourceStore>(warehouse) != nullptr);
	const std::uint32_t boxes = world.Get<gp::ResourceStore>(warehouse)->boxes;
	world.Get<gp::ResourceStore>(warehouse)->boxes = 0;
	const bool mapHasSome = near(0);
	world.Get<gp::ResourceStore>(warehouse)->boxes = boxes * 10;
	const std::int64_t worth = static_cast<std::int64_t>(boxes) * 10 * shell.game.gameData.valuePerSupplyBox;
	BOOST_TEST_REQUIRE(worth > 0);
	BOOST_TEST(near(worth - 1));
	BOOST_TEST(!near(worth));
	world.Get<gp::ResourceStore>(warehouse)->boxes = 0;
	BOOST_TEST(near(0) == mapHasSome);
	BOOST_TEST(!near(worth - 1));
}

// Player::sellEverythingUnderTheSun (PLAYER_SELL_EVERYTHING) with the shipped GLA buildings: its barracks (FS_BARRACKS),
// command centre go on sale; its tunnel network only as its kinds say (a faction kind or not); its units are left; a sale
// already under way is not begun again.
BOOST_AUTO_TEST_CASE(legacy_parity_a_player_sells_everything)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const std::uint32_t team = match->Team(game, 1);
	const ecs::Entity barracks = game.Place("GLABarracks", match->At(300, 300), {}, team);
	const ecs::Entity center = game.Place("GLACommandCenter", match->At(600, 300), {}, team);
	const ecs::Entity tunnel = game.Place("GLATunnelNetwork", match->At(300, 600), {}, team);
	const ecs::Entity rebel = game.Place("GLAInfantryRebel", match->At(450, 450), {}, team);
	for (const ecs::Entity placed : {barracks, center, tunnel, rebel})
		BOOST_TEST_REQUIRE(world.IsAlive(placed));
	game.Tick();
	const bool tunnelFaction = [&] {
		const auto &definition = *shell.game.objects.Find("GLATunnelNetwork");
		for (const char *kind : {"FS_FACTORY", "FS_BASE_DEFENSE", "FS_TECHNOLOGY", "COMMANDCENTER", "FS_POWER", "FS_BARRACKS"})
			if (definition.Is(kind))
				return true;
		return false;
	}();
	domain::SellEverything(game.Game(), world.Get<gp::Owner>(barracks)->player);
	BOOST_TEST(world.Get<gp::Sale>(barracks) != nullptr);
	BOOST_TEST(world.Get<gp::Sale>(center) != nullptr);
	BOOST_TEST((world.Get<gp::Sale>(tunnel) != nullptr) == tunnelFaction);
	BOOST_TEST(world.Get<gp::Sale>(rebel) == nullptr);
	const std::uint64_t since = world.Get<gp::Sale>(barracks)->since;
	game.Tick();
	domain::SellEverything(game.Game(), world.Get<gp::Owner>(barracks)->player);
	BOOST_TEST(world.Get<gp::Sale>(barracks)->since == since);
}

// doLoadAllTransports (TEAM_LOAD_TRANSPORTS) with the shipped AmericaVehicleHumvee (5 slots) and seven Rangers added to
// a team that has a worker and a command centre: PartitionSolver's fast solution, the largest first, equal sizes in team
// order, things without a slot count taking none; doMoveTeamTowardsNearest: the team heads for the TechOilDerrick
// inside InnerPerimeter1.
BOOST_AUTO_TEST_CASE(legacy_parity_a_team_loads_its_transports_and_moves_towards_a_type)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const std::uint32_t team = match->Team(game, 1);
	const std::string name = "#" + std::to_string(team);
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(300, 300), {}, team);
	BOOST_TEST_REQUIRE(world.IsAlive(humvee));
	std::vector<ecs::Entity> rangers;
	for (int index = 0; index < 7; ++index)
		rangers.push_back(game.Place("AmericaInfantryRanger", match->At(330 + index * 12, 330), {}, team));
	game.Tick();
	domain::TeamLoadTransports(game.Game(), name);
	for (int tick = 0; tick < 300; ++tick)
		game.Tick();
	const auto aboard = game.Game().manifest.Aboard(humvee);
	// The team's worker (1 slot, first in the team's order) took the first slot and is still on its way from the base;
	// the command centre takes none; four Rangers board, three are left out.
	BOOST_TEST(aboard.size() == 4u);
	for (const ecs::Entity rider : aboard)
		BOOST_TEST((std::ranges::find(rangers, rider) != rangers.end()));

	const auto &areas = world.Resource<gp::TriggerAreas>();
	const std::uint32_t inner = areas.Find("InnerPerimeter1");
	BOOST_TEST_REQUIRE(inner != gp::TriggerAreas::None);
	const auto &square = areas.areas[inner];
	const Engine::Math::FixedVector2 middle{Engine::Math::Fixed::FromInt((square.lo[0] + square.hi[0]) / 2), Engine::Math::Fixed::FromInt((square.lo[1] + square.hi[1]) / 2)};
	const ecs::Entity derrick = game.Place("TechOilDerrick", middle, {}, *game.Teams().FindTeam("team"));
	BOOST_TEST_REQUIRE(world.IsAlive(derrick));
	domain::TeamMoveTowardsNearest(game.Game(), name, "TechOilDerrick", inner);
	const auto *order = world.Get<gp::MoveOrder>(humvee);
	BOOST_TEST_REQUIRE(order != nullptr);
	BOOST_TEST((order->mode != gp::MoveMode::Idle));
	for (int tick = 0; tick < 30; ++tick)
		game.Tick();
	const auto *at = world.Get<gp::Transform>(humvee);
	const auto start = match->At(300, 300);
	BOOST_TEST((Engine::Math::DistanceSquared(at->position.XY(), middle) < Engine::Math::DistanceSquared(start, middle)));
}

// doMoveUnitTowardsNearest (UNIT_MOVE_TOWARDS_NEAREST_OBJECT_TYPE), ScriptActions.cpp: a Humvee heads for the nearer of
// two TechOilDerricks inside InnerPerimeter1 (getClosestObject FROM_CENTER_2D with PartitionFilterPolygonTrigger), not
// for a nearer one outside it; a type with nothing inside the area orders nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_unit_moves_towards_the_nearest_of_a_type_in_an_area)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const std::uint32_t team = match->Team(game, 1);
	const auto &areas = world.Resource<gp::TriggerAreas>();
	const std::uint32_t inner = areas.Find("InnerPerimeter1");
	BOOST_TEST_REQUIRE(inner != gp::TriggerAreas::None);
	const auto &square = areas.areas[inner];
	const auto at = [](std::int32_t x, std::int32_t y) {
		return Engine::Math::FixedVector2{Engine::Math::Fixed::FromInt(x), Engine::Math::Fixed::FromInt(y)};
	};
	const std::int32_t midY = (square.lo[1] + square.hi[1]) / 2;
	// The Humvee just outside the area's low x edge; a derrick outside nearer still, two inside at different depths.
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", at(square.lo[0] - 60, midY), {}, team);
	const auto neutral = *game.Teams().FindTeam("team");
	game.Place("TechOilDerrick", at(square.lo[0] - 20, midY), {}, neutral);
	const auto nearer = at(square.lo[0] + 40, midY);
	const auto farther = at(square.hi[0] - 40, midY);
	game.Place("TechOilDerrick", farther, {}, neutral);
	game.Place("TechOilDerrick", nearer, {}, neutral);
	BOOST_TEST_REQUIRE(world.IsAlive(humvee));
	game.Tick();

	domain::UnitMoveTowardsNearest(game.Game(), humvee, "AmericaInfantryRanger", inner);
	BOOST_TEST((world.Get<gp::MoveOrder>(humvee)->mode == gp::MoveMode::Idle));
	domain::UnitMoveTowardsNearest(game.Game(), humvee, "TechOilDerrick", inner);
	const auto *order = world.Get<gp::MoveOrder>(humvee);
	BOOST_TEST((order->mode == gp::MoveMode::Point));
	BOOST_TEST((order->destination == nearer));
}

// AI::findClosestEnemy with an attack priority set (the shipped AttackPriorityDistanceModifier 100): a hunting
// Battlemaster whose set gives Humvees 10 (the rest the default 1) goes for a Humvee 400 away (10 less 3) over a Ranger
// 100 away (1); with Humvees at 0 (never attacked) it takes the Ranger; the set checkpoints with the session.
BOOST_AUTO_TEST_CASE(legacy_parity_an_attack_priority_set_picks_the_target)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	auto &priorities = world.Resource<gp::AttackPriorities>();
	BOOST_TEST((priorities.distanceModifier == Engine::Math::Fixed::FromInt(100)));
	const ecs::Entity hunter = game.Place("ChinaTankBattleMaster", match->At(300, 300), {}, match->Team(game, 0));
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(400, 300), {}, match->Team(game, 1));
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(700, 300), {}, match->Team(game, 1));
	for (const ecs::Entity placed : {hunter, ranger, humvee})
		BOOST_TEST_REQUIRE(world.IsAlive(placed));
	const std::uint16_t set = priorities.Find("PreferHumvees", true);
	priorities.SetPriority(set, game.Game().templates.Definition(*shell.game.objects.Find("AmericaVehicleHumvee")), 10);
	auto *aggression = world.Get<gp::Aggression>(hunter);
	aggression->prioritySet = set;
	aggression->stance = gp::Stance::Hunt;
	aggression->nextScan = 0;
	game.Tick();
	BOOST_TEST((world.Get<gp::AttackTarget>(hunter)->target == humvee));
	priorities.SetPriority(set, game.Game().templates.Definition(*shell.game.objects.Find("AmericaVehicleHumvee")), 0);
	*world.Get<gp::AttackTarget>(hunter) = {};
	world.Get<gp::Aggression>(hunter)->nextScan = 0;
	game.Tick();
	BOOST_TEST((world.Get<gp::AttackTarget>(hunter)->target == ranger));
	const auto bytes = game.Checkpoint();
	const auto restored = session::Session::Restore(match->skirmish.level, shell.game, match->Options(1), bytes);
	BOOST_TEST_REQUIRE(restored != nullptr);
	BOOST_TEST(restored->World().Resource<gp::AttackPriorities>().Find("PreferHumvees") == set);
	BOOST_TEST(restored->StateHash() == game.StateHash());
}

// The team state a sequential script waits on (evaluateAndProgressAllSequentialScripts: AIGroup::isIdle /
// isGroupAiDead) and evaluateTeamIsContained, on real units: a team of two Rangers is idle; one ordered to move makes
// it busy; aboard a Humvee one of them makes it partly (not wholly) contained; a team index past the roster is gone.
BOOST_AUTO_TEST_CASE(legacy_parity_a_sequential_scripts_team_state)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	using Activity = domain::TeamActivity;
	const std::uint32_t team = match->Team(game, 1);
	const ecs::Entity a = game.Place("AmericaInfantryRanger", match->At(300, 300), {}, team);
	const ecs::Entity b = game.Place("AmericaInfantryRanger", match->At(320, 300), {}, team);
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(360, 330), {}, team);
	game.Tick();
	// The player's own starting things are on the team too; stop everyone so the team is idle.
	domain::TeamStop(game.Game(), "#" + std::to_string(team), false);
	game.Tick();
	BOOST_TEST((domain::TeamSequenceState(game.Game(), team) == Activity::Idle));
	domain::OrderMove(game.Game(), a, match->At(900, 300));
	BOOST_TEST((domain::TeamSequenceState(game.Game(), team) == Activity::Busy));
	domain::OrderStop(game.Game(), a);
	BOOST_TEST(!domain::TeamContained(game.Game(), team, false));
	domain::OrderBoard(game.Game(), b, humvee);
	for (int tick = 0; tick < 200 && world.Get<gp::Passenger>(b) == nullptr; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Passenger>(b) != nullptr);
	BOOST_TEST(domain::TeamContained(game.Game(), team, false));
	BOOST_TEST(!domain::TeamContained(game.Game(), team, true));
	BOOST_TEST((domain::TeamSequenceState(game.Game(), game.Teams().TeamCount() + 5) == Activity::Gone));
}

// Legacy parity (ScriptActions::doDestroyAllContained: iterateContained(killTheObject)): a script kills everyone in the
// named Humvee on that tick; the Humvee stands; an empty or unknown holder changes nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_script_kills_everyone_aboard)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	engine::level::Level level = match->skirmish.level;
	// SET_TIMER(t, 300) on the first tick; the destroy once it runs out (the rider aboard long before).
	engine::level::Script start;
	start.name = "start";
	start.oneShot = true;
	engine::level::ScriptCall always;
	always.name = "CONDITION_TRUE";
	start.conditions = {{always}};
	engine::level::ScriptCall timer;
	timer.name = "SET_TIMER";
	engine::level::ScriptParameter timerName, ticks;
	timerName.text = "t";
	ticks.integer = 300;
	timer.parameters = {timerName, ticks};
	start.actions = {timer};
	level.scenario.participants.front().scripts.scripts.push_back(start);
	engine::level::Script script;
	script.name = "empty";
	script.oneShot = true;
	engine::level::ScriptCall expired;
	expired.name = "TIMER_EXPIRED";
	expired.parameters = {timerName};
	script.conditions = {{expired}};
	engine::level::ScriptCall destroy;
	destroy.name = "UNIT_DESTROY_ALL_CONTAINED";
	engine::level::ScriptParameter holder;
	holder.text = "Ride";
	destroy.parameters = {holder};
	engine::level::ScriptCall nobody = destroy;
	nobody.parameters[0].text = "Nobody";
	script.actions = {destroy, nobody};
	level.scenario.participants.front().scripts.scripts.push_back(script);
	session::Session game(level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const std::uint32_t team = match->Team(game, 0);
	const ecs::Entity rider = game.Place("AmericaInfantryRanger", match->At(320, 300), {}, team);
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", match->At(360, 330), {}, team);
	world.Resource<gp::NameRegistry>().Assign("Ride", humvee);
	domain::OrderBoard(game.Game(), rider, humvee);
	for (int tick = 0; tick < 200 && world.Get<gp::Passenger>(rider) == nullptr; ++tick)
		game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Passenger>(rider) != nullptr);
	for (int tick = 0; tick < 400 && world.IsAlive(rider) && !world.Has<gp::Dying>(rider); ++tick)
		game.Tick();
	BOOST_TEST((!world.IsAlive(rider) || world.Has<gp::Dying>(rider)));
	BOOST_TEST((world.IsAlive(humvee) && !world.Has<gp::Dying>(humvee)));
}

// Object::doCommandButton (CMD_FROM_SCRIPT) with shipped buttons: Command_AmericaRangerSwitchToFlagBangGrenades
// locks a Ranger (with the grenade upgrade) to its secondary slot; Command_ConstructAmericaVehicleScoutDrone queues the
// drone upgrade at a Humvee, after which the button is no longer valid on it (isValidToUseOn: an upgrade in its queue);
// on the other Humvee it still is.
BOOST_AUTO_TEST_CASE(legacy_parity_scripts_use_command_buttons)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	namespace domain = generalszh::gameplay;
	const std::uint32_t america = *game.Teams().FindPlayer("player0");
	world.Resource<gp::PlayerUpgrades>().Grant(america, *shell.game.upgrades.Find("Upgrade_AmericaRangerFlashBangGrenade"));
	const ecs::Entity ranger = game.Place("AmericaInfantryRanger", match->At(0, -200), {}, match->Team(game, 0));
	const ecs::Entity first = game.Place("AmericaVehicleHumvee", match->At(100, -200), {}, match->Team(game, 0));
	const ecs::Entity second = game.Place("AmericaVehicleHumvee", match->At(160, -200), {}, match->Team(game, 0));
	world.Resource<gp::PlayerMoney>().Deposit(america, 5000);
	for (int tick = 0; tick < 5; ++tick)
		game.Tick();
	const auto *grenades = shell.game.commands.Button("Command_AmericaRangerSwitchToFlagBangGrenades");
	const auto *drone = shell.game.commands.Button("Command_ConstructAmericaVehicleScoutDrone");
	BOOST_TEST_REQUIRE((grenades != nullptr && drone != nullptr));
	domain::DoCommandButton(game.Game(), ranger, *grenades);
	BOOST_TEST(world.Get<gp::WeaponSlots>(ranger)->locked == 1u);
	BOOST_TEST_REQUIRE(domain::ButtonValidOn(game.Game(), first, *drone));
	domain::DoCommandButton(game.Game(), first, *drone);
	const auto *queue = world.Get<gp::ProductionQueue>(first);
	BOOST_TEST_REQUIRE(queue != nullptr);
	BOOST_TEST(queue->count == 1u);
	BOOST_TEST(!domain::ButtonValidOn(game.Game(), first, *drone));
	BOOST_TEST(domain::ButtonValidOn(game.Game(), second, *drone));
}

// OverchargeBehavior on the shipped ChinaPowerPlant (EnergyProduction 10, EnergyBonus 5, MaxHealth 1500,
// HealthPercentToDrainPerSecond 3%, NotAllowedWhenHealthBelowPercent 0%, RodsExtendTime 1 ms), switched by its
// player's MSG_TOGGLE_OVERCHARGE (AIGroup::groupToggleOvercharge): on, its bonus counts that tick (15), its rods come
// out (POWER_PLANT_UPGRADING, then POWER_PLANT_UPGRADED a tick later) and it drains 1500 * 3% / 30 = 1.5 a tick from
// the next tick on; another player's order does nothing. Off, the bonus goes and the rods are in at once.
BOOST_AUTO_TEST_CASE(legacy_parity_a_nuclear_reactor_overcharges_on_its_players_order)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity reactor = game.Place("ChinaPowerPlant", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(reactor));
	BOOST_TEST_REQUIRE(world.Get<gp::Overcharge>(reactor) != nullptr);
	const std::uint32_t owner = world.Get<gp::Owner>(reactor)->player;
	const auto send = [&](const commands::GameCommand &command, std::uint32_t seat) {
		auto envelope = commands::Encode(command);
		envelope.player = seat;
		game.Tick(std::span(&envelope, 1));
	};
	const auto rods = [&](const char *condition) { return world.Get<gp::Appearance>(reactor)->Test(content::ModelConditionBit(condition)); };
	game.Tick();
	const std::int64_t before = world.Resource<gp::PlayerEnergy>().Production(owner);
	const Fixed full = world.Get<gp::Health>(reactor)->current;
	send(commands::ToggleOvercharge{{reactor}}, 1);
	BOOST_TEST(world.Get<gp::Overcharge>(reactor)->active == 0u);
	send(commands::ToggleOvercharge{{reactor}}, 0);
	BOOST_TEST(world.Resource<gp::PlayerEnergy>().Production(owner) == before + 5);
	BOOST_TEST((world.Get<gp::Health>(reactor)->current == full));
	BOOST_TEST(rods("POWER_PLANT_UPGRADING"));
	game.Tick();
	BOOST_TEST(rods("POWER_PLANT_UPGRADED"));
	BOOST_TEST((world.Get<gp::Health>(reactor)->current == full - Fixed::FromRatio(3, 2)));
	for (int tick = 0; tick < 29; ++tick)
		game.Tick();
	BOOST_TEST((world.Get<gp::Health>(reactor)->current == full - Fixed::FromInt(45))); // a second's drain: 3%
	send(commands::ToggleOvercharge{{reactor}}, 0);
	BOOST_TEST(world.Get<gp::Overcharge>(reactor)->active == 0u);
	BOOST_TEST(world.Resource<gp::PlayerEnergy>().Production(owner) == before);
	BOOST_TEST(!rods("POWER_PLANT_UPGRADING"));
	BOOST_TEST(!rods("POWER_PLANT_UPGRADED"));
	const Fixed after = world.Get<gp::Health>(reactor)->current;
	game.Tick();
	BOOST_TEST((world.Get<gp::Health>(reactor)->current == after));
}

// NeutronMissileSlowDeathBehavior on the shipped NeutronMissile (the engine's
// legacy_parity_a_neutron_missile_blasts_scorches_and_burns_on_its_frames pins the rules): killed where it stands, it
// burns the look of a Humvee 50 away with its first scorch wave, 4 ticks after it died (BURNED), and its sixth blast,
// 36 ticks after, kills a Technical 100 away (2567 of its 3500 at that distance), which nothing had hurt before (on
// the same side: the blast spares no one). A GenericTree 80 away burns with the second scorch wave (6 ticks: 180 ms)
// and starts to fall with the second blast's push (20 ticks: 660 ms), TOPPLED from then on.
BOOST_AUTO_TEST_CASE(legacy_parity_a_neutron_missile_burns_and_blasts_what_is_near)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity missile = game.Place("NeutronMissile", match->At(400, 400), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(missile));
	const auto &at = world.Get<gp::Transform>(missile)->position;
	const ecs::Entity humvee = game.Place("AmericaVehicleHumvee", {at.x + Fixed::FromInt(50), at.y}, {}, match->Team(game, 0));
	const ecs::Entity technical = game.Place("GLAVehicleTechnical", {at.x, at.y + Fixed::FromInt(100)}, {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(humvee));
	BOOST_TEST_REQUIRE(world.IsAlive(technical));
	const ecs::Entity tree = game.Place("GenericTree", {at.x - Fixed::FromInt(80), at.y}, {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(tree));
	world.Resource<gp::KillRequests>().entities.push_back(missile);
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Dying>(missile) != nullptr);
	BOOST_TEST_REQUIRE(world.Get<gp::BlastWave>(missile) != nullptr);
	const std::uint64_t died = world.Get<gp::Dying>(missile)->since;
	const Fixed full = world.Get<gp::Health>(technical)->maximum;
	std::uint64_t burned = 0, killed = 0, treeBurned = 0, treeToppled = 0;
	while (game.CurrentTick() < died + 40)
	{
		game.Tick();
		if (burned == 0 && world.Get<gp::Appearance>(humvee)->Test(content::model_condition::Burned))
			burned = game.CurrentTick() - died;
		if (treeBurned == 0 && world.IsAlive(tree) && world.Get<gp::Appearance>(tree)->Test(content::model_condition::Burned))
			treeBurned = game.CurrentTick() - died;
		if (treeToppled == 0 && world.IsAlive(tree) && world.Get<gp::Appearance>(tree)->Test(content::model_condition::Toppled))
			treeToppled = game.CurrentTick() - died;
		if (killed == 0 && world.Get<gp::Dying>(technical) != nullptr)
			killed = game.CurrentTick() - died;
		if (killed == 0)
			BOOST_TEST_REQUIRE((world.Get<gp::Health>(technical)->current == full));
	}
	BOOST_TEST(burned == 4u);
	BOOST_TEST(killed == 36u);
	BOOST_TEST(treeBurned == 6u);
	BOOST_TEST(treeToppled == 20u);
}

// HelicopterSlowDeathBehavior with its ComancheLocomotor working on while dead (LocomotorWorksWhenDead): the spiral is a
// motive force on its 50 mass, braked (MaxBraking 190) and lifted short of gravity by its locomotor, with airborne
// friction, so a Comanche shot down over the map circles tightly down where it died (the engine's
// legacy_parity_a_comanche_spirals_down_on_its_locomotor pins the frames): never 100 from that point, which a spiral
// flown at SpiralOrbitForwardSpeed (350 a second, a 143 radius) would leave; it comes down and blows up, leaving its ComancheRubbleHull.
BOOST_AUTO_TEST_CASE(legacy_parity_a_shot_down_comanche_circles_down_where_it_died)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity comanche = game.Place("AmericaVehicleComanche", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(comanche));
	world.Get<gp::Transform>(comanche)->position.z += Fixed::FromInt(100);
	game.Tick();
	world.Resource<gp::KillRequests>().entities.push_back(comanche);
	game.Tick();
	BOOST_TEST_REQUIRE(world.Get<gp::Crash>(comanche) != nullptr);
	BOOST_TEST_REQUIRE(world.Get<gp::PhysicsBody>(comanche) != nullptr); // flown by its locomotor, on its physics
	const auto start = world.Get<gp::Transform>(comanche)->position.XY();
	Fixed farthest{};
	int ticks = 0;
	while (world.IsAlive(comanche) && ticks < 1200)
	{
		game.Tick();
		++ticks;
		if (world.IsAlive(comanche))
			farthest = std::max(farthest, Engine::Math::Length(world.Get<gp::Transform>(comanche)->position.XY() - start));
	}
	BOOST_TEST(!world.IsAlive(comanche)); // blown up
	BOOST_TEST((farthest < Fixed::FromInt(100)));
	BOOST_TEST((farthest > Fixed::FromInt(5))); // it did circle
	BOOST_TEST(!Named(game, "ComancheRubbleHull").empty());
}

// InactiveBody (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Body/InactiveBody.cpp): a fire field has no health
// to hurt and is effectively dead from the start (its constructor's setEffectivelyDead), so the living never count
// it; killed outright (Object::kill: unresistable damage) it dies, once.
BOOST_AUTO_TEST_CASE(legacy_parity_an_inactive_body_is_never_hurt_but_dies_when_killed)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity field = game.Place("FireFieldSmall", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(field));
	BOOST_TEST(world.Get<gp::InactiveBody>(field) != nullptr);
	BOOST_TEST(world.Get<gp::Health>(field) == nullptr);
	game.Tick();
	BOOST_TEST(world.IsAlive(field));
	world.Resource<gp::KillRequests>().entities.push_back(field);
	world.Resource<gp::KillRequests>().entities.push_back(field);
	game.Tick();
	BOOST_TEST((!world.IsAlive(field) || world.Get<gp::Dying>(field) != nullptr));
}

// FireWeaponWhenDamagedBehavior on the battleship's bogus target (AmericaBattleshipBogusTarget: StartsActive, a
// ReactionWeapon per damage state, DamageAmount 1): damage it under script control (unresistable, through its
// invulnerable armor) and it goes off, BattleshipTargetDamagedWeapon (100 within 30, 30 within 65) hurting what stands
// by it; its weapon fires at once whenever it is ready (DelayBetweenShots 0).
BOOST_AUTO_TEST_CASE(legacy_parity_the_battleship_target_explodes_when_damaged)
{
	Install &shell = Data();
	if (!shell.loaded)
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	const auto match = Prepare(shell);
	BOOST_TEST_REQUIRE(match.has_value());
	session::Session game(match->skirmish.level, shell.game, match->Options(1));
	auto &world = game.World();
	namespace gp = engine::gameplay;
	const ecs::Entity target = game.Place("AmericaBattleshipBogusTarget", match->At(300, 300), {}, match->Team(game, 0));
	BOOST_TEST_REQUIRE(world.IsAlive(target));
	BOOST_TEST_REQUIRE(world.Get<gp::DamageReaction>(target) != nullptr);
	BOOST_TEST(world.Get<gp::DamageReaction>(target)->active == 1);
	const auto at = world.Get<gp::Transform>(target)->position.XY();
	const ecs::Entity bystander = game.Place("AmericaInfantryRanger", {at.x + Fixed::FromInt(10), at.y}, {}, match->Team(game, 1));
	BOOST_TEST_REQUIRE(world.IsAlive(bystander));
