#include <boost/test/unit_test.hpp>
#include <algorithm>
#include <chrono>
#include <cstdint>
#include <cstdlib>
#include <filesystem>
#include <optional>
#include <string>
#include <string_view>
#include <vector>
import games.generalszh.session.session;
import games.generalszh.content.install.install_mount;
import games.generalszh.content.ini.zero_hour_grammar;
import games.generalszh.content.loading.game_content;
import engine.level.adapters.generals_map.map_reader;

// A diagnostic (not in the suite unless CAMPAIGN_SCAN is set): each Zero Hour campaign map played as its mission
// (GAME_SINGLE_PLAYER, its human side the local player) for CAMPAIGN_TICKS ticks (default 600): what its scripts call
// that is not ported, and how long its ticks take.
using namespace generalszh;

BOOST_AUTO_TEST_SUITE(campaign_scan)

BOOST_AUTO_TEST_CASE(every_campaign_map_plays)
{
	const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
	if (install == nullptr || !std::filesystem::exists(install) || std::getenv("CAMPAIGN_SCAN") == nullptr)
		return;
	const std::string only = std::getenv("CAMPAIGN_SCAN");
	const int ticks = std::getenv("CAMPAIGN_TICKS") != nullptr ? std::atoi(std::getenv("CAMPAIGN_TICKS")) : 600;
	engine::filesystem::VirtualFileSystem files;
	engine::config::Diagnostics grammarDiagnostics;
	content::MountInstall(files, install);
	content::ContentLoader loader(files, content::ZeroHourIniGrammar(grammarDiagnostics));
	const content::GameContent game = content::LoadGameContent(loader, engine::time::FixedStep{30});
	const char *maps[] = {"MD_USA01", "MD_USA02", "MD_USA03", "MD_USA04", "MD_USA05", "MD_GLA01", "MD_GLA02", "MD_GLA03", "MD_GLA04", "MD_GLA05",
		"MD_CHI01", "MD_CHI02", "MD_CHI03", "MD_CHI04", "MD_CHI05", "MD_USA01_CINE", "MD_USA02_INTRO", "MD_USA03_Intro", "MD_USA04_Intro",
		"MD_GLA02_CINE", "MD_GLA03_CINE", "MD_GLA04_INTRO", "MD_GLA05_INTRO", "MD_CHI05_Intro", "MD_USA03_END", "MD_GLA03_END", "MD_GLA05_END",
		"MD_CHI05_END", "GC_AirGeneral", "GC_ChemGeneral", "GC_ChinaBoss", "GC_DemolitionGeneral", "GC_LaserGeneral", "GC_NukeGeneral", "GC_Stealth",
		"GC_SuperWeaponsGeneral", "GC_TankGeneral"};
	for (const char *name : maps)
	{
		if (only != "all" && only != name)
			continue;
		const std::string path = std::string("Maps/") + name + "/" + name + ".map";
		const auto bytes = files.Read(path);
		if (!bytes)
		{
			BOOST_TEST_MESSAGE(name << ": no map");
			continue;
		}
		auto read = engine::level::generals_map::Read(*bytes);
		if (!read)
		{
			BOOST_TEST_MESSAGE(name << ": unreadable");
			continue;
		}
		std::vector<std::string> seats;
		for (const auto &side : read->level.scenario.participants)
			if (side.properties.Get<bool>("playerIsHuman").value_or(false))
			{
				seats.push_back(side.properties.Get<std::string>("playerName").value_or(""));
				break;
			}
		session::SessionOptions options{7, 1, {}, seats};
		options.singlePlayer = true;
		options.difficulty = 1;
		session::Session session(read->level, game, options);
		// CAMPAIGN_PROFILE: where each mission's ticks go (parts, costliest systems and script calls).
		const bool profile = std::getenv("CAMPAIGN_PROFILE") != nullptr;
		if (profile)
			session.EnableProfiling(true);
		double worst = 0.0, total = 0.0;
		for (int tick = 0; tick < ticks; ++tick)
		{
			const auto begin = std::chrono::steady_clock::now();
			session.Tick();
			const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - begin).count();
			worst = std::max(worst, ms);
			total += ms;
		}
		BOOST_TEST_MESSAGE(name << ": " << session.EntityCount() << " entities, avg " << total / ticks << " ms, max " << worst
								<< " ms; unported: " << session.UnportedSummary());
		if (profile)
		{
			const char *parts[] = {"commands", "scripts", "team states", "systems", "aftermath", "AI players", "generic scripts", "tending"};
			const auto nanos = session.TickNanos();
			for (std::size_t part = 0; part < nanos.size(); ++part)
				BOOST_TEST_MESSAGE("  part " << parts[part] << " " << nanos[part] / 1e6 / ticks << " ms/tick");
			auto systems = session.Profile();
			std::sort(systems.begin(), systems.end(), [](const auto &a, const auto &b) { return a.cpuNanos > b.cpuNanos; });
			for (std::size_t index = 0; index < systems.size() && index < 12; ++index)
				BOOST_TEST_MESSAGE("  system " << systems[index].name << " " << systems[index].cpuNanos / 1e6 / ticks << " ms/tick");
			auto calls = session.ScriptProfile();
			std::sort(calls.begin(), calls.end(), [](const auto &a, const auto &b) { return a.nanos > b.nanos; });
			for (std::size_t index = 0; index < calls.size() && index < 12; ++index)
				BOOST_TEST_MESSAGE("  script " << calls[index].name << " " << calls[index].nanos / 1e6 / ticks << " ms/tick (" << calls[index].calls << " calls)");
		}
	}
}

BOOST_AUTO_TEST_SUITE_END()
