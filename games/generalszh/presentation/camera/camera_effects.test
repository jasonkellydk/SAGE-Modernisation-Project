#define BOOST_TEST_MODULE GeneralsZhPresentationCamera
#include <boost/test/included/unit_test.hpp>

import std;

import games.generalszh.presentation.camera.algorithms.camera_shaking;
import games.generalszh.presentation.camera.algorithms.motion_blur_steps;
import games.generalszh.presentation.camera.algorithms.screen_filters;
import games.generalszh.presentation.camera.algorithms.selection_focus;
import games.generalszh.presentation.camera.algorithms.camera_slave;

using namespace generalszh::presentation;

namespace
{
// A random source that always gives its lowest value, so every uniform draw is its range's low end.
struct LowestRandom
{
	using result_type = std::uint32_t;
	static constexpr result_type(min)() { return 0; }
	static constexpr result_type(max)() { return (std::numeric_limits<result_type>::max)(); }
	result_type operator()() { return 0; }
};
}

BOOST_AUTO_TEST_SUITE(camera_effects)

// legacy_parity: CameraShakeSystemClass::Add_Camera_Shake / Timestep (W3DDevice CameraShakeSystem.cpp), stepped by
// 1/30 of a second a frame as W3DView::getCameraTransform does at 30 frames a second: a shaker lives while its elapsed
// time, summed in floats, is below its duration: one of 1 s is gone on the 30th step (1.0000004), one of 1.5 s on the
// 46th (45 steps sum to 1.4999998), one of 0.5 s on the 15th; the others stay in their order.
BOOST_AUTO_TEST_CASE(legacy_parity_shakers_expire_on_the_frame_their_summed_time_reaches_their_duration)
{
	CameraShakers shakers;
	LowestRandom random;
	AddCameraShake(shakers, {0, 0, 0}, 100.0f, 1.0f, 2.0f, random);
	AddCameraShake(shakers, {0, 0, 0}, 100.0f, 1.5f, 2.0f, random);
	AddCameraShake(shakers, {0, 0, 0}, 100.0f, 0.5f, 2.0f, random);
	BOOST_TEST(shakers.intensities[0] == 2.0f * std::numbers::pi_v<float> / 180.0f); // power: degrees of amplitude
	std::vector<std::size_t> alive;
	for (int frame = 1; frame <= 50; ++frame)
	{
		StepCameraShakers(shakers, 1.0f / 30.0f);
		alive.push_back(shakers.durations.size());
		if (frame == 14 || frame == 15)
			BOOST_TEST(shakers.durations.size() == (frame == 14 ? 3u : 2u));
		if (frame == 29 || frame == 30)
			BOOST_TEST(shakers.durations.size() == (frame == 29 ? 2u : 1u));
		if (frame == 30)
			BOOST_TEST(shakers.durations[0] == 1.5f);
		if (frame == 45 || frame == 46)
			BOOST_TEST(shakers.durations.size() == (frame == 45 ? 1u : 0u));
	}
	BOOST_TEST(!CameraShaking(shakers));
}

// legacy_parity: CameraShakerClass::Compute_Rotations: out of its radius a shaker adds nothing; within it, per axis
// 7.5 / 15 / 5 degrees x power x (1 - distance / radius) x (1 - elapsed / duration) x sin(omega(t) t + phi), omega
// sliding from its start toward one turn a second, and on each of the three axis passes a fudge of up to half that
// intensity on every axis. With every random draw at its low end (omega 12.5 turns a second, phase 0, fudge -half), a
// 2-degree shaker 50 units from the camera with radius 100, 3 frames in, gives exactly the original's sums.
BOOST_AUTO_TEST_CASE(legacy_parity_shaker_rotations_follow_the_originals_sinusoids)
{
	CameraShakers shakers;
	LowestRandom random;
	AddCameraShake(shakers, {50, 0, 0}, 100.0f, 1.0f, 2.0f, random);
	for (int frame = 0; frame < 3; ++frame)
		StepCameraShakers(shakers, 1.0f / 30.0f);
	const float elapsed = shakers.elapsed[0];
	const float intensity = shakers.intensities[0] * (1.0f - 50.0f / 100.0f) * (1.0f - elapsed / 1.0f);
	const std::array<float, 3> axes = camera_shaking::AxisRotation;
	std::array<float, 3> expected{};
	for (std::size_t axis = 0; axis < 3; ++axis)
	{
		const float omega = camera_shaking::MinOmega + (camera_shaking::EndOmega - camera_shaking::MinOmega) * elapsed;
		expected[axis] += axes[axis] * intensity * std::sin(omega * elapsed + camera_shaking::MinPhi);
		for (float &angle : expected)
			angle += -intensity * 0.5f;
	}
	const std::array<float, 3> angles = ShakerAngles(shakers, {0, 0, 0}, random);
	for (std::size_t axis = 0; axis < 3; ++axis)
		BOOST_TEST(angles[axis] == expected[axis]);
	// 101 units away: beyond its radius, nothing.
	const std::array<float, 3> beyond = ShakerAngles(shakers, {151, 0, 0}, random);
	BOOST_TEST(beyond[0] == 0.0f);
	BOOST_TEST(beyond[1] == 0.0f);
	BOOST_TEST(beyond[2] == 0.0f);
}

// legacy_parity: doCameraMotionBlurJump (setViewFilter(FT_VIEW_MOTION_BLUR_FILTER), setViewFilterMode(
// FM_VIEW_MB_IN_AND_OUT_ALPHA), setViewFilterPos) and ScreenMotionBlurFilter::setup / postRender: the count rises 5 a
// logic frame from the script's frame (tick 10), so on the 12th (tick 21) it reaches 60, turns and the camera looks at
// the waypoint (lookAt); it falls to 0 on the 24th (tick 33), when the effect ends and the view's filter is the
// default again. A second step in the same logic frame does nothing. W3DView::isCameraMovementFinished answers
// finished while the zoom blur runs.
BOOST_AUTO_TEST_CASE(legacy_parity_a_blur_jump_moves_the_camera_at_its_peak_and_ends_on_the_originals_frames)
{
	ViewFilter filter;
	StartMotionBlurJump(filter, {100, 200, 5}, false);
	BOOST_TEST(filter.motionBlur);
	BOOST_TEST((filter.mode == ViewFilterMode::InAndOutAlpha));
	BOOST_TEST(MotionBlurZooming(filter));
	std::optional<std::uint64_t> jumped, ended;
	for (std::uint64_t tick = 10; tick < 60 && !ended; ++tick)
	{
		const MotionBlurStep step = StepMotionBlur(filter, tick);
		const MotionBlurStep again = StepMotionBlur(filter, tick);
		BOOST_TEST((!again.jumpTo && !again.ended));
		if (step.jumpTo)
		{
			jumped = tick;
			BOOST_TEST((*step.jumpTo)[0] == 100.0f);
			BOOST_TEST((*step.jumpTo)[1] == 200.0f);
			BOOST_TEST(filter.maxCount == 60);
		}
		if (step.ended)
			ended = tick;
	}
	BOOST_TEST_REQUIRE(jumped.has_value());
	BOOST_TEST(*jumped == 21u);
	BOOST_TEST_REQUIRE(ended.has_value());
	BOOST_TEST(*ended == 33u);
	BOOST_TEST(!filter.motionBlur);
	BOOST_TEST((filter.mode == ViewFilterMode::Default));
	BOOST_TEST(!MotionBlurZooming(filter));
}

// legacy_parity: doCameraMotionBlur(zoom in / out, saturate): a zoom in rises from 0 and ends as it reaches 60 on its
// 12th logic frame (no point to jump to); a zoom out starts at 60 falling (setup: m_maxCount = MAX_COUNT, decrement)
// and ends below 1 on its 12th; neither moves the camera. A follow (pan) blur keeps its amount (0: DEFAULT_PAN_FACTOR
// 30) and is not stepped by logic frames; its end keeps the count it had.
BOOST_AUTO_TEST_CASE(legacy_parity_zoom_blurs_end_on_their_twelfth_frame)
{
	for (const bool zoomIn : {true, false})
		for (const bool saturate : {false, true})
		{
			ViewFilter filter;
			StartMotionBlur(filter, zoomIn, saturate);
			BOOST_TEST(filter.additive == saturate);
			BOOST_TEST(filter.maxCount == (zoomIn ? 0 : 60));
			int endedOn = 0;
			for (int frame = 1; frame <= 20 && endedOn == 0; ++frame)
			{
				const MotionBlurStep step = StepMotionBlur(filter, static_cast<std::uint64_t>(frame));
				BOOST_TEST(!step.jumpTo.has_value());
				if (step.ended)
					endedOn = frame;
			}
			BOOST_TEST(endedOn == 12);
		}
	ViewFilter pan;
	StartMotionBlurFollow(pan, 0);
	BOOST_TEST((pan.mode == ViewFilterMode::PanAlpha));
	BOOST_TEST(pan.panFactor == 30);
	BOOST_TEST(!MotionBlurZooming(pan));
	BOOST_TEST(!StepMotionBlur(pan, 1).ended);
	pan.maxCount = 17;
	EndMotionBlurFollow(pan);
	BOOST_TEST((pan.mode == ViewFilterMode::EndPanAlpha));
	BOOST_TEST(pan.maxCount == 17);
	BOOST_TEST(pan.motionBlur);
}

// legacy_parity: ScriptActions::doModCameraMoveToSelection: the selected drawables' positions summed and divided by
// their count (z first, as the original); with none selected there is nothing to move to.
BOOST_AUTO_TEST_CASE(legacy_parity_the_camera_moves_to_the_average_of_the_selection)
{
	BOOST_TEST(!SelectionCentre({}).has_value());
	const std::vector<std::array<float, 3>> selected{{10.0f, 20.0f, 3.0f}, {30.0f, 40.0f, 6.0f}, {50.0f, 0.0f, 0.0f}};
	const auto centre = SelectionCentre(selected);
	BOOST_TEST_REQUIRE(centre.has_value());
	BOOST_TEST((*centre)[0] == 30.0f);
	BOOST_TEST((*centre)[1] == 20.0f);
	BOOST_TEST((*centre)[2] == 3.0f);
}

// legacy_parity: W3DView::getCameraTransform in slave mode: the camera's transform is the bone's in the world
// (getRenderObjectBoneTransform: the object's transform times the bone's in its model) and the view's position its x and
// y (View::setPosition2D). An object at (100, 50, 10) turned a quarter about z, its bone 5 along the model's x and 2 up,
// itself turned a quarter about x: the camera sits at (100, 55, 12), its x axis along the world's y, its y along z.
BOOST_AUTO_TEST_CASE(legacy_parity_a_slaved_camera_is_its_bone_in_the_world)
{
	const std::array<float, 16> world{0, -1, 0, 100, 1, 0, 0, 50, 0, 0, 1, 10, 0, 0, 0, 1};
	const std::array<float, 12> bone{1, 0, 0, 5, 0, 0, -1, 0, 0, 1, 0, 2};
	const std::array<float, 12> camera = BoneInWorld(world, bone);
	const std::array<float, 12> expected{0, 0, 1, 100, 1, 0, 0, 55, 0, 1, 0, 12};
	for (std::size_t index = 0; index < 12; ++index)
		BOOST_TEST(camera[index] == expected[index]);
	const std::array<float, 2> at = SlavePosition(camera);
	BOOST_TEST(at[0] == 100.0f);
	BOOST_TEST(at[1] == 55.0f);
}

// legacy_parity: ScriptActions::doBlackWhiteMode and ScreenBWFilter::set (W3DShaderManager.cpp), a frame at a time: begun
// over 4 frames the grey fades in 0.25, 0.5, 0.75, then 1 and settles; ended over 2 frames it fades out 0.5, then 0 and the
// view's filter is none (that frame still drawn). Ending it while the view's filter is not the grey one does nothing; a
// motion blur replaces it (the view has one filter). Drawn: the whole view through the grey shader at the fade.
BOOST_AUTO_TEST_CASE(legacy_parity_black_and_white_fades_in_and_out_frame_by_frame)
{
	ViewFilter filter;
	EndBlackWhite(filter, 3);
	BOOST_TEST(filter.fadeDirection == 0);
	StartBlackWhite(filter, 4);
	const float in[5] = {0.25f, 0.5f, 0.75f, 1.0f, 1.0f};
	for (int frame = 0; frame < 5; ++frame)
	{
		BOOST_TEST(StepBlackWhite(filter));
		BOOST_TEST(filter.fadeValue == in[frame]);
	}
	ScreenFilterDraw draw;
	BlackWhiteDraw(filter, filter.blackWhite, draw);
	BOOST_TEST_REQUIRE(draw.quads.size() == 1u);
	BOOST_TEST(draw.quads[0].blackWhite);
	BOOST_TEST(draw.quads[0].fade == 1.0f);
	BOOST_TEST((draw.quads[0].uv[0] == std::array<float, 2>{1.0f, 1.0f}));
	BOOST_TEST((draw.quads[0].uv[3] == std::array<float, 2>{0.0f, 0.0f}));
	EndBlackWhite(filter, 2);
	BOOST_TEST(StepBlackWhite(filter));
	BOOST_TEST(filter.fadeValue == 0.5f);
	BOOST_TEST(StepBlackWhite(filter));
	BOOST_TEST(filter.fadeValue == 0.0f);
	BOOST_TEST(!filter.blackWhite);
	BOOST_TEST(!StepBlackWhite(filter));
	StartBlackWhite(filter, 4);
	StartMotionBlur(filter, true, false);
	BOOST_TEST(!filter.blackWhite);
	BOOST_TEST(filter.motionBlur);
}

// legacy_parity: ScreenMotionBlurFilter::postRender's quads (W3DShaderManager.cpp). A zoom in-and-out (doCameraMotionBlurJump)
// after its first logic frame (count 5): the picture drawn back opaque with its corners pulled to the centre by sqrt(1 - 5 /
// 60 x 0.9) (0.98088 at the bottom right), then 5 copies, each pulled in by 0.99 more (the fifth's corner 0.95732 / 0.04268),
// blended at alpha 0x15; drawn from the last frame's picture (m_skipRender: the count just moved). Saturating at its peak
// (count 60): 30 copies added at 0x09 + (60 - 30) / 5 + 60 = 75, each 0.98 in. A pan (no scroll, pan factor 30): count 15
// (half the pan factor at least), centred half a view up, the copies 0.006 wider across.
BOOST_AUTO_TEST_CASE(legacy_parity_a_motion_blur_draws_its_copies_pulled_to_the_centre)
{
	ViewFilter filter;
	StartMotionBlurJump(filter, {100.0f, 200.0f, 0.0f}, false);
	StepMotionBlur(filter, 1);
	BOOST_TEST(filter.maxCount == 5);
	BOOST_TEST(filter.skipRender);
	ScreenFilterDraw draw;
	BOOST_TEST(MotionBlurDraw(filter, {0.0f, 0.0f}, draw));
	BOOST_TEST_REQUIRE(draw.quads.size() == 6u);
	BOOST_TEST(draw.keepPicture);
	BOOST_TEST(!draw.quads[0].blend);
	BOOST_TEST(std::abs(draw.quads[0].uv[0][0] - 0.9808846f) <= 0.00001f);
	BOOST_TEST(std::abs(draw.quads[5].uv[0][0] - 0.9573165f) <= 0.00001f);
	BOOST_TEST(std::abs(draw.quads[5].uv[3][1] - 0.0426835f) <= 0.00001f);
	BOOST_TEST(draw.quads[1].blend);
	BOOST_TEST(!draw.quads[1].additive);
	BOOST_TEST(draw.quads[1].color[3] == 21.0f / 255.0f);

	ViewFilter peak;
	StartMotionBlur(peak, true, true);
	peak.maxCount = ViewFilter::MaxCount;
	ScreenFilterDraw bright;
	MotionBlurDraw(peak, {0.0f, 0.0f}, bright);
	BOOST_TEST_REQUIRE(bright.quads.size() == 31u);
	BOOST_TEST(bright.quads[30].additive);
	BOOST_TEST(bright.quads[30].color[3] == 75.0f / 255.0f);

	ViewFilter pan;
	StartMotionBlurFollow(pan, 30);
	ScreenFilterDraw panned;
	MotionBlurDraw(pan, {0.0f, 0.0f}, panned);
	BOOST_TEST(pan.maxCount == 15);
	BOOST_TEST_REQUIRE(panned.quads.size() == 16u);
	BOOST_TEST((panned.quads[0].uv[3] == std::array<float, 2>{0.0f, 0.0f}));
	BOOST_TEST(std::abs(panned.quads[1].uv[3][0] - 0.002f) <= 0.00001f);
	BOOST_TEST(panned.quads[1].uv[3][1] == 0.0f);
}

// legacy_parity: W3DView::draw drew the view (and ScreenBWFilter::set / ScreenMotionBlurFilter::postRender stepped) once a
// frame at 30 frames a second; on real time: 0.07 s is 2 of those frames (the grey over 10 frames at 0.2), 0.01 s more
// none, a 0.25 s stall 7 (0.9). A pan (CAMERA_MOTION_BLUR_FOLLOW 30) scrolling 0.1125 of the screen up a frame
// (calcDeltaScroll): count int(0.1125 x 200 x 30 / 30) = 22, 22 copies; its end (END_FOLLOW) centred toward that scroll
// (0.5, 0): 2 frames later the count is 20 (the first copy's top left 0.002 / 0, bottom right 0.998 / 0.99); stepping
// on, it stops at 1, that frame is still drawn (one copy), and the effect is over. A zoom's kept picture is only the
// first drawing after its count moved (m_skipRender cleared by the next postRender).
BOOST_AUTO_TEST_CASE(legacy_parity_screen_filters_step_by_the_originals_drawn_frames)
{
	ViewFilter grey;
	StartBlackWhite(grey, 10);
	BOOST_TEST(StepScreenFilterFrames(grey, 0.07f) == 2);
	BOOST_TEST(grey.fadeValue == 0.2f);
	BOOST_TEST(StepScreenFilterFrames(grey, 0.01f) == 0);
	BOOST_TEST(grey.fadeValue == 0.2f);
	BOOST_TEST(StepScreenFilterFrames(grey, 0.25f) == 7);
	BOOST_TEST(grey.fadeValue == 0.9f);

	ViewFilter pan;
	StartMotionBlurFollow(pan, 30);
	ScreenFilterDraw panned;
	BOOST_TEST(MotionBlurDraw(pan, {0.0f, 0.1125f}, panned));
	BOOST_TEST(pan.maxCount == 22);
	BOOST_TEST(panned.quads.size() == 23u);
	EndMotionBlurFollow(pan);
	BOOST_TEST(StepScreenFilterFrames(pan, 0.07f) == 2);
	BOOST_TEST(pan.maxCount == 20);
	ScreenFilterDraw ending;
	BOOST_TEST(MotionBlurDraw(pan, {0.0f, 0.0f}, ending));
	BOOST_TEST_REQUIRE(ending.quads.size() == 21u);
	BOOST_TEST(std::abs(ending.quads[1].uv[3][0] - 0.002f) <= 0.00001f);
	BOOST_TEST(std::abs(ending.quads[1].uv[3][1]) <= 0.00001f);
	BOOST_TEST(std::abs(ending.quads[1].uv[0][0] - 0.998f) <= 0.00001f);
	BOOST_TEST(std::abs(ending.quads[1].uv[0][1] - 0.99f) <= 0.00001f);
	StepScreenFilterFrames(pan, 0.25f);
	StepScreenFilterFrames(pan, 0.25f);
	StepScreenFilterFrames(pan, 0.25f);
	BOOST_TEST(pan.maxCount == 1);
	ScreenFilterDraw over;
	BOOST_TEST(!MotionBlurDraw(pan, {0.0f, 0.0f}, over));
	BOOST_TEST(over.quads.size() == 2u);
	BOOST_TEST(!pan.motionBlur);

	ViewFilter zoom;
	StartMotionBlurJump(zoom, {0.0f, 0.0f, 0.0f}, false);
	StepMotionBlur(zoom, 1);
	ScreenFilterDraw first;
	MotionBlurDraw(zoom, {0.0f, 0.0f}, first);
	BOOST_TEST(first.keepPicture);
	ScreenFilterDraw second;
	MotionBlurDraw(zoom, {0.0f, 0.0f}, second);
	BOOST_TEST(!second.keepPicture);
}

BOOST_AUTO_TEST_SUITE_END()
