{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.FinalizeComponents();
	world.EmplaceResource<LookCatalog>().aircraftWheelScreechSound = "JetSkid";
	auto &sounds = world.EmplaceResource<SoundRequests>();
	auto &touchdowns = world.EmplaceResource<engine::gameplay::JetTouchdowns>();
	JetTouchdownSoundSystem system;
	ecs::SystemRegistry registry;
	registry.Register(system);
	registry.Finalize(world.Components());
	ecs::Scheduler scheduler(world, registry, engine::jobs::JobSystemConfig{1});
	scheduler.Finalize(engine::time::FixedStep{30});
	touchdowns.list = {{ecs::Entity{}, {Engine::Math::Fixed::FromInt(1100), Engine::Math::Fixed::FromInt(1000), Engine::Math::Fixed::FromRatio(1, 4)}}};
	scheduler.Execute(engine::time::SimulationTime{1, engine::time::FixedStep{30}});
	BOOST_TEST_REQUIRE(sounds.pending.size() == 1u);
	BOOST_TEST(sounds.pending[0].sound == "JetSkid");
	BOOST_TEST(sounds.pending[0].at[0] == 1100.0f);
	BOOST_TEST(sounds.pending[0].at[1] == 1000.0f);
	BOOST_TEST(sounds.pending[0].at[2] == 0.25f);
	BOOST_TEST(sounds.pending[0].positioned);
	BOOST_TEST(sounds.pending[0].owner == SoundRequest::NoOwner);
	sounds.pending.clear();
	touchdowns.list.clear();
	scheduler.Execute(engine::time::SimulationTime{2, engine::time::FixedStep{30}});
	BOOST_TEST(sounds.pending.empty());
}

// Cash that changed hands floats up as it shows in the original: Player::doBountyForKill's bounty GUI:AddCash in
