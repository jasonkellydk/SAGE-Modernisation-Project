	BOOST_TEST(texts.shown[0].alpha == 230);
}


// Drawable::calcPhysicsXformTreads, frame by frame (stiffness 0.1, damping 0.9, ForwardAccelerationPitchFactor 1):
// a frame of forward acceleration 0.1 kicks the acceleration pitch rate to -0.1 after that frame's pose; the next
// frame the spring and damper take it to -0.01 (rate -0.1 + 0.09), then it holds (rate -0.01 + 0.001 + 0.009 = 0);
// the pitch stays within AccelerationPitchLimit. On a slope the suspension pitches toward the ground's slope
// (groundPitch = dot(normal, direction) * pi / 2), pitching up (toward a negative slope) at half the rate.
BOOST_AUTO_TEST_CASE(legacy_parity_treads_rock_with_acceleration_and_follow_the_slope)
{
	ChassisTuning look;
	look.kind = generalszh::content::ChassisKind::Treads;
	look.forwardAccel = 1.0f;
	look.accelPitchLimit = 0.3f;
	look.decelPitchLimit = 0.3f;
	ChassisState state;
	ChassisInput in;
	in.acceleration = {0.1f, 0.0f, 0.0f};
	BOOST_TEST(StepChassis(state, look, in).pitch == 0.0f);
	BOOST_TEST(state.accelPitchRate == -0.1f, boost::test_tools::tolerance(1e-6f));
	in.acceleration = {};
	BOOST_TEST(StepChassis(state, look, in).pitch == -0.01f, boost::test_tools::tolerance(1e-6f));
	BOOST_TEST(StepChassis(state, look, in).pitch == -0.01f, boost::test_tools::tolerance(1e-6f));
	// Hard acceleration is held at the limit.
	ChassisState hard;
	in.acceleration = {-5.0f, 0.0f, 0.0f};
	for (int frame = 0; frame < 5; ++frame)
		StepChassis(hard, look, in);
	BOOST_TEST(hard.accelPitch == 0.3f, boost::test_tools::tolerance(1e-6f));
	// Facing east up a slope rising to the east (the normal leans west): it settles nose up at the slope's pitch.
	ChassisState slope;
	in.acceleration = {};
	in.groundNormal = {-0.2f, 0.0f, std::sqrt(1.0f - 0.04f)};
	for (int frame = 0; frame < 400; ++frame)
		StepChassis(slope, look, in);
	BOOST_TEST(slope.pitch == -0.2f * 1.5707963f, boost::test_tools::tolerance(1e-3f));
	// Its first frame there: rate -0.1 * (0 - groundPitch) = -0.0314... (nose up, at full rate); downhill the rate
	// is positive (nose down) and halved: +0.0157...
	ChassisState first;
	BOOST_TEST(StepChassis(first, look, in).pitch == -0.1f * 0.2f * 1.5707963f, boost::test_tools::tolerance(1e-5f));
	ChassisState downhill;
	in.groundNormal = {0.2f, 0.0f, std::sqrt(1.0f - 0.04f)};
	BOOST_TEST(StepChassis(downhill, look, in).pitch == 0.1f * 0.2f * 1.5707963f * 0.5f, boost::test_tools::tolerance(1e-5f));
}

// ChassisLook from Locomotor.ini: the Crusader's treads, the Humvee's four wheels, their suspension values.
BOOST_AUTO_TEST_CASE(shipped_locomotors_carry_their_chassis_values)
{
	const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
	if (install == nullptr || !std::filesystem::exists(install))
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	engine::filesystem::VirtualFileSystem files;
	generalszh::content::MountInstall(files, install);
	engine::config::Diagnostics grammarDiagnostics;
	generalszh::content::ContentLoader loader(files, generalszh::content::ZeroHourIniGrammar(grammarDiagnostics));
	const auto looks = generalszh::content::ReadChassisLooks(loader.Load({"Data/INI/Locomotor"}));
	const auto crusader = looks.find("CrusaderLocomotor");
	BOOST_TEST_REQUIRE((crusader != looks.end()));
	BOOST_TEST((crusader->second.kind == generalszh::content::ChassisKind::Treads));
	const ChassisTuning tuning = TuningOf(crusader->second);
	BOOST_TEST(tuning.pitchStiffness > 0.0f);
	BOOST_TEST(tuning.accelPitchLimit > 0.0f);
	const auto humvee = looks.find("HumveeLocomotor");
	BOOST_TEST_REQUIRE((humvee != looks.end()));
	BOOST_TEST((humvee->second.kind == generalszh::content::ChassisKind::Wheels));
	BOOST_TEST(TuningOf(humvee->second).pitchStiffness == 0.35f, boost::test_tools::tolerance(1e-4f));
	BOOST_TEST(TuningOf(humvee->second).rollStiffness == 0.05f, boost::test_tools::tolerance(1e-4f));
	BOOST_TEST(TuningOf(humvee->second).pitchDamping == 0.96f, boost::test_tools::tolerance(1e-4f));
	const auto buggy = looks.find("RocketBuggyLocomotor");
	BOOST_TEST_REQUIRE((buggy != looks.end()));
	BOOST_TEST(TuningOf(buggy->second).bounceKick > 0.0f);
}

// W3DDebrisDraw::doDrawModule, a drawn frame at a time (frames of 1/30 s): a thrown Rebel (OCL_RebelFlyingOffBikeDeathStart:
// UITech_Man_DTA1 once, DTA2 looping, DTA3 once, FXFinal) starts its initial animation on the first frame; when that
// animation is on its last frame (10 frames: the 9th drawn after it started) it moves on to its flying one; once on the
// ground after more than three frames it goes to its final one at once and plays its landing effect, once. Landing on its
// first frames waits for the fourth. "STOP": the final state holds the flying animation's first frame (manual), restarted
// as the state changes. A state without an animation keeps the last one showing and moves on when that one finishes.
BOOST_AUTO_TEST_CASE(legacy_parity_debris_animations_step_as_it_flies_and_lands)
{
	engine::gameplay::DebrisLook look;
	look.animations = {11, 12, 13};
	look.finalEffect = 5;
	const LookClip clip{10.0f, 30.0f};
	const auto frame = [&](DebrisMotion &motion, bool above, int index) {
		const double clock = index / 30.0;
		return StepDebris(motion, look, above, DebrisAnimationComplete(motion, clip, clock), clock, 1.0f / 30.0f);
	};
	DebrisMotion motion;
	BOOST_TEST(!frame(motion, true, 0));
	BOOST_TEST(motion.state == DebrisMotion::Initial);
	BOOST_TEST(motion.animation == 11u);
	BOOST_TEST(motion.mode == static_cast<std::uint8_t>(generalszh::content::ModelAnimationMode::Once));
	int flyingAt = -1;
	for (int index = 1; index < 20; ++index)
	{
		BOOST_TEST(!frame(motion, true, index));
		if (flyingAt < 0 && motion.state == DebrisMotion::Flying)
			flyingAt = index;
	}
	BOOST_TEST(flyingAt == 9); // on its last frame (the 9th after it started): done
	BOOST_TEST(motion.animation == 12u);
	BOOST_TEST(motion.mode == static_cast<std::uint8_t>(generalszh::content::ModelAnimationMode::Loop));
	BOOST_TEST(!DebrisAnimationComplete(motion, clip, 100.0)); // a loop never finishes
	BOOST_TEST(frame(motion, false, 20)); // lands: its final animation and its effect
	BOOST_TEST(motion.state == DebrisMotion::Final);
	BOOST_TEST(motion.animation == 13u);
	for (int index = 21; index < 60; ++index)
		BOOST_TEST(!frame(motion, false, index)); // once

	// On the ground from the start: the final state waits until more than three frames were drawn.
	DebrisMotion early;
	int finalAt = -1;
	for (int index = 0; index < 8 && finalAt < 0; ++index)
		if (frame(early, false, index))
			finalAt = index;
	BOOST_TEST(finalAt == 4);

	// STOP: its flying animation, held at its first frame.
	look.animations = {11, 12, 12};
	look.finalStop = 1;
	DebrisMotion stop;
	for (int index = 0; index < 15; ++index)
		frame(stop, true, index);
	BOOST_TEST(stop.state == DebrisMotion::Flying);
	BOOST_TEST(frame(stop, false, 15));
	BOOST_TEST(stop.animation == 12u);
	BOOST_TEST(stop.mode == static_cast<std::uint8_t>(generalszh::content::ModelAnimationMode::Manual));
	BOOST_TEST(stop.since == 15 / 30.0);

	// No flying animation: the initial one keeps showing, and being done moves it on to the final one in the air.
	look.animations = {11, 0, 13};
	look.finalStop = 0;
	DebrisMotion gap;
	int gapFinal = -1;
	for (int index = 0; index < 20 && gapFinal < 0; ++index)
		if (frame(gap, true, index))
			gapFinal = index;
	BOOST_TEST(gapFinal == 10); // done on frame 9 (flying: nothing new), still done on 10: final
}

// Object::adjustModelConditionForWeaponStatus -> Drawable::updateDrawableClipStatus -> W3DModelDraw::
// updateProjectileClipStatus, as sampled each tick: a slot with a 4-shot clip shows 4 projectiles loaded, hides one per
// shot fired (the first ones: doHideShowProjectileObjects), hides them all while its clip reloads (Weapon::
// getRemainingAmmo is 0 while RELOADING_CLIP) and shows them again once it is loaded; out of ammo it shows none; a
// weapon without a clip hides nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_loaded_projectiles_hide_as_the_clip_empties)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Armament>();
	world.RegisterComponent<engine::gameplay::WeaponSlots>();
	world.RegisterComponent<engine::gameplay::Turret>();
	world.RegisterComponent<engine::gameplay::AltTurret>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	auto &weapons = world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	engine::gameplay::WeaponDefinition clipped;
	clipped.clipSize = 4;
	const std::uint32_t missiles = weapons.Add(clipped);
	const std::uint32_t gun = weapons.Add(engine::gameplay::WeaponDefinition{});
	ecs::SystemRegistry systems;
	PoseSampleSystem sample;
	systems.Register(sample);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{1});
	scheduler.Finalize(engine::time::FixedStep{30});
	std::uint64_t tick = 0;
	const ecs::Entity launcher = world.Create();
	world.Add<engine::gameplay::Transform>(launcher);
	world.Add<engine::gameplay::DefinitionRef>(launcher);
	world.Add<engine::gameplay::Armament>(launcher);
	world.Add<engine::gameplay::WeaponSlots>(launcher);
	auto &slots = *world.Get<engine::gameplay::WeaponSlots>(launcher);
	slots.slots[0].weapon = missiles;
	slots.slots[1].weapon = gun;
	world.Get<engine::gameplay::Armament>(launcher)->weapon = missiles;
	const auto step = [&] {
		scheduler.Execute(engine::time::SimulationTime{++tick, engine::time::FixedStep{30}});
		const WeaponPose *pose = world.Side<WeaponPose>().Get(launcher);
		return pose != nullptr ? pose->projectilesHidden : std::array<std::uint8_t, 3>{};
	};
	step();
	auto &arm = *world.Get<engine::gameplay::Armament>(launcher);
	BOOST_TEST(step()[0] == 0u); // loaded: all four show
	arm.clip = 3;                // one fired
	BOOST_TEST(step()[0] == 1u);
	arm.clip = 1;
	BOOST_TEST(step()[0] == 3u);
	// The last one fired: the clip reloads (the port refills it at once, the original reports none while reloading).
	arm.clip = 4;
	arm.reloading = true;
	arm.readyTick = tick + 10;
	BOOST_TEST(step()[0] == 4u);
	while (tick + 1 < arm.readyTick)
		BOOST_TEST(step()[0] == 4u);
	BOOST_TEST(step()[0] == 0u); // loaded again
	arm.readyTick = engine::gameplay::OutOfAmmo;
	arm.clip = 0;
	BOOST_TEST(step()[0] == 4u); // out of ammo: none
	BOOST_TEST(step()[1] == 0u); // the gun has no clip
}

// GameClient::update / W3DScene's shroud (GeneralsMD/Code/GameEngine/Source/GameClient/GameClient.cpp,
// GeneralsMD/Code/GameEngineDevice/Source/W3DDevice/GameClient/W3DScene.cpp) and PartitionData::getShroudedStatus's
// ghost objects: an enemy tank fogged to the viewer is still drawn for 2 seconds after it was last clear, then not; a
// ghost-leaving (immobile) one stays in the fog once seen, is forgotten when wholly shrouded, and always stays where the
// viewer is neutral to it. Nobody's eyes (an observer): everything shows.
BOOST_AUTO_TEST_CASE(legacy_parity_what_the_shroud_hides)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	world.RegisterComponent<engine::gameplay::ObjectShroud>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>();
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	auto &relationships = world.EmplaceResource<engine::gameplay::Relationships>(8u);
	relationships.Set(1, 0, engine::gameplay::Relationship::Enemies);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	world.EmplaceResource<engine::gameplay::PlayerSciences>();
	world.EmplaceResource<engine::gameplay::MatchOutcome>();
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	world.EmplaceResource<MotionLooks>();
	DefinitionLooks looks;
	looks.states.states.resize(1);
	looks.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	looks.stateLooks = {0};
	DefinitionLooks bunker = looks;
	bunker.ghost = true;
	catalog.byDefinition = {looks, bunker};
	catalog.known = {1, 1};
	catalog.looks = {{0, 0, 0}};
	catalog.lookModels = {"A"};
	catalog.playerColors = {{1, 0, 0, 1}};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{1});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{1});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto make = [&](std::uint32_t definition) {
		const ecs::Entity entity = world.Create();
		world.Add<engine::gameplay::Transform>(entity);
		world.Add<engine::gameplay::DefinitionRef>(entity);
		world.Get<engine::gameplay::DefinitionRef>(entity)->index = definition;
		world.Add<engine::gameplay::Owner>(entity);
		world.Add<engine::gameplay::Appearance>(entity);
		world.Add<engine::gameplay::ObjectShroud>(entity);
		return entity;
	};
	const ecs::Entity tank = make(0);
	const ecs::Entity base = make(1);
	tick.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}});
	const auto drawnAt = [&](double clock) {
		frame.clock = clock;
		draw.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}});
		std::vector<PresentedObject> presented;
		world.Resource<PresentedObjects>().AppendTo(presented);
		std::pair<bool, bool> shown{false, false};
		for (const PresentedObject &object : presented)
		{
			shown.first = shown.first || object.entity == tank;
			shown.second = shown.second || object.entity == base;
		}
		return shown;
	};
	const auto set = [&](ecs::Entity entity, std::uint64_t clear, std::uint64_t fogged) { *world.Get<engine::gameplay::ObjectShroud>(entity) = {clear, 0, fogged}; };
	frame.viewer = 1;
	set(tank, 0b10, 0);
	set(base, 0b10, 0);
	BOOST_TEST(drawnAt(1.0).first);
	BOOST_TEST(drawnAt(1.1).second);
	set(tank, 0, 0b10);
	set(base, 0, 0b10);
	BOOST_TEST(drawnAt(2.9).first); // within 2 s of 1.0
	auto shown = drawnAt(3.2);
	BOOST_TEST(!shown.first);
	BOOST_TEST(shown.second); // a ghost, seen before
	set(base, 0, 0); // wholly shrouded: forgotten
	BOOST_TEST(!drawnAt(3.3).second);
	set(base, 0, 0b10);
	BOOST_TEST(!drawnAt(6.0).second); // fogged, never seen since
	relationships.Set(1, 0, engine::gameplay::Relationship::Neutral);
	shown = drawnAt(6.1);
	BOOST_TEST(shown.second); // neutral ghosts stay
	BOOST_TEST(!shown.first); // a neutral unit does not
	frame.viewer = PresentationFrame::NoViewer;
	BOOST_TEST(drawnAt(6.2).first);
}

// Legacy parity (ScriptActions::doNamedFlash, Drawable::updateDrawable, colorFlash): two seconds of flashing is
// 30 * 2 / 15 = 4 flashes, one on each tick the frame count is a multiple of DRAWABLE_FRAMES_PER_FLASH (15, 30, 45, 60),
// each playing the tint in the script's colour (an object without a tint yet gets one); then no more.
BOOST_AUTO_TEST_CASE(legacy_parity_a_scripted_flash_flashes_every_half_second)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Owner>();
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	ecs::SystemRegistry tickSystems;
	ScriptFlashSystem flashing;
	tickSystems.Register(flashing);
	tickSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{1});
	tick.Finalize(engine::time::FixedStep{30});
	const ecs::Entity unit = world.Create();
	world.Add<engine::gameplay::Owner>(unit);
	ScriptFlash flash{30 * 2 / 15, {1.0f, 0.0f, 0.0f}};
	world.Side<ScriptFlash>().Insert(unit, &flash);
	std::vector<std::uint64_t> flashed;
	std::int32_t before = 4;
	for (std::uint64_t serial = 1; serial <= 100; ++serial)
	{
		tick.Execute(engine::time::SimulationTime{serial, engine::time::FixedStep{30}});
		const std::int32_t left = world.Side<ScriptFlash>().Get(unit)->count;
		if (left != before)
			flashed.push_back(serial);
		before = left;
	}
	BOOST_TEST((flashed == std::vector<std::uint64_t>{15, 30, 45, 60}));
	const TintEnvelope *tint = world.Side<TintEnvelope>().Get(unit);
	BOOST_TEST_REQUIRE(tint != nullptr);
	BOOST_TEST(tint->peak[0] == 1.0f);
	BOOST_TEST(tint->peak[1] == 0.0f);
}

// W3DTankDraw::doDrawModule / setHidden / setFullyObscuredByShroud: a moving tank's tread debris runs while it is seen;
// inside something (hidden) it stops, and so it does fogged or shrouded to the viewer (fully obscured) and stealthed
// out of the viewer's sight; seen again, moving, it starts again. An ally's stealthed tank still throws debris.
BOOST_AUTO_TEST_CASE(legacy_parity_tread_debris_stops_while_hidden_or_obscured)
{
	Street street(1);
	auto &world = street.world;
	EffectsContent effects;
	effects.particles.Define("TrackDebrisDirtLeft");
	engine::effects::ParticleWorld particles([&](std::string_view name) { return effects.particles.Find(name); });
	world.Resource<ParticleWorldHandle>() = ParticleWorldHandle{&particles, &effects};
	auto &looks = world.Resource<MotionLooks>();
	looks.byDefinition[0].motionSystems = {"TrackDebrisDirtLeft"};
	looks.byDefinition[0].motionRoles = {static_cast<std::uint8_t>(generalszh::content::MotionEmitterRole::TreadDebris)};
	PresentationFrame &frame = world.Resource<PresentationFrame>();
	frame.viewer = 0;
	const ecs::Entity tank = street.Vehicle(0);
	world.Add<engine::gameplay::Owner>(tank);
	world.Get<engine::gameplay::Owner>(tank)->player = 1;
	world.Add<engine::gameplay::ObjectShroud>(tank);
	const auto clearTo = [&](bool clear) {
		engine::gameplay::ObjectShroud &s = *world.Get<engine::gameplay::ObjectShroud>(tank);
		s = engine::gameplay::ObjectShroud{};
		if (!clear)
			s.clear = 0; // fogged: not even partially clear
	};
	clearTo(true);
	const auto drive = [&] {
		street.Tick(tank, 3, 0);
		street.Sample();
		street.Frame();
		const MotionEmission *emission = world.Side<MotionEmission>().Get(tank);
		return emission != nullptr && emission->count > 0 && particles.Running(emission->systems[0]);
	};
	drive();
	BOOST_TEST(drive());
	world.Add<engine::gameplay::OffMap>(tank);
	BOOST_TEST(!drive());
	world.Remove<engine::gameplay::OffMap>(tank);
	BOOST_TEST(drive());
	clearTo(false);
	BOOST_TEST(!drive());
	clearTo(true);
	BOOST_TEST(drive());
	world.Add<engine::gameplay::Stealth>(tank);
	world.Get<engine::gameplay::Stealth>(tank)->flags = engine::gameplay::stealth_flag::Stealthed;
	BOOST_TEST(!drive());
	world.Resource<engine::gameplay::Relationships>().Set(1, 0, engine::gameplay::Relationship::Allies);
	world.Resource<engine::gameplay::Relationships>().Set(0, 1, engine::gameplay::Relationship::Allies);
	BOOST_TEST(drive());
}

// W3DOverlordAircraftDraw / W3DOverlordTankDraw::doDrawModule: the portable structure riding a carrier drawn by one of
// them takes the carrier's colour tint whole each drawn frame (Drawable::setColorTintEnvelope), only when it has a tint
// of its own; a carrier with another draw (W3DModelDraw) passes nothing on.
BOOST_AUTO_TEST_CASE(legacy_parity_an_overlord_riders_tint_follows_its_carrier)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	DefinitionLooks overlord;
	overlord.ridersTakeTint = true;
	DefinitionLooks plain;
	catalog.byDefinition = {overlord, plain, plain};
	catalog.known = {1, 1, 1};
	world.EmplaceResource<PresentationFrame>();
	ecs::SystemRegistry systems;
	TintStatusSystem tintStatus;
	RiderTintSystem riders;
	systems.Register(tintStatus);
	systems.Register(riders);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{2});
	scheduler.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&] { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };
	const auto make = [&](std::uint32_t definition) {
		const ecs::Entity entity = world.Create();
		world.Add<engine::gameplay::DefinitionRef>(entity);
		world.Get<engine::gameplay::DefinitionRef>(entity)->index = definition;
		return entity;
	};
	const ecs::Entity carrier = make(0);
	const ecs::Entity other = make(1);
	const ecs::Entity gun = make(2), lone = make(2), onOther = make(2);
	for (const auto &[rider, on] : {std::pair{gun, carrier}, std::pair{lone, carrier}, std::pair{onOther, other}})
	{
		world.Add<engine::gameplay::Mounted>(rider);
		world.Get<engine::gameplay::Mounted>(rider)->carrier = on;
	}
	auto &tints = world.Side<TintEnvelope>();
	TintEnvelope dark;
	dark.state = TintEnvelope::Sustain;
	dark.current = {-0.5f, -0.5f, -0.5f};
	dark.status = 1;
	tints.Emplace(carrier, dark);
	tints.Emplace(other, dark);
	tints.Emplace(gun);
	tints.Emplace(onOther);
	run();
	// The carrier's tint as stepped this frame (not disabled, it began to fade back), copied whole.
	BOOST_TEST(tints.Get(gun)->state == tints.Get(carrier)->state);
	BOOST_TEST(tints.Get(gun)->current == tints.Get(carrier)->current);
	BOOST_TEST(tints.Get(gun)->status == tints.Get(carrier)->status);
	BOOST_TEST(tints.Get(gun)->current[0] < 0.0f);
	BOOST_TEST(tints.Get(lone) == nullptr);
	BOOST_TEST(tints.Get(onOther)->current[0] == 0.0f);
}

// Legacy parity (GeneralsMD Drawable.cpp, Drawable::handleWeaponFireFX; Weapon.cpp fireWeaponTemplate's reAngle/reDir):
// a shot kicks its firer's acceleration pitch and roll rates by its WeaponRecoil turned about from the way it fired,
// relative to its facing: firing dead ahead pitches it back by the whole recoil (the Marauder's 10 degrees), firing to
// its left rolls it; no recoil, nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_shot_rocks_its_firer_back)
{
	const float recoil = 10.0f * 3.14159265358979f / 180.0f;
	ChassisState ahead;
	Recoil(ahead, recoil, 0.0f, 0.0f);
	BOOST_TEST(std::fabs(ahead.accelPitchRate + recoil) < 1e-6f);
	BOOST_TEST(std::fabs(ahead.accelRollRate) < 1e-6f);
	ChassisState left;
	Recoil(left, recoil, 1.57079632679f, 0.0f);
	BOOST_TEST(std::fabs(left.accelPitchRate) < 1e-6f);
	BOOST_TEST(std::fabs(left.accelRollRate + recoil) < 1e-6f);
	// Facing the way it fires: the same as dead ahead.
	ChassisState turned;
	Recoil(turned, recoil, 1.0f, 1.0f);
	BOOST_TEST(std::fabs(turned.accelPitchRate + recoil) < 1e-6f);
	ChassisState none;
	Recoil(none, 0.0f, 0.3f, 0.0f);
	BOOST_TEST(none.accelPitchRate == 0.0f);
	BOOST_TEST(none.accelRollRate == 0.0f);
}

BOOST_AUTO_TEST_SUITE_END()
