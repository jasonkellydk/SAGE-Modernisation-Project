// A simulation-like world (Transform, DefinitionRef) with presentation's
// side tables on the same entities: a tank (definition 0) and a truck
// (definition 1); the tick and frame schedules run on `workers` threads.
struct Street
{
	explicit Street(std::size_t workers)
	{
		world.RegisterComponent<engine::gameplay::Transform>();
		world.RegisterComponent<engine::gameplay::DefinitionRef>();
		world.RegisterComponent<engine::gameplay::Appearance>();
		world.RegisterComponent<engine::gameplay::Owner>();
		world.RegisterComponent<engine::gameplay::ObjectShroud>();
		world.RegisterComponent<engine::gameplay::OffMap>();
		world.RegisterComponent<engine::gameplay::Stealth>();
		world.RegisterComponent<engine::gameplay::MoveOrder>();
		world.RegisterComponent<engine::gameplay::Locomotion>();
		RegisterVehicleMotion(world);
		world.FinalizeComponents();
		world.EmplaceResource<PresentationFrame>(PresentationFrame{1.0f / 60.0f, 0});
		world.EmplaceResource<engine::gameplay::Relationships>(8u);
		MotionLooks &looks = world.EmplaceResource<MotionLooks>();
		MotionLook tank;
		tank.treadRate = 2.0f;
		tank.treadPivot = 0.6f;
		tank.treadDrive = 0.3f;
		tank.maxSpeed = 1.0f;
		MotionLook truck;
		truck.wheelBones = {"Tire01"};
		truck.wheelMultiplier = 0.2f;
		truck.maxSpeed = 2.0f;
		looks.byDefinition = {tank, truck};
		looks.known = {1, 1};
		world.EmplaceResource<ParticleWorldHandle>();
		tickSystems.Register(sample);
		frameSystems.Register(treads);
		frameSystems.Register(wheels);
		frameSystems.Register(emitters);
		frameSystems.OrderBefore<WheelRollSystem, MotionEmitterSystem>();
		world.EmplaceResource<SoundRequests>();
		tickSystems.Finalize(world.Components());
		frameSystems.Finalize(world.Components());
		tick = std::make_unique<ecs::Scheduler>(world, tickSystems, engine::jobs::JobSystemConfig{workers});
		frame = std::make_unique<ecs::Scheduler>(world, frameSystems, engine::jobs::JobSystemConfig{workers});
		tick->Finalize(engine::time::FixedStep{30});
		frame->Finalize(engine::time::FixedStep{30});
	}

	ecs::Entity Vehicle(std::uint32_t definition)
	{
		const ecs::Entity entity = world.Create();
		world.Add<engine::gameplay::Transform>(entity);
		world.Add<engine::gameplay::DefinitionRef>(entity);
		*world.Get<engine::gameplay::DefinitionRef>(entity) = {definition};
		return entity;
	}

	// The simulation moves it on (by `step` along x, turning by `turn`), then presentation samples the tick.
	void Tick(ecs::Entity vehicle, int step, std::uint32_t turn)
	{
		auto &transform = *world.Get<engine::gameplay::Transform>(vehicle);
		transform.position.x += Fixed::FromInt(step);
		transform.facing = transform.facing + Engine::Math::TurnAngle{turn};
	}
	void Sample() { tick->Execute(engine::time::SimulationTime{++ticks, engine::time::FixedStep{30}}); }
	void Frame() { frame->Execute(engine::time::SimulationTime{++frames, engine::time::FixedStep{30}}); }

	ecs::World world{ecs::WorldConfig{4}};
	MotionSampleSystem sample;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	MotionEmitterSystem emitters;
	ecs::SystemRegistry tickSystems;
	ecs::SystemRegistry frameSystems;
	std::unique_ptr<ecs::Scheduler> tick;
	std::unique_ptr<ecs::Scheduler> frame;
	std::uint64_t ticks{0};
	std::uint64_t frames{0};
};
}

BOOST_AUTO_TEST_SUITE(vehicle_motion)

BOOST_AUTO_TEST_CASE(side_tables_on_the_simulations_entities_roll_treads_and_turn_tires_on_frame_time)
{
	Street street(2);
	const ecs::Entity driving = street.Vehicle(0);
	const ecs::Entity pivoting = street.Vehicle(0);
	const ecs::Entity truck = street.Vehicle(1);
	street.Sample(); // first seen: their side tables are added
	BOOST_TEST_REQUIRE(street.world.Side<TreadRoll>().Get(driving) != nullptr);
	BOOST_TEST(street.world.Side<WheelRoll>().Get(driving) == nullptr);
	BOOST_TEST_REQUIRE(street.world.Side<WheelRoll>().Get(truck) != nullptr);
	street.Tick(driving, 1, 0);        // full speed ahead
	street.Tick(pivoting, 0, 1000000); // turning left in place
	street.Tick(truck, 2, 0);
	street.Sample();
	for (int frame = 0; frame < 15; ++frame) // a quarter second at 60 frames a second
		street.Frame();
	const auto &drive = street.world.Side<TreadRoll>().Get(driving)->offsets;
	BOOST_TEST(drive[0] == 0.5f, boost::test_tools::tolerance(1e-3f)); // back by 0.5, wrapped
	BOOST_TEST(drive[0] == drive[1], boost::test_tools::tolerance(1e-5f));
	const auto &pivot = street.world.Side<TreadRoll>().Get(pivoting)->offsets;
	BOOST_TEST(pivot[0] == 0.5f, boost::test_tools::tolerance(1e-3f));
	BOOST_TEST(pivot[1] == 0.5f, boost::test_tools::tolerance(1e-3f));
	// 2 a tick at 0.2 radians a unit for a quarter second (7.5 ticks): 3 radians.
	BOOST_TEST(street.world.Side<WheelRoll>().Get(truck)->angle == 3.0f, boost::test_tools::tolerance(1e-3f));
	// Side tables are presentation only: the simulation's hash does not see them.
	const auto hash = street.world.StateHash();
	street.Frame();
	BOOST_TEST(street.world.StateHash() == hash);
	// A vehicle that goes takes its presentation state with it.
	street.world.Destroy(truck);
	BOOST_TEST(street.world.Side<WheelRoll>().Size() == 0u);
}

// PhysicsBehavior::isMotive (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Update/PhysicsUpdate.cpp: applyMotiveForce
// sets m_motiveForceExpires = frame + MOTIVE_FRAMES, 10) and getTurning, as W3DTruckDraw reads them for its wheel
// emitters: driven by its locomotor on tick 1, it counts as pushed through tick 10 after it stops (10 down to 1), not on
// tick 11; moved without an order (pushed about) it is not; turning is its locomotor's.
BOOST_AUTO_TEST_CASE(legacy_parity_a_truck_is_under_way_while_its_locomotor_pushed_it_in_the_last_ten_ticks)
{
	Street street(1);
	const ecs::Entity truck = street.Vehicle(1);
	street.world.Add<engine::gameplay::MoveOrder>(truck);
	street.world.Add<engine::gameplay::Locomotion>(truck);
	street.Sample();
	street.world.Get<engine::gameplay::MoveOrder>(truck)->mode = engine::gameplay::MoveMode::Point;
	street.world.Get<engine::gameplay::Locomotion>(truck)->turning = -1;
	street.Tick(truck, 2, 0);
	street.Sample();
	const MotionSample *sample = street.world.Side<MotionSample>().Get(truck);
	BOOST_TEST_REQUIRE(sample != nullptr);
	BOOST_TEST(sample->motiveTicks == 10u);
	BOOST_TEST(sample->turning == -1);
	street.world.Get<engine::gameplay::MoveOrder>(truck)->mode = engine::gameplay::MoveMode::Idle;
	street.world.Get<engine::gameplay::Locomotion>(truck)->turning = 0;
	for (int tick = 0; tick < 9; ++tick)
	{
		street.Tick(truck, 1, 0); // coasting / shoved: not its locomotor
		street.Sample();
	}
	BOOST_TEST(street.world.Side<MotionSample>().Get(truck)->motiveTicks == 1u);
	BOOST_TEST(street.world.Side<MotionSample>().Get(truck)->turning == 0);
	street.Sample();
	BOOST_TEST(street.world.Side<MotionSample>().Get(truck)->motiveTicks == 0u);
}

BOOST_AUTO_TEST_CASE(many_vehicles_roll_the_same_on_any_number_of_workers)
{
	const auto run = [](std::size_t workers) {
		Street street(workers);
		std::vector<ecs::Entity> vehicles;
		for (int index = 0; index < 300; ++index)
			vehicles.push_back(street.Vehicle(static_cast<std::uint32_t>(index % 2)));
		street.Sample();
		for (int index = 0; index < 300; ++index)
			street.Tick(vehicles[static_cast<std::size_t>(index)], index % 3, static_cast<std::uint32_t>((index % 5) * 100000));
		street.Sample();
		for (int frame = 0; frame < 20; ++frame)
			street.Frame();
		std::vector<float> state;
		for (const ecs::Entity vehicle : vehicles)
			if (const auto *treads = street.world.Side<TreadRoll>().Get(vehicle))
				state.insert(state.end(), treads->offsets.begin(), treads->offsets.end());
			else
				state.push_back(street.world.Side<WheelRoll>().Get(vehicle)->angle);
		return state;
	};
	BOOST_TEST((run(1) == run(4)));
}

// Legacy parity (W3DScienceModelDraw.cpp, doDrawModule): a salvage crate (RequiredScience SCIENCE_GLA: here science 3)
// is drawn for a viewer with the science, for an observer (no viewer) and for a viewer no longer playing (defeated);
// hidden from one still playing without it; one whose science is unknown is drawn for no one.
BOOST_AUTO_TEST_CASE(legacy_parity_a_science_models_draw_shows_only_to_those_with_its_science)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>();
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<engine::gameplay::Relationships>(8u);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	auto &sciences = world.EmplaceResource<engine::gameplay::PlayerSciences>();
	sciences.Resize(4);
	sciences.Grant(0, 3);
	auto &outcome = world.EmplaceResource<engine::gameplay::MatchOutcome>();
	outcome.players = {{0, false, false}, {1, false, false}, {2, true, false}};
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	DefinitionLooks crate;
	crate.states.states.resize(1);
	crate.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	crate.stateLooks = {0};
	crate.needsScience = true;
	crate.requiredScience = 3;
	DefinitionLooks unknown = crate;
	unknown.requiredScience = 0xFFFFFFFFu;
	catalog.byDefinition = {crate, unknown};
	catalog.known = {1, 1};
	catalog.looks = {{0, 0, 0}};
	catalog.lookModels = {"PMJnkCrate"};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	world.EmplaceResource<MotionLooks>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto make = [&](std::uint32_t definition) {
		const ecs::Entity entity = world.Create();
		world.Add<engine::gameplay::Transform>(entity);
		world.Add<engine::gameplay::DefinitionRef>(entity);
		world.Get<engine::gameplay::DefinitionRef>(entity)->index = definition;
		world.Add<engine::gameplay::Owner>(entity);
		world.Add<engine::gameplay::Appearance>(entity);
		return entity;
	};
	make(0);
	make(1);
	tick.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}});
	const auto drawnFor = [&](std::uint32_t viewer) {
		frame.viewer = viewer;
		draw.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}});
		std::vector<ObjectInstance> drawn;
		world.Resource<ObjectInstances>().AppendTo(drawn);
		return drawn.size();
	};
	BOOST_TEST(drawnFor(0) == 1u);                           // has it (the crate; the unknown one never)
	BOOST_TEST(drawnFor(1) == 0u);                           // playing without it
	BOOST_TEST(drawnFor(2) == 1u);                           // defeated
	BOOST_TEST(drawnFor(PresentationFrame::NoViewer) == 1u); // an observer
}

BOOST_AUTO_TEST_CASE(objects_are_drawn_between_ticks_in_their_look_restarting_its_animation_when_it_changes)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>();
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<engine::gameplay::Relationships>(8u);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	world.EmplaceResource<engine::gameplay::PlayerSciences>();
	world.EmplaceResource<engine::gameplay::MatchOutcome>();
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	// One definition, two model states (the second while stealthed), each its own look.
	DefinitionLooks looks;
	looks.states.states.resize(2);
	looks.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	looks.states.states[1].conditions = {generalszh::content::ConditionBits{std::uint64_t{1} << 5, 0}};
	looks.stateLooks = {0, 1};
	looks.stealth = true;
	looks.stealthMin = 0.25f;
	looks.stealthMax = 0.25f;
	catalog.byDefinition = {looks};
	catalog.known = {1};
	catalog.looks = {{0, 0, 0}, {0, 1, 0}};
	catalog.lookModels = {"A", "B"};
	catalog.playerColors = {{1, 0, 0, 1}};
	catalog.bits.stealthed = 5;
	catalog.bits.detected = 6;
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	world.EmplaceResource<MotionLooks>();
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&](ecs::Scheduler &scheduler) { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };

	const ecs::Entity tank = world.Create();
	world.Add<engine::gameplay::Transform>(tank);
	world.Add<engine::gameplay::DefinitionRef>(tank);
	world.Add<engine::gameplay::Owner>(tank);
	world.Add<engine::gameplay::Appearance>(tank);
	run(tick); // first tick: its pose starts here
	world.Get<engine::gameplay::Transform>(tank)->position.x = Fixed::FromInt(10);
	run(tick);
	frame.alpha = 0.5f;
	frame.clock = 1.0;
	run(draw); // first frame: its look starts
	frame.clock = 2.0;
	run(draw);
	std::vector<ObjectInstance> drawn;
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].world[3] == 5.0f, boost::test_tools::tolerance(1e-4f)); // halfway between the ticks
	BOOST_TEST(drawn[0].look == 0u);
	BOOST_TEST(drawn[0].teamColor[0] == 1.0f);
	const float before = drawn[0].animationSeconds;
	// Stealthed: the other state, its animation from now, seen through.
	world.Get<engine::gameplay::Appearance>(tank)->flags[0] |= std::uint64_t{1} << 5;
	frame.clock = 3.0;
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].look == 1u);
	BOOST_TEST(drawn[0].animationSeconds == 0.0f);
	BOOST_TEST(before > 0.0f);
	BOOST_TEST(drawn[0].opacity == 0.25f, boost::test_tools::tolerance(1e-5f));
	// StealthUpdate::calcStealthedStatusForPlayer (GeneralsMD/Code/GameEngine/Source/GameLogic/Object/Update/StealthUpdate.cpp):
	// seen through by its allies and by an observer (no viewer, above), not seen at all by anyone else.
	frame.viewer = 1;
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST(drawn.empty());
	world.Resource<engine::gameplay::Relationships>().Set(0, 1, engine::gameplay::Relationship::Allies);
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].opacity == 0.25f, boost::test_tools::tolerance(1e-5f));
	// Drawable::setStealthLook / draw (GeneralsMD/Code/GameEngine/Source/GameClient/Drawable.cpp): turning detected it
	// glows (second material pass 1), faded by 0.8 a logic frame before it is drawn; to an enemy only the glow shows.
	frame.seconds = 1.0f / 30.0f;
	world.Get<engine::gameplay::Appearance>(tank)->flags[0] |= std::uint64_t{1} << 6;
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].heatVision == 0.8f, boost::test_tools::tolerance(1e-5f));
	BOOST_TEST(!drawn[0].heatOnly);
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST(drawn[0].heatVision == 0.64f, boost::test_tools::tolerance(1e-5f));
	world.Resource<engine::gameplay::Relationships>().Set(0, 1, engine::gameplay::Relationship::Enemies);
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].heatOnly);
	BOOST_TEST(drawn[0].heatVision == 0.8f, boost::test_tools::tolerance(1e-5f));
	for (int step = 0; step < 40; ++step)
		run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST(drawn[0].heatVision == 0.0f); // under 0.001: gone
	world.Get<engine::gameplay::Appearance>(tank)->flags[0] &= ~(std::uint64_t{1} << 6);
	frame.seconds = 0.0f;
	frame.viewer = PresentationFrame::NoViewer;
	// Presentation never touches the simulation's hash.
	const auto hash = world.StateHash();
	run(draw);
	BOOST_TEST(world.StateHash() == hash);
}

// W3DModelDraw::showSubObject (SubObjectsUpgrade, W3DSupplyDraw::updateDrawModuleSupplyStatus): parts shown or hidden on
// the render object it already has; its model state and animation go on untouched (no setModelState). A truck that took
// on a part set is drawn through its look's copy with those parts, and its animation keeps running from where it
// started instead of starting over every frame.
BOOST_AUTO_TEST_CASE(legacy_parity_upgraded_parts_leave_the_animation_running)
{
	namespace gp = engine::gameplay;
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<gp::Transform>();
	world.RegisterComponent<gp::DefinitionRef>();
	world.RegisterComponent<gp::Owner>();
	world.RegisterComponent<gp::Appearance>();
	world.RegisterComponent<gp::Attitude>();
	world.RegisterComponent<gp::ModelOverride>();
	world.RegisterComponent<gp::DebrisLook>();
	world.RegisterComponent<gp::Parachute>();
	world.RegisterComponent<gp::Dying>();
	world.RegisterComponent<gp::ParachuteRider>();
	world.RegisterComponent<gp::OffMap>();
	world.RegisterComponent<gp::Health>();
	world.RegisterComponent<gp::Mounted>();
	world.RegisterComponent<gp::EmpPulse>();
	world.RegisterComponent<gp::IndicatorColor>();
	world.RegisterComponent<gp::PartOverrides>();
	world.RegisterComponent<gp::OcclusionSafe>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>();
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<gp::Relationships>(8u);
	world.EmplaceResource<gp::Detections>();
	world.EmplaceResource<gp::ParachuteCatalog>();
	world.EmplaceResource<gp::PlayerSciences>();
	world.EmplaceResource<gp::MatchOutcome>();
	world.EmplaceResource<gp::WeaponCatalog>();
	DefinitionLooks looks;
	looks.states.states.resize(1);
	looks.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	looks.stateLooks = {0};
	looks.ownLookFirst = 0;
	looks.ownLookCount = 1;
	looks.partSets = {{{"Bombload02", true}, {"Bombload01", false}}};
	catalog.byDefinition = {looks};
	catalog.known = {1};
	catalog.looks = {{0, 0, 0}};
	catalog.lookModels = {"TRUCK"};
	catalog.playerColors = {{1, 0, 0, 1}};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	world.EmplaceResource<MotionLooks>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&](ecs::Scheduler &scheduler) { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };
	const ecs::Entity truck = world.Create();
	world.Add<gp::Transform>(truck);
	world.Add<gp::DefinitionRef>(truck);
	world.Add<gp::Owner>(truck);
	world.Add<gp::Appearance>(truck);
	world.Add<gp::PartOverrides>(truck);
	world.Get<gp::PartOverrides>(truck)->Apply(0);
	KnowPartLooks(catalog, world);
	const std::uint32_t copy = catalog.byDefinition[0].WithParts(0, std::vector<std::uint8_t>{0});
	BOOST_TEST_REQUIRE(copy != 0u);
	run(tick);
	run(tick);
	const auto drawnAt = [&](double clock) {
		frame.clock = clock;
		run(draw);
		std::vector<ObjectInstance> drawn;
		world.Resource<ObjectInstances>().AppendTo(drawn);
		BOOST_TEST_REQUIRE(drawn.size() == 1u);
		return drawn[0];
	};
	drawnAt(1.0); // its look starts
	const ObjectInstance first = drawnAt(2.0);
	const ObjectInstance second = drawnAt(3.5);
	BOOST_TEST(first.look == copy);
	BOOST_TEST(second.look == copy);
	BOOST_TEST(first.animationSeconds > 0.0f);
	BOOST_TEST(second.animationSeconds == first.animationSeconds + 1.5f, boost::test_tools::tolerance(1e-4f));
}

// W3DModelDraw with several Animation (or IdleAnimation) lines in a condition state: each object picks one of them
// at random as it takes the state (so a crowd does not move in step), and keeps it while it stays.
// FloatUpdate::update on a drawable (Enabled = No: swayed, not lifted): its turn kept, then Ry by
// sin(frame * 0.0291) * 0.05 and Rx by sin(frame * 0.0515) * 0.05, the frame being the game clock in 1/30 s (here
// 1 s: frame 30, pitch sin(0.873) * 0.05 = 0.03832, roll sin(1.545) * 0.05 = 0.04998, to a float's rounding).
// W3DModelDraw (Core/GameEngineDevice/Source/W3DDevice/GameClient/Drawable/Draw/W3DModelDraw.cpp): the model is made in its
// object's indicator colour (the constructor's m_hexColor) and keeps it; a later colour (Drawable::setIndicatorColor on a
// capture or a script's colour: replaceIndicatorColor) takes only where OkToChangeModelColor lets it.
BOOST_AUTO_TEST_CASE(legacy_parity_a_model_keeps_the_colour_it_was_made_with_unless_it_may_change)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>();
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<engine::gameplay::Relationships>(8u);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	world.EmplaceResource<engine::gameplay::PlayerSciences>();
	world.EmplaceResource<engine::gameplay::MatchOutcome>();
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	// Two definitions, one model state each: the first's draw keeps its colour, the second's may change it.
	DefinitionLooks keeps;
	keeps.states.states.resize(1);
	keeps.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	keeps.stateLooks = {0};
	DefinitionLooks changes = keeps;
	changes.states.okToChangeColor = true;
	catalog.byDefinition = {keeps, changes};
	catalog.known = {1, 1};
	catalog.looks = {{0, 0, 0}};
	catalog.lookModels = {"A"};
	catalog.playerColors = {{1, 0, 0, 1}, {0, 0, 1, 1}};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	world.EmplaceResource<MotionLooks>();
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&](ecs::Scheduler &scheduler) { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };

	const auto tank = [&](std::uint32_t definition) {
		const ecs::Entity entity = world.Create();
		world.Add<engine::gameplay::Transform>(entity);
		world.Add<engine::gameplay::DefinitionRef>(entity);
		world.Add<engine::gameplay::Owner>(entity);
		world.Add<engine::gameplay::Appearance>(entity);
		world.Get<engine::gameplay::DefinitionRef>(entity)->index = definition;
		return entity;
	};
	const ecs::Entity kept = tank(0), changed = tank(1);
	run(tick);
	run(tick);
	frame.clock = 1.0;
	run(draw);
	world.Get<engine::gameplay::Owner>(kept)->player = 1; // captured
	world.Get<engine::gameplay::Owner>(changed)->player = 1;
	run(tick);
	frame.clock = 2.0;
	run(draw);
	std::vector<ObjectInstance> drawn;
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 2u);
	const auto colourOf = [&](std::size_t index) { return drawn[index].teamColor; };
	// Instances come in chunk order: the one that keeps its colour first (made first).
	BOOST_TEST((colourOf(0) == std::array<float, 4>{1, 0, 0, 1}));
	BOOST_TEST((colourOf(1) == std::array<float, 4>{0, 0, 1, 1}));
}

// W3DModelDraw::adjustTransformMtx (Core/GameEngineDevice/Source/W3DDevice/GameClient/Drawable/Draw/W3DModelDraw.cpp,
// ADJUST_HEIGHT_BY_CONSTRUCTION_PERCENT): while under construction the model is drawn lowered by what is left to build,
// -height + height * percent / 100 (GeometryInfo::getMaxHeightAbovePosition): 40 high at 25%: 30 down; at 100%: level.
BOOST_AUTO_TEST_CASE(legacy_parity_a_building_rises_out_of_the_ground_as_it_is_built)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	world.RegisterComponent<engine::gameplay::ConstructionProgress>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>();
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<engine::gameplay::Relationships>(8u);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	world.EmplaceResource<engine::gameplay::PlayerSciences>();
	world.EmplaceResource<engine::gameplay::MatchOutcome>();
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	// One definition whose state sinks it by what is left to build, 40 high.
	DefinitionLooks building;
	building.states.states.resize(1);
	building.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	building.states.states[0].adjustHeightByConstruction = true;
	building.stateLooks = {0};
	building.constructionHeight = 40.0f;
	catalog.byDefinition = {building};
	catalog.known = {1};
	catalog.looks = {{0, 0, 0}};
	catalog.lookModels = {"A"};
	catalog.playerColors = {{1, 0, 0, 1}};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	world.EmplaceResource<MotionLooks>();
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&](ecs::Scheduler &scheduler) { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };

	const ecs::Entity site = world.Create();
	world.Add<engine::gameplay::Transform>(site);
	world.Add<engine::gameplay::DefinitionRef>(site);
	world.Add<engine::gameplay::Owner>(site);
	world.Add<engine::gameplay::Appearance>(site);
	world.Add<engine::gameplay::ConstructionProgress>(site);
	world.Get<engine::gameplay::ConstructionProgress>(site)->percent = Fixed::FromInt(25);
	run(tick);
	run(tick);
	frame.clock = 1.0;
	run(draw);
	std::vector<ObjectInstance> drawn;
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].world[11] == -30.0f, boost::test_tools::tolerance(1e-4f));
	world.Get<engine::gameplay::ConstructionProgress>(site)->percent = Fixed::FromInt(100);
	frame.clock = 2.0;
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].world[11] == 0.0f, boost::test_tools::tolerance(1e-4f));
}

// W3DModelDraw::setAnimationLoopDuration / setCurAnimDurationInMsec (Core/GameEngineDevice/Source/W3DDevice/GameClient/
// Drawable/Draw/W3DModelDraw.cpp): the animation showing plays at natural / ceil(frames * 1000 / 30) ms. Object::
// adjustModelConditionForWeaponStatus asks it as a weapon turns PREATTACK for the frames left of its wind-up (15: a one
// second clip at twice its speed); BuildAssistant::sellObject as a sale starts, for TOTAL_FRAMES_TO_SELL_OBJECT / 2 (45:
// 1000 / 1500 of its speed).
BOOST_AUTO_TEST_CASE(legacy_parity_a_wind_up_or_a_sale_stretches_the_animation_to_its_time)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	world.RegisterComponent<engine::gameplay::Armament>();
	world.RegisterComponent<engine::gameplay::Sale>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>().byLook = {{30, 30}}; // one second at its natural speed
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<engine::gameplay::Relationships>(8u);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	world.EmplaceResource<engine::gameplay::PlayerSciences>();
	world.EmplaceResource<engine::gameplay::MatchOutcome>();
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	// One definition, one looping model state.
	DefinitionLooks gun;
	gun.states.states.resize(1);
	gun.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	gun.states.states[0].animationMode = generalszh::content::ModelAnimationMode::Loop;
	gun.stateLooks = {0};
	catalog.byDefinition = {gun};
	catalog.known = {1};
	catalog.looks = {{0, 0, 0}};
	catalog.lookModels = {"A"};
	catalog.playerColors = {{1, 0, 0, 1}};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	world.EmplaceResource<MotionLooks>();
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&](ecs::Scheduler &scheduler) { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };

	const ecs::Entity unit = world.Create();
	world.Add<engine::gameplay::Transform>(unit);
	world.Add<engine::gameplay::DefinitionRef>(unit);
	world.Add<engine::gameplay::Owner>(unit);
	world.Add<engine::gameplay::Appearance>(unit);
	world.Add<engine::gameplay::Armament>(unit);
	run(tick);
	run(tick);
	frame.clock = 1.0;
	run(draw);
	const ShownLook *shown = world.Side<ShownLook>().Get(unit);
	BOOST_TEST_REQUIRE(shown != nullptr);
	BOOST_TEST(shown->speed == 1.0f);
	// Winding up on tick 10 until tick 25.
	frame.tick = 10;
	world.Get<engine::gameplay::Armament>(unit)->preAttackUntil = 25;
	world.Get<engine::gameplay::Appearance>(unit)->flags[0] |= std::uint64_t{1} << generalszh::content::model_condition::PreattackA;
	frame.clock = 1.1;
	run(draw);
	shown = world.Side<ShownLook>().Get(unit);
	BOOST_TEST(shown->speed == 2.0f, boost::test_tools::tolerance(1e-5f));
	frame.clock = 1.2;
	run(draw); // once, as it comes on
	BOOST_TEST(world.Side<ShownLook>().Get(unit)->speed == 2.0f, boost::test_tools::tolerance(1e-5f));
	// Sold.
	world.Add<engine::gameplay::Sale>(unit);
	frame.clock = 1.3;
	run(draw);
	BOOST_TEST(world.Side<ShownLook>().Get(unit)->speed == 1000.0f / 1500.0f, boost::test_tools::tolerance(1e-5f));
}

BOOST_AUTO_TEST_CASE(legacy_parity_a_tree_sways_in_the_breeze)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>();
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<engine::gameplay::Relationships>(8u);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	world.EmplaceResource<engine::gameplay::PlayerSciences>();
	world.EmplaceResource<engine::gameplay::MatchOutcome>();
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	DefinitionLooks looks;
	looks.states.states.resize(1);
	looks.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	looks.states.states[0].animations = {"Rest"};
	looks.treeSway = true;
	looks.stateLooks = {0};
	looks.stateVariants = {1};
	catalog.byDefinition = {looks};
	catalog.known = {1};
	catalog.looks = {{0, 0, 0, 0, 0}};
	catalog.lookModels = {"Tree"};
	world.Resource<Breeze>().randomness = 0.0f; // every tree alike
	catalog.playerColors = {{1, 0, 0, 1}};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	world.EmplaceResource<MotionLooks>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&](ecs::Scheduler &scheduler) { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };
	const ecs::Entity boat = world.Create();
	world.Add<engine::gameplay::Transform>(boat);
	world.Add<engine::gameplay::DefinitionRef>(boat);
	world.Add<engine::gameplay::Owner>(boat);
	world.Add<engine::gameplay::Appearance>(boat);
	run(tick);
	run(tick);
	// SwayClientUpdate::clientUpdate: the first frame it is seen it gets its sway; then each 1/30 s its sway moves on
	// 2 pi / 150 (BreezePeriod 5 s), the tree leaning cos(value) * intensity + lean along the breeze (direction pi / 3).
	const Breeze &breeze = world.Resource<Breeze>();
	frame.seconds = 1.0f / 30.0f;
	run(draw);
	run(draw);
	std::vector<ObjectInstance> drawn;
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	const float angle = std::cos(2.0f * 3.14159265358979f / 150.0f) * breeze.intensity + breeze.lean;
	const float pitch = angle * breeze.directionY, roll = -angle * breeze.directionX;
	BOOST_TEST(drawn[0].world[8] == -std::sin(pitch), boost::test_tools::tolerance(1e-5f));
	BOOST_TEST(drawn[0].world[9] == std::cos(pitch) * std::sin(roll), boost::test_tools::tolerance(1e-5f));
	BOOST_TEST(angle == 0.1100f, boost::test_tools::tolerance(1e-3f));
	// Burned (SMOLDERING), it stands where it stopped.
	world.Get<engine::gameplay::Appearance>(boat)->Set(generalszh::content::ModelConditionBit("SMOLDERING"));
	run(draw);
	const float stopped = world.Side<TreeSway>().Get(boat)->angle;
	run(draw);
	run(draw);
	BOOST_TEST(world.Side<TreeSway>().Get(boat)->angle == stopped);
	BOOST_TEST(world.Side<TreeSway>().Get(boat)->swaying == 0u);
	// W3DTreeBuffer: a map tree pushed aside darkens, its colour scaled by 1 - DarkeningFactor x pushAside (0.5 x 0.4).
	catalog.byDefinition[0].bufferTree = true;
	catalog.byDefinition[0].treeMotion.darkening = 0.5f;
	world.Side<TreeBend>().Emplace(boat)->pushAside = 0.4f;
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(drawn[0].shade == 0.8f, boost::test_tools::tolerance(1e-6f));
}
// The frame's dynamic lights (W3DDynamicLight on each drawn frame): a police car shows its light bar 8 above where it
// is drawn, coloured by its light-bar clip's frame; a light pulse ages a frame each 1/30 s, out on its last.
BOOST_AUTO_TEST_CASE(legacy_parity_police_light_bars_and_light_pulses_are_the_frames_lights)
{
	ecs::World world{ecs::WorldConfig{4}};
	world.RegisterComponent<engine::gameplay::Transform>();
	world.RegisterComponent<engine::gameplay::DefinitionRef>();
	world.RegisterComponent<engine::gameplay::Owner>();
	world.RegisterComponent<engine::gameplay::Appearance>();
	world.RegisterComponent<engine::gameplay::Attitude>();
	world.RegisterComponent<engine::gameplay::ModelOverride>();
	world.RegisterComponent<engine::gameplay::DebrisLook>();
	world.RegisterComponent<engine::gameplay::Parachute>();
	world.RegisterComponent<engine::gameplay::Dying>();
	world.RegisterComponent<engine::gameplay::ParachuteRider>();
	world.RegisterComponent<engine::gameplay::OffMap>();
	world.RegisterComponent<engine::gameplay::Health>();
	world.RegisterComponent<engine::gameplay::Mounted>();
	world.RegisterComponent<engine::gameplay::EmpPulse>();
	world.RegisterComponent<engine::gameplay::IndicatorColor>();
	world.RegisterComponent<engine::gameplay::OcclusionSafe>();
	RegisterVehicleMotion(world);
	RegisterObjectPresentation(world);
	world.FinalizeComponents();
	PresentationFrame &frame = world.EmplaceResource<PresentationFrame>();
	LookCatalog &catalog = world.EmplaceResource<LookCatalog>();
	world.EmplaceResource<LookClips>().byLook = {{15, 15}};
	world.EmplaceResource<Breeze>();
	world.EmplaceResource<TreeBreeze>();
	world.EmplaceResource<engine::gameplay::Relationships>(8u);
	world.EmplaceResource<engine::gameplay::Detections>();
	world.EmplaceResource<engine::gameplay::ParachuteCatalog>();
	world.EmplaceResource<engine::gameplay::PlayerSciences>();
	world.EmplaceResource<engine::gameplay::MatchOutcome>();
	world.EmplaceResource<engine::gameplay::WeaponCatalog>();
	world.EmplaceResource<LightPulses>().live.push_back({{1, 2, 3}, {1, 1, 1}, 1.0f, 31.0f, 0.0f, 15.0f, 0.0f});
	const DynamicLights &lights = world.EmplaceResource<DynamicLights>();
	DefinitionLooks looks;
	looks.states.states.resize(1);
	looks.states.states[0].conditions = {generalszh::content::ConditionBits{}};
	looks.states.states[0].animations = {"CVPoliceCar2.CVPoliceCar2"};
	looks.states.states[0].animationMode = generalszh::content::ModelAnimationMode::Loop;
	looks.policeLights = true;
	looks.stateLooks = {0};
	looks.stateVariants = {1};
	catalog.byDefinition = {looks};
	catalog.known = {1};
	catalog.looks = {{0, 0, 0, 0, 0}};
	catalog.lookModels = {"CVPoliceCar2"};
	catalog.playerColors = {{1, 0, 0, 1}};
	world.EmplaceResource<ObjectInstances>();
	world.EmplaceResource<MountedInstances>();
	if (world.FindResource<BonePoses>() == nullptr)
		world.EmplaceResource<BonePoses>();
	world.EmplaceResource<PresentedObjects>();
	world.EmplaceResource<MotionLooks>();
	ecs::SystemRegistry tickSystems, frameSystems;
	PoseSampleSystem sample;
	ObjectPresentationSystem present;
	DynamicLightSystem shine;
	TreadRollSystem treads;
	WheelRollSystem wheels;
	tickSystems.Register(sample);
	frameSystems.Register(treads);
	frameSystems.Register(wheels);
	frameSystems.Register(present);
	frameSystems.Register(shine);
	frameSystems.OrderBefore<ObjectPresentationSystem, DynamicLightSystem>();
	tickSystems.Finalize(world.Components());
	frameSystems.Finalize(world.Components());
	ecs::Scheduler tick(world, tickSystems, engine::jobs::JobSystemConfig{2});
	ecs::Scheduler draw(world, frameSystems, engine::jobs::JobSystemConfig{2});
	tick.Finalize(engine::time::FixedStep{30});
	draw.Finalize(engine::time::FixedStep{30});
	std::uint64_t serial = 0;
	const auto run = [&](ecs::Scheduler &scheduler) { scheduler.Execute(engine::time::SimulationTime{++serial, engine::time::FixedStep{30}}); };
	const ecs::Entity car = world.Create();
	world.Add<engine::gameplay::Transform>(car);
	world.Get<engine::gameplay::Transform>(car)->position = {Engine::Math::Fixed::FromInt(100), Engine::Math::Fixed::FromInt(50), {}};
	world.Add<engine::gameplay::DefinitionRef>(car);
	world.Add<engine::gameplay::Owner>(car);
	world.Add<engine::gameplay::Appearance>(car);
	run(tick);
	run(tick);
	frame.seconds = 1.0f / 30.0f;
	frame.realSeconds = 1.0f / 30.0f; // the pulse's frames (W3DDynamicLight::On_Frame_Update: per rendered frame)
	frame.clock = 1.0;
	run(draw); // the car's look starts
	run(draw);
	BOOST_TEST_REQUIRE(lights.shown.size() == 2u);
	BOOST_TEST(lights.shown[0].diffuse[0] == 13.0f / 15.0f, boost::test_tools::tolerance(1e-5f)); // the pulse, two frames on
	const ShownLight &bar = lights.shown[1];
	BOOST_TEST((bar.at == std::array<float, 3>{100.0f, 50.0f, 8.0f}));
	const ShownLook &shown = *world.Side<ShownLook>().Get(car);
	const double at = ShownClipFrame(shown, LookClip{15, 15}, generalszh::content::ModelAnimationMode::Loop, frame.clock);
	BOOST_TEST(at >= 0.0);
	BOOST_TEST(at <= 14.0); // somewhere on its loop
	const auto color = PoliceLightColor(static_cast<float>(at));
	BOOST_TEST(bar.diffuse[0] == color[0]);
	BOOST_TEST(bar.diffuse[2] == color[2]);
	// It casts a shadow (its looks say so), but not while detected in stealth (STEALTHLOOK_VISIBLE_DETECTED).
	std::vector<ObjectInstance> drawn;
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST_REQUIRE(drawn.size() == 1u);
	BOOST_TEST(!drawn[0].castsShadow); // its looks cast none
	catalog.byDefinition[0].castsShadow = true;
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST(drawn[0].castsShadow);
	world.Get<engine::gameplay::Appearance>(car)->Set(catalog.bits.stealthed);
	world.Get<engine::gameplay::Appearance>(car)->Set(catalog.bits.detected);
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST(!drawn[0].castsShadow);
	for (int later = 0; later < 10; ++later)
		run(draw);
	BOOST_TEST(lights.shown.size() == 2u); // the pulse on its 14th frame
	run(draw);
	BOOST_TEST(lights.shown.size() == 1u); // out on its 15th: only the light bar
	// SlowDeathBehavior::beginSlowDeath: infantry dying a death that sinks it casts no shadow (setShadowsEnabled(false));
	// a death that does not sink it keeps it.
	world.Get<engine::gameplay::Appearance>(car)->Set(catalog.bits.stealthed, false);
	world.Get<engine::gameplay::Appearance>(car)->Set(catalog.bits.detected, false);
	catalog.byDefinition[0].infantry = true;
	world.Add<engine::gameplay::Dying>(car);
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST(drawn[0].castsShadow); // no sink rate
	world.Get<engine::gameplay::Dying>(car)->sinkRate = Engine::Math::Fixed::FromRatio(1, 30);
	run(draw);
	drawn.clear();
	world.Resource<ObjectInstances>().AppendTo(drawn);
	BOOST_TEST(!drawn[0].castsShadow);
	world.Remove<engine::gameplay::Dying>(car);
	catalog.byDefinition[0].infantry = false;
}

BOOST_AUTO_TEST_CASE(legacy_parity_a_fishing_boat_rocks_like_a_buoy)
{
