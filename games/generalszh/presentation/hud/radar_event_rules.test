#include <boost/test/unit_test.hpp>

#include <array>
#include <cstdint>

import games.generalszh.presentation.hud.algorithms.radar_event_rules;

using namespace generalszh::presentation;

BOOST_AUTO_TEST_SUITE(radar_event_rules)

// Radar::createEvent / tryEvent / update (PRESERVE_RADAR_WARNING_SUPPRESSION): an event lives 4 s (120 frames), fading
// its last half second (15), in its type's colours; the last event is its place. Another under attack event within 10 s
// (300 frames) of one is refused anywhere on the map; an upgrade 250 or less away likewise, but not 251 away; a beacon
// pulse is never the last event. Past its die frame an event goes inactive.
BOOST_AUTO_TEST_CASE(legacy_parity_radar_events_space_themselves_out)
{
	RadarEvents radar;
	BOOST_TEST(TryRadarEvent(radar, RadarEventType::UnderAttack, {100, 100, 0}, 1000));
	const RadarEvent &first = radar.events[0];
	BOOST_TEST(first.dieFrame == 1120u);
	BOOST_TEST(first.fadeFrame == 1105u);
	BOOST_TEST((first.color1 == std::array<std::uint8_t, 4>{255, 0, 0, 255}));
	BOOST_TEST(radar.last.value_or(99) == 0u);
	BOOST_TEST(!TryRadarEvent(radar, RadarEventType::UnderAttack, {5000, 5000, 0}, 1299)); // anywhere, within 10 s
	BOOST_TEST(TryRadarEvent(radar, RadarEventType::UnderAttack, {5000, 5000, 0}, 1300));
	BOOST_TEST(TryRadarEvent(radar, RadarEventType::Upgrade, {0, 0, 0}, 1300));
	BOOST_TEST(!TryRadarEvent(radar, RadarEventType::Upgrade, {250, 0, 0}, 1301));
	BOOST_TEST(TryRadarEvent(radar, RadarEventType::Upgrade, {251, 0, 0}, 1301));
	CreateRadarEvent(radar, {0, 0, 0}, RadarEventType::BeaconPulse, 1302);
	BOOST_TEST(radar.last.value_or(99) == 3u);
	UpdateRadarEvents(radar, 1120);
	BOOST_TEST(radar.events[0].active);
	UpdateRadarEvents(radar, 1121);
	BOOST_TEST(!radar.events[0].active);
}

BOOST_AUTO_TEST_SUITE_END()
