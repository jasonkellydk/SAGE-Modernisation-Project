// FIRE_WEAPON waiting for its target. GUICommandTranslator::doFireWeaponCommand (Command_ChinaDragonTankFireWall:
// NEED_TARGET_POS): a click on the ground fires the button's slot there (MSG_DO_WEAPON_AT_LOCATION) and ends the wait.
// A context command (CONTEXTMODE_COMMAND, Command_ColonelBurtonKnifeAttack: an enemy's or a neutral's object) goes
// through handleGuiCommand: InGameUI::canSelectedObjectsEffectivelyUseWeapon (ActionManager::canFireWeaponAtObject)
// shows its cursor over an enemy its slot's weapon can attack, the invalid one elsewhere (the ground, its own, a slot
// with no weapon); only a click on a valid target fires (MSG_DO_WEAPON_AT_OBJECT), with its MaxShotsToFire.
BOOST_AUTO_TEST_CASE(legacy_parity_a_fire_weapon_button_fires_at_what_it_is_aimed_at)
{
	using Cursor = generalszh::content::MouseCursorKind;
	namespace bo = generalszh::content::button_option;
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity enemy = field.Tank(150, 100, 1);
	const auto tankAt = field.Pixel(100, 100);
	field.Click(tankAt[0], tankAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	GuiTargeting &targeting = field.world.Resource<GuiTargeting>();
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	const auto wait = [&](std::uint32_t options, std::uint8_t slot, std::uint32_t shots) {
		targeting = GuiTargeting{};
		targeting.active = true;
		targeting.source = tank;
		targeting.options = options;
		targeting.kind = GuiCommandKind::FireWeapon;
		targeting.cursor = Cursor::StabAttack;
		targeting.invalidCursor = Cursor::StabAttackInvalid;
		targeting.weaponSlot = slot;
		targeting.maxShots = shots;
	};
	wait(bo::NeedTargetPos | bo::OkForMultiSelect, 1, 0);
	BOOST_TEST((field.Hover(400, 60) == Cursor::StabAttack));
	field.Click(400, 100);
	BOOST_TEST(!targeting.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *fire = std::get_if<generalszh::commands::FireWeapon>(&orders[0]);
	BOOST_TEST_REQUIRE(fire != nullptr);
	BOOST_TEST((fire->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST(fire->slot == 1);
	BOOST_TEST(fire->at == 1);
	BOOST_TEST(std::abs(Engine::Math::ToFloat(fire->position.y) - 186.6f) < 0.5f);
	orders.clear();
	wait(bo::NeedTargetEnemy | bo::NeedTargetNeutral | bo::ContextModeCommand, 0, 1);
	const auto enemyAt = field.Pixel(150, 100);
	BOOST_TEST((field.Hover(enemyAt[0], enemyAt[1]) == Cursor::StabAttack));
	BOOST_TEST((field.Hover(400, 60) == Cursor::StabAttackInvalid));
	BOOST_TEST((field.Hover(tankAt[0], tankAt[1]) == Cursor::StabAttackInvalid));
	field.Click(400, 100);
	BOOST_TEST(targeting.active);
	BOOST_TEST(orders.empty());
	targeting.weaponSlot = 1;
	BOOST_TEST((field.Hover(enemyAt[0], enemyAt[1]) == Cursor::StabAttackInvalid));
	targeting.weaponSlot = 0;
	field.Click(enemyAt[0], enemyAt[1]);
	BOOST_TEST(!targeting.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	fire = std::get_if<generalszh::commands::FireWeapon>(&orders[0]);
	BOOST_TEST_REQUIRE(fire != nullptr);
	BOOST_TEST(fire->at == 2);
	BOOST_TEST((fire->target == enemy));
	BOOST_TEST(fire->maxShots == 1u);
}

// CommandTranslator::evaluateContextCommand (Core/GameEngine/Source/GameClient/MessageStream/CommandXlat.cpp:
// ACTIONTYPE_RESUME_CONSTRUCTION, then ACTIONTYPE_REPAIR_OBJECT) with ActionManager::canResumeConstructionOf and
// canRepairObject (GeneralsMD/Code/GameEngine/Source/Common/RTS/ActionManager.cpp), handleResumeConstructionCommand and
// handleRepairObjectCommand, and InGameUI::createCommandHint's RESUME_CONSTRUCTION / DO_REPAIR cursors: with a dozer
// selected, the player's structure still under construction resumes it (MSG_RESUME_CONSTRUCTION), not while fogged, nor
// while the builder set to it is alive and at work on it (a dead one no longer counts); once standing and hurt a click
// repairs it (MSG_DO_REPAIR), unless another is its sole healer (its heal lock); whole, nothing (it is selected).
BOOST_AUTO_TEST_CASE(legacy_parity_a_dozer_resumes_construction_or_repairs_a_structure_it_clicks)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	catalog.byDefinition.push_back(SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f});
	catalog.byDefinition.push_back(SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f});
	catalog.kinds = {Kinds({}), Kinds({"VEHICLE", "DOZER"}), Kinds({"STRUCTURE"})};
	const ecs::Entity dozer = field.Object(100, 100, 0, 1);
	const ecs::Entity other = field.Object(40, 100, 0, 1);
	const ecs::Entity plant = field.Object(150, 100, 0, 2);
	field.world.Add<gp::UnderConstruction>(plant);
	field.Select(dozer);
	BOOST_TEST_REQUIRE(field.IsSelected(dozer));
	BOOST_TEST((field.HoverOver(plant) == Cursor::Select)); // fogged to the player: no command, one of mine to select
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	BOOST_TEST((field.HoverOver(plant) == Cursor::ResumeConstruction));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(plant);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *resume = std::get_if<generalszh::commands::ResumeConstruction>(&orders[0]);
	BOOST_TEST_REQUIRE(resume != nullptr);
	BOOST_TEST((resume->units == std::vector<ecs::Entity>{dozer}));
	BOOST_TEST((resume->target == plant));
	BOOST_TEST(!field.IsSelected(plant));
	orders.clear();
	// Its builder at work on it: nobody else may resume it.
	field.world.Get<gp::UnderConstruction>(plant)->builder = other;
	field.world.Add<gp::Builder>(other);
	field.world.Get<gp::Builder>(other)->target = plant;
	BOOST_TEST((field.HoverOver(plant) == Cursor::Select));
	field.world.Add<gp::Dying>(other);
	BOOST_TEST((field.HoverOver(plant) == Cursor::ResumeConstruction));
	field.world.Remove<gp::Dying>(other);
	// Standing: repaired when hurt.
	field.world.Remove<gp::UnderConstruction>(plant);
	BOOST_TEST((field.HoverOver(plant) == Cursor::Select)); // whole
	field.world.Get<gp::Health>(plant)->current = Fixed::FromInt(50);
	BOOST_TEST((field.HoverOver(plant) == Cursor::DoRepair));
	field.ClickOn(plant);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *repair = std::get_if<generalszh::commands::Repair>(&orders[0]);
	BOOST_TEST_REQUIRE(repair != nullptr);
	BOOST_TEST((repair->units == std::vector<ecs::Entity>{dozer}));
	BOOST_TEST((repair->target == plant));
	orders.clear();
	// Another dozer its sole healer this frame (getSoleHealingBenefactor): no repair; its own heal lock is no bar.
	field.world.Add<gp::HealLock>(plant);
	*field.world.Get<gp::HealLock>(plant) = gp::HealLock{other, catalog.tick + 2};
	BOOST_TEST((field.HoverOver(plant) == Cursor::Select));
	field.world.Get<gp::HealLock>(plant)->healer = dozer;
	BOOST_TEST((field.HoverOver(plant) == Cursor::DoRepair));
	field.world.Get<gp::HealLock>(plant)->healer = other;
	catalog.tick = 3; // the lock ran out
	BOOST_TEST((field.HoverOver(plant) == Cursor::DoRepair));
}

// evaluateContextCommand's ACTIONTYPE_DOCK_AT (SELECTION_ALL) with ActionManager::canDockAt / canTransferSuppliesAt,
// handleDockAtCommand and the DOCK cursor: a supply truck docks (MSG_DOCK) at a warehouse with boxes left that is not an
// enemy's, not while it is shrouded to the player; an empty warehouse is no dock; an enemy's is attacked; at its player's
// supply centre only with boxes aboard; with something else selected that may not dock, nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_supply_truck_docks_where_it_may_take_or_bring_supplies)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	catalog.byDefinition.push_back(SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f});
	catalog.byDefinition.push_back(SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f});
	catalog.kinds = {Kinds({}), Kinds({"VEHICLE"}), Kinds({"STRUCTURE"})};
	const ecs::Entity truck = field.Object(100, 100, 0, 1);
	field.world.Add<gp::Harvester>(truck);
	const ecs::Entity warehouse = field.Object(150, 100, 0, 2);
	field.world.Add<gp::Dock>(warehouse);
	field.world.Add<gp::ResourceStore>(warehouse);
	field.world.Get<gp::ResourceStore>(warehouse)->boxes = 5;
	const ecs::Entity theirs = field.Object(100, 160, 1, 2);
	field.world.Add<gp::Dock>(theirs);
	field.world.Add<gp::ResourceStore>(theirs);
	field.world.Get<gp::ResourceStore>(theirs)->boxes = 5;
	const ecs::Entity centre = field.Object(100, 40, 0, 2);
	field.world.Add<gp::Dock>(centre);
	field.world.Add<gp::ResourceDepot>(centre);
	field.Select(truck);
	BOOST_TEST_REQUIRE(field.IsSelected(truck));
	BOOST_TEST((field.HoverOver(warehouse) == Cursor::Select)); // shrouded
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	BOOST_TEST((field.HoverOver(warehouse) == Cursor::Dock));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(warehouse);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *dock = std::get_if<generalszh::commands::Dock>(&orders[0]);
	BOOST_TEST_REQUIRE(dock != nullptr);
	BOOST_TEST((dock->units == std::vector<ecs::Entity>{truck}));
	BOOST_TEST((dock->dock == warehouse));
	orders.clear();
	field.world.Get<gp::ResourceStore>(warehouse)->boxes = 0;
	BOOST_TEST((field.HoverOver(warehouse) == Cursor::Select));
	BOOST_TEST((field.HoverOver(theirs) == Cursor::AttackObj)); // an enemy's: its view of the truck is ENEMIES
	BOOST_TEST((field.HoverOver(centre) == Cursor::Select));    // nothing aboard
	field.world.Get<gp::Harvester>(truck)->boxes = 2;
	BOOST_TEST((field.HoverOver(centre) == Cursor::Dock));
	// SELECTION_ALL: a tank selected with it may not dock.
	const auto tankAt = field.Pixel(40, 100);
	field.Tank(40, 100, 0);
	field.Frame(tankAt[0], tankAt[1], pointer_button::Left, pointer_button::Left, true);
	BOOST_TEST((field.HoverOver(centre) == Cursor::Select));
}

// evaluateContextCommand's ACTIONTYPE_DOCK_AT with ActionManager::canDockAt's railed transport case: any VEHICLE (and
// INFANTRY) selected docks (MSG_DOCK) with a ferry (a RailedTransportDockUpdate), its own or not, with the DOCK cursor;
// a structure selected with it may not dock, so nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_vehicle_docks_with_a_ferry)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	catalog.byDefinition.push_back(SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f});
	catalog.byDefinition.push_back(SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f});
	catalog.kinds = {Kinds({}), Kinds({"VEHICLE"}), Kinds({"STRUCTURE"})};
	const ecs::Entity tank = field.Object(100, 100, 0, 1);
	const ecs::Entity ferry = field.Object(150, 100, 1, 1);
	field.world.Add<gp::Dock>(ferry);
	field.world.Add<generalszh::gameplay::RailedTransport>(ferry);
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	field.Select(tank);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	BOOST_TEST((field.HoverOver(ferry) == Cursor::Dock));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(ferry);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *dock = std::get_if<generalszh::commands::Dock>(&orders[0]);
	BOOST_TEST_REQUIRE(dock != nullptr);
	BOOST_TEST((dock->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST((dock->dock == ferry));
}

// evaluateContextCommand's ACTIONTYPE_ENTER_OBJECT (SELECTION_ANY, CHECK_CAPACITY) with ActionManager::canEnterObject
// and TransportContain / GarrisonContain::isValidContainerFor, handleEnterObjectCommand (createEnterMessage: MSG_ENTER)
// and the ENTER_FRIENDLY cursor: infantry boards its player's transport with room (TransportSlotCount 1 of 2 free), not a
// full one (selecting it instead), nor an enemy's (only its own player's may ride: attacked instead); it garrisons an
// empty building of any player's; one held by anyone not stealthy is not entered unless its own; an unmanned vehicle is
// taken over.
BOOST_AUTO_TEST_CASE(legacy_parity_infantry_enters_a_transport_or_building_with_room)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook infantry{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Infantry), 8.0f, 4.0f};
	infantry.transportSlots = 1;
	SelectionLook humvee{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f};
	humvee.contain = ContainKind::Transport;
	SelectionLook building{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f};
	building.contain = ContainKind::Garrison;
	SelectionLook stealthy = infantry;
	catalog.byDefinition.insert(catalog.byDefinition.end(), {infantry, humvee, building, stealthy, SelectionLook{select_kind::Selectable, 8.0f, 4.0f}});
	catalog.kinds = {Kinds({}), Kinds({"INFANTRY"}), Kinds({"VEHICLE", "TRANSPORT"}), Kinds({"STRUCTURE"}), Kinds({"INFANTRY", "STEALTH_GARRISON"}),
		Kinds({"VEHICLE"})};
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	const ecs::Entity rifleman = field.Object(100, 100, 0, 1);
	const ecs::Entity transport = field.Object(150, 100, 0, 2);
	field.world.Add<gp::Transport>(transport);
	field.world.Get<gp::Transport>(transport)->definition.slots = 2;
	field.world.Get<gp::Transport>(transport)->occupied = 1;
	field.Select(rifleman);
	BOOST_TEST_REQUIRE(field.IsSelected(rifleman));
	BOOST_TEST((field.HoverOver(transport) == Cursor::EnterFriendly));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(transport);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *enter = std::get_if<generalszh::commands::Enter>(&orders[0]);
	BOOST_TEST_REQUIRE(enter != nullptr);
	BOOST_TEST((enter->units == std::vector<ecs::Entity>{rifleman}));
	BOOST_TEST((enter->target == transport));
	orders.clear();
	field.world.Get<gp::Transport>(transport)->occupied = 2;
	BOOST_TEST((field.HoverOver(transport) == Cursor::Select));
	const ecs::Entity enemyTransport = field.Object(150, 160, 1, 2);
	field.world.Add<gp::Transport>(enemyTransport);
	field.world.Get<gp::Transport>(enemyTransport)->definition.slots = 2;
	BOOST_TEST((field.HoverOver(enemyTransport) == Cursor::AttackObj));
	// A building: an enemy's empty one is garrisoned; held by one of theirs, attacked; held only by a stealthy garrisoner, entered.
	const ecs::Entity house = field.Object(100, 40, 1, 3);
	field.world.Add<gp::Transport>(house);
	field.world.Get<gp::Transport>(house)->definition.slots = 5;
	BOOST_TEST((field.HoverOver(house) == Cursor::EnterFriendly));
	const ecs::Entity inside = field.world.Create();
	field.world.Add<gp::DefinitionRef>(inside);
	field.world.Get<gp::DefinitionRef>(inside)->index = 1;
	field.world.Resource<gp::CargoManifest>().Board(house, inside);
	BOOST_TEST((field.HoverOver(house) == Cursor::AttackObj));
	field.world.Get<gp::DefinitionRef>(inside)->index = 4;
	BOOST_TEST((field.HoverOver(house) == Cursor::EnterFriendly));
	// An unmanned vehicle (DISABLED_UNMANNED), anyone's: any infantry takes it over.
	const ecs::Entity empty = field.Object(40, 100, 1, 5);
	field.world.Add<gp::Disabled>(empty);
	field.world.Get<gp::Disabled>(empty)->mask = gp::disabled_type::Unmanned;
	BOOST_TEST((field.HoverOver(empty) == Cursor::EnterFriendly));
}

// evaluateContextCommand's ACTIONTYPE_GET_HEALED_AT (before ENTER_OBJECT) with ActionManager::canGetHealedAt (a HEAL_PAD
// of an ally's, a hurt INFANTRY) and InGameUI::canSelectedObjectsDoAction's isHealContain exception, handleGetHealedAtCommand
// (MSG_GET_HEALED) and the GET_HEALED cursor: hurt infantry goes to a heal pad (one with no contain) to be healed; a pad
// that heals only who is inside it (HealContain) is entered instead (canEnterObject: not whole); whole, neither.
BOOST_AUTO_TEST_CASE(legacy_parity_hurt_infantry_is_healed_at_a_heal_pad)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook infantry{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Infantry), 8.0f, 4.0f};
	infantry.transportSlots = 1;
	SelectionLook pad{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f};
	SelectionLook barracks = pad;
	barracks.contain = ContainKind::Heal;
	catalog.byDefinition.insert(catalog.byDefinition.end(), {infantry, pad, barracks});
	catalog.kinds = {Kinds({}), Kinds({"INFANTRY"}), Kinds({"STRUCTURE", "HEAL_PAD"}), Kinds({"STRUCTURE", "HEAL_PAD"})};
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	const ecs::Entity rifleman = field.Object(100, 100, 0, 1);
	const ecs::Entity healer = field.Object(150, 100, 0, 2);
	const ecs::Entity heals = field.Object(100, 160, 0, 3);
	field.world.Add<gp::Transport>(heals);
	field.world.Get<gp::Transport>(heals)->definition.slots = 5;
	field.Select(rifleman);
	BOOST_TEST_REQUIRE(field.IsSelected(rifleman));
	BOOST_TEST((field.HoverOver(healer) == Cursor::Select)); // whole
	BOOST_TEST((field.HoverOver(heals) == Cursor::Select));
	field.world.Get<gp::Health>(rifleman)->current = Fixed::FromInt(40);
	BOOST_TEST((field.HoverOver(healer) == Cursor::GetHealed));
	BOOST_TEST((field.HoverOver(heals) == Cursor::EnterFriendly));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(healer);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *healed = std::get_if<generalszh::commands::GetHealed>(&orders[0]);
	BOOST_TEST_REQUIRE(healed != nullptr);
	BOOST_TEST((healed->units == std::vector<ecs::Entity>{rifleman}));
	BOOST_TEST((healed->target == healer));
	orders.clear();
	field.ClickOn(heals);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST((std::get_if<generalszh::commands::Enter>(&orders[0]) != nullptr));
}

// evaluateContextCommand's ACTIONTYPE_SABOTAGE_BUILDING with ActionManager::canSabotageBuilding (an enemy's, alive, not
// fogged; a SabotagePowerPlantCrateCollide with BuildingPickup that would like to collide: FS_POWER, not under
// construction), handleSabotageBuildingCommand (MSG_ENTER) and the ENTER_AGGRESSIVELY cursor: an unarmed saboteur goes in
// to sabotage an enemy power plant; a barracks is nothing to its collide (a plain move hint over it); nor a plant being
// built.
BOOST_AUTO_TEST_CASE(legacy_parity_a_saboteur_enters_an_enemy_building_to_sabotage_it)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook saboteur{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Infantry), 8.0f, 4.0f};
	saboteur.saboteur = 0;
	saboteur.saboteurCount = 1;
	catalog.saboteurs = {SaboteurCollide{generalszh::content::SabotageKind::PowerPlant, {}, {}, true, false}};
	SelectionLook building{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f};
	catalog.byDefinition.insert(catalog.byDefinition.end(), {saboteur, building, building});
	catalog.kinds = {Kinds({}), Kinds({"INFANTRY"}), Kinds({"STRUCTURE", "FS_POWER"}), Kinds({"STRUCTURE", "FS_BARRACKS"})};
	const ecs::Entity spy = field.Object(100, 100, 0, 1);
	field.world.Remove<gp::Armament>(spy);
	const ecs::Entity plant = field.Object(150, 100, 1, 2);
	const ecs::Entity barracks = field.Object(100, 160, 1, 3);
	field.Select(spy);
	BOOST_TEST_REQUIRE(field.IsSelected(spy));
	BOOST_TEST((field.HoverOver(plant) == Cursor::Move)); // fogged
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	BOOST_TEST((field.HoverOver(plant) == Cursor::EnterAggressive));
	BOOST_TEST((field.HoverOver(barracks) == Cursor::Move));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(plant);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *enter = std::get_if<generalszh::commands::Enter>(&orders[0]);
	BOOST_TEST_REQUIRE(enter != nullptr);
	BOOST_TEST((enter->units == std::vector<ecs::Entity>{spy}));
	BOOST_TEST((enter->target == plant));
	field.world.Add<gp::UnderConstruction>(plant);
	BOOST_TEST((field.HoverOver(plant) == Cursor::Move));
}

// evaluateContextCommand's canSelectionSalvage (a salvage crate, any SALVAGER selected) before the attack, and
// handleSalvageCommand: MSG_DO_SALVAGE with the crate's position (GameLogic runs it as a move, onDoMoveto), its hint
// MSG_DO_SALVAGE_HINT the MOVETO cursor; a selection with no salvager attacks the crate like anything else (after moving).
BOOST_AUTO_TEST_CASE(legacy_parity_a_salvager_moves_onto_a_salvage_crate)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook crate{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Crate), 8.0f, 4.0f};
	crate.salvageCrate = true;
	catalog.byDefinition.insert(catalog.byDefinition.end(), {SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f}, crate});
	catalog.kinds = {Kinds({}), Kinds({"VEHICLE", "SALVAGER"}), Kinds({"CRATE"})};
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	const ecs::Entity technical = field.Object(100, 100, 0, 1);
	const ecs::Entity tank = field.Tank(40, 100, 0);
	const ecs::Entity box = field.Object(150, 100, 1, 2);
	field.Select(technical);
	BOOST_TEST_REQUIRE(field.IsSelected(technical));
	BOOST_TEST((field.HoverOver(box) == Cursor::Move));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(box);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *move = std::get_if<generalszh::commands::MoveTo>(&orders[0]);
	BOOST_TEST_REQUIRE(move != nullptr);
	BOOST_TEST((move->units == std::vector<ecs::Entity>{technical}));
	BOOST_TEST((move->destination == Engine::Math::FixedVector2{Fixed::FromInt(150), Fixed::FromInt(100)}));
	orders.clear();
	field.Select(tank);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	BOOST_TEST((field.HoverOver(box) == Cursor::OutRange)); // 110 away: beyond its rifle's 100 + 5 + 5
}

// evaluateContextCommand's ACTIONTYPE_CAPTURE_BUILDING and the hacking actions (after the attack) with
// ActionManager::canCaptureBuilding, canDisableVehicleViaHacking and canStealCashViaHacking, handleCaptureBuildingCommand
// and handleHackCommand (the first selected's command set: its button's power fired at the object through
// issueSpecialPowerCommand, MSG_DO_SPECIAL_POWER_AT_OBJECT, only at an object of a relationship the button takes), and the
// CAPTUREBUILDING / HACK cursors: an unarmed ranger with its capture ready captures an enemy building, not with the power
// paused (the upgrade not yet in), nor when armed and able to shoot it (the attack comes first); a Black Lotus hacks: a
// building (its capture: the HACK hint), a vehicle (disable), a cash generator once its capture is not ready (steal cash);
// a button that takes no enemy shows its hint but a click fires nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_capturer_captures_and_a_hacker_hacks_what_it_clicks)
{
	using Cursor = generalszh::content::MouseCursorKind;
	namespace bo = generalszh::content::button_option;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook ranger{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Infantry), 8.0f, 4.0f};
	ranger.commandSet = 0;
	SelectionLook lotus = ranger;
	lotus.commandSet = 1;
	catalog.byDefinition.insert(catalog.byDefinition.end(), {ranger, lotus,
		SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f},
		SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f}});
	catalog.kinds = {Kinds({}), Kinds({"INFANTRY"}), Kinds({"INFANTRY"}), Kinds({"STRUCTURE", "CAPTURABLE", "CASH_GENERATOR"}), Kinds({"VEHICLE"})};
	catalog.powers = {ContextPower::InfantryCapture, ContextPower::BlackLotusCapture, ContextPower::DisableVehicleHack, ContextPower::StealCashHack};
	const std::uint32_t takes = bo::NeedTargetEnemy | bo::NeedTargetNeutral;
	catalog.contextSets = {{ContextButton{ContextPower::InfantryCapture, "SpecialAbilityRangerCaptureBuilding", takes}},
		{ContextButton{ContextPower::BlackLotusCapture, "SpecialAbilityBlackLotusCaptureBuilding", takes},
			ContextButton{ContextPower::DisableVehicleHack, "SpecialAbilityBlackLotusDisableVehicleHack", takes},
			ContextButton{ContextPower::StealCashHack, "SpecialAbilityBlackLotusStealCashHack", takes}}};
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	const ecs::Entity capturer = field.Object(100, 100, 0, 1);
	field.world.Remove<gp::Armament>(capturer);
	field.world.Add<gp::SpecialPowerTimers>(capturer);
	auto &capture = *field.world.Get<gp::SpecialPowerTimers>(capturer);
	capture.count = 1;
	capture.timers[0].power = 0;
	const ecs::Entity bank = field.Object(150, 100, 1, 3);
	const ecs::Entity car = field.Object(100, 160, 1, 4);
	field.Select(capturer);
	BOOST_TEST_REQUIRE(field.IsSelected(capturer));
	BOOST_TEST((field.HoverOver(bank) == Cursor::CaptureBuilding));
	BOOST_TEST((field.HoverOver(car) == Cursor::Move));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(bank);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *fire = std::get_if<generalszh::commands::UseSpecialPowerAtObject>(&orders[0]);
	BOOST_TEST_REQUIRE(fire != nullptr);
	BOOST_TEST((fire->source == capturer));
	BOOST_TEST(fire->power == "SpecialAbilityRangerCaptureBuilding");
	BOOST_TEST((fire->target == bank));
	orders.clear();
	capture.timers[0].pausedCount = 1; // StartsPaused until the capture upgrade: getPercentReady below 1
	BOOST_TEST((field.HoverOver(bank) == Cursor::Move));
	capture.timers[0].pausedCount = 0;
	field.world.Add<gp::Armament>(capturer);
	field.world.Get<gp::Armament>(capturer)->weapon = field.gun;
	BOOST_TEST((field.HoverOver(bank) == Cursor::AttackObj));
	// The Black Lotus.
	const ecs::Entity hacker = field.Object(40, 100, 0, 2);
	field.world.Remove<gp::Armament>(hacker);
	field.world.Add<gp::SpecialPowerTimers>(hacker);
	auto &hacks = *field.world.Get<gp::SpecialPowerTimers>(hacker);
	hacks.count = 3;
	hacks.timers[0].power = 1;
	hacks.timers[1].power = 2;
	hacks.timers[2].power = 3;
	field.Select(hacker);
	BOOST_TEST_REQUIRE(field.IsSelected(hacker));
	BOOST_TEST((field.HoverOver(bank) == Cursor::Hack));
	field.ClickOn(bank);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get<generalszh::commands::UseSpecialPowerAtObject>(orders[0]).power == "SpecialAbilityBlackLotusCaptureBuilding");
	orders.clear();
	BOOST_TEST((field.HoverOver(car) == Cursor::Hack));
	field.ClickOn(car);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get<generalszh::commands::UseSpecialPowerAtObject>(orders[0]).power == "SpecialAbilityBlackLotusDisableVehicleHack");
	BOOST_TEST((std::get<generalszh::commands::UseSpecialPowerAtObject>(orders[0]).target == car));
	orders.clear();
	hacks.timers[0].availableOn = 900; // the capture recharging
	BOOST_TEST((field.HoverOver(bank) == Cursor::Hack));
	field.ClickOn(bank);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get<generalszh::commands::UseSpecialPowerAtObject>(orders[0]).power == "SpecialAbilityBlackLotusStealCashHack");
	orders.clear();
	catalog.contextSets[1][2].options = bo::NeedTargetNeutral; // isValidObjectTarget: an enemy is not taken
	BOOST_TEST((field.HoverOver(bank) == Cursor::Hack));
	field.ClickOn(bank);
	BOOST_TEST(orders.empty());
}

// evaluateContextCommand's ACTIONTYPE_ENTER_OBJECT for an aircraft (ActionManager::canEnterObject's aircraft case: above
// the ground, at its own player's FS_AIRFIELD where it holds a space, or one is free: ParkingPlaceBehavior::
// hasReservedSpace / shouldReserveDoorWhenQueued / hasAvailableSpaceFor) and createEnterMessage: an airborne jet is sent
// to land at its player's airfield with a space free (MSG_ENTER), not one whose spaces other jets hold, but its own
// airfield where it holds one; on the ground, never.
BOOST_AUTO_TEST_CASE(legacy_parity_a_jet_lands_at_an_airfield_of_its_players_with_room)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	catalog.byDefinition.insert(catalog.byDefinition.end(), {SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle | select_kind::Aircraft), 8.0f, 4.0f},
		SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f}});
	catalog.kinds = {Kinds({}), Kinds({"VEHICLE", "AIRCRAFT"}), Kinds({"STRUCTURE", "FS_AIRFIELD"})};
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	const ecs::Entity raptor = field.Object(100, 100, 0, 1);
	field.world.Get<gp::Transform>(raptor)->position.z = Fixed::FromInt(60);
	field.world.Add<gp::Jet>(raptor);
	const ecs::Entity airfield = field.Object(150, 100, 0, 2);
	field.world.Add<gp::Airfield>(airfield);
	field.world.Get<gp::Airfield>(airfield)->spaceCount = 1;
	field.Select(raptor);
	BOOST_TEST_REQUIRE(field.IsSelected(raptor));
	BOOST_TEST((field.HoverOver(airfield) == Cursor::EnterFriendly));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(airfield);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *enter = std::get_if<generalszh::commands::Enter>(&orders[0]);
	BOOST_TEST_REQUIRE(enter != nullptr);
	BOOST_TEST((enter->target == airfield));
	orders.clear();
	const ecs::Entity parked = field.world.Create();
	field.world.Add<gp::Jet>(parked);
	field.world.Get<gp::Jet>(parked)->airfield = airfield;
	BOOST_TEST((field.HoverOver(airfield) == Cursor::Select)); // its one space held
	field.world.Get<gp::Jet>(parked)->airfield = ecs::Entity{};
	field.world.Get<gp::Jet>(raptor)->airfield = airfield;
	BOOST_TEST((field.HoverOver(airfield) == Cursor::EnterFriendly)); // its own space
	field.world.Get<gp::Transform>(raptor)->position.z = Fixed{};
	BOOST_TEST((field.HoverOver(airfield) == Cursor::Select));
}

// evaluateContextCommand's ACTIONTYPE_ENTER_OBJECT for a pilot (canEnterObject: its VeterancyCrateCollide would like to
// collide with the vehicle: VeterancyCrateCollide::isValidToExecute, IsPilot: its own player's, with an AI, trainable, not
// yet heroic, on the ground): it climbs into its player's vehicle (MSG_ENTER), not into a heroic one, nor into an
// enemy's (attacked).
BOOST_AUTO_TEST_CASE(legacy_parity_a_pilot_enters_its_players_vehicle)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook vehicle{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f};
	vehicle.hasAi = true;
	catalog.byDefinition.insert(catalog.byDefinition.end(), {SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Infantry), 8.0f, 4.0f}, vehicle});
	catalog.kinds = {Kinds({}), Kinds({"INFANTRY"}), Kinds({"VEHICLE"})};
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	const ecs::Entity pilot = field.Object(100, 100, 0, 1);
	field.world.Add<generalszh::gameplay::PilotSeeker>(pilot);
	auto &seeker = *field.world.Get<generalszh::gameplay::PilotSeeker>(pilot);
	seeker.required = Kinds({"VEHICLE"});
	seeker.isPilot = 1;
	field.world.Add<gp::Experience>(pilot);
	const ecs::Entity tank = field.Object(150, 100, 0, 2);
	field.world.Add<gp::Experience>(tank);
	field.world.Get<gp::Experience>(tank)->trainable = true;
	const ecs::Entity enemy = field.Object(100, 160, 1, 2);
	field.world.Add<gp::Experience>(enemy);
	field.world.Get<gp::Experience>(enemy)->trainable = true;
	field.Select(pilot);
	BOOST_TEST_REQUIRE(field.IsSelected(pilot));
	BOOST_TEST((field.HoverOver(tank) == Cursor::EnterFriendly));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.ClickOn(tank);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *enter = std::get_if<generalszh::commands::Enter>(&orders[0]);
	BOOST_TEST_REQUIRE(enter != nullptr);
	BOOST_TEST((enter->units == std::vector<ecs::Entity>{pilot}));
	BOOST_TEST((enter->target == tank));
	BOOST_TEST((field.HoverOver(enemy) == Cursor::AttackObj));
	field.world.Get<gp::Experience>(tank)->level = 3; // heroic
	BOOST_TEST((field.HoverOver(tank) == Cursor::Select));
}

// Legacy parity (W3DModelDraw, as its render object is made: Set_Collision_Type from KindOf in turn, each replacing the
// one before; the non-bridge dead set to none): a selectable unit is picked as selectable; a selectable mine only as a
// mine (MINE came later); a force-attackable civilian building only as force-attackable; CLICK_THROUGH never; a dead
// unit never; a dead bridge still as selectable.
BOOST_AUTO_TEST_CASE(legacy_parity_pick_types_follow_the_kinds_in_w3d_model_draws_order)
{
	using namespace generalszh::presentation;
	BOOST_TEST(PickTypes(select_kind::Selectable, false) == pick_type::Selectable);
	BOOST_TEST(PickTypes(select_kind::Selectable | select_kind::Mine, false) == pick_type::Mines);
	BOOST_TEST(PickTypes(select_kind::Selectable | select_kind::ForceAttackable, false) == pick_type::ForceAttackable);
	BOOST_TEST(PickTypes(select_kind::Selectable | select_kind::ClickThrough, false) == 0);
	BOOST_TEST(PickTypes(select_kind::Selectable, true) == 0);
	BOOST_TEST(PickTypes(select_kind::Selectable | select_kind::Bridge, true) == pick_type::Selectable);
}

// Object::onContainedBy: anything contained is OBJECT_STATUS_UNSELECTABLE, and MASKED only inside a container that
// encloses it. A fire base's occupant is not hidden (OpenContain::addToContain leaves it in the world: OffMap Stationed),
// so the pick ray meets it (W3DView::pickDrawable): a click on an enemy one orders the attack
// (WeaponSet::getAbleToAttackSpecificObject refuses only an enclosed victim), a click on one of mine selects nothing.
// An enclosed one's drawable is hidden: the click goes through to the ground (a move).
BOOST_AUTO_TEST_CASE(legacy_parity_a_fire_bases_occupant_is_targeted_but_never_selected)
{
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity stationed = field.Tank(150, 100, 1);
	field.world.Add<gp::OffMap>(stationed);
	*field.world.Get<gp::OffMap>(stationed) = gp::OffMap{gp::off_map_reason::Stationed, true, {}, {}};
	field.Select(tank);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	orders.clear();
	field.ClickOn(stationed);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *attack = std::get_if<generalszh::commands::Attack>(&orders[0]);
	BOOST_TEST_REQUIRE(attack != nullptr);
	BOOST_TEST((attack->target == stationed));
	BOOST_TEST(!field.IsSelected(stationed));
	orders.clear();
	*field.world.Get<gp::OffMap>(stationed) = gp::OffMap{gp::off_map_reason::Contained, true, {}, {}};
	field.ClickOn(stationed);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get_if<generalszh::commands::MoveTo>(&orders[0]) != nullptr);
	// One of mine at its station: never selected by a click.
	orders.clear();
	field.Click(10, 10, pointer_button::Right);
	const ecs::Entity mine = field.Tank(100, 150, 0);
	field.world.Add<gp::OffMap>(mine);
	*field.world.Get<gp::OffMap>(mine) = gp::OffMap{gp::off_map_reason::Stationed, true, {}, {}};
	field.ClickOn(mine);
	BOOST_TEST(!field.IsSelected(mine));
}

BOOST_AUTO_TEST_SUITE_END()

BOOST_AUTO_TEST_SUITE(waypoint_mode)

// CommandTranslator in waypoint mode (MSG_META_BEGIN_WAYPOINTS / END_WAYPOINTS: Alt held, CommandMap.ini): the cursor
// over the ground is WAYPOINT (MSG_ADD_WAYPOINT_HINT); a click there adds a waypoint (handleWaypointModeCommand ->
// issueMoveToLocationCommand: MSG_ADD_WAYPOINT at the spot) for the selection, which answers as for a move in waypoint
// mode (pickAndPlayUnitVoiceResponse MSG_DO_MOVETO); a click on another of mine is a waypoint too, not a selection
// (contextCommandForNewSelection: the command is MSG_ADD_WAYPOINT, not invalid); Alt let go, a click moves again.
BOOST_AUTO_TEST_CASE(legacy_parity_alt_clicks_add_waypoints)
{
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity second = field.Tank(130, 100, 0);
	field.Click(400, 300);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	field.world.Resource<PointerInput>().alt = true;
	BOOST_TEST((field.Hover(400, 100) == generalszh::content::MouseCursorKind::Waypoint));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	auto &cues = field.world.Resource<UnitVoiceCues>().pending;
	orders.clear();
	cues.clear();
	field.Click(400, 100);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *waypoint = std::get_if<generalszh::commands::AddWaypoint>(&orders[0]);
	BOOST_TEST_REQUIRE(waypoint != nullptr);
	BOOST_TEST((waypoint->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST(std::abs(Engine::Math::ToFloat(waypoint->destination.x) - 100.0f) < 0.5f);
	BOOST_TEST(std::abs(Engine::Math::ToFloat(waypoint->destination.y) - 186.6f) < 0.5f);
	BOOST_TEST_REQUIRE(cues.size() == 1u);
	BOOST_TEST((cues[0].order == VoiceOrder::Move));
	BOOST_TEST(cues[0].waypointMode);
	orders.clear();
	field.ClickOn(second);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get_if<generalszh::commands::AddWaypoint>(&orders[0]) != nullptr);
	BOOST_TEST(!field.IsSelected(second));
	orders.clear();
	field.world.Resource<PointerInput>().alt = false;
	field.Click(400, 100);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get_if<generalszh::commands::MoveTo>(&orders[0]) != nullptr);
}

BOOST_AUTO_TEST_SUITE_END()
