PickedObject Unit(std::uint32_t index, PickSide side = PickSide::Mine)
{
	PickedObject object;
	object.entity = ecs::Entity{index, 1};
	object.side = side;
	return object;
}

PickedObject Building(std::uint32_t index, PickSide side = PickSide::Mine)
{
	PickedObject object = Unit(index, side);
	object.structure = true;
	return object;
}

const auto noCommand = [](std::size_t) { return false; };
const auto anyCommand = [](std::size_t) { return true; };

std::vector<std::uint32_t> Indices(const ClickSelection &selection)
{
	std::vector<std::uint32_t> out;
	for (const ecs::Entity entity : selection.entities)
		out.push_back(entity.index);
	return out;
}
}

BOOST_AUTO_TEST_SUITE(selection_rules)

// SelectionTranslator::onMouseLeftClick: with nothing selected a click on one of mine selects it; with mine
// selected, a click on another of mine without a context command for it (contextCommandForNewSelection:
// newCountMine == 1, point, not prefer-selection -> evaluateContextCommand) replaces the selection.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_one_of_mine_selects_it)
{
	const std::vector<PickedObject> none;
	const std::vector<PickedObject> tank{Unit(1)};
	ClickSelection selection = LeftClickSelection(none, tank, true, false, false, false, false, noCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Replace));
	BOOST_TEST(Indices(selection) == std::vector<std::uint32_t>{1});
	const std::vector<PickedObject> current{Unit(2), Unit(3)};
	selection = LeftClickSelection(current, tank, true, false, false, false, false, noCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Replace));
	// One of mine that takes a command (a transport to enter): the click is the command's.
	selection = LeftClickSelection(current, tank, true, false, false, false, false, anyCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Pass));
}

// contextCommandForNewSelection: mine selected, a click on one enemy is its context command (attack) when there
// is one; without one the enemy is selected alone. A drag over enemies is never theirs to select in numbers.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_an_enemy_attacks_or_selects_it)
{
	const std::vector<PickedObject> current{Unit(2)};
	const std::vector<PickedObject> enemy{Unit(9, PickSide::Enemy)};
	BOOST_TEST((LeftClickSelection(current, enemy, true, false, false, false, false, anyCommand).outcome == ClickOutcome::Pass));
	const ClickSelection selected = LeftClickSelection(current, enemy, true, false, false, false, false, noCommand);
	BOOST_TEST((selected.outcome == ClickOutcome::Replace));
	BOOST_TEST(Indices(selected) == std::vector<std::uint32_t>{9});
	const std::vector<PickedObject> enemies{Unit(8, PickSide::Enemy), Unit(9, PickSide::Enemy)};
	BOOST_TEST((LeftClickSelection(current, enemies, false, false, false, false, false, noCommand).outcome == ClickOutcome::Pass));
	// Force attack: never a command for new selection; one enemy is selected.
	BOOST_TEST((LeftClickSelection(current, enemy, true, false, true, false, false, anyCommand).outcome == ClickOutcome::Replace));
}

// A drag selects my units, not my buildings, unless one building is the only selectable thing picked.
BOOST_AUTO_TEST_CASE(legacy_parity_a_drag_takes_units_before_buildings)
{
	const std::vector<PickedObject> none;
	const std::vector<PickedObject> mixed{Unit(1), Building(2), Unit(3), Unit(4, PickSide::Enemy)};
	ClickSelection selection = LeftClickSelection(none, mixed, false, false, false, false, false, noCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Replace));
	BOOST_TEST(Indices(selection) == (std::vector<std::uint32_t>{1, 3}));
	// A building listed twice (its garrison passes selection to it: addDrawableToList) is still the one building.
	const std::vector<PickedObject> building{Building(2), Building(2)};
	selection = LeftClickSelection(none, building, false, false, false, false, false, noCommand);
	BOOST_TEST(Indices(selection) == std::vector<std::uint32_t>{2});
	const std::vector<PickedObject> twoBuildings{Building(2), Building(6)};
	selection = LeftClickSelection(none, twoBuildings, false, false, false, false, false, noCommand);
	BOOST_TEST(selection.entities.empty());
	// Passengers are never selected themselves.
	PickedObject passenger = Unit(7);
	passenger.contained = true;
	const std::vector<PickedObject> aboard{passenger, Unit(1)};
	selection = LeftClickSelection(none, aboard, false, false, false, false, false, noCommand);
	BOOST_TEST(Indices(selection) == std::vector<std::uint32_t>{1});
}

// Prefer-selection mode (shift): adds to a selection of mine, and a point on what is all selected deselects it;
// a building of mine alone, or a selection holding others' objects, replaces instead.
BOOST_AUTO_TEST_CASE(legacy_parity_prefer_selection_adds_and_toggles)
{
	const std::vector<PickedObject> current{Unit(2), Unit(3)};
	const std::vector<PickedObject> another{Unit(4)};
	BOOST_TEST((LeftClickSelection(current, another, true, true, false, false, false, anyCommand).outcome == ClickOutcome::Add));
	const std::vector<PickedObject> again{Unit(3)};
	const ClickSelection off = LeftClickSelection(current, again, true, true, false, false, true, noCommand);
	BOOST_TEST((off.outcome == ClickOutcome::Deselect));
	BOOST_TEST(Indices(off) == std::vector<std::uint32_t>{3});
	const std::vector<PickedObject> barracks{Building(5)};
	BOOST_TEST((LeftClickSelection(current, barracks, true, true, false, false, false, noCommand).outcome == ClickOutcome::Replace));
	const std::vector<PickedObject> enemySelected{Unit(9, PickSide::Enemy)};
	BOOST_TEST((LeftClickSelection(enemySelected, another, true, true, false, false, false, noCommand).outcome == ClickOutcome::Replace));
}

// MetaEventTranslator::onMouseEvent: a release under DragTolerance (25) on both axes is a point.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_is_a_point_under_the_drag_tolerance)
{
	BOOST_TEST(IsPointClick(100, 100, 124, 76, 25));
	BOOST_TEST(!IsPointClick(100, 100, 125, 100, 25));
	BOOST_TEST(!IsPointClick(100, 100, 100, 75, 25));
}

BOOST_AUTO_TEST_SUITE_END()

namespace
