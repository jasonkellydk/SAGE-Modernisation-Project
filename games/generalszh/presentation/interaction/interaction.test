PickedObject Unit(std::uint32_t index, PickSide side = PickSide::Mine)
{
	PickedObject object;
	object.entity = ecs::Entity{index, 1};
	object.side = side;
	return object;
}

PickedObject Building(std::uint32_t index, PickSide side = PickSide::Mine)
{
	PickedObject object = Unit(index, side);
	object.structure = true;
	return object;
}

const auto noCommand = [](std::size_t) { return false; };
const auto anyCommand = [](std::size_t) { return true; };

std::vector<std::uint32_t> Indices(const ClickSelection &selection)
{
	std::vector<std::uint32_t> out;
	for (const ecs::Entity entity : selection.entities)
		out.push_back(entity.index);
	return out;
}
}

BOOST_AUTO_TEST_SUITE(selection_rules)

// SelectionTranslator::onMouseLeftClick: with nothing selected a click on one of mine selects it; with mine
// selected, a click on another of mine without a context command for it (contextCommandForNewSelection:
// newCountMine == 1, point, not prefer-selection -> evaluateContextCommand) replaces the selection.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_one_of_mine_selects_it)
{
	const std::vector<PickedObject> none;
	const std::vector<PickedObject> tank{Unit(1)};
	ClickSelection selection = LeftClickSelection(none, tank, true, false, false, false, false, noCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Replace));
	BOOST_TEST(Indices(selection) == std::vector<std::uint32_t>{1});
	const std::vector<PickedObject> current{Unit(2), Unit(3)};
	selection = LeftClickSelection(current, tank, true, false, false, false, false, noCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Replace));
	// One of mine that takes a command (a transport to enter): the click is the command's.
	selection = LeftClickSelection(current, tank, true, false, false, false, false, anyCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Pass));
}

// contextCommandForNewSelection: mine selected, a click on one enemy is its context command (attack) when there
// is one; without one the enemy is selected alone. A drag over enemies is never theirs to select in numbers.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_an_enemy_attacks_or_selects_it)
{
	const std::vector<PickedObject> current{Unit(2)};
	const std::vector<PickedObject> enemy{Unit(9, PickSide::Enemy)};
	BOOST_TEST((LeftClickSelection(current, enemy, true, false, false, false, false, anyCommand).outcome == ClickOutcome::Pass));
	const ClickSelection selected = LeftClickSelection(current, enemy, true, false, false, false, false, noCommand);
	BOOST_TEST((selected.outcome == ClickOutcome::Replace));
	BOOST_TEST(Indices(selected) == std::vector<std::uint32_t>{9});
	const std::vector<PickedObject> enemies{Unit(8, PickSide::Enemy), Unit(9, PickSide::Enemy)};
	BOOST_TEST((LeftClickSelection(current, enemies, false, false, false, false, false, noCommand).outcome == ClickOutcome::Pass));
	// Force attack: never a command for new selection; one enemy is selected.
	BOOST_TEST((LeftClickSelection(current, enemy, true, false, true, false, false, anyCommand).outcome == ClickOutcome::Replace));
}

// A drag selects my units, not my buildings, unless one building is the only selectable thing picked.
BOOST_AUTO_TEST_CASE(legacy_parity_a_drag_takes_units_before_buildings)
{
	const std::vector<PickedObject> none;
	const std::vector<PickedObject> mixed{Unit(1), Building(2), Unit(3), Unit(4, PickSide::Enemy)};
	ClickSelection selection = LeftClickSelection(none, mixed, false, false, false, false, false, noCommand);
	BOOST_TEST((selection.outcome == ClickOutcome::Replace));
	BOOST_TEST(Indices(selection) == (std::vector<std::uint32_t>{1, 3}));
	// A building listed twice (its garrison passes selection to it: addDrawableToList) is still the one building.
	const std::vector<PickedObject> building{Building(2), Building(2)};
	selection = LeftClickSelection(none, building, false, false, false, false, false, noCommand);
	BOOST_TEST(Indices(selection) == std::vector<std::uint32_t>{2});
	const std::vector<PickedObject> twoBuildings{Building(2), Building(6)};
	selection = LeftClickSelection(none, twoBuildings, false, false, false, false, false, noCommand);
	BOOST_TEST(selection.entities.empty());
	// Passengers are never selected themselves.
	PickedObject passenger = Unit(7);
	passenger.contained = true;
	const std::vector<PickedObject> aboard{passenger, Unit(1)};
	selection = LeftClickSelection(none, aboard, false, false, false, false, false, noCommand);
	BOOST_TEST(Indices(selection) == std::vector<std::uint32_t>{1});
}

// Prefer-selection mode (shift): adds to a selection of mine, and a point on what is all selected deselects it;
// a building of mine alone, or a selection holding others' objects, replaces instead.
BOOST_AUTO_TEST_CASE(legacy_parity_prefer_selection_adds_and_toggles)
{
	const std::vector<PickedObject> current{Unit(2), Unit(3)};
	const std::vector<PickedObject> another{Unit(4)};
	BOOST_TEST((LeftClickSelection(current, another, true, true, false, false, false, anyCommand).outcome == ClickOutcome::Add));
	const std::vector<PickedObject> again{Unit(3)};
	const ClickSelection off = LeftClickSelection(current, again, true, true, false, false, true, noCommand);
	BOOST_TEST((off.outcome == ClickOutcome::Deselect));
	BOOST_TEST(Indices(off) == std::vector<std::uint32_t>{3});
	const std::vector<PickedObject> barracks{Building(5)};
	BOOST_TEST((LeftClickSelection(current, barracks, true, true, false, false, false, noCommand).outcome == ClickOutcome::Replace));
	const std::vector<PickedObject> enemySelected{Unit(9, PickSide::Enemy)};
	BOOST_TEST((LeftClickSelection(enemySelected, another, true, true, false, false, false, noCommand).outcome == ClickOutcome::Replace));
}

// MetaEventTranslator::onMouseEvent: a release under DragTolerance (25) on both axes is a point.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_is_a_point_under_the_drag_tolerance)
{
	BOOST_TEST(IsPointClick(100, 100, 124, 76, 25));
	BOOST_TEST(!IsPointClick(100, 100, 125, 100, 25));
	BOOST_TEST(!IsPointClick(100, 100, 100, 75, 25));
}

BOOST_AUTO_TEST_SUITE_END()

namespace
{
namespace gp = engine::gameplay;
using Engine::Math::Fixed;

// A flat field seen straight down from 300 above (100, 100): 800 x 600 pixels, 60 degrees across.
struct Field
{
	engine::level::Heightfield heights;
	ecs::World world{ecs::WorldConfig{4}};
	std::uint64_t frame{0};
	std::uint32_t gun{0};

	Field()
	{
		heights.width = 2;
		heights.height = 2;
		heights.cellSize = Fixed::FromInt(1000);
		heights.heights.assign(4, Fixed{});
		world.RegisterComponent<gp::Owner>();
		world.RegisterComponent<gp::Targetable>();
		world.RegisterComponent<gp::OffMap>();
		world.RegisterComponent<gp::Health>();
		world.RegisterComponent<gp::Armament>();
		world.RegisterComponent<gp::WeaponSlots>();
		world.RegisterComponent<gp::Slaved>();
		world.RegisterComponent<gp::ScriptStatus>();
		world.RegisterComponent<gp::DefinitionRef>();
		world.RegisterComponent<gp::StatusFlags>();
		world.RegisterComponent<gp::Loadout>();
		world.RegisterComponent<gp::Transport>();
		world.RegisterComponent<generalszh::gameplay::ParticleCannon>();
		world.RegisterComponent<generalszh::gameplay::SpectreGunship>();
		world.RegisterComponent<gp::Transform>();
		world.RegisterComponent<gp::WeaponBonusConditions>();
		world.RegisterComponent<Selected>();
		world.FinalizeComponents();
		world.EmplaceResource<gp::GroundHeight>(heights);
		world.EmplaceResource<generalszh::gameplay::Deselections>();
		world.EmplaceResource<gp::ShroudMap>().Init(Fixed::FromInt(2000), Fixed::FromInt(2000), Fixed::FromInt(10), 2, 0);
		gp::Relationships &relationships = world.EmplaceResource<gp::Relationships>(2u);
		relationships.Set(0, 1, gp::Relationship::Enemies);
		relationships.Set(1, 0, gp::Relationship::Enemies);
		gp::WeaponDefinition rifle;
		rifle.attackRange = Fixed::FromInt(100);
		gun = world.EmplaceResource<gp::WeaponCatalog>().Add(rifle);
		world.EmplaceResource<gp::VisibleObjects>().Reset(1);
		world.EmplaceResource<PointerInput>();
		InteractionView &view = world.EmplaceResource<InteractionView>();
		view = {{100, 100, 300}, {1, 0, 0}, {0, 1, 0}, {0, 0, -1}, std::tan(0.5236f), std::tan(0.5236f) * 0.75f, 800, 600, true};
		world.EmplaceResource<InteractionState>();
		world.EmplaceResource<MouseSettings>();
		world.EmplaceResource<SelectionBox>();
		world.EmplaceResource<CursorState>();
		world.EmplaceResource<GuiTargeting>();
		world.Resource<MouseSettings>().cursorDirections[static_cast<std::size_t>(generalszh::content::MouseCursorKind::Scroll)] = 8;
		SelectionCatalog &catalog = world.EmplaceResource<SelectionCatalog>();
		catalog.byDefinition = {SelectionLook{select_kind::Selectable, 8.0f, 4.0f}};
		world.EmplaceResource<LocalPlayer>(LocalPlayer{0, true});
		world.EmplaceResource<PlayerOrders>();
		world.EmplaceResource<BuildPlacement>();
	}

	ecs::Entity Tank(int x, int y, std::uint32_t player)
	{
		const ecs::Entity entity = world.Create();
		world.Add<gp::Owner>(entity);
		world.Add<gp::Targetable>(entity);
		world.Add<gp::Health>(entity);
		world.Add<gp::Armament>(entity);
		world.Add<gp::Transform>(entity);
		world.Get<gp::Transform>(entity)->position = {Fixed::FromInt(x), Fixed::FromInt(y), {}};
		*world.Get<gp::Owner>(entity) = {player};
		*world.Get<gp::Targetable>(entity) = {Fixed::FromInt(5), gp::target_class::Ground};
		*world.Get<gp::Health>(entity) = {Fixed::FromInt(100), Fixed::FromInt(100)};
		world.Get<gp::Armament>(entity)->weapon = gun;
		gp::VisibleObject seen;
		seen.entity = entity;
		seen.player = player;
		seen.transform.position = {Fixed::FromInt(x), Fixed::FromInt(y), {}};
		world.Resource<gp::VisibleObjects>().SlotAt(0).push_back(seen);
		return entity;
	}

	// One frame with the pointer at (x, y), these buttons going down and coming up.
	void Frame(float x, float y, std::uint8_t pressed = 0, std::uint8_t released = 0, bool shift = false)
	{
		PointerInput &pointer = world.Resource<PointerInput>();
		pointer.x = x;
		pointer.y = y;
		pointer.pressed = pressed;
		pointer.released = released;
		pointer.shift = shift;
		pointer.timeMs = static_cast<std::uint32_t>(frame * 33);
		BuildPlacementSystem placement;
		PointerInteractionSystem interaction;
		ecs::SystemRegistry registry;
		registry.Register(placement);
		registry.Register(interaction);
		registry.Finalize(world.Components());
		ecs::Scheduler scheduler(world, registry, engine::jobs::JobSystemConfig{1});
		scheduler.Finalize(engine::time::FixedStep{30});
		scheduler.Execute(engine::time::SimulationTime{++frame, engine::time::FixedStep{30}});
	}

	void Click(float x, float y, std::uint8_t button = pointer_button::Left) { Frame(x, y, button, button); }
	bool IsSelected(ecs::Entity entity) { return world.Side<Selected>().Get(entity) != nullptr; }
	// The pointer resting at (x, y) for a frame: the cursor it gets.
	generalszh::content::MouseCursorKind Hover(float x, float y)
	{
		Frame(x, y);
		return world.Resource<CursorState>().cursor;
	}
	std::array<float, 2> Pixel(float x, float y)
	{
		std::array<float, 2> at{};
		world.Resource<InteractionView>().Project(x, y, 4, at[0], at[1]);
		return at;
	}
};
}

BOOST_AUTO_TEST_SUITE(pointer_interaction)

// SelectionTranslator / CommandTranslator (default mouse setup): a click on a tank of mine selects it; a click on
// the ground moves it there (the point under the pointer on the terrain); a click on an enemy it can shoot orders
// the attack; a right click deselects; a drag selects mine within the box, not the enemy.
BOOST_AUTO_TEST_CASE(clicks_select_move_and_attack_and_a_drag_box_selects)
{
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity second = field.Tank(130, 100, 0);
	const ecs::Entity enemy = field.Tank(150, 100, 1);
	field.Click(400, 300);
	BOOST_TEST(field.IsSelected(tank));
	BOOST_TEST(!field.IsSelected(second));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.Click(400, 100);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *move = std::get_if<generalszh::commands::MoveTo>(&orders[0]);
	BOOST_TEST_REQUIRE(move != nullptr);
	BOOST_TEST((move->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST(std::abs(Engine::Math::ToFloat(move->destination.x) - 100.0f) < 0.5f);
	BOOST_TEST(std::abs(Engine::Math::ToFloat(move->destination.y) - 186.6f) < 0.5f); // 2/3 of the half view up at 300 deep
	orders.clear();
	float ex = 0, ey = 0;
	field.world.Resource<InteractionView>().Project(150, 100, 4, ex, ey);
	field.Click(ex, ey);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *attack = std::get_if<generalszh::commands::Attack>(&orders[0]);
	BOOST_TEST_REQUIRE(attack != nullptr);
	BOOST_TEST((attack->target == enemy));
	BOOST_TEST(field.IsSelected(tank)); // attacking is not selecting
	orders.clear();
	field.Click(10, 10, pointer_button::Right);
	BOOST_TEST(!field.IsSelected(tank));
	// A drag across all three: my two tanks.
	field.Frame(300, 200, pointer_button::Left);
	field.Frame(560, 400);
	BOOST_TEST(field.world.Resource<SelectionBox>().active);
	field.Frame(560, 400, 0, pointer_button::Left);
	BOOST_TEST(field.IsSelected(tank));
	BOOST_TEST(field.IsSelected(second));
	BOOST_TEST(!field.IsSelected(enemy));
	BOOST_TEST(orders.empty());
}

// WeaponSet::getAbleToAttackSpecificObject (CMD_FROM_PLAYER): a click on a neutral object orders no attack, unless a
// script or the map made it player-targetable (OBJECT_STATUS_SCRIPT_TARGETABLE); an ally's never.
BOOST_AUTO_TEST_CASE(legacy_parity_a_player_targetable_object_can_be_attacked_when_not_an_enemys)
{
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity other = field.Tank(150, 100, 1);
	auto &relationships = field.world.Resource<gp::Relationships>();
	relationships.Set(0, 1, gp::Relationship::Neutral);
	field.Click(400, 300);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	float ex = 0, ey = 0;
	field.world.Resource<InteractionView>().Project(150, 100, 4, ex, ey);
	field.Click(ex, ey);
	BOOST_TEST(orders.empty());
	field.world.Add<gp::ScriptStatus>(other);
	field.world.Get<gp::ScriptStatus>(other)->Set(gp::script_status::Targetable, true);
	field.Click(400, 300); // the neutral one was selected instead
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	field.Click(ex, ey);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *attack = std::get_if<generalszh::commands::Attack>(&orders[0]);
	BOOST_TEST_REQUIRE(attack != nullptr);
	BOOST_TEST((attack->target == other));
	orders.clear();
	relationships.Set(0, 1, gp::Relationship::Allies);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	field.Click(ex, ey);
	BOOST_TEST(orders.empty());
}

// InGameUI's MOUSEMODE_BUILD_PLACE (handleBuildPlacements / getPlacementPoints): the ghost follows the ground under
// the pointer; the left button anchors it, a drag turns it to face along the drag, and the release orders the build
// at the anchor (DozerAIUpdate::construct through the command bus); the clicks neither select nor move. An illegal
// place only drops the anchor; a right click gives placing up without ordering or deselecting.
BOOST_AUTO_TEST_CASE(placing_a_structure_anchors_turns_and_orders_the_build)
{
	Field field;
	const ecs::Entity worker = field.Tank(100, 100, 0);
	field.Click(400, 300);
	BOOST_TEST_REQUIRE(field.IsSelected(worker));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	BuildPlacement &placement = field.world.Resource<BuildPlacement>();
	placement.active = true;
	placement.structure = "GLABarracks";
	placement.builder = worker;
	placement.legal = true;
	float ax = 0, ay = 0, bx = 0, by = 0;
	InteractionView &view = field.world.Resource<InteractionView>();
	view.Project(80, 120, 0, ax, ay);
	view.Project(80, 160, 0, bx, by);
	field.Frame(ax, ay);
	BOOST_TEST(placement.onGround);
	BOOST_TEST(std::abs(placement.at[0] - 80.0f) < 0.5f);
	BOOST_TEST(std::abs(placement.at[1] - 120.0f) < 0.5f);
	field.Frame(ax, ay, pointer_button::Left);
	BOOST_TEST(placement.anchored);
	field.Frame(bx, by); // dragged north: faces +y
	BOOST_TEST(std::abs(placement.at[1] - 120.0f) < 0.5f);
	BOOST_TEST(std::abs(placement.facing - 1.5708f) < 0.01f);
	BOOST_TEST(!field.world.Resource<SelectionBox>().active);
	field.Frame(bx, by, 0, pointer_button::Left);
	BOOST_TEST(!placement.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *build = std::get_if<generalszh::commands::BuildStructure>(&orders[0]);
	BOOST_TEST_REQUIRE(build != nullptr);
	BOOST_TEST((build->builder == worker));
	BOOST_TEST(build->structure == "GLABarracks");
	BOOST_TEST(std::abs(Engine::Math::ToFloat(build->position.x) - 80.0f) < 0.5f);
	BOOST_TEST(std::abs(Engine::Math::ToFloat(build->position.y) - 120.0f) < 0.5f);
	BOOST_TEST(build->facing == 0x40000000u); // a quarter turn
	BOOST_TEST(field.IsSelected(worker));
	orders.clear();

	// Illegal: the release only lets go of the anchor; placing goes on.
	placement.active = true;
	placement.builder = worker;
	placement.legal = false;
	field.Click(ax, ay);
	BOOST_TEST(placement.active);
	BOOST_TEST(!placement.anchored);
	BOOST_TEST(orders.empty());
	// The right button gives up: no move, still selected.
	field.Click(ax, ay, pointer_button::Right);
	BOOST_TEST(!placement.active);
	BOOST_TEST(orders.empty());
	BOOST_TEST(field.IsSelected(worker));
}

// CommandTranslator::evaluateContextCommand (ACTIONTYPE_GET_REPAIRED_AT, SELECTION_ANY): with a damaged tank selected,
// a click on the player's repair pad orders it repaired there (MSG_GET_REPAIRED) instead of selecting the pad; whole,
// the click selects the pad.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_a_repair_pad_sends_a_damaged_vehicle_to_it)
{
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	catalog.byDefinition = {SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f},
		SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure | select_kind::RepairPad), 8.0f, 4.0f}};
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity pad = field.Tank(150, 100, 0);
	field.world.Add<gp::DefinitionRef>(tank);
	field.world.Add<gp::DefinitionRef>(pad);
	field.world.Get<gp::DefinitionRef>(pad)->index = 1;
	field.world.Resource<gp::VisibleObjects>().SlotAt(0)[1].definition = 1;
	field.Click(400, 300);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	field.world.Get<gp::Health>(tank)->current = Fixed::FromInt(40);
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	float ex = 0, ey = 0;
	field.world.Resource<InteractionView>().Project(150, 100, 4, ex, ey);
	field.Click(ex, ey);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *repair = std::get_if<generalszh::commands::GetRepaired>(&orders[0]);
	BOOST_TEST_REQUIRE(repair != nullptr);
	BOOST_TEST((repair->depot == pad));
	BOOST_TEST((repair->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST(!field.IsSelected(pad));
	orders.clear();
	field.world.Get<gp::Health>(tank)->current = Fixed::FromInt(100);
	field.Click(ex, ey);
	BOOST_TEST(orders.empty());
	BOOST_TEST(field.IsSelected(pad));
}

// CommandTranslator::evaluateContextCommand (ACTIONTYPE_CONVERT_OBJECT_TO_CARBOMB before ACTIONTYPE_ATTACK_OBJECT):
// with a terrorist selected, a click on an enemy car it may make a car bomb (VEHICLE, as its collide requires) sends it
// in (MSG_ENTER) rather than attacking; a car already on its CARBOMB set is attacked.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_a_car_sends_a_terrorist_to_make_it_a_car_bomb)
{
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook terrorist{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Infantry), 8.0f, 4.0f};
	terrorist.carBomber = 0;
	SelectionLook car{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f};
	car.carBombable = true;
	catalog.byDefinition = {terrorist, car};
	generalszh::content::KindOfMask vehicle{};
	vehicle[generalszh::content::KindOfBit("VEHICLE") / 64] |= std::uint64_t{1} << (generalszh::content::KindOfBit("VEHICLE") % 64);
	catalog.kinds = {generalszh::content::KindOfMask{}, vehicle};
	catalog.carBombers = {CarBomberKinds{vehicle, {}}};
	const ecs::Entity bomber = field.Tank(100, 100, 0);
	const ecs::Entity target = field.Tank(150, 100, 1);
	field.world.Add<gp::DefinitionRef>(bomber);
	field.world.Add<gp::DefinitionRef>(target);
	field.world.Get<gp::DefinitionRef>(target)->index = 1;
	field.world.Resource<gp::VisibleObjects>().SlotAt(0)[1].definition = 1;
	field.Click(400, 300);
	BOOST_TEST_REQUIRE(field.IsSelected(bomber));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	float ex = 0, ey = 0;
	field.world.Resource<InteractionView>().Project(150, 100, 4, ex, ey);
	field.Click(ex, ey);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *enter = std::get_if<generalszh::commands::Enter>(&orders[0]);
	BOOST_TEST_REQUIRE(enter != nullptr);
	BOOST_TEST((enter->target == target));
	BOOST_TEST((enter->units == std::vector<ecs::Entity>{bomber}));
	orders.clear();
	field.world.Add<gp::Loadout>(target);
	field.world.Get<gp::Loadout>(target)->weaponFlags = generalszh::content::SetFlag(generalszh::content::WeaponSetFlagNames, "CARBOMB");
	field.Click(ex, ey);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::holds_alternative<generalszh::commands::Attack>(orders[0]));
}

// CommandTranslator::evaluateContextCommand (ACTIONTYPE_HIJACK_VEHICLE before ACTIONTYPE_ATTACK_OBJECT) and
// handleHijackVehicleCommand (createEnterMessage): with a hijacker selected, a click on an enemy vehicle its collide
// takes sends it in (MSG_ENTER) rather than attacking; a vehicle already HIJACKED is attacked.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_an_enemy_vehicle_sends_a_hijacker_in)
{
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	SelectionLook jacker{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Infantry), 8.0f, 4.0f};
	jacker.hijacker = 0;
	SelectionLook tank{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Vehicle), 8.0f, 4.0f};
	catalog.byDefinition = {jacker, tank};
	generalszh::content::KindOfMask vehicle{};
	vehicle[generalszh::content::KindOfBit("VEHICLE") / 64] |= std::uint64_t{1} << (generalszh::content::KindOfBit("VEHICLE") % 64);
	catalog.kinds = {generalszh::content::KindOfMask{}, vehicle};
	catalog.hijackers = {CarBomberKinds{vehicle, {}}};
	const ecs::Entity hijacker = field.Tank(100, 100, 0);
	const ecs::Entity target = field.Tank(150, 100, 1);
	field.world.Add<gp::DefinitionRef>(hijacker);
	field.world.Add<gp::DefinitionRef>(target);
	field.world.Get<gp::DefinitionRef>(target)->index = 1;
	field.world.Resource<gp::VisibleObjects>().SlotAt(0)[1].definition = 1;
	field.Click(400, 300);
	BOOST_TEST_REQUIRE(field.IsSelected(hijacker));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	float ex = 0, ey = 0;
	field.world.Resource<InteractionView>().Project(150, 100, 4, ex, ey);
	field.Click(ex, ey);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *enter = std::get_if<generalszh::commands::Enter>(&orders[0]);
	BOOST_TEST_REQUIRE(enter != nullptr);
	BOOST_TEST((enter->target == target));
	orders.clear();
	field.world.Add<gp::StatusFlags>(target);
	field.world.Get<gp::StatusFlags>(target)->bits = std::uint64_t{1} << generalszh::content::ObjectStatusBit("HIJACKED");
	field.Click(ex, ey);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::holds_alternative<generalszh::commands::Attack>(orders[0]));
}

// CommandTranslator::evaluateContextCommand (canSelectedObjectsOverrideSpecialPowerDestination before every other context
// command) and handleSpecialPowerOverrideDestinationCommand: with a Particle Cannon of mine selected while its beam is
// firing, a click on the ground drives the beam there (MSG_DO_SPECIAL_POWER_OVERRIDE_DESTINATION for the selection),
// even over an enemy; not where the ground is black to its player (canOverrideSpecialPowerDestination: the enemy is
// attacked instead), nor while it is only charging (a plain move).
BOOST_AUTO_TEST_CASE(legacy_parity_a_firing_particle_cannon_is_driven_by_clicks)
{
	Field field;
	const ecs::Entity uplink = field.Tank(100, 100, 0);
	field.Tank(100, 186, 1); // an enemy under the second click
	field.world.Add<generalszh::gameplay::ParticleCannon>(uplink);
	auto &cannon = *field.world.Get<generalszh::gameplay::ParticleCannon>(uplink);
	cannon.status = generalszh::gameplay::CannonStatus::Firing;
	field.Click(400, 300);
	BOOST_TEST_REQUIRE(field.IsSelected(uplink));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	auto &shroud = field.world.Resource<gp::ShroudMap>();
	field.Click(400, 100); // still black to its player: the enemy there is attacked as usual
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get_if<generalszh::commands::Attack>(&orders[0]) != nullptr);
	orders.clear();
	shroud.RevealAllPermanently(0);
	field.Click(400, 100);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *drive = std::get_if<generalszh::commands::SpecialPowerDestination>(&orders[0]);
	BOOST_TEST_REQUIRE(drive != nullptr);
	BOOST_TEST((drive->units == std::vector<ecs::Entity>{uplink}));
	BOOST_TEST(std::abs(Engine::Math::ToFloat(drive->position.y) - 186.6f) < 0.5f);
	BOOST_TEST(field.IsSelected(uplink));
	orders.clear();
	cannon.status = generalszh::gameplay::CannonStatus::Charging;
	field.Click(400, 50);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST(std::get_if<generalszh::commands::SpecialPowerDestination>(&orders[0]) == nullptr);
}

// CommandTranslator's hints (MSG_MOUSEOVER_DRAWABLE_HINT / MSG_MOUSEOVER_LOCATION_HINT: evaluateContextCommand, or
// evaluateForceAttack, with DO_HINT) as InGameUI::createMouseoverHint and createCommandHint turn them into the cursor,
// with ActionManager::getCanAttackObject's results (WeaponSet::getAbleToAttackSpecificObject: POSSIBLE within the
// current weapon's range between the bounding circles, POSSIBLE_AFTER_MOVING beyond it, INVALID_SHOT with no weapon for
// the target's kind): nothing selected, one of mine may be selected (SELECTING), anything else is the arrow; with a
// tank of mine selected the ground is a move (MOVETO), an enemy in range an attack (ATTACK_OBJECT), one out of range
// OUTRANGE, one black to the player a move, an aircraft its rifle cannot hit GENERIC_INVALID; force-attacking, the
// ground and objects are FORCE_ATTACK_GROUND / FORCE_ATTACK_OBJECT; a window under the pointer is the arrow; scrolling
// (InGameUI::setScrolling) is SCROLL, turned by W3DMouse::setCursorDirection (frame 0 right, clockwise: up is 6 of 8).
BOOST_AUTO_TEST_CASE(legacy_parity_the_cursor_shows_what_a_click_would_do)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	field.Tank(150, 100, 1);             // 50 apart: within 100 + 5 + 5
	field.Tank(100, 220, 1);             // 120 apart: beyond it
	const ecs::Entity jet = field.Tank(40, 100, 1);
	field.world.Get<gp::Targetable>(jet)->classes = gp::target_class::AirborneVehicle;
	const auto mineAt = field.Pixel(100, 100), nearAt = field.Pixel(150, 100), farAt = field.Pixel(100, 220), jetAt = field.Pixel(40, 100);
	BOOST_TEST((field.Hover(mineAt[0], mineAt[1]) == Cursor::Select));
	BOOST_TEST((field.Hover(nearAt[0], nearAt[1]) == Cursor::Arrow));
	BOOST_TEST((field.Hover(400, 60) == Cursor::Arrow));
	field.Click(mineAt[0], mineAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	BOOST_TEST((field.Hover(400, 60) == Cursor::Move));
	BOOST_TEST((field.Hover(nearAt[0], nearAt[1]) == Cursor::Move)); // still black to the player
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	BOOST_TEST((field.Hover(nearAt[0], nearAt[1]) == Cursor::AttackObj));
	BOOST_TEST((field.Hover(farAt[0], farAt[1]) == Cursor::OutRange));
	BOOST_TEST((field.Hover(jetAt[0], jetAt[1]) == Cursor::GenericInvalid));
	BOOST_TEST((field.Hover(mineAt[0], mineAt[1]) == Cursor::Select));
	PointerInput &pointer = field.world.Resource<PointerInput>();
	pointer.ctrl = true;
	BOOST_TEST((field.Hover(400, 60) == Cursor::ForceAttackGround));
	BOOST_TEST((field.Hover(nearAt[0], nearAt[1]) == Cursor::ForceAttackObj));
	pointer.ctrl = false;
	pointer.overInterface = true;
	BOOST_TEST((field.Hover(nearAt[0], nearAt[1]) == Cursor::Arrow));
	pointer.overInterface = false;
	pointer.scrolling = true;
	pointer.scrollX = 0;
	pointer.scrollY = -10; // up the screen
	BOOST_TEST((field.Hover(400, 60) == Cursor::Scroll));
	BOOST_TEST(field.world.Resource<CursorState>().direction == 6);
	pointer.scrollX = 10;
	pointer.scrollY = 10; // down and right: 45 degrees clockwise from right
	field.Hover(400, 60);
	BOOST_TEST(field.world.Resource<CursorState>().direction == 1);
	pointer.scrolling = false;
	BOOST_TEST((field.Hover(400, 60) == Cursor::Move));
	BOOST_TEST(field.world.Resource<CursorState>().direction == 0);
}

// SelectionTranslator / evaluateContextCommand: a click on something the selection could shoot at but has no weapon
// for (INVALID_SHOT: handleInvalidShotCommand, a command all the same) neither selects it nor orders anything.
BOOST_AUTO_TEST_CASE(legacy_parity_a_click_on_what_the_selection_cannot_hit_does_nothing)
{
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity jet = field.Tank(150, 100, 1);
	field.world.Get<gp::Targetable>(jet)->classes = gp::target_class::AirborneVehicle;
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	const auto mineAt = field.Pixel(100, 100), jetAt = field.Pixel(150, 100);
	field.Click(mineAt[0], mineAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	field.Click(jetAt[0], jetAt[1]);
	BOOST_TEST(field.IsSelected(tank));
	BOOST_TEST(!field.IsSelected(jet));
	BOOST_TEST(field.world.Resource<PlayerOrders>().pending.empty());
}

// InGameUI::setGUICommand / CommandTranslator::handleGuiCommand (GUI_COMMAND_SPECIAL_POWER, NEED_TARGET_POS) with
// ActionManager::canDoSpecialPowerAtLocation (SPECIAL_PARTICLE_UPLINK_CANNON: not where the ground is black to its
// player) and SelectionTranslator: waiting for its target, the uplink shows the button's invalid cursor over black
// ground and its cursor over seen ground; a click on black ground does nothing, a click on seen ground fires the power
// there (MSG_DO_SPECIAL_POWER_AT_LOCATION) and ends the wait; clicks select nothing meanwhile; a right click gives a
// waiting command up without deselecting.
BOOST_AUTO_TEST_CASE(legacy_parity_a_special_power_waits_for_a_spot_its_player_can_see)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	const ecs::Entity uplink = field.Tank(100, 100, 0);
	const ecs::Entity other = field.Tank(130, 100, 0);
	const auto uplinkAt = field.Pixel(100, 100), otherAt = field.Pixel(130, 100);
	field.Click(uplinkAt[0], uplinkAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(uplink));
	GuiTargeting &targeting = field.world.Resource<GuiTargeting>();
	const auto wait = [&] {
		targeting = GuiTargeting{true, uplink, "SuperweaponParticleUplinkCannon", "SPECIAL_PARTICLE_UPLINK_CANNON",
			generalszh::content::button_option::NeedTargetPos, Cursor::ParticleUplinkCannon, Cursor::GenericInvalid};
	};
	wait();
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	BOOST_TEST((field.Hover(400, 60) == Cursor::GenericInvalid)); // black to its player
	field.Click(400, 60);
	BOOST_TEST(orders.empty());
	BOOST_TEST(targeting.active);
	field.world.Resource<gp::ShroudMap>().RevealAllPermanently(0);
	BOOST_TEST((field.Hover(400, 60) == Cursor::ParticleUplinkCannon));
	field.Click(otherAt[0], otherAt[1]); // over one of mine: not selected, the power goes where the pointer meets the ground
	BOOST_TEST(!field.IsSelected(other));
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *fire = std::get_if<generalszh::commands::UseSpecialPower>(&orders[0]);
	BOOST_TEST_REQUIRE(fire != nullptr);
	BOOST_TEST((fire->source == uplink));
	BOOST_TEST(fire->power == "SuperweaponParticleUplinkCannon");
	BOOST_TEST(fire->atLocation);
	BOOST_TEST(std::abs(Engine::Math::ToFloat(fire->target.x) - 130.0f) < 1.0f);
	BOOST_TEST(!targeting.active);
	orders.clear();
	wait();
	field.Click(10, 10, pointer_button::Right);
	BOOST_TEST(!targeting.active);
	BOOST_TEST(field.IsSelected(uplink));
	BOOST_TEST(orders.empty());
}

// ActionManager::canDoSpecialPowerAtLocation (GeneralsMD/Code/GameEngine/Source/Common/RTS/ActionManager.cpp): a
// paradrop not onto water (isUnderwater), whatever the shroud allows; a spy satellite anywhere inside the map's extent,
// its edge excluded (isPointOnMap), shroud or not; a power needing an object (a cash hack) never at a spot; one not
// listed (a plain OCL power name) never either.
BOOST_AUTO_TEST_CASE(legacy_parity_special_powers_go_only_where_the_original_lets_them)
{
	Field field;
	auto &ground = field.world.Resource<gp::GroundHeight>();
	ground.AddWater({{Fixed::FromInt(0), Fixed::FromInt(0)}, {Fixed::FromInt(100), Fixed::FromInt(0)}, {Fixed::FromInt(100), Fixed::FromInt(100)},
		{Fixed::FromInt(0), Fixed::FromInt(100)}}, Fixed::FromInt(5));
	auto &shroud = field.world.Resource<gp::ShroudMap>();
	shroud.RevealAllPermanently(0);
	using generalszh::gameplay::CanDoSpecialPowerAtLocation;
	const Engine::Math::FixedVector2 wet{Fixed::FromInt(50), Fixed::FromInt(50)}, dry{Fixed::FromInt(500), Fixed::FromInt(500)};
	BOOST_TEST(!CanDoSpecialPowerAtLocation("SPECIAL_PARADROP_AMERICA", 0, wet, ground, shroud));
	BOOST_TEST(CanDoSpecialPowerAtLocation("SPECIAL_PARADROP_AMERICA", 0, dry, ground, shroud));
	BOOST_TEST(CanDoSpecialPowerAtLocation("SPECIAL_DAISY_CUTTER", 0, wet, ground, shroud)); // bombs may fall on water
	const auto [low, high] = ground.Extent();
	BOOST_TEST(CanDoSpecialPowerAtLocation("SPECIAL_SPY_SATELLITE", 1, dry, ground, shroud)); // player 1 sees nothing
	BOOST_TEST(!CanDoSpecialPowerAtLocation("SPECIAL_SPY_SATELLITE", 1, low, ground, shroud));
	BOOST_TEST(!CanDoSpecialPowerAtLocation("SPECIAL_CASH_HACK", 0, dry, ground, shroud));
	BOOST_TEST(!CanDoSpecialPowerAtLocation("SPECIAL_INVALID", 0, dry, ground, shroud));
	BOOST_TEST(CanDoSpecialPowerAtLocation("SPECIAL_LAUNCH_BAIKONUR_ROCKET", 1, low, ground, shroud));
}

// CommandTranslator::handleGuiCommand with COMMAND_OPTION_NEED_OBJECT_TARGET (resolveGuiCommandTarget, then
// canSelectedObjectsDoSpecialPower -> canDoSpecialPowerAtObject, asked of the session by the host): the object under
// the pointer is the candidate; until it is found fit the invalid cursor shows and a click does nothing; once fit, the
// valid cursor, and a click fires the power at it (MSG_DO_SPECIAL_POWER_AT_OBJECT) and ends the wait.
BOOST_AUTO_TEST_CASE(legacy_parity_a_special_power_waits_for_an_object_it_may_be_fired_at)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	const ecs::Entity hacker = field.Tank(100, 100, 0);
	const ecs::Entity centre = field.Tank(150, 100, 1);
	const auto hackerAt = field.Pixel(100, 100), centreAt = field.Pixel(150, 100);
	field.Click(hackerAt[0], hackerAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(hacker));
	GuiTargeting &targeting = field.world.Resource<GuiTargeting>();
	targeting = GuiTargeting{true, hacker, "SuperweaponCashHack", "SPECIAL_CASH_HACK", generalszh::content::button_option::NeedTargetEnemy,
		Cursor::Hack, Cursor::GenericInvalid};
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	BOOST_TEST((field.Hover(centreAt[0], centreAt[1]) == Cursor::GenericInvalid));
	BOOST_TEST((targeting.hovered == centre));
	field.Click(centreAt[0], centreAt[1]);
	BOOST_TEST(orders.empty());
	targeting.validFor = centre; // the host: canDoSpecialPowerAtObject holds
	BOOST_TEST((field.Hover(centreAt[0], centreAt[1]) == Cursor::Hack));
	BOOST_TEST((field.Hover(400, 60) == Cursor::GenericInvalid)); // nothing there
	targeting.validFor = centre;
	field.Click(centreAt[0], centreAt[1]);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *fire = std::get_if<generalszh::commands::UseSpecialPowerAtObject>(&orders[0]);
	BOOST_TEST_REQUIRE(fire != nullptr);
	BOOST_TEST((fire->source == hacker));
	BOOST_TEST((fire->target == centre));
	BOOST_TEST(!targeting.active);
	BOOST_TEST(!field.IsSelected(centre));
}

// GUICommandTranslator (Core/GameEngine/Source/GameClient/MessageStream/GUICommandTranslator.cpp, doGuardCommand) and
// InGameUI::createCommandHint (MOUSEMODE_GUI_COMMAND, not a context command: its CursorName, CROSS without one): the
// shipped Command_Guard (NEED_TARGET_POS) guards the ground clicked with the player's selection (MSG_DO_GUARD_POSITION,
// GUARDMODE_NORMAL) and the wait ends; a guard taking objects (NEED_TARGET_ALLY_OBJECT) guards one of the player's own
// clicked (MSG_DO_GUARD_OBJECT); an enemy clicked is no ally, so without NEED_TARGET_POS it guards where the first
// selected stands.
BOOST_AUTO_TEST_CASE(legacy_parity_a_guard_button_guards_the_spot_or_object_clicked)
{
	using Cursor = generalszh::content::MouseCursorKind;
	namespace bo = generalszh::content::button_option;
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity friendTank = field.Tank(130, 100, 0);
	field.Tank(160, 100, 1);
	const auto tankAt = field.Pixel(100, 100), friendAt = field.Pixel(130, 100), enemyAt = field.Pixel(160, 100);
	field.Click(tankAt[0], tankAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	GuiTargeting &targeting = field.world.Resource<GuiTargeting>();
	const auto guard = [&](std::uint32_t options, std::uint8_t mode) {
		targeting = GuiTargeting{};
		targeting.active = true;
		targeting.source = tank;
		targeting.options = options;
		targeting.kind = GuiCommandKind::Guard;
		targeting.guardMode = mode;
		targeting.invalidCursor = Cursor::GenericInvalid;
	};
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	guard(bo::OkForMultiSelect | bo::NeedTargetPos, 0);
	BOOST_TEST((field.Hover(400, 60) == Cursor::Target));
	field.Click(400, 100);
	BOOST_TEST(!targeting.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *spot = std::get_if<generalszh::commands::GuardPosition>(&orders[0]);
	BOOST_TEST_REQUIRE(spot != nullptr);
	BOOST_TEST((spot->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST(std::abs(Engine::Math::ToFloat(spot->position.y) - 186.6f) < 0.5f);
	BOOST_TEST(spot->mode == 0u);
	orders.clear();
	guard(bo::NeedTargetAlly, 1);
	field.Click(friendAt[0], friendAt[1]);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *object = std::get_if<generalszh::commands::GuardObject>(&orders[0]);
	BOOST_TEST_REQUIRE(object != nullptr);
	BOOST_TEST((object->target == friendTank));
	BOOST_TEST(object->mode == 1u);
	BOOST_TEST(field.IsSelected(tank));
	BOOST_TEST(!field.IsSelected(friendTank));
	orders.clear();
	guard(bo::NeedTargetAlly, 2);
	field.Click(enemyAt[0], enemyAt[1]);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *stand = std::get_if<generalszh::commands::GuardPosition>(&orders[0]);
	BOOST_TEST_REQUIRE(stand != nullptr);
	BOOST_TEST((stand->position == Engine::Math::FixedVector2{Fixed::FromInt(100), Fixed::FromInt(100)}));
	BOOST_TEST(stand->mode == 2u);
}

// CommandTranslator::evaluateContextCommand (ACTIONTYPE_SET_RALLY_POINT, SELECTION_ALL: every selected one AUTO_RALLYPOINT
// and the player's, nothing under the pointer) / handleSetRallyPointCommand, InGameUI::createCommandHint
// (MSG_SET_RALLY_POINT_HINT: SET_RALLY_POINT) and GUICommandTranslator::doSetRallyPointCommand: with a factory of the
// player's selected, the ground shows the rally cursor and a click sets its rally point there (MSG_SET_RALLY_POINT);
// with a tank also selected it is a move again; the Command_SetRallyPoint button sets it the same way and ends its wait.
BOOST_AUTO_TEST_CASE(legacy_parity_a_factory_selected_sets_its_rally_point_where_the_ground_is_clicked)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	auto &catalog = field.world.Resource<SelectionCatalog>();
	catalog.byDefinition.push_back(SelectionLook{static_cast<std::uint16_t>(select_kind::Selectable | select_kind::Structure), 8.0f, 4.0f});
	generalszh::content::KindOfMask rally{};
	rally[generalszh::content::KindOfBit("AUTO_RALLYPOINT") / 64] |= std::uint64_t{1} << (generalszh::content::KindOfBit("AUTO_RALLYPOINT") % 64);
	catalog.kinds = {generalszh::content::KindOfMask{}, rally};
	const ecs::Entity barracks = field.Tank(100, 100, 0);
	field.world.Add<gp::DefinitionRef>(barracks);
	field.world.Get<gp::DefinitionRef>(barracks)->index = 1;
	field.world.Resource<gp::VisibleObjects>().SlotAt(0)[0].definition = 1;
	const ecs::Entity tank = field.Tank(130, 100, 0);
	const auto barracksAt = field.Pixel(100, 100), tankAt = field.Pixel(130, 100);
	field.Click(barracksAt[0], barracksAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(barracks));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	BOOST_TEST((field.Hover(400, 60) == Cursor::SetRallyPoint));
	field.Click(400, 100);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *rallyOrder = std::get_if<generalszh::commands::SetRallyPoint>(&orders[0]);
	BOOST_TEST_REQUIRE(rallyOrder != nullptr);
	BOOST_TEST((rallyOrder->factory == barracks));
	BOOST_TEST(std::abs(Engine::Math::ToFloat(rallyOrder->position.y) - 186.6f) < 0.5f);
	orders.clear();
	field.Frame(tankAt[0], tankAt[1], pointer_button::Left, pointer_button::Left, true); // prefer-selection adds the tank
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	BOOST_TEST((field.Hover(400, 60) == Cursor::Move));
	field.Click(10, 10, pointer_button::Right);
	field.Click(barracksAt[0], barracksAt[1]);
	GuiTargeting &targeting = field.world.Resource<GuiTargeting>();
	targeting = GuiTargeting{};
	targeting.active = true;
	targeting.source = barracks;
	targeting.options = generalszh::content::button_option::NeedTargetPos;
	targeting.kind = GuiCommandKind::RallyPoint;
	targeting.cursor = Cursor::SetRallyPoint;
	BOOST_TEST((field.Hover(400, 60) == Cursor::SetRallyPoint));
	field.Click(400, 100);
	BOOST_TEST(!targeting.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	BOOST_TEST((std::get_if<generalszh::commands::SetRallyPoint>(&orders[0]) != nullptr));
}

// GUICommandTranslator::doAttackMoveCommand and InGameUI::createCommandHint (MOUSEMODE_GUI_COMMAND: Command_AttackMove's
// CursorName AttackMove): waiting, the pointer shows AttackMove; a click on the ground sends the player's selection
// attack-moving there (MSG_DO_ATTACKMOVETO) and ends the wait.
BOOST_AUTO_TEST_CASE(legacy_parity_the_attack_move_button_sends_the_selection_attack_moving)
{
	using Cursor = generalszh::content::MouseCursorKind;
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const auto tankAt = field.Pixel(100, 100);
	field.Click(tankAt[0], tankAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	GuiTargeting &targeting = field.world.Resource<GuiTargeting>();
	targeting = GuiTargeting{};
	targeting.active = true;
	targeting.source = tank;
	targeting.options = generalszh::content::button_option::NeedTargetPos;
	targeting.kind = GuiCommandKind::AttackMove;
	targeting.cursor = Cursor::AttackMove;
	BOOST_TEST((field.Hover(400, 60) == Cursor::AttackMove));
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	field.Click(400, 100);
	BOOST_TEST(!targeting.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *move = std::get_if<generalszh::commands::AttackMoveTo>(&orders[0]);
	BOOST_TEST_REQUIRE(move != nullptr);
	BOOST_TEST((move->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST(std::abs(Engine::Math::ToFloat(move->position.y) - 186.6f) < 0.5f);
}

// FIRE_WEAPON waiting for its target. GUICommandTranslator::doFireWeaponCommand (Command_ChinaDragonTankFireWall:
// NEED_TARGET_POS): a click on the ground fires the button's slot there (MSG_DO_WEAPON_AT_LOCATION) and ends the wait.
// A context command (CONTEXTMODE_COMMAND, Command_ColonelBurtonKnifeAttack: an enemy's or a neutral's object) goes
// through handleGuiCommand: InGameUI::canSelectedObjectsEffectivelyUseWeapon (ActionManager::canFireWeaponAtObject)
// shows its cursor over an enemy its slot's weapon can attack, the invalid one elsewhere (the ground, its own, a slot
// with no weapon); only a click on a valid target fires (MSG_DO_WEAPON_AT_OBJECT), with its MaxShotsToFire.
BOOST_AUTO_TEST_CASE(legacy_parity_a_fire_weapon_button_fires_at_what_it_is_aimed_at)
{
	using Cursor = generalszh::content::MouseCursorKind;
	namespace bo = generalszh::content::button_option;
	Field field;
	const ecs::Entity tank = field.Tank(100, 100, 0);
	const ecs::Entity enemy = field.Tank(150, 100, 1);
	const auto tankAt = field.Pixel(100, 100);
	field.Click(tankAt[0], tankAt[1]);
	BOOST_TEST_REQUIRE(field.IsSelected(tank));
	GuiTargeting &targeting = field.world.Resource<GuiTargeting>();
	auto &orders = field.world.Resource<PlayerOrders>().pending;
	const auto wait = [&](std::uint32_t options, std::uint8_t slot, std::uint32_t shots) {
		targeting = GuiTargeting{};
		targeting.active = true;
		targeting.source = tank;
		targeting.options = options;
		targeting.kind = GuiCommandKind::FireWeapon;
		targeting.cursor = Cursor::StabAttack;
		targeting.invalidCursor = Cursor::StabAttackInvalid;
		targeting.weaponSlot = slot;
		targeting.maxShots = shots;
	};
	wait(bo::NeedTargetPos | bo::OkForMultiSelect, 1, 0);
	BOOST_TEST((field.Hover(400, 60) == Cursor::StabAttack));
	field.Click(400, 100);
	BOOST_TEST(!targeting.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	const auto *fire = std::get_if<generalszh::commands::FireWeapon>(&orders[0]);
	BOOST_TEST_REQUIRE(fire != nullptr);
	BOOST_TEST((fire->units == std::vector<ecs::Entity>{tank}));
	BOOST_TEST(fire->slot == 1);
	BOOST_TEST(fire->at == 1);
	BOOST_TEST(std::abs(Engine::Math::ToFloat(fire->position.y) - 186.6f) < 0.5f);
	orders.clear();
	wait(bo::NeedTargetEnemy | bo::NeedTargetNeutral | bo::ContextModeCommand, 0, 1);
	const auto enemyAt = field.Pixel(150, 100);
	BOOST_TEST((field.Hover(enemyAt[0], enemyAt[1]) == Cursor::StabAttack));
	BOOST_TEST((field.Hover(400, 60) == Cursor::StabAttackInvalid));
	BOOST_TEST((field.Hover(tankAt[0], tankAt[1]) == Cursor::StabAttackInvalid));
	field.Click(400, 100);
	BOOST_TEST(targeting.active);
	BOOST_TEST(orders.empty());
	targeting.weaponSlot = 1;
	BOOST_TEST((field.Hover(enemyAt[0], enemyAt[1]) == Cursor::StabAttackInvalid));
	targeting.weaponSlot = 0;
	field.Click(enemyAt[0], enemyAt[1]);
	BOOST_TEST(!targeting.active);
	BOOST_TEST_REQUIRE(orders.size() == 1u);
	fire = std::get_if<generalszh::commands::FireWeapon>(&orders[0]);
	BOOST_TEST_REQUIRE(fire != nullptr);
	BOOST_TEST(fire->at == 2);
	BOOST_TEST((fire->target == enemy));
	BOOST_TEST(fire->maxShots == 1u);
}

BOOST_AUTO_TEST_SUITE_END()
