#include <boost/test/unit_test.hpp>

import std;

import games.generalszh.presentation.rendering.infantry_lighting;

using namespace generalszh::presentation;

BOOST_AUTO_TEST_SUITE(infantry_lighting)

// legacy_parity: RTS3DScene::updateFixedLightEnvironments: the infantry light scale is the script's override
// (doSetInfantryLightingOverride; RESET sets -1, which means none) or else GameData's InfantryLight<TimeOfDay>Scale for
// the time of day (GlobalData's default 1.5 for each); each global light's diffuse times it, clamped to -1..1 per
// channel: 0.4 x 1.5 = 0.6, 0.8 x 1.5 = 1.2 clamped to 1; the shipped GameData.ini's evening scale of 200 turns any lit
// channel full.
BOOST_AUTO_TEST_CASE(legacy_parity_infantry_lights_are_the_scenes_scaled_and_clamped)
{
	const std::array<float, 4> scales{1.5f, 1.5f, 200.0f, 200.0f};
	BOOST_TEST(InfantryLightScale(-1.0f, scales, 0) == 1.5f);
	BOOST_TEST(InfantryLightScale(-1.0f, scales, 2) == 200.0f);
	BOOST_TEST(InfantryLightScale(0.5f, scales, 2) == 0.5f);
	const std::array<float, 3> lit = InfantryLightColor({0.4f, 0.8f, 0.0f}, 1.5f);
	BOOST_TEST(lit[0] == 0.4f * 1.5f);
	BOOST_TEST(lit[1] == 1.0f);
	BOOST_TEST(lit[2] == 0.0f);
	const std::array<float, 3> evening = InfantryLightColor({0.1f, 0.05f, 0.2f}, 200.0f);
	BOOST_TEST(evening[0] == 1.0f);
	BOOST_TEST(evening[1] == 1.0f);
	BOOST_TEST(evening[2] == 1.0f);
	const std::array<float, 3> dimmed = InfantryLightColor({0.4f, 0.8f, 0.2f}, 0.5f);
	BOOST_TEST(dimmed[1] == 0.4f);
}

BOOST_AUTO_TEST_SUITE_END()
