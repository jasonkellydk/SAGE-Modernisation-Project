// doPlayerEnableFactories / doPlayerDisableFactories (player, object type), doNamedSetStoppingDistance and
// doSetStoppingDistance (unit or team, distance) and doTeamEnableStealth (team, enabled) reach the host as such.
BOOST_AUTO_TEST_CASE(legacy_parity_factory_and_stopping_distance_actions_reach_the_host)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script script;
	script.name = "switches";
	script.oneShot = true;
	script.conditions = {{Call("CONDITION_TRUE", {})}};
	level::ScriptCall named = Call("NAMED_SET_STOPPING_DISTANCE", {"Tank", ""});
	named.parameters[1].number = Engine::Math::Fixed::FromInt(25);
	level::ScriptCall team = Call("SET_STOPPING_DISTANCE", {"Squad", ""});
	team.parameters[1].number = Engine::Math::Fixed::FromInt(40);
	level::ScriptCall stealth = Call("TEAM_SET_STEALTH_ENABLED", {"Squad", ""});
	stealth.parameters[1].integer = 0;
	script.actions = {Call("PLAYER_DISABLE_FACTORIES", {"<This Player>", "AmericaBarracks"}), Call("PLAYER_ENABLE_FACTORIES", {"<This Player>", "AmericaBarracks"}),
		named, team, stealth};
	participant.scripts.scripts.push_back(script);
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	const std::vector<std::string> expected{"me disables AmericaBarracks", "me enables AmericaBarracks", "Tank stops within 25", "Squad stop within 40",
		"Squad may not stealth"};
	BOOST_TEST(host.calls == expected, boost::test_tools::per_element());
	BOOST_TEST(runtime.UnknownActions().empty());
}

