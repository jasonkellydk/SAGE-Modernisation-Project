// Records the unit actions the scripts ask for.
struct RecordingHost final : generalszh::scripting::UnitScriptHost
{
	std::vector<std::string> calls;

	void CreateNamedOnTeam(const std::string &, const std::string &, const std::string &, const std::string &) override {}
	void DeleteNamed(const std::string &) override {}
	void KillNamed(const std::string &) override {}
	void NamedFollowWaypoints(const std::string &, const std::string &) override {}
	void MoveNamedTo(const std::string &, const std::string &) override {}
	void CreateReinforcements(const std::string &, const std::string &) override {}
	void TeamFollowWaypoints(const std::string &, const std::string &, bool) override {}
	void TeamFollowApproachPath(std::size_t, const std::string &team, const std::string &path, bool asTeam) override
	{
		calls.push_back(team + " follows " + path + (asTeam ? " as team" : ""));
	}
	void TeamMoveToApproachPath(std::size_t, const std::string &team, const std::string &path) override { calls.push_back(team + " moves to " + path); }
	void TeamCaptureNearestUnowned(const std::string &team) override { calls.push_back(team + " captures nearest unmanned"); }
	void TeamGuardInTunnelNetwork(const std::string &team) override { calls.push_back(team + " guards tunnels"); }
	void NamedHunt(const std::string &unit) override { calls.push_back(unit + " hunts"); }
	void HumansIdleOrResume(bool idle) override { calls.push_back(idle ? "humans idle" : "humans resume"); }
	void TeamWander(const std::string &team, const std::string &path, bool panic) override { calls.push_back(team + (panic ? " panics " : " wanders ") + path); }
	void TeamWanderInPlace(const std::string &team) override { calls.push_back(team + " wanders in place"); }
	std::string UnitReference(std::uint64_t subject, const std::string &name) override
	{
		return name == "<This Object>" ? "unit#" + std::to_string(subject & 0xFFFFu) : name;
	}
	std::optional<std::uint64_t> UnitSubject(const std::string &unit) override
	{
		if (unit != "Tank")
			return std::nullopt;
		return (std::uint64_t{1} << 62) | 7u;
	}
	void NamedCustomColor(const std::string &unit, std::uint32_t argb) override { calls.push_back(unit + " colour " + std::to_string(argb)); }
	void AllowBonuses(bool allow) override { calls.push_back(allow ? "bonuses on" : "bonuses off"); }
	void DeleteAllUnmanned() override { calls.push_back("delete unmanned"); }
	void ObjectPanelFlag(const std::string &who, bool team, const std::string &flag, bool value) override
	{
		calls.push_back(who + (team ? " team " : " ") + flag + (value ? " on" : " off"));
	}
	void NamedAttackTeam(const std::string &unit, const std::string &team) override { calls.push_back(unit + " attacks team " + team); }
	void TeamAttackTeam(const std::string &team, const std::string &victims) override { calls.push_back(team + " attacks team " + victims); }
	void ChooseVictimAlwaysUsesNormal(bool enable) override { calls.push_back(std::string("normal victims ") + (enable ? "on" : "off")); }
	void NamedPowerCountdown(const std::string &unit, const std::string &power, int edit, std::int64_t seconds) override
	{
		calls.push_back(unit + " " + power + " " + std::to_string(edit) + " " + std::to_string(seconds));
	}
	void FollowWaypointsExact(const std::string &who, const std::string &path, bool team, bool asTeam) override
	{
		calls.push_back(who + (team ? " team" : "") + " exactly along " + path + (asTeam ? " as team" : ""));
	}
	void TeamAttackNamed(const std::string &team, const std::string &unit) override { calls.push_back(team + " attacks " + unit); }
	void CreateObject(const std::string &name, const std::string &type, const std::string &team, Engine::Math::FixedVector3 at, Engine::Math::Fixed angle) override
	{
		calls.push_back("make " + name + ":" + type + "@" + team + " " + std::to_string(at.x.Floor()) + "," + std::to_string(at.y.Floor()) + " " +
			std::to_string(angle.Floor()));
	}
	void SetRelationOverride(std::size_t, OverrideKind kind, const std::string &from, const std::string &to, std::optional<std::int64_t> relationship) override
	{
		calls.push_back(std::to_string(static_cast<int>(kind)) + " " + from + ">" + to + (relationship ? "=" + std::to_string(*relationship) : " off"));
	}
	void ClearTeamOverrides(const std::string &team) override { calls.push_back(team + " overrides off"); }
	void NamedSetAttitude(const std::string &unit, std::int64_t attitude) override { calls.push_back(unit + " mood " + std::to_string(attitude)); }
	void TeamSetAttitude(const std::string &team, std::int64_t attitude) override { calls.push_back(team + " mood " + std::to_string(attitude)); }
	void TeamDelete(const std::string &) override {}
	void TeamMergeInto(const std::string &, const std::string &) override {}
	bool TeamCreated(const std::string &) const override { return false; }
	std::map<std::string, std::string> states;
	void SetTeamState(const std::string &team, const std::string &state) override { states[team] = state; }
	std::optional<std::string> TeamState(const std::string &team) const override
	{
		const auto found = states.find(team);
		return found != states.end() ? std::optional(found->second) : std::nullopt;
