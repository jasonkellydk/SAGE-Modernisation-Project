// The skirmish area counts reach the host (player, what, types or kind, area) and compare as asked (the host has 2).
BOOST_AUTO_TEST_CASE(legacy_parity_area_counts_reach_the_host)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script script;
	script.name = "counts";
	script.oneShot = true;
	const auto number = [](level::ScriptCall call, std::size_t index, std::int64_t value) {
		call.parameters[index].integer = value;
		return call;
	};
	level::ScriptCall byType = number(number(Call("PLAYER_HAS_COMPARISON_UNIT_TYPE_IN_TRIGGER_AREA", {"<This Player>", "", "", "Tanks", "Gate"}), 1, 3), 2, 2);
	level::ScriptCall byKind = number(number(number(Call("PLAYER_HAS_COMPARISON_UNIT_KIND_IN_TRIGGER_AREA", {"PlyrGLA", "", "", "", "Gate"}), 1, 2), 2, 2), 3, 9);
	level::ScriptCall value = number(number(Call("SKIRMISH_VALUE_IN_AREA", {"PlyrGLA", "", "", "[Skirmish]MyOuterPerimeter"}), 1, 0), 2, 3);
	script.conditions = {{byType, byKind, Call("SKIRMISH_NAMED_AREA_EXIST", {"", "Gate"}), Call("SKIRMISH_PLAYER_HAS_UNITS_IN_AREA", {"PlyrGLA", "Gate"}), value}};
	script.actions = {Call("NAMED_STOP", {"Tank"})};
	level::Script outside = script;
	outside.name = "outside";
	outside.conditions = {{Call("SKIRMISH_PLAYER_IS_OUTSIDE_AREA", {"PlyrGLA", "Gate"})}};
	outside.actions = {Call("NAMED_STOP", {"Never"})};
	participant.scripts.scripts = {script, outside};
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	const std::vector<std::string> expected{"me has 0 Tanks/-1 in Gate", "PlyrGLA has 1 /9 in Gate", "Gate exists", "PlyrGLA has 2 /-1 in Gate",
		"PlyrGLA has 3 /-1 in [Skirmish]MyOuterPerimeter", "Tank stops", "PlyrGLA has 2 /-1 in Gate"};
	BOOST_TEST(host.calls == expected, boost::test_tools::per_element());
	BOOST_TEST(runtime.UnknownConditions().empty());
}

