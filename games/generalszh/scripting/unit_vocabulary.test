level::ScriptCall Call(std::string name, std::vector<std::string> texts)
{
	level::ScriptCall call;
	call.name = std::move(name);
	for (std::string &text : texts)
	{
		level::ScriptParameter parameter;
		parameter.text = std::move(text);
		call.parameters.push_back(std::move(parameter));
	}
	return call;
}
}

BOOST_AUTO_TEST_SUITE(zero_hour_unit_vocabulary)

// ScriptActions::doUnitReceiveUpgrade (NAMED_RECEIVE_UPGRADE: unit name, upgrade name) reaches the host once.
BOOST_AUTO_TEST_CASE(legacy_parity_named_receive_upgrade_gives_the_unit_its_upgrade)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script script;
	script.name = "arm";
	script.oneShot = true;
	script.conditions = {{Call("CONDITION_TRUE", {})}};
	script.actions = {Call("NAMED_RECEIVE_UPGRADE", {"Ranger1", "Upgrade_AmericaChemicalSuits"}),
		Call("AI_PLAYER_BUILD_UPGRADE", {"PlyrChina", "Upgrade_Nationalism"})};
	participant.scripts.scripts.push_back(script);
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	for (std::uint64_t tick = 1; tick <= 5; ++tick)
		runtime.Tick(tick);
	BOOST_TEST_REQUIRE(host.calls.size() == 2u);
	BOOST_TEST(host.calls[0] == "Ranger1 <- Upgrade_AmericaChemicalSuits");
	// ScriptActions::doBuildUpgrade (AI_PLAYER_BUILD_UPGRADE: player, upgrade).
	BOOST_TEST(host.calls[1] == "PlyrChina builds Upgrade_Nationalism");
	BOOST_TEST(runtime.UnknownActions().empty());
}

// ScriptActions' garrison actions (NAMED_ / TEAM_GARRISON_SPECIFIC_BUILDING, NAMED_ / TEAM_GARRISON_NEAREST_BUILDING,
// PLAYER_GARRISON_ALL_BUILDINGS) reach the host with their parameters.
BOOST_AUTO_TEST_CASE(garrison_actions_reach_the_host)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script script;
	script.name = "garrison";
	script.oneShot = true;
	script.conditions = {{Call("CONDITION_TRUE", {})}};
	script.actions = {Call("NAMED_GARRISON_SPECIFIC_BUILDING", {"Ranger1", "Hotel"}), Call("TEAM_GARRISON_SPECIFIC_BUILDING", {"Squad", "Hotel"}),
		Call("NAMED_GARRISON_NEAREST_BUILDING", {"Ranger2"}), Call("TEAM_GARRISON_NEAREST_BUILDING", {"Squad"}),
		Call("PLAYER_GARRISON_ALL_BUILDINGS", {"PlyrGLA"})};
	participant.scripts.scripts.push_back(script);
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	BOOST_TEST_REQUIRE(host.calls.size() == 5u);
	BOOST_TEST(host.calls[0] == "Ranger1 garrisons Hotel");
	BOOST_TEST(host.calls[1] == "Squad garrison Hotel");
	BOOST_TEST(host.calls[2] == "Ranger2 garrisons nearest");
	BOOST_TEST(host.calls[3] == "Squad garrison nearest");
	BOOST_TEST(host.calls[4] == "PlyrGLA garrisons all");
	BOOST_TEST(runtime.UnknownActions().empty());
}

// ScriptActions' stop, damage, kill, transfer and money actions reach the host with their parameters (players as the
// script names them: "<This Player>" its own).
BOOST_AUTO_TEST_CASE(legacy_parity_orders_damage_kills_transfers_and_money_reach_the_host)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script script;
	script.name = "misc";
	script.oneShot = true;
	script.conditions = {{Call("CONDITION_TRUE", {})}};
	const auto withNumbers = [](level::ScriptCall call, std::size_t index, std::int64_t value) {
		call.parameters[index].integer = value;
		call.parameters[index].number = Engine::Math::Fixed::FromInt(value);
		return call;
	};
	script.actions = {Call("NAMED_STOP", {"Tank"}), Call("TEAM_STOP", {"Squad"}), Call("TEAM_STOP_AND_DISBAND", {"Squad"}),
		Call("MOVE_TEAM_TO", {"Squad", "Here"}), withNumbers(Call("NAMED_DAMAGE", {"Tank", ""}), 1, 50),
		withNumbers(Call("DAMAGE_MEMBERS_OF_TEAM", {"Squad", ""}), 1, 25), Call("TEAM_KILL", {"Squad"}), Call("TEAM_DELETE_LIVING", {"Squad"}),
		Call("PLAYER_KILL", {"<This Player>"}), Call("NAMED_TRANSFER_OWNERSHIP_PLAYER", {"Tank", "PlyrGLA"}),
		Call("TEAM_TRANSFER_TO_PLAYER", {"Squad", "<This Player>"}), withNumbers(Call("PLAYER_GIVE_MONEY", {"PlyrGLA", ""}), 1, -300),
		withNumbers(Call("PLAYER_SET_MONEY", {"<This Player>", ""}), 1, 5000)};
	participant.scripts.scripts.push_back(script);
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	const std::vector<std::string> expected{"Tank stops", "Squad stops", "Squad disbands", "Squad to Here", "Tank -50", "Squad -25", "Squad killed",
		"Squad deleted living", "me killed", "Tank to PlyrGLA", "Squad to me", "PlyrGLA +$-300", "me =$5000"};
	BOOST_TEST(host.calls == expected, boost::test_tools::per_element());
	BOOST_TEST(runtime.UnknownActions().empty());
}

