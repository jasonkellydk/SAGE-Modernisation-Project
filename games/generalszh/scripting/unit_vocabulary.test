// ScriptActions::executeAction SKIRMISH_FOLLOW_APPROACH_PATH (team, path, as team: doTeamFollowSkirmishApproachPath) and
// SKIRMISH_MOVE_TO_APPROACH_PATH (team, path: doTeamMoveToSkirmishApproachPath) reach the host with their parameters.
BOOST_AUTO_TEST_CASE(legacy_parity_skirmish_approach_paths_reach_the_host)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script script;
	script.name = "approach";
	script.oneShot = true;
	script.conditions = {{Call("CONDITION_TRUE", {})}};
	auto follow = Call("SKIRMISH_FOLLOW_APPROACH_PATH", {"Squad", "Center", ""});
	follow.parameters[2].integer = 1;
	auto loose = Call("SKIRMISH_FOLLOW_APPROACH_PATH", {"Squad", "Flank", ""});
	loose.parameters[2].integer = 0;
	auto sleepy = Call("NAMED_SET_ATTITUDE", {"Tank", ""});
	sleepy.parameters[1].integer = -2;
	auto angry = Call("TEAM_SET_ATTITUDE", {"Squad", ""});
	angry.parameters[1].integer = 2;
	script.actions = {follow, loose, Call("SKIRMISH_MOVE_TO_APPROACH_PATH", {"Squad", "Backdoor"}), Call("TEAM_CAPTURE_NEAREST_UNOWNED_FACTION_UNIT", {"Squad"}),
		sleepy, angry, Call("TEAM_GUARD_IN_TUNNEL_NETWORK", {"Squad"})};
	auto friends = Call("TEAM_SET_OVERRIDE_RELATION_TO_TEAM", {"Squad", "Civilians", ""});
	friends.parameters[2].integer = 2;
	auto hostile = Call("PLAYER_SET_OVERRIDE_RELATION_TO_TEAM", {"PlyrGLA", "Squad", ""});
	hostile.parameters[2].integer = 0;
	script.actions.push_back(friends);
	script.actions.push_back(hostile);
	script.actions.push_back(Call("TEAM_REMOVE_OVERRIDE_RELATION_TO_PLAYER", {"Squad", "PlyrGLA"}));
	script.actions.push_back(Call("TEAM_REMOVE_ALL_OVERRIDE_RELATIONS", {"Squad"}));
	script.actions.push_back(Call("NAMED_HUNT", {"Tank"}));
	script.actions.push_back(Call("PLAYER_DISABLE_UNIT_CONSTRUCTION", {"PlyrGLA"}));
	auto countdown = Call("NAMED_ADD_SPECIAL_POWER_COUNTDOWN", {"Tank", "SuperweaponScudStorm", ""});
	countdown.parameters[2].integer = 30;
	script.actions.push_back(countdown);
	script.actions.push_back(Call("NAMED_STOP_SPECIAL_POWER_COUNTDOWN", {"Tank", "SuperweaponScudStorm"}));
	script.actions.push_back(Call("NAMED_ATTACK_TEAM", {"Tank", "Enemies"}));
	script.actions.push_back(Call("TEAM_ATTACK_TEAM", {"Squad", "Enemies"}));
	auto normal = Call("CHOOSE_VICTIM_ALWAYS_USES_NORMAL", {""});
	normal.parameters[0].integer = 1;
	script.actions.push_back(normal);
	script.actions.push_back(Call("IDLE_ALL_UNITS", {}));
	script.actions.push_back(Call("RESUME_SUPPLY_TRUCKING", {}));
	auto godly = Call("UNIT_AFFECT_OBJECT_PANEL_FLAGS", {"Tank", "Indestructible", ""});
	godly.parameters[2].integer = 1;
	script.actions.push_back(godly);
	script.actions.push_back(Call("TEAM_AFFECT_OBJECT_PANEL_FLAGS", {"Squad", "Enabled", ""}));
	script.actions.push_back(Call("OBJECT_ALLOW_BONUSES", {""}));
	script.actions.push_back(Call("DELETE_ALL_UNMANNED", {}));
	auto colour = Call("NAMED_CUSTOM_COLOR", {"Tank", ""});
	colour.parameters[1].integer = 0xFFFF0000;
	script.actions.push_back(colour);
	script.actions.push_back(Call("TEAM_WANDER", {"Squad", "Road"}));
	script.actions.push_back(Call("TEAM_WANDER_IN_PLACE", {"Squad"}));
	auto cash = Call("WAREHOUSE_SET_VALUE", {"Depot", ""});
	cash.parameters[1].integer = 1250;
	script.actions.push_back(cash);
	script.actions.push_back(Call("NAMED_FOLLOW_WAYPOINTS_EXACT", {"Tank", "Road"}));
	auto exactTeam = Call("TEAM_FOLLOW_WAYPOINTS_EXACT", {"Squad", "Road", ""});
	exactTeam.parameters[2].integer = 1;
	script.actions.push_back(exactTeam);
	script.actions.push_back(Call("TEAM_ATTACK_NAMED", {"Squad", "Tank"}));
	auto made = Call("CREATE_OBJECT", {"AmericaTankCrusader", "Squad", "", ""});
	made.parameters[2].position = {Engine::Math::Fixed::FromInt(100), Engine::Math::Fixed::FromInt(200), {}};
	made.parameters[3].number = Engine::Math::Fixed::FromInt(3);
	script.actions.push_back(made);
	auto spawned = Call("UNIT_SPAWN_NAMED_LOCATION_ORIENTATION", {"Boss", "AmericaTankCrusader", "Squad", "", ""});
	spawned.parameters[3].position = {Engine::Math::Fixed::FromInt(5), Engine::Math::Fixed::FromInt(6), {}};
	spawned.parameters[4].number = Engine::Math::Fixed::FromInt(1);
	script.actions.push_back(spawned);
	participant.scripts.scripts.push_back(script);
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	const std::vector<std::string> expected{"Squad follows Center as team", "Squad follows Flank", "Squad moves to Backdoor", "Squad captures nearest unmanned",
		"Tank mood -2", "Squad mood 2", "Squad guards tunnels", "0 Squad>Civilians=2", "2 PlyrGLA>Squad=0", "1 Squad>PlyrGLA off",
		"Squad overrides off", "Tank hunts", "PlyrGLA builds no units", "Tank SuperweaponScudStorm 1 30", "Tank SuperweaponScudStorm 2 0",
		"Tank attacks team Enemies", "Squad attacks team Enemies", "normal victims on", "humans idle", "humans resume", "Tank Indestructible on",
		"Squad team Enabled off", "bonuses off", "delete unmanned", "Tank colour 4294901760", "Squad wanders Road", "Squad wanders in place", "Depot $1250", "Tank exactly along Road", "Squad team exactly along Road as team", "Squad attacks Tank", "make :AmericaTankCrusader@Squad 100,200 3", "make Boss:AmericaTankCrusader@Squad 5,6 1"};
	BOOST_TEST(host.calls == expected, boost::test_tools::per_element());
	BOOST_TEST(runtime.UnknownActions().empty());
}

