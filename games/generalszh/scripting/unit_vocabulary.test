	BOOST_TEST(runtime.UnknownActions().empty());
}

// doTeamStartSequentialScript and the sequential wait actions over the real runtime (a team always idle here): the team
// idles, then its script runs an action at a time as it stays idle, all on the first tick until TEAM_IDLE_FOR_FRAMECOUNT
// makes it wait two frames (ticks 2 and 3), the rest on tick 4; TEAM_WAIT_FOR_NOT_CONTAINED_ALL holds it while the team
// is aboard.
BOOST_AUTO_TEST_CASE(legacy_parity_a_team_runs_a_sequential_script)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script plan;
	plan.name = "Plan";
	plan.subroutine = true;
	level::ScriptCall idle = Call("TEAM_IDLE_FOR_FRAMECOUNT", {"Squad", ""});
	idle.parameters[1].integer = 2;
	plan.actions = {Call("NAMED_STOP", {"First"}), idle, Call("TEAM_WAIT_FOR_NOT_CONTAINED_ALL", {"Squad"}), Call("NAMED_STOP", {"Last"})};
	level::Script start;
	start.name = "Start";
	start.oneShot = true;
	start.conditions = {{Call("CONDITION_TRUE", {})}};
	start.actions = {Call("TEAM_EXECUTE_SEQUENTIAL_SCRIPT", {"Squad", "Plan"})};
	participant.scripts.scripts = {plan, start};
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	host.contained = true;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	BOOST_TEST((host.calls == std::vector<std::string>{"#4 stops", "First stops", "#4 stops"}));
	runtime.Tick(2);
	runtime.Tick(3);
	BOOST_TEST(host.calls.size() == 3u);
	runtime.Tick(4); // the wait is over: held while aboard
	BOOST_TEST(host.calls.back() == "Squad all aboard?");
	host.contained = false;
	runtime.Tick(5);
	BOOST_TEST((std::vector<std::string>(host.calls.end() - 2, host.calls.end()) == std::vector<std::string>{"Squad all aboard?", "Last stops"}));
	BOOST_TEST(runtime.SequenceCount() == 0u);
	BOOST_TEST(runtime.UnknownActions().empty());
}

// doTeamSpinForFramecount: the team's sequence waits two frames (ticks 2 and 3) and does nothing else; the next action
// runs on tick 4.
BOOST_AUTO_TEST_CASE(legacy_parity_a_team_spins_for_a_framecount)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script plan;
	plan.name = "Plan";
	plan.subroutine = true;
	level::ScriptCall spin = Call("TEAM_SPIN_FOR_FRAMECOUNT", {"Squad", ""});
	spin.parameters[1].integer = 2;
	plan.actions = {spin, Call("NAMED_STOP", {"Last"})};
	level::Script start;
	start.name = "Start";
	start.oneShot = true;
	start.conditions = {{Call("CONDITION_TRUE", {})}};
	start.actions = {Call("TEAM_EXECUTE_SEQUENTIAL_SCRIPT", {"Squad", "Plan"})};
	participant.scripts.scripts = {plan, start};
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	BOOST_TEST((host.calls == std::vector<std::string>{"#4 stops"})); // the sequence's start
	runtime.Tick(2);
	runtime.Tick(3);
	BOOST_TEST(host.calls.size() == 1u);
	runtime.Tick(4);
	BOOST_TEST(host.calls.back() == "Last stops");
	BOOST_TEST(runtime.UnknownActions().empty());
}

// ScriptActions::doNamedEnterNamed, doNamedFaceNamed / doNamedFaceWaypoint / doTeamFaceNamed / doTeamFaceWaypoint,
// doNamedSetRepulsor / doTeamSetRepulsor (a boolean parameter) and doNamedEnableStealth reach the host as such.
BOOST_AUTO_TEST_CASE(legacy_parity_enter_face_repulse_and_stealth_actions)
{
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	level::Scenario scenario;
	ScriptRuntime runtime(scenario, vocabulary);
	const auto act = [&](level::ScriptCall call, std::optional<std::int64_t> flag = std::nullopt) {
		if (flag)
			call.parameters[1].integer = *flag;
		ScriptCallContext context{runtime, 0, NoSubject, call, 1};
		(*vocabulary.FindAction(call.name))(context);
	};
	act(Call("NAMED_ENTER_NAMED", {"Ranger", "Humvee"}));
	act(Call("NAMED_FACE_NAMED", {"Ranger", "Humvee"}));
	act(Call("NAMED_FACE_WAYPOINT", {"Ranger", "Hill"}));
	act(Call("TEAM_FACE_NAMED", {"Squad", "Humvee"}));
	act(Call("TEAM_FACE_WAYPOINT", {"Squad", "Hill"}));
	act(Call("NAMED_SET_REPULSOR", {"Ranger", ""}), 1);
	act(Call("TEAM_SET_REPULSOR", {"Squad", ""}), 0);
	act(Call("NAMED_SET_STEALTH_ENABLED", {"Ranger", ""}), 0);
	act(Call("NAMED_EXIT_BUILDING", {"Ranger"}));
	act(Call("TEAM_EXIT_ALL_BUILDINGS", {"Squad"}));
	act(Call("EXIT_SPECIFIC_BUILDING", {"Bunker"}));
	act(Call("NAMED_GUARD", {"Ranger"}));
	act(Call("NAMED_SET_UNMANNED_STATUS", {"Humvee"}));
	act(Call("TEAM_SET_UNMANNED_STATUS", {"Squad"}));
	act(Call("TEAM_USE_COMMANDBUTTON_ABILITY_AT_WAYPOINT", {"Squad", "Command_Frenzy", "Hill"}));
	BOOST_TEST((host.calls == std::vector<std::string>{"Ranger enters Humvee", "Ranger faces Humvee", "Ranger faces Hill", "Squad face Humvee",
					"Squad face Hill", "Ranger repulses", "Squad repulse not", "Ranger may not stealth", "Ranger exits", "Squad exit", "Bunker empties",
					"Ranger guards", "Humvee unmanned", "Squad unmanned", "Squad uses Command_Frenzy at Hill"}));
}

// ScriptActions::doSetTeamState and ScriptConditions::evaluateTeamStateIs / IsNot: a team that is not there is in no
// state (both false); UNIT_EMPTIED and TEAM_OWNED_BY_PLAYER as the host answers them.
BOOST_AUTO_TEST_CASE(legacy_parity_team_states_and_ownership)
{
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	level::Scenario scenario;
	ScriptRuntime runtime(scenario, vocabulary);
	const auto run = [&](const level::ScriptCall &call) {
		ScriptCallContext context{runtime, 0, NoSubject, call, 1};
		if (const auto *condition = vocabulary.FindCondition(call.name))
			return (*condition)(context);
		(*vocabulary.FindAction(call.name))(context);
		return true;
	};
	BOOST_TEST(!run(Call("TEAM_STATE_IS", {"Squad", "Attack"})));
	BOOST_TEST(!run(Call("TEAM_STATE_IS_NOT", {"Squad", "Attack"})));
	run(Call("TEAM_SET_STATE", {"Squad", "Attack"}));
	BOOST_TEST(run(Call("TEAM_STATE_IS", {"Squad", "Attack"})));
	BOOST_TEST(!run(Call("TEAM_STATE_IS_NOT", {"Squad", "Attack"})));
	BOOST_TEST(run(Call("TEAM_STATE_IS_NOT", {"Squad", "Defend"})));
	BOOST_TEST(run(Call("UNIT_EMPTIED", {"Emptied"})));
	BOOST_TEST(!run(Call("UNIT_EMPTIED", {"Full"})));
	BOOST_TEST(run(Call("TEAM_OWNED_BY_PLAYER", {"Squad", "Me"})));
	BOOST_TEST(!run(Call("TEAM_OWNED_BY_PLAYER", {"Squad", "Them"})));
}

// ScriptEngine::evaluateAndProgressAllSequentialScripts: SKIRMISH_WAIT_FOR_COMMANDBUTTON_AVAILABLE_PARTIAL holds the
// sequence (m_dontAdvanceInstruction) each frame evaluateSkirmishCommandButtonIsReady(team, button, false) is false,
// and the next action runs the frame it is true. ScriptConditions::evaluateCondition: SKIRMISH_COMMAND_BUTTON_READY_ALL
// asks the same of all members.
BOOST_AUTO_TEST_CASE(legacy_parity_a_sequence_waits_for_a_command_button)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script plan;
	plan.name = "Plan";
	plan.subroutine = true;
	plan.actions = {Call("SKIRMISH_WAIT_FOR_COMMANDBUTTON_AVAILABLE_PARTIAL", {"", "Squad", "Command_Frenzy"}), Call("NAMED_STOP", {"Last"})};
	level::Script start;
	start.name = "Start";
	start.oneShot = true;
	start.conditions = {{Call("SKIRMISH_COMMAND_BUTTON_READY_ALL", {"", "Squad", "Command_Frenzy"})}};
	start.actions = {Call("TEAM_EXECUTE_SEQUENTIAL_SCRIPT", {"Squad", "Plan"})};
	participant.scripts.scripts = {plan, start};
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	BOOST_TEST(host.calls.back() == "Squad Command_Frenzy all ready?");
	host.allReady = true;
	runtime.Tick(2); // started: the wait holds it the same tick
	BOOST_TEST(host.calls.back() == "Squad Command_Frenzy any ready?");
	runtime.Tick(3);
	BOOST_TEST(host.calls.back() == "Squad Command_Frenzy any ready?");
	host.anyReady = true;
	runtime.Tick(4);
	BOOST_TEST((std::vector<std::string>(host.calls.end() - 2, host.calls.end()) == std::vector<std::string>{"Squad Command_Frenzy any ready?", "Last stops"}));
	BOOST_TEST(runtime.SequenceCount() == 0u);
	BOOST_TEST(runtime.UnknownActions().empty());
}

// doUnitStartSequentialScript (UNIT_EXECUTE_SEQUENTIAL_SCRIPT_LOOPING, twice) over the real runtime (a unit always idle
// here): the script runs on the unit, "<This Object>" naming it (m_conditionObject), both times through on the first
// tick; an unknown unit starts nothing; UNIT_STOP_SEQUENTIAL_SCRIPT ends a running one.
BOOST_AUTO_TEST_CASE(legacy_parity_a_unit_runs_a_sequential_script)
{
	level::Scenario scenario;
	auto &participant = scenario.participants.emplace_back();
	level::Script plan;
	plan.name = "Plan";
	plan.subroutine = true;
	level::ScriptCall self = Call("NAMED_STOP", {"<This Object>"});
	self.parameters[0].kind = 14;
	plan.actions = {self, Call("NAMED_STOP", {"Last"})};
	level::Script start;
	start.name = "Start";
	start.oneShot = true;
	start.conditions = {{Call("CONDITION_TRUE", {})}};
	level::ScriptCall twice = Call("UNIT_EXECUTE_SEQUENTIAL_SCRIPT_LOOPING", {"Tank", "Plan", ""});
	twice.parameters[2].integer = 2;
	start.actions = {twice, Call("UNIT_EXECUTE_SEQUENTIAL_SCRIPT", {"Nobody", "Plan"})};
	participant.scripts.scripts = {plan, start};
	Vocabulary vocabulary;
	generalszh::scripting::AddCoreVocabulary(vocabulary);
	RecordingHost host;
	generalszh::scripting::AddUnitVocabulary(vocabulary, host);
	ScriptRuntime runtime(scenario, vocabulary);
	runtime.Tick(1);
	BOOST_TEST((host.calls == std::vector<std::string>{"unit#7 stops", "Last stops", "unit#7 stops", "Last stops"}));
	BOOST_TEST(runtime.SequenceCount() == 0u);
	BOOST_TEST(runtime.UnknownActions().empty());
}

