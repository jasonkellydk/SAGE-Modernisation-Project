#define BOOST_TEST_MODULE CinematicContent
#include <boost/test/included/unit_test.hpp>
import std;
import games.renegade.content.cinematics.cinematic;
import games.renegade.content.install.install_mount;
import games.renegade.content.cinematics.startup;
import games.renegade.content.levels.level_scene;
import games.renegade.content.campaign.conversations;
using namespace renegade::content;using Engine::Math::Fixed;
BOOST_AUTO_TEST_CASE(retail_startup_is_discovered_from_attached_lua_and_editor_helper_identity) {
    const auto* install=std::getenv("RENEGADE_INSTALL_DIR");if(!install) return;
    const auto mounted=MountInstall(install);BOOST_REQUIRE(mounted.has_value());
    const auto scripts=std::filesystem::path(std::source_location::current().file_name()).parent_path().parent_path()/"scripts";
    mounted->files->Mount(std::make_unique<engine::filesystem::DirectorySource>(scripts));
    const auto level=LoadLevelScene(*mounted->files,"M13.mix");BOOST_REQUIRE(level.has_value());
    const auto startup=LoadCinematicStartup(*mounted->files,level->level,1);BOOST_REQUIRE_MESSAGE(startup.has_value(),(startup ? "" : startup.error()));BOOST_REQUIRE(startup->has_value());
    BOOST_TEST((**startup).subject==1200001u);BOOST_TEST((**startup).program=="MX0_MissionStart_DME");BOOST_TEST((**startup).control_file=="X00_Intro.txt");
    BOOST_TEST((**startup).music=="renegade_intro_no_vox.mp3");BOOST_TEST((**startup).music_fade_ms==1000u);BOOST_TEST((**startup).clear_weapon);
    for(const auto value:(**startup).state) BOOST_TEST(value==0);
}
BOOST_AUTO_TEST_CASE(cinematic_source_units_equal_time_order_quotes_and_empty_fields) {
    const auto definition=ReadCinematic("; comments\n-30 Play_Animation, 1, \"rig.walk\", 0,,1\n0 Create_Object,1,\"a,b\",0,0,0,0\n1 Attach_Script,1,\"test\",\"a,b,c\"\n-2130 Control_Camera,-1\n");
    BOOST_REQUIRE_MESSAGE(definition.has_value(),(definition ? "" : definition.error()));BOOST_REQUIRE_EQUAL(definition->timeline.cues.size(),4u);
    BOOST_TEST(definition->timeline.cues[0].action==1u);BOOST_TEST(definition->timeline.cues[1].action==0u);BOOST_TEST(definition->timeline.cues[2].action==2u);
    BOOST_TEST(definition->timeline.cues[1].time.Raw()==Fixed::OneRaw);BOOST_TEST(definition->timeline.cues[3].time.Raw()==71*Fixed::OneRaw);
    BOOST_TEST(definition->actions[0].blended);BOOST_TEST(!definition->actions[0].looping);BOOST_TEST(definition->actions[1].asset=="a,b");BOOST_TEST(definition->actions[2].parameters=="a,b,c");
    BOOST_TEST(!ReadCinematic("0 Play_Animation,1,\"unterminated"));BOOST_TEST(!ReadCinematic("nan Control_Camera,-1"));BOOST_TEST(!ReadCinematic("0 Unknown,1"));
}
BOOST_AUTO_TEST_CASE(tutorial_callbacks_are_owned_by_the_ECS_dispatcher_and_do_not_become_startup_films) {
    const auto* install=std::getenv("RENEGADE_INSTALL_DIR");if(!install) return;
    const auto mounted=MountInstall(install);BOOST_REQUIRE(mounted.has_value());
    const auto scripts=std::filesystem::path(std::source_location::current().file_name()).parent_path().parent_path()/"scripts";
    mounted->files->Mount(std::make_unique<engine::filesystem::DirectorySource>(scripts));
    const auto level=LoadLevelScene(*mounted->files,"M00_Tutorial.mix");BOOST_REQUIRE(level.has_value());
    const auto startup=LoadCinematicStartup(*mounted->files,level->level,1);
    BOOST_REQUIRE_MESSAGE(startup.has_value(),(startup ? "" : startup.error()));BOOST_TEST(!startup->has_value());
}
BOOST_AUTO_TEST_CASE(retail_first_mission_opening_preserves_every_authored_command_and_camera_release) {
    const auto* install=std::getenv("RENEGADE_INSTALL_DIR");if(!install) return;
    const auto mounted=MountInstall(install);BOOST_REQUIRE(mounted.has_value());const auto text=mounted->files->ReadText("X00_Intro.txt");BOOST_REQUIRE(text.has_value());
    const auto definition=ReadCinematic(*text);BOOST_REQUIRE_MESSAGE(definition.has_value(),(definition ? "" : definition.error()));
    BOOST_TEST(definition->actions.size()==250u);BOOST_TEST(definition->timeline.cues.size()==250u);
    const auto count=[&](CinematicOpcode type) {return std::ranges::count(definition->actions,type,&CinematicAction::opcode);};
    BOOST_TEST(count(CinematicOpcode::CreateModel)==16);BOOST_TEST(count(CinematicOpcode::CreatePreset)==21);BOOST_TEST(count(CinematicOpcode::Animation)==45);BOOST_TEST(count(CinematicOpcode::Script)==65);
    BOOST_TEST(definition->actions[0].asset=="X00_CAMERA");BOOST_TEST(definition->actions[1].asset=="X00_CAMERA.X00_CAMERA");
    const auto release=std::ranges::find_if(definition->timeline.cues,[&](const auto& cue) {const auto& action=definition->actions[cue.action];return action.opcode==CinematicOpcode::Camera && action.slot==-1;});
    BOOST_REQUIRE(release!=definition->timeline.cues.end());BOOST_TEST(release->time.Raw()==71*Fixed::OneRaw);
    BOOST_TEST(definition->timeline.cues.back().time.Raw()==75*Fixed::OneRaw);
    const auto level=LoadLevelScene(*mounted->files,"M13.mix");BOOST_REQUIRE(level);
    const auto conversations=ReadLevelConversations(level->dynamic_data);BOOST_REQUIRE(conversations);
    unsigned bindings{},available{},missing{};
    for(const auto& action:definition->actions) if(action.opcode==CinematicOpcode::Script && action.asset=="M00_Generic_Conv_DME") {
        ++bindings;const auto* conversation=conversations->Find(action.parameters);
        if(!conversation) {++missing;BOOST_TEST(action.parameters=="MX0_GDITROOPER4_HIT6");continue;}
        ++available;BOOST_REQUIRE(conversation->remarks.size()==1u);BOOST_TEST(conversation->remarks.front().orator==0u);
    }
    BOOST_TEST(bindings==26u);BOOST_TEST(available==25u);BOOST_TEST(missing==1u);
}
