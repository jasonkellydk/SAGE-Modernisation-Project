#include <boost/test/unit_test.hpp>
#include <cstddef>
#include <string>
#include <vector>
import games.renegade.content.armor.defense_preset;

namespace
{
std::vector<std::byte> DefenseHex(std::string_view text) {
	std::vector<std::byte> bytes;
	for (std::size_t i = 0; i < text.size(); i += 2) bytes.push_back(static_cast<std::byte>(std::stoul(std::string(text.substr(i, 2)), nullptr, 16)));
	return bytes;
}
}

BOOST_AUTO_TEST_CASE(defense_preset_original_wire_uses_persistent_armor_ids)
{
	using namespace renegade;
	content::ArmorCatalog armor; armor.armors = {"Kevlar", "Flesh", "Duplicate"}; armor.armorSaveIds = {17, 2, 17};
	content::LegacyDefinition definition;
	// Independently captured Commando defense record: save IDs 2 and 17 are
	// distinct from the deliberately reordered armor declaration indices.
	definition.data = DefenseHex("87bd560c38000080f7906f0030000000"
		"00040000c84201040000c84202040200000003040000c84204040000c84205041100000006040000803f070400000000");
	auto result = content::ReadDefensePreset(definition, armor); BOOST_REQUIRE(result.has_value());
	BOOST_TEST(result->health.current.Raw() == 100 * Fixed::OneRaw);
	BOOST_TEST(result->health.maximum.Raw() == 100 * Fixed::OneRaw);
	BOOST_TEST(result->shield.current.Raw() == 100 * Fixed::OneRaw);
	BOOST_TEST(result->shield.maximum.Raw() == 100 * Fixed::OneRaw);
	BOOST_TEST(result->defense.skin == 1u); BOOST_TEST(result->health.armor == 1u);
	BOOST_TEST(result->shield.armor == 0u);
	BOOST_TEST(result->damage_points.Raw() == Fixed::OneRaw); BOOST_TEST(result->death_points.Raw() == 0);
	BOOST_TEST(armor.ArmorBySaveId(17) == 0u); BOOST_TEST(armor.ArmorBySaveId(-2) == 0u);
	for (const int difficulty : {0, 1, 2, -1, 3}) {
		auto player = *result; content::ApplySoloDifficulty(player, difficulty);
		const int expected = difficulty == 0 ? 200 : difficulty == 2 ? 75 : 100;
		BOOST_TEST(player.health.current.Raw() == expected * Fixed::OneRaw);
		BOOST_TEST(player.health.maximum.Raw() == expected * Fixed::OneRaw);
		BOOST_TEST(player.shield.current.Raw() == expected * Fixed::OneRaw);
		BOOST_TEST(player.shield.maximum.Raw() == expected * Fixed::OneRaw);
		BOOST_TEST(player.defense.skin == 1u); BOOST_TEST(player.shield.armor == 0u);
		BOOST_TEST(player.damage_points.Raw() == Fixed::OneRaw);
	}
}

BOOST_AUTO_TEST_CASE(defense_preset_constructor_defaults_and_malformed_data)
{
	using namespace renegade;
	content::ArmorCatalog armor; armor.armors = {"Default", "MissingId"}; armor.armorSaveIds = {5, -2};
	content::LegacyDefinition definition;
	definition.data = DefenseHex("87bd560c08000080f7906f0000000000");
	const auto defaults = content::ReadDefensePreset(definition, armor); BOOST_REQUIRE(defaults.has_value());
	BOOST_TEST(defaults->health.current.Raw() == 100 * Fixed::OneRaw);
	BOOST_TEST(defaults->health.maximum.Raw() == 100 * Fixed::OneRaw);
	BOOST_TEST(defaults->shield.current.Raw() == 0); BOOST_TEST(defaults->shield.maximum.Raw() == 0);
	BOOST_TEST(defaults->defense.skin == 1u); BOOST_TEST(defaults->shield.armor == 1u);
	BOOST_TEST(!content::ReadDefensePreset(definition, content::ArmorCatalog{}));
	definition.data = DefenseHex("87bd560c14000080f7906f000c00000000040000c84200040000c842");
	BOOST_TEST(!content::ReadDefensePreset(definition, armor)); // duplicate known field
	definition.data = DefenseHex("87bd560c0e000080f7906f000600000000040000807f");
	BOOST_TEST(!content::ReadDefensePreset(definition, armor)); // non-finite health
	definition.data.pop_back(); BOOST_TEST(!content::ReadDefensePreset(definition, armor));
	definition.data.clear(); BOOST_TEST(!content::ReadDefensePreset(definition, armor));
}
