#define BOOST_TEST_MODULE RenegadePresentationContent
#include <boost/test/included/unit_test.hpp>
#include <cstddef>
#include <cstdint>
#include <vector>
#include <string>
#include <span>
#include <cstdlib>
#include <fstream>
#include <filesystem>
#include <memory>
import games.renegade.content.presentation.strings;
import games.renegade.content.presentation.asset_paths;
import games.renegade.content.install.install_mount;
import engine.assets.adapters.filesystem.virtual_asset_source;
import engine.filesystem.adapters.pe.resources;
import engine.gui.w3d.dialog_template;
import Assets.Cache;
import Assets.Identity;
import Assets.Adapters.W3D;
import Assets.Importers.Models;
import Assets.Models;

namespace {
void Put(std::vector<std::byte>& out,std::uint32_t value,unsigned count=4) { for(unsigned i=0;i<count;++i) out.push_back(std::byte(value>>(8*i))); }
std::vector<std::byte> Chunk(std::uint32_t id,const std::vector<std::byte>& payload,bool children=false) {
    std::vector<std::byte> out;Put(out,id);Put(out,std::uint32_t(payload.size())|(children ? 0x80000000u : 0));out.insert(out.end(),payload.begin(),payload.end());return out;
}
void Append(std::vector<std::byte>& out,const std::vector<std::byte>& bytes) { out.insert(out.end(),bytes.begin(),bytes.end()); }
std::vector<std::byte> Text(std::u16string value) { std::vector<std::byte> out;for(auto c:value) Put(out,c,2);Put(out,0,2);return out; }
std::vector<std::byte> Fixture() {
    std::vector<std::byte> fields{std::byte{1},std::byte{4}};Put(fields,1000);
    const std::string descriptor="IDS_MENU_TEXT073";Put(fields,2,1);Put(fields,std::uint32_t(descriptor.size()+1),1);
    for(auto c:descriptor) Put(fields,c,1);Put(fields,0,1);
    const std::string animation="FACE.TALK";Put(fields,6,1);Put(fields,std::uint32_t(animation.size()+1),1);for(auto c:animation) Put(fields,c,1);Put(fields,0,1);
    auto object=Chunk(0x06141108,fields);Append(object,Chunk(0x0614110b,Text(u"Single Player")));
    std::vector<std::byte> english;for(const auto c:std::string("Original English phrase")) Put(english,c,1);Put(english,0,1);Append(object,Chunk(0x0614110a,english));
    Append(object,Chunk(0x0614110b,Text(u"Joueur unique")));
    return Chunk(0x90000,Chunk(0x07141201,Chunk(0x90001,Chunk(0x00100101,object,true),true),true),true);
}
}
BOOST_AUTO_TEST_CASE(source_translation_format_preserves_descriptors_and_falls_back_to_english) {
    const auto bytes=Fixture();const auto result=renegade::content::ReadStrings(bytes);BOOST_REQUIRE(result);
    BOOST_TEST(result->entries.at(1000).animation=="FACE.TALK");BOOST_TEST(result->entries.at(1000).english=="Original English phrase");
    BOOST_CHECK(result->Lookup("IDS_MENU_TEXT073")==u"Single Player");
    BOOST_CHECK(result->Lookup("IDS_MENU_TEXT073",1)==u"Joueur unique");
    BOOST_CHECK(result->Lookup("IDS_MENU_TEXT073",7)==u"Single Player");BOOST_CHECK(result->Lookup("missing").empty());
    BOOST_CHECK(result->Lookup(1000u)==u"Single Player");BOOST_CHECK(result->Lookup(1000u,1)==u"Joueur unique");BOOST_CHECK(result->Lookup(1000u,7)==u"Single Player");BOOST_CHECK(result->Lookup(999u).empty());
    for(std::size_t count=0;count<bytes.size();++count) BOOST_CHECK(!renegade::content::ReadStrings(std::span(bytes).first(count)));
}
BOOST_AUTO_TEST_CASE(retail_menu_models_rigs_materials_dialog_and_labels) {
    const char* location=std::getenv("RENEGADE_INSTALL_DIR");BOOST_REQUIRE_MESSAGE(location,"RENEGADE_INSTALL_DIR is required for this retail test");
    const auto mounted=renegade::content::MountInstall(location);BOOST_REQUIRE(mounted);
    const auto& files=*mounted->files;
    engine::assets::VirtualAssetSource source(files,renegade::content::AssetPaths);
    Assets::AssetCache cache(source);BOOST_REQUIRE(cache.Register_Model_Adapter(std::make_shared<Assets::W3DAdapter>()));
    for(const auto name:{"IF_BACK01","IF_RENLOGO","IF_TITLETRANS","IF_EVAGIZMO"}) {
        const auto handle=cache.Request_Model(std::string(name)+".w3d");cache.Wait(handle);
        const auto* asset=cache.Try_Get_Model(handle);BOOST_REQUIRE_MESSAGE(asset,cache.Get_Error(handle));
        BOOST_TEST(!asset->Vertices().empty());BOOST_TEST(!asset->Indices().empty());BOOST_TEST(!asset->Rig().bones.empty());
        for(const auto& material:asset->Materials()) {
            BOOST_TEST_MESSAGE(name << " material " << material.name << " ambient " << material.ambient_color.r << ',' << material.ambient_color.g << ',' << material.ambient_color.b
                << " diffuse " << material.base_color.r << ',' << material.base_color.g << ',' << material.base_color.b << " emissive " << material.emissive_color.r
                << " opacity " << material.opacity << " textured " << material.texturing);
        }
        for(const auto texture:cache.Model_Texture_Dependencies(handle)) {cache.Wait(texture);BOOST_REQUIRE_MESSAGE(cache.Try_Get_Texture(texture),cache.Get_Error(texture));}
        if(std::string(name)!="IF_RENLOGO") {
            std::string error;const auto rig=cache.Load_Rig(Assets::AssetType::Animation,std::string(name)+"."+name,error);
            BOOST_REQUIRE_MESSAGE(rig,error);BOOST_REQUIRE(!rig->animations.empty());BOOST_TEST(rig->animations.front().channels_available);
        }
    }
    const auto bytes=files.Read("strings.tdb");BOOST_REQUIRE(bytes);const auto strings=renegade::content::ReadStrings(*bytes);BOOST_REQUIRE(strings);
    BOOST_CHECK(strings->Lookup("IDS_MENU_TEXT073")==u"Single Player");BOOST_CHECK(strings->Lookup("IDS_MENU_TEXT076")==u"Options");
    std::ifstream input(std::filesystem::path(location)/"Game.exe",std::ios::binary|std::ios::ate);BOOST_REQUIRE(input);
    std::vector<std::byte> executable(static_cast<std::size_t>(input.tellg()));input.seekg(0);input.read(reinterpret_cast<char*>(executable.data()),std::streamsize(executable.size()));
    const auto resource=engine::filesystem::pe::Resource(executable,5,128);BOOST_REQUIRE(resource);
    const auto dialog=engine::gui::w3d::ReadDialogTemplate(*resource);BOOST_REQUIRE(dialog);
    BOOST_TEST(dialog->rect.width==400);BOOST_TEST(dialog->rect.height==300);BOOST_REQUIRE_EQUAL(dialog->controls.size(),9u);
    BOOST_CHECK(dialog->controls[0].title.text==u"IDS_MENU_TEXT073");BOOST_TEST(dialog->controls[0].id==11000);
}
