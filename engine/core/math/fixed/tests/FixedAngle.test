#include <boost/test/unit_test.hpp>

#include <bit>
#include <cmath>
#include <cstdint>
#include <numbers>

import Engine.Core.Math.Fixed;
import Engine.Core.Math.FixedAngle;

using namespace Engine::Math;
using namespace Engine::Math::Literals;

namespace
{
double ToDouble(Fixed value) { return static_cast<double>(value.Raw()) / Fixed::OneRaw; }
double ToRadiansDouble(TurnAngle angle) { return angle.units * (2.0 * std::numbers::pi / 4294967296.0); }
}

BOOST_AUTO_TEST_SUITE(fixed_angle)

BOOST_AUTO_TEST_CASE(conversions_are_exact_for_common_values)
{
	BOOST_TEST(TurnFromDegrees(90).units == 0x40000000u);
	BOOST_TEST(TurnFromDegrees(180).units == 0x80000000u);
	BOOST_TEST(TurnFromDegrees(-90).units == 0xC0000000u);
	BOOST_TEST(TurnFromDegrees(450).units == 0x40000000u);
	BOOST_TEST(TurnFromDegrees(720).units == 0u);
	BOOST_TEST(Degrees(TurnFromDegrees(45.5_fx)).Raw() == (45.5_fx).Raw());
	BOOST_TEST(Radians(TurnFromDegrees(180)).Raw() == 205887); // round(pi * 65536)
}

BOOST_AUTO_TEST_CASE(radians_round_trip_within_resolution)
{
	for (std::int64_t raw = -500000; raw <= 500000; raw += 777)
	{
		const TurnAngle angle = TurnFromRadians(Fixed::FromRaw(raw));
		const double expected = std::remainder(raw / 65536.0, 2.0 * std::numbers::pi);
		const double actual = std::remainder(ToRadiansDouble(angle), 2.0 * std::numbers::pi);
		BOOST_TEST(std::fabs(std::remainder(actual - expected, 2.0 * std::numbers::pi)) < 1e-6);
	}
}

BOOST_AUTO_TEST_CASE(binary32_radians_convert_to_the_nearest_turn_unit)
{
	for (const float radians : {0.0f, 1.5707964f, -1.5707964f, 3.1415927f, 0.001f, 6.2f, -12.5f, 100.25f})
	{
		const TurnAngle angle = TurnFromRadiansBinary32Bits(std::bit_cast<std::uint32_t>(radians));
		const double exact = std::fmod(static_cast<double>(radians) / (2.0 * std::numbers::pi) * 4294967296.0, 4294967296.0);
		const double wrapped = exact < 0 ? exact + 4294967296.0 : exact;
		const double error = std::fabs(static_cast<double>(angle.units) - wrapped);
		BOOST_TEST(std::fmin(error, 4294967296.0 - error) <= 1.0);
	}
	BOOST_TEST(TurnFromRadiansBinary32Bits(0x7FC00000u).units == 0u);
}

BOOST_AUTO_TEST_CASE(arithmetic_wraps_and_delta_is_shortest)
{
	const TurnAngle a = TurnFromDegrees(350);
	const TurnAngle b = TurnFromDegrees(20);
	BOOST_TEST((a + b).units == TurnFromDegrees(10).units);
	BOOST_TEST(DeltaTo(a, b) == static_cast<std::int32_t>(TurnFromDegrees(30).units));
	BOOST_TEST(DeltaTo(b, a) == -static_cast<std::int32_t>(TurnFromDegrees(30).units));
	BOOST_TEST((-TurnFromDegrees(90)).units == TurnFromDegrees(270).units);
}

BOOST_AUTO_TEST_CASE(sine_and_cosine_track_reference_within_one_unit)
{
	BOOST_TEST(Sin(TurnAngle{}).Raw() == 0);
	BOOST_TEST(Sin(TurnFromDegrees(90)).Raw() == Fixed::OneRaw);
	BOOST_TEST(Sin(TurnFromDegrees(270)).Raw() == -Fixed::OneRaw);
	BOOST_TEST(Cos(TurnAngle{}).Raw() == Fixed::OneRaw);
	BOOST_TEST(Cos(TurnFromDegrees(180)).Raw() == -Fixed::OneRaw);
	for (std::uint64_t units = 0; units < 0x100000000ull; units += 0x10001ull)
	{
		const TurnAngle angle = TurnAngle{static_cast<std::uint32_t>(units)};
		const double radians = ToRadiansDouble(angle);
		BOOST_TEST(std::fabs(ToDouble(Sin(angle)) - std::sin(radians)) * 65536.0 <= 1.0);
		BOOST_TEST(std::fabs(ToDouble(Cos(angle)) - std::cos(radians)) * 65536.0 <= 1.0);
	}
}

BOOST_AUTO_TEST_CASE(atan2_covers_all_quadrants)
{
	BOOST_TEST(Atan2(Fixed{}, Fixed{}).units == 0u);
	BOOST_TEST(Atan2(0_fx, 5_fx).units == 0u);
	for (int y = -40; y <= 40; y += 3)
	{
		for (int x = -40; x <= 40; x += 3)
		{
			if (x == 0 && y == 0)
				continue;
			const Fixed fy = Fixed::FromRatio(y, 7);
			const Fixed fx = Fixed::FromRatio(x, 7);
			const double expected = std::atan2(ToDouble(fy), ToDouble(fx));
			const double actual = ToRadiansDouble(Atan2(fy, fx));
			BOOST_TEST(std::fabs(std::remainder(actual - expected, 2.0 * std::numbers::pi)) < 1e-6);
		}
	}
	// Extreme magnitudes are normalised, not overflowed.
	const double big = ToRadiansDouble(Atan2(Fixed::Max(), Fixed::Max()));
	BOOST_TEST(std::fabs(big - std::numbers::pi / 4) < 1e-6);
	const double negative = ToRadiansDouble(Atan2(Fixed::Min(), Fixed::Min()));
	BOOST_TEST(std::fabs(negative - 5 * std::numbers::pi / 4) < 1e-6);
}

BOOST_AUTO_TEST_SUITE_END()
