// count: chunks visited; extra: entities visited.
struct ParallelChunkSystem
{
	static constexpr std::string_view ProbeName = "tests.scheduler.probe.parallel.chunks";
	using Query = ecs::Query<ecs::Write<Position>>;
	using Resources = ecs::Resources<ecs::Write<Probe<ParallelChunkSystem>>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
	{
		Probe<ParallelChunkSystem> &probe = context.Write<Probe<ParallelChunkSystem>>();
		probe.count.fetch_add(1, std::memory_order_relaxed);
		auto positions = chunk.Get<Position>();
		for (Position &position : positions)
			++position.value;
		probe.extra.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct DeterministicMutationSystem
{
	using Query = ecs::Query<ecs::Write<Position>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &context)
	{
		auto positions = chunk.Get<Position>();
		for (Position &position : positions)
			position.value += 3;

		const auto created = context.Commands().Create();
		context.Commands().Add<Marker>(created, Marker{static_cast<int>(context.ChunkOrder())});
	}
};

struct WaveCountObserveSystem
{
	static constexpr std::string_view ProbeName = "tests.scheduler.probe.parallel.wave_observe";
	using Query = ecs::Query<ecs::Read<Marker>>;
	using Resources = ecs::Resources<ecs::Write<Probe<WaveCountObserveSystem>>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
	{
		context.Write<Probe<WaveCountObserveSystem>>().count.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

// count: rejected creates; extra: rejected commits.
struct DirectMutationSystem
{
	static constexpr std::string_view ProbeName = "tests.scheduler.probe.parallel.direct_mutation";
	using Query = ecs::Query<ecs::Read<Position>>;
	using Resources = ecs::Resources<ecs::Write<Probe<DirectMutationSystem>>>;

	void Execute(Query::Chunk, ecs::SystemContext &context) const
	{
		Probe<DirectMutationSystem> &probe = context.Write<Probe<DirectMutationSystem>>();
		try
		{
			context.GetWorld().Create<>();
		}
		catch (const std::logic_error &)
		{
			probe.count.fetch_add(1, std::memory_order_relaxed);
		}
		try
		{
			ecs::CommandBuffer commands;
			context.GetWorld().Commit(commands);
		}
		catch (const std::logic_error &)
		{
			probe.extra.fetch_add(1, std::memory_order_relaxed);
		}
	}
};

struct ThrowingSystem
{
	using Query = ecs::Query<ecs::Read<Position>>;

	void Execute(Query::Chunk, ecs::SystemContext &)
	{
		throw std::runtime_error("deterministic scheduler job failure");
	}
};

struct LaterAfterFailureSystem
{
	static constexpr std::string_view ProbeName = "tests.scheduler.probe.failure.later";
	using Query = ecs::Query<ecs::Read<Position>>;
	using Resources = ecs::Resources<ecs::Write<Probe<LaterAfterFailureSystem>>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
	{
		context.Write<Probe<LaterAfterFailureSystem>>().count.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

struct TimeIntegrationSystem
{
	using Query = ecs::Query<ecs::Write<Position>, ecs::Read<Velocity>>;
	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
	{
		const auto perTick = [&](int perSecond) { return context.Time().PerTick(Engine::Math::Fixed::FromInt(perSecond)).Round(); };
		auto positions = chunk.Get<Position>();
		const auto velocities = chunk.Get<Velocity>();
		for (std::size_t index = 0; index < positions.size(); ++index)
			positions[index].value += static_cast<int>(perTick(velocities[index].value));
		const auto created = context.Commands().Create();
		context.Commands().Add<Marker>(created, Marker{static_cast<int>(context.Tick())});
	}
};

