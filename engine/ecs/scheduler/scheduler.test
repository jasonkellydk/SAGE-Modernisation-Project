struct BarrierAddSystem
{
	static constexpr std::string_view ProbeName = "tests.scheduler.probe.barrier.add";
	using Query = ecs::Query<ecs::Read<Position>>;
	using Resources = ecs::Resources<ecs::Read<Probe<BarrierAddSystem>>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
	{
		const ecs::Entity target = context.Read<Probe<BarrierAddSystem>>().target;
		for (const ecs::Entity entity : chunk.Entities())
		{
			if (entity == target)
				context.Commands().Add<Marker>(entity, Marker{7});
		}
	}
};

