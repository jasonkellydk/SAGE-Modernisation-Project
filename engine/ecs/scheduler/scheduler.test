} // namespace ecs

namespace
{

void RegisterSimulationComponents(ecs::World &world)
{
	world.RegisterComponent<ecs_scheduler_test::Position>();
	world.RegisterComponent<ecs_scheduler_test::Velocity>();
	world.RegisterComponent<ecs_scheduler_test::Marker>();
	world.FinalizeComponents();
}

} // namespace

BOOST_AUTO_TEST_SUITE(ecs_scheduler)

BOOST_AUTO_TEST_CASE(systems_are_explicitly_finalized_before_scheduler_use)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	ecs_scheduler_test::PreSystem pre;
	ecs::SystemRegistry systems;
	systems.Register(pre);
	ecs::Scheduler scheduler(world, systems);
	BOOST_CHECK_THROW(scheduler.Finalize(), std::logic_error);
	BOOST_TEST(!scheduler.IsFinalized());
	BOOST_CHECK_THROW(scheduler.Execute(1), std::logic_error);

	systems.Finalize(world.Components());
	BOOST_TEST(systems.IsFrozen());
	scheduler.Finalize();
	BOOST_TEST(scheduler.IsFinalized());
}

BOOST_AUTO_TEST_CASE(scheduler_rejects_a_different_component_schema)
{
	ecs::World registeredWorld;
	registeredWorld.RegisterComponent<ecs_scheduler_test::Position>();
	registeredWorld.FinalizeComponents();
	ecs_scheduler_test::PreSystem pre;
	ecs::SystemRegistry systems;
	systems.Register(pre);
	systems.Finalize(registeredWorld.Components());

	ecs::World differentWorld;
	RegisterSimulationComponents(differentWorld);
	ecs::Scheduler scheduler(differentWorld, systems);
	BOOST_CHECK_THROW(scheduler.Finalize(), std::logic_error);
	BOOST_TEST(!scheduler.IsFinalized());
}

BOOST_AUTO_TEST_CASE(read_read_and_unrelated_accesses_share_a_wave)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	ecs_scheduler_test::SimulationSystem simulation;
	ecs_scheduler_test::UnrelatedSystem unrelated;
	ecs::SystemRegistry systems;
	systems.Register(unrelated);
	systems.Register(simulation);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems);
	scheduler.Finalize();

	const auto &waves = scheduler.Plan().Phases()[1].waves;
	BOOST_TEST(waves.size() == 1);
	BOOST_TEST(waves[0].size() == 2);
}

BOOST_AUTO_TEST_CASE(phases_and_explicit_transitive_ordering_are_deterministic)
{
	ecs::World firstWorld;
	RegisterSimulationComponents(firstWorld);
	std::vector<int> firstPhaseLog;
	ecs_scheduler_test::PreSystem firstPre{&firstPhaseLog};
	ecs_scheduler_test::SimulationSystem firstSimulation{&firstPhaseLog};
	ecs_scheduler_test::PostSystem firstPost{&firstPhaseLog};
	ecs_scheduler_test::OrderA firstA{&firstPhaseLog};
	ecs_scheduler_test::OrderB firstB{&firstPhaseLog};
	ecs_scheduler_test::OrderC firstC{&firstPhaseLog};
	ecs::SystemRegistry firstSystems;
	firstSystems.Register(firstC);
	firstSystems.Register(firstPost);
	firstSystems.Register(firstA);
	firstSystems.Register(firstPre);
	firstSystems.Register(firstB);
	firstSystems.Register(firstSimulation);
	firstSystems.Finalize(firstWorld.Components());
	ecs::Scheduler firstScheduler(firstWorld, firstSystems, engine::jobs::JobSystemConfig{1});
		firstScheduler.Finalize();

	ecs::World secondWorld;
	RegisterSimulationComponents(secondWorld);
	std::vector<int> secondPhaseLog;
	ecs_scheduler_test::PreSystem secondPre{&secondPhaseLog};
	ecs_scheduler_test::SimulationSystem secondSimulation{&secondPhaseLog};
	ecs_scheduler_test::PostSystem secondPost{&secondPhaseLog};
	ecs_scheduler_test::OrderA secondA{&secondPhaseLog};
	ecs_scheduler_test::OrderB secondB{&secondPhaseLog};
	ecs_scheduler_test::OrderC secondC{&secondPhaseLog};
	ecs::SystemRegistry secondSystems;
	secondSystems.Register(secondSimulation);
	secondSystems.Register(secondB);
	secondSystems.Register(secondPre);
	secondSystems.Register(secondC);
	secondSystems.Register(secondA);
	secondSystems.Register(secondPost);
	secondSystems.Finalize(secondWorld.Components());
	ecs::Scheduler secondScheduler(secondWorld, secondSystems, engine::jobs::JobSystemConfig{1});
		secondScheduler.Finalize();

	BOOST_TEST(firstScheduler.Graph().NodeCount() == secondScheduler.Graph().NodeCount());
	for (ecs::SystemId id = 0; id < firstScheduler.Graph().NodeCount(); ++id)
		BOOST_TEST(firstScheduler.Graph().Edges(id) == secondScheduler.Graph().Edges(id));
	BOOST_TEST(firstScheduler.Graph().HasPath(firstSystems.TryGet<ecs_scheduler_test::OrderA>(),
		firstSystems.TryGet<ecs_scheduler_test::OrderB>()));
	BOOST_TEST(firstScheduler.Graph().HasPath(firstSystems.TryGet<ecs_scheduler_test::OrderA>(),
		firstSystems.TryGet<ecs_scheduler_test::OrderC>()));
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves.size() == 3);
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves[0].size() == 2);
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves[1].size() == 1);
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves[2].size() == 1);

	const ecs::Entity firstEntity = firstWorld.Create<ecs_scheduler_test::Position>();
	const ecs::Entity secondEntity = secondWorld.Create<ecs_scheduler_test::Position>();
	BOOST_TEST(firstWorld.IsAlive(firstEntity));
	BOOST_TEST(secondWorld.IsAlive(secondEntity));
	firstScheduler.Execute(9);
	secondScheduler.Execute(9);
	BOOST_TEST(firstPhaseLog == secondPhaseLog);
	BOOST_TEST(firstPhaseLog.size() == 6);
	BOOST_TEST(firstPhaseLog[0] == 9);
	BOOST_TEST(firstPhaseLog[1] == 1);
	BOOST_TEST(firstPhaseLog[2] == 0);
	BOOST_TEST(firstPhaseLog[3] == 1);
	BOOST_TEST(firstPhaseLog[4] == 2);
	BOOST_TEST(firstPhaseLog[5] == 2);
}

BOOST_AUTO_TEST_CASE(ambiguous_conflicting_systems_are_rejected)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	ecs_scheduler_test::AmbiguousWriteA first;
	ecs_scheduler_test::AmbiguousWriteB second;
	ecs::SystemRegistry systems;
	systems.Register(second);
	systems.Register(first);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems);
	BOOST_CHECK_THROW(scheduler.Finalize(), std::logic_error);
	BOOST_TEST(!scheduler.IsFinalized());
	BOOST_CHECK_THROW(scheduler.Execute(0), std::logic_error);
}

BOOST_AUTO_TEST_CASE(dependency_cycles_have_diagnostics_and_do_not_finalize)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	ecs_scheduler_test::CycleA first;
	ecs_scheduler_test::CycleB second;
	ecs::SystemRegistry systems;
	systems.Register(first);
	systems.Register(second);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems);
	try
	{
		scheduler.Finalize();
		BOOST_FAIL("Expected scheduler cycle validation to fail");
	}
	catch (const std::logic_error &error)
	{
		BOOST_TEST(std::string(error.what()).find("cycle") != std::string::npos);
		BOOST_TEST(std::string(error.what()).find("tests.scheduler.cycle") != std::string::npos);
	}
	BOOST_TEST(!scheduler.IsFinalized());
}

BOOST_AUTO_TEST_CASE(system_queries_execute_over_matching_chunks)
{
	ecs::World world{ecs::WorldConfig{256}};
	RegisterSimulationComponents(world);
	for (int value = 0; value < 32; ++value)
	{
		const ecs::Entity entity = world.Create<ecs_scheduler_test::Position>();
		world.Get<ecs_scheduler_test::Position>(entity)->value = value;
	}

	ecs_scheduler_test::PreSystem system;
	ecs::SystemRegistry systems;
	systems.Register(system);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{1});
	scheduler.Finalize();
	scheduler.Execute(17);
	BOOST_TEST(system.visited == 32);
}

BOOST_AUTO_TEST_CASE(system_commands_commit_at_the_wave_barrier)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	const ecs::Entity entity = world.Create<ecs_scheduler_test::Position>();
	ecs_scheduler_test::BarrierAddSystem add;
	add.target = entity;
	ecs_scheduler_test::BarrierObserveSystem observe;
	ecs::SystemRegistry systems;
	systems.Register(observe);
	systems.Register(add);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{1});
	scheduler.Finalize();

	scheduler.Execute(1);
	BOOST_TEST(observe.observed == 1);
	BOOST_TEST(world.Has<ecs_scheduler_test::Marker>(entity));

	scheduler.Execute(2);
	BOOST_TEST(observe.observed == 2);
}

BOOST_AUTO_TEST_CASE(system_command_buffers_use_deterministic_order_metadata)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	const ecs::Entity entity = world.Create<ecs_scheduler_test::Position>();
	ecs_scheduler_test::OrderedAddSystem add;
	add.target = entity;
	ecs_scheduler_test::OrderedRemoveSystem remove;
	remove.target = entity;
	ecs::SystemRegistry systems;
	systems.Register(remove);
	systems.Register(add);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems);
	scheduler.Finalize();
	scheduler.Execute(1);

	BOOST_TEST(!world.Has<ecs_scheduler_test::Marker>(entity));
}

BOOST_AUTO_TEST_CASE(systems_in_one_wave_do_not_observe_each_others_structural_commands)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	const ecs::Entity entity = world.Create<ecs_scheduler_test::Position>();
	ecs_scheduler_test::BarrierAddSystem add;
	add.target = entity;
	ecs_scheduler_test::SameWaveObserveSystem observe;
	ecs::SystemRegistry systems;
	systems.Register(observe);
	systems.Register(add);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{2});
	scheduler.Finalize();

	scheduler.Execute(1);
	BOOST_TEST(observe.observed.load() == 0);
	BOOST_TEST(world.Has<ecs_scheduler_test::Marker>(entity));
}

BOOST_AUTO_TEST_CASE(compatible_systems_execute_concurrently)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	world.Create<ecs_scheduler_test::Position>();
	std::barrier<> barrier(2);
	ecs_scheduler_test::ParallelBarrierSystemA first;
	ecs_scheduler_test::ParallelBarrierSystemB second;
	first.barrier = &barrier;
	second.barrier = &barrier;
	ecs::SystemRegistry systems;
	systems.Register(second);
	systems.Register(first);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{2});
	scheduler.Finalize();

	scheduler.Execute(1);
	BOOST_TEST(first.chunks.load() == 1);
	BOOST_TEST(second.chunks.load() == 1);
	BOOST_TEST(scheduler.Plan().Phases()[1].waves.size() == 1);
}

BOOST_AUTO_TEST_CASE(one_system_is_split_into_parallel_chunk_jobs)
{
	ecs::World world{ecs::WorldConfig{128}};
	RegisterSimulationComponents(world);
	constexpr std::size_t entityCount = 2048;
	for (std::size_t index = 0; index < entityCount; ++index)
		world.Create<ecs_scheduler_test::Position>();

	ecs_scheduler_test::ParallelChunkSystem system;
	ecs::SystemRegistry systems;
	systems.Register(system);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{4});
	scheduler.Finalize();
	scheduler.Execute(1);

	BOOST_TEST(system.chunkCount.load() > 1);
	BOOST_TEST(system.entityCount.load() == entityCount);
}

struct DeterministicSnapshot
{
	std::vector<int> positions;
	std::vector<std::pair<ecs::Entity, int>> markers;
};

DeterministicSnapshot RunDeterministicWorkload(const std::size_t workerCount)
{
	ecs::World world{ecs::WorldConfig{128}};
	RegisterSimulationComponents(world);
	std::vector<ecs::Entity> initial;
	constexpr std::size_t entityCount = 2048;
	initial.reserve(entityCount);
	for (std::size_t index = 0; index < entityCount; ++index)
	{
		const ecs::Entity entity = world.Create<ecs_scheduler_test::Position>();
		world.Get<ecs_scheduler_test::Position>(entity)->value = static_cast<int>(index);
		initial.push_back(entity);
	}

	ecs_scheduler_test::DeterministicMutationSystem system;
	ecs::SystemRegistry systems;
	systems.Register(system);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{workerCount});
	scheduler.Finalize();
	scheduler.Execute(42);

	DeterministicSnapshot snapshot;
	snapshot.positions.reserve(initial.size());
	for (const ecs::Entity entity : initial)
		snapshot.positions.push_back(world.Get<ecs_scheduler_test::Position>(entity)->value);

	ecs::Query<ecs::Read<ecs_scheduler_test::Marker>> markerQuery(world);
	markerQuery.ForEachChunk([&](auto chunk) {
		const auto values = chunk.Get<ecs_scheduler_test::Marker>();
		const auto entities = chunk.Entities();
		for (std::size_t index = 0; index < values.size(); ++index)
			snapshot.markers.emplace_back(entities[index], values[index].value);
	});
	return snapshot;
}

BOOST_AUTO_TEST_CASE(worker_count_does_not_change_simulation_state_or_deferred_entity_ids)
{
	const DeterministicSnapshot one = RunDeterministicWorkload(1);
	const DeterministicSnapshot two = RunDeterministicWorkload(2);
	const DeterministicSnapshot four = RunDeterministicWorkload(4);

	BOOST_TEST(one.positions == two.positions);
	BOOST_TEST(one.positions == four.positions);
	BOOST_REQUIRE(one.markers.size() == two.markers.size());
	BOOST_REQUIRE(one.markers.size() == four.markers.size());
	for (std::size_t index = 0; index < one.markers.size(); ++index)
	{
		BOOST_TEST(one.markers[index].second == static_cast<int>(index));
		BOOST_TEST(one.markers[index].first.index == two.markers[index].first.index);
		BOOST_TEST(one.markers[index].first.generation == two.markers[index].first.generation);
		BOOST_TEST(one.markers[index].first.index == four.markers[index].first.index);
		BOOST_TEST(one.markers[index].first.generation == four.markers[index].first.generation);
		BOOST_TEST(one.markers[index].second == two.markers[index].second);
		BOOST_TEST(one.markers[index].second == four.markers[index].second);
	}
}

BOOST_AUTO_TEST_CASE(scheduler_waits_for_every_wave_job_before_committing)
{
	ecs::World world{ecs::WorldConfig{128}};
	RegisterSimulationComponents(world);
	constexpr std::size_t entityCount = 2048;
	for (std::size_t index = 0; index < entityCount; ++index)
		world.Create<ecs_scheduler_test::Position>();

	ecs_scheduler_test::DeterministicMutationSystem producer;
	ecs_scheduler_test::WaveCountObserveSystem observer;
	ecs::SystemRegistry systems;
	systems.Register(observer);
	systems.Register(producer);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{4});
	scheduler.Finalize();
	scheduler.Execute(1);

	ecs::Query<ecs::Read<ecs_scheduler_test::Marker>> query(world);
	std::size_t committed = 0;
	query.ForEachChunk([&](auto chunk) { committed += chunk.Count(); });
	BOOST_TEST(committed > 1);
	BOOST_TEST(observer.observed.load() == committed);
}

BOOST_AUTO_TEST_CASE(scheduled_execution_rejects_direct_structural_world_mutation)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	world.Create<ecs_scheduler_test::Position>();
	ecs_scheduler_test::DirectMutationSystem system;
	ecs::SystemRegistry systems;
	systems.Register(system);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{2});
	scheduler.Finalize();

	scheduler.Execute(1);
	BOOST_TEST(system.rejected.load() == 1);
	BOOST_TEST(system.commitRejected.load() == 1);
	BOOST_TEST(world.EntityCount() == 1);
}

BOOST_AUTO_TEST_CASE(job_failure_stops_later_waves_and_fails_scheduler)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	world.Create<ecs_scheduler_test::Position>();
	ecs_scheduler_test::ThrowingSystem throwing;
	ecs_scheduler_test::LaterAfterFailureSystem later;
	ecs::SystemRegistry systems;
	systems.Register(later);
	systems.Register(throwing);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{2});
	scheduler.Finalize();

	BOOST_CHECK_THROW(scheduler.Execute(1), std::runtime_error);
	BOOST_TEST(scheduler.IsFailed());
	BOOST_TEST(later.executed.load() == 0);
	BOOST_CHECK_THROW(scheduler.Execute(2), std::logic_error);
}

BOOST_AUTO_TEST_SUITE_END()
