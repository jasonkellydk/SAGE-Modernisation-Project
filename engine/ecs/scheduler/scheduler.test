	scheduler.Finalize(engine::time::FixedStep{60});

	scheduler.Execute(TestTime(1));
	const auto &probe = ecs_scheduler_test::ProbeOf<ecs_scheduler_test::DirectMutationSystem>(world);
	BOOST_TEST(probe.count.load() == 1);
	BOOST_TEST(probe.extra.load() == 1);
	BOOST_TEST(world.EntityCount() == 1);
}

BOOST_AUTO_TEST_CASE(job_failure_stops_later_waves_and_fails_scheduler)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	world.Create<ecs_scheduler_test::Position>();
	ecs_scheduler_test::ThrowingSystem throwing;
	ecs_scheduler_test::AddProbes<ecs_scheduler_test::LaterAfterFailureSystem>(world);
	ecs_scheduler_test::LaterAfterFailureSystem later;
	ecs::SystemRegistry systems;
	systems.Register(later);
	systems.Register(throwing);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{2});
	scheduler.Finalize(engine::time::FixedStep{60});

	BOOST_CHECK_THROW(scheduler.Execute(TestTime(1)), std::runtime_error);
	BOOST_TEST(scheduler.IsFailed());
	BOOST_TEST(ecs_scheduler_test::ProbeOf<ecs_scheduler_test::LaterAfterFailureSystem>(world).count.load() == 0);
	BOOST_CHECK_THROW(scheduler.Execute(TestTime(2)), std::logic_error);
}

BOOST_AUTO_TEST_SUITE_END()

namespace ecs_batch_test
{
// The seed batch probe: its job system and caller in, what it saw out.
struct SeedProbe
{
    engine::jobs::JobSystem *jobs{nullptr};
    std::thread::id caller;
    unsigned calls{};
    bool guarded{}, onCaller{}, fail{};
};
}
namespace ecs
{
template<> struct ResourceTraits<ecs_batch_test::SeedProbe>
{
    static constexpr std::string_view StableName = "tests.batch.probe.seed";
};
}
namespace ecs_batch_test
{
using ecs_scheduler_test::Probe;
struct Seed
{
    using Query = ecs::Query<ecs::Write<ecs_scheduler_test::Marker>>;
    using Resources = ecs::Resources<ecs::Write<SeedProbe>>;
    void Execute(ecs::SystemContext &context) const
    {
        SeedProbe &probe = context.Write<SeedProbe>();
        ++probe.calls;
        probe.onCaller = probe.caller == std::this_thread::get_id();
        try { context.GetWorld().Create(); }
        catch (const std::logic_error &) { probe.guarded = true; }
        unsigned result{};
        engine::jobs::Job work{[](void *value) { ++*static_cast<unsigned *>(value); }, &result};
        probe.jobs->Execute(std::span<engine::jobs::Job>(&work, 1));
        if (result != 1) throw std::logic_error("Joined batch work did not complete");
        const auto entity = context.Commands().Create();
        context.Commands().Add<ecs_scheduler_test::Marker>(entity, ecs_scheduler_test::Marker{42});
        if (probe.fail) throw std::runtime_error("batch failure");
    }
};
struct Observe
{
    static constexpr std::string_view ProbeName = "tests.batch.probe.observe";
    using Query = ecs::Query<ecs::Read<ecs_scheduler_test::Marker>>;
    using Resources = ecs::Resources<ecs::Write<Probe<Observe>>>;
    void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
    { context.Write<Probe<Observe>>().count.fetch_add(chunk.Count()); }
};
struct DeferredMarker
{
    using Query = ecs::Query<ecs::Read<ecs_scheduler_test::Position>>;
    void Execute(Query::Chunk chunk, ecs::SystemContext &context)
    {
        for (const auto entity : chunk.Entities())
            context.Commands().Add<ecs_scheduler_test::Marker>(entity, ecs_scheduler_test::Marker{7});
    }
};
struct IndependentBatch
{
    static constexpr std::string_view ProbeName = "tests.batch.probe.independent";
    using Query = ecs::Query<ecs::Read<ecs_scheduler_test::Velocity>>;
    using Resources = ecs::Resources<ecs::Write<Probe<IndependentBatch>>>;
    void Execute(ecs::SystemContext &context) const { context.Write<Probe<IndependentBatch>>().count.fetch_add(1); }
};

inline ecs_batch_test::SeedProbe &AddSeedProbe(ecs::World &world, engine::jobs::JobSystem &jobs)
{
    ecs_batch_test::SeedProbe &probe = world.EmplaceResource<ecs_batch_test::SeedProbe>();
    probe.jobs = &jobs;
    probe.caller = std::this_thread::get_id();
    return probe;
}
}
namespace ecs
{
template<> struct SystemTraits<ecs_batch_test::Seed>
{
    static constexpr std::string_view StableName = "tests.batch.seed";
    static constexpr SystemPhase Phase = SystemPhase::PreSimulation;
    static constexpr bool Batch = true;
    static constexpr bool BorrowsJobs = true; // it runs pool work of its own, on the caller
    using Before = SystemTypeList<>;
    using After = SystemTypeList<>;
};
template<> struct SystemTraits<ecs_batch_test::Observe>
{
    static constexpr std::string_view StableName = "tests.batch.observe";
    static constexpr SystemPhase Phase = SystemPhase::PostSimulation;
    using Before = SystemTypeList<>;
    using After = SystemTypeList<>;
};
template<> struct SystemTraits<ecs_batch_test::DeferredMarker>
{
    static constexpr std::string_view StableName = "tests.batch.deferred_marker";
    static constexpr SystemPhase Phase = SystemPhase::Simulation;
    using Before = SystemTypeList<>; using After = SystemTypeList<>;
};
template<> struct SystemTraits<ecs_batch_test::IndependentBatch>
{
    static constexpr std::string_view StableName = "tests.batch.independent";
    static constexpr SystemPhase Phase = SystemPhase::Simulation;
    static constexpr bool Batch = true;
    using Before = SystemTypeList<>; using After = SystemTypeList<>;
};
}

BOOST_AUTO_TEST_SUITE(ecs_composed_batch)
BOOST_AUTO_TEST_CASE(independent_batch_does_not_split_ready_wave_structural_visibility)
{
    for (const std::size_t workers : {1u, 2u, 4u})
    {
        ecs::World world; world.RegisterComponent<ecs_scheduler_test::Position>();
        world.RegisterComponent<ecs_scheduler_test::Marker>(); world.RegisterComponent<ecs_scheduler_test::Velocity>();
        world.FinalizeComponents(); world.Create<ecs_scheduler_test::Position>();
        ecs_scheduler_test::AddProbes<ecs_batch_test::IndependentBatch, ecs_batch_test::Observe>(world);
        const auto &calls = ecs_scheduler_test::ProbeOf<ecs_batch_test::IndependentBatch>(world).count;
        const auto &observed = ecs_scheduler_test::ProbeOf<ecs_batch_test::Observe>(world).count;
        ecs_batch_test::DeferredMarker producer;
        ecs_batch_test::IndependentBatch batch;
        ecs_batch_test::Observe observer;
        ecs::SystemRegistry systems;
        systems.Register(producer); systems.Register(batch); systems.Register(observer, ecs::SystemPhase::Simulation);
        systems.Finalize(world.Components());
        ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{workers});
        scheduler.Finalize(engine::time::FixedStep{60});
        const auto &waves = scheduler.Plan().Phases()[1].waves;
        BOOST_REQUIRE(waves.size() == 1u); BOOST_TEST(waves.front().size() == 3u);
        scheduler.Execute(TestTime(0));
        BOOST_TEST(calls.load() == 1u); BOOST_TEST(observed.load() == 0u);
        scheduler.Execute(TestTime(1));
        BOOST_TEST(calls.load() == 2u); BOOST_TEST(observed.load() == 1u);
    }
}
BOOST_AUTO_TEST_CASE(batch_runs_without_entities_on_caller_and_commits_before_dependent_chunks)
{
    for (const std::size_t workers : {1u, 2u, 4u})
    {
        ecs::World world;
        world.RegisterComponent<ecs_scheduler_test::Marker>(); world.FinalizeComponents();
        engine::jobs::JobSystem jobs({workers});
        const ecs_batch_test::SeedProbe &probe = ecs_batch_test::AddSeedProbe(world, jobs);
        ecs_scheduler_test::AddProbes<ecs_batch_test::Observe>(world);
        const auto &observed = ecs_scheduler_test::ProbeOf<ecs_batch_test::Observe>(world).count;
        ecs_batch_test::Seed seed;
        ecs_batch_test::Observe observer;
        ecs::SystemRegistry systems;
        systems.OrderBefore<ecs_batch_test::Seed, ecs_batch_test::Observe>();
        if (workers == 2)
        { systems.Register(observer, ecs::SystemPhase::Simulation); systems.Register(seed, ecs::SystemPhase::Simulation); }
        else
        { systems.Register(seed, ecs::SystemPhase::Simulation); systems.Register(observer, ecs::SystemPhase::Simulation); }
        systems.Finalize(world.Components());
        ecs::Scheduler scheduler(world, systems, jobs); scheduler.Finalize(engine::time::FixedStep{60});
        const auto &waves = scheduler.Plan().Phases()[1].waves;
        BOOST_REQUIRE_EQUAL(waves.size(), 2u);
        BOOST_TEST(waves.front().size() == 1u);
        scheduler.Execute(TestTime(0));
        BOOST_TEST(probe.calls == 1u); BOOST_TEST(probe.guarded); BOOST_TEST(probe.onCaller);
        BOOST_TEST(observed.load() == 1u);
        scheduler.Execute(TestTime(1));
        BOOST_TEST(probe.calls == 2u); BOOST_TEST(observed.load() == 3u);
    }
}
BOOST_AUTO_TEST_CASE(batch_failure_skips_commit_and_later_nodes)
{
    ecs::World world; world.RegisterComponent<ecs_scheduler_test::Marker>(); world.FinalizeComponents();
    engine::jobs::JobSystem jobs({2}); ecs_batch_test::AddSeedProbe(world, jobs).fail = true;
    ecs_scheduler_test::AddProbes<ecs_batch_test::Observe>(world);
    ecs_batch_test::Seed seed; ecs_batch_test::Observe observer; ecs::SystemRegistry systems;
    systems.Register(seed); systems.Register(observer);
    systems.OrderBefore<ecs_batch_test::Seed, ecs_batch_test::Observe>(); systems.Finalize(world.Components());
    ecs::Scheduler scheduler(world, systems, jobs); scheduler.Finalize(engine::time::FixedStep{60});
    BOOST_CHECK_THROW(scheduler.Execute(TestTime(0)), std::runtime_error);
    BOOST_TEST(scheduler.IsFailed()); BOOST_TEST(world.EntityCount() == 0u);
    BOOST_TEST(ecs_scheduler_test::ProbeOf<ecs_batch_test::Observe>(world).count.load() == 0u);
    BOOST_TEST(!world.IsScheduledExecutionActive());
    BOOST_CHECK_THROW(scheduler.Execute(TestTime(1)), std::logic_error);
}
BOOST_AUTO_TEST_CASE(batch_does_not_hide_ambiguous_component_conflicts)
{
    ecs::World world; world.RegisterComponent<ecs_scheduler_test::Marker>(); world.FinalizeComponents();
    engine::jobs::JobSystem jobs({1}); ecs_batch_test::AddSeedProbe(world, jobs);
    ecs_batch_test::Seed seed; ecs_batch_test::Observe observer; ecs::SystemRegistry systems;
    systems.Register(seed, ecs::SystemPhase::Simulation); systems.Register(observer, ecs::SystemPhase::Simulation);
    systems.Finalize(world.Components()); ecs::Scheduler scheduler(world, systems, jobs);
    BOOST_CHECK_THROW(scheduler.Finalize(engine::time::FixedStep{60}), std::logic_error);
    BOOST_TEST(!scheduler.IsFinalized());
}
BOOST_AUTO_TEST_CASE(composition_ordering_is_startup_only_and_validates_missing_nodes_and_cycles)
{
    ecs::World world; world.RegisterComponent<ecs_scheduler_test::Marker>(); world.FinalizeComponents();
    engine::jobs::JobSystem jobs({1}); ecs_batch_test::AddSeedProbe(world, jobs);
    ecs_batch_test::Seed seed; ecs_batch_test::Observe observer;
    for (bool cycle : {false, true})
    {
        ecs::SystemRegistry systems;
        systems.Register(seed, ecs::SystemPhase::Simulation);
        systems.OrderBefore<ecs_batch_test::Seed, ecs_batch_test::Observe>();
        if (cycle)
        {
            systems.Register(observer, ecs::SystemPhase::Simulation);
            systems.OrderBefore<ecs_batch_test::Observe, ecs_batch_test::Seed>();
        }
        systems.Finalize(world.Components());
        BOOST_CHECK_THROW((systems.OrderBefore<ecs_batch_test::Seed, ecs_batch_test::Observe>()), std::logic_error);
        ecs::Scheduler scheduler(world, systems, jobs);
        BOOST_CHECK_THROW(scheduler.Finalize(engine::time::FixedStep{60}), std::logic_error);
        BOOST_TEST(!scheduler.IsFinalized());
    }
}
BOOST_AUTO_TEST_SUITE_END()
#include <algorithm>

namespace ecs_lifecycle_test
{
// The cohesive system probe: the total entity and failure mode in, the hook
// calls and per-chunk visits out. Chunk jobs touch distinct visit slots.
struct CohesiveProbe
{
    ecs::Entity totalEntity;
    unsigned beforeCalls{}, afterCalls{};
    unsigned failure{}; // 1=before, 2=chunk, 3=after
    std::vector<unsigned> visits;
};
}
namespace ecs
{
template<> struct ResourceTraits<ecs_lifecycle_test::CohesiveProbe>
{
    static constexpr std::string_view StableName = "tests.lifecycle.probe.cohesive";
};
}
namespace ecs_lifecycle_test
{
using ecs_scheduler_test::Probe;
struct Cohesive
{
    using Query = ecs::Query<ecs::Write<ecs_scheduler_test::Position>>;
    using AuxiliaryAccess = ecs::Query<ecs::Read<ecs_scheduler_test::Position>, ecs::Write<ecs_scheduler_test::Velocity>>;
    using Resources = ecs::Resources<ecs::Write<CohesiveProbe>>;
    static void Record(ecs::SystemContext &context, int value)
    {
        auto entity = context.Commands().Create();
        context.Commands().Add<ecs_scheduler_test::Marker>(entity, ecs_scheduler_test::Marker{value});
    }
    void BeforeChunks(Query &query, ecs::SystemContext &context) const
    {
        CohesiveProbe &probe = context.Write<CohesiveProbe>();
        ++probe.beforeCalls;
        probe.visits.assign(query.PrepareChunks(), 0);
        if (!context.GetWorld().IsScheduledExecutionActive()) throw std::logic_error("unguarded before hook");
        if (context.JobOrder() != 0) throw std::logic_error("invalid before order");
        Record(context, -1);
        if (probe.failure == 1) throw std::runtime_error("before failure");
    }
    void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
    {
        CohesiveProbe &probe = context.Write<CohesiveProbe>();
        if (probe.beforeCalls != 1 || context.JobOrder() != context.ChunkOrder() + 1)
            throw std::logic_error("invalid chunk lifecycle");
        probe.visits.at(context.ChunkOrder()) += static_cast<unsigned>(chunk.Count());
        for (auto &position : chunk.Get<ecs_scheduler_test::Position>()) ++position.value;
        Record(context, static_cast<int>(context.ChunkOrder()));
        if (probe.failure == 2) throw std::runtime_error("chunk failure");
    }
    void AfterChunks(Query &, ecs::SystemContext &context) const
    {
        CohesiveProbe &probe = context.Write<CohesiveProbe>();
        ++probe.afterCalls;
        if (!context.GetWorld().IsScheduledExecutionActive()) throw std::logic_error("unguarded after hook");
        unsigned sum = 0;
        for (unsigned count : probe.visits) sum += count;
        context.GetWorld().Get<ecs_scheduler_test::Velocity>(probe.totalEntity)->value = static_cast<int>(sum);
        if (context.JobOrder() != probe.visits.size() + 1) throw std::logic_error("invalid after order");
        Record(context, -2);
        if (probe.failure == 3) throw std::runtime_error("after failure");
    }
};
struct Observe
{
    static constexpr std::string_view ProbeName = "tests.lifecycle.probe.observe";
    using Query = ecs::Query<ecs::Read<ecs_scheduler_test::Marker>>;
    using Resources = ecs::Resources<ecs::Write<Probe<Observe>>>;
    void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
    { context.Write<Probe<Observe>>().count.fetch_add(chunk.Count()); }
};

inline const CohesiveProbe &AddProbes(ecs::World &world, ecs::Entity total, unsigned failure = 0)
{
    CohesiveProbe &probe = world.EmplaceResource<CohesiveProbe>();
    probe.totalEntity = total;
    probe.failure = failure;
    ecs_scheduler_test::AddProbes<Observe>(world);
    return probe;
}
}
namespace ecs
{
template<> struct SystemTraits<ecs_lifecycle_test::Cohesive>
{
    static constexpr std::string_view StableName = "tests.lifecycle.cohesive";
    static constexpr SystemPhase Phase = SystemPhase::Simulation;
    using Before = SystemTypeList<>; using After = SystemTypeList<>;
};
template<> struct SystemTraits<ecs_lifecycle_test::Observe>
{
    static constexpr std::string_view StableName = "tests.lifecycle.observe";
    static constexpr SystemPhase Phase = SystemPhase::Simulation;
    using Before = SystemTypeList<>; using After = SystemTypeList<>;
};
}
BOOST_AUTO_TEST_SUITE(ecs_cohesive_lifecycle)
BOOST_AUTO_TEST_CASE(one_node_runs_hooks_once_and_commits_in_canonical_order_across_worker_counts)
{
    for (const unsigned entities : {0u, 5000u})
    {
        std::vector<std::uint64_t> expected;
        for (const unsigned workers : {1u, 2u, 4u})
        {
            ecs::World world;
            world.RegisterComponent<ecs_scheduler_test::Position>(); world.RegisterComponent<ecs_scheduler_test::Velocity>();
            world.RegisterComponent<ecs_scheduler_test::Marker>(); world.FinalizeComponents();
            const auto total = world.Create<ecs_scheduler_test::Velocity>();
            for (unsigned i=0; i!=entities; ++i) world.Create<ecs_scheduler_test::Position>();
            const auto &probe = ecs_lifecycle_test::AddProbes(world, total);
            const auto &observed = ecs_scheduler_test::ProbeOf<ecs_lifecycle_test::Observe>(world).count;
            ecs_lifecycle_test::Cohesive system; ecs_lifecycle_test::Observe observer;
            ecs::SystemRegistry registry; registry.Register(system); registry.Register(observer);
            registry.OrderBefore<ecs_lifecycle_test::Cohesive, ecs_lifecycle_test::Observe>();
            registry.Finalize(world.Components());
            const auto &access = registry.Get(registry.TryGet<ecs_lifecycle_test::Cohesive>()).Access();
            BOOST_TEST(access.WriteComponents().size() == 2u);
            BOOST_TEST(access.ReadComponents().empty());
            ecs::Scheduler scheduler(world, registry, engine::jobs::JobSystemConfig{workers});
            scheduler.Finalize(engine::time::FixedStep{60});
            BOOST_TEST(scheduler.Plan().Phases()[1].waves.front().size() == 1u);
            scheduler.Execute(TestTime(0));
            BOOST_TEST(probe.beforeCalls == 1u); BOOST_TEST(probe.afterCalls == 1u);
            BOOST_TEST(world.Get<ecs_scheduler_test::Velocity>(total)->value == static_cast<int>(entities));
            BOOST_TEST(observed.load() == probe.visits.size() + 2);
            if (entities) BOOST_TEST(probe.visits.size() > 1u);
            std::vector<std::uint64_t> result;
            ecs::Query<ecs::Read<ecs_scheduler_test::Marker>> markers(world);
            markers.ForEachChunk([&](auto chunk) {
                const auto values = chunk.template Get<ecs_scheduler_test::Marker>();
                for (std::size_t row=0; row!=chunk.Count(); ++row) {
                    result.push_back(chunk.Entities()[row].index);
                    result.push_back(chunk.Entities()[row].generation);
                    result.push_back(static_cast<std::uint64_t>(values[row].value));
                }
            });
            BOOST_REQUIRE(result.size() >= 6u);
            BOOST_TEST(result[2] == static_cast<std::uint64_t>(-1));
            BOOST_TEST(result.back() == static_cast<std::uint64_t>(-2));
            if (workers==1) expected=result; else BOOST_CHECK(result==expected);
        }
    }
}
BOOST_AUTO_TEST_CASE(hook_and_chunk_failures_discard_the_wave_and_prevent_reexecution)
{
    for (const unsigned failure : {1u,2u,3u})
    {
        ecs::World world;
        world.RegisterComponent<ecs_scheduler_test::Position>(); world.RegisterComponent<ecs_scheduler_test::Velocity>();
        world.RegisterComponent<ecs_scheduler_test::Marker>(); world.FinalizeComponents();
        const auto total = world.Create<ecs_scheduler_test::Velocity>(); world.Create<ecs_scheduler_test::Position>();
        const auto &probe = ecs_lifecycle_test::AddProbes(world, total, failure);
        ecs_lifecycle_test::Cohesive system;
        ecs_lifecycle_test::Observe observer; ecs::SystemRegistry registry;
        registry.Register(system); registry.Register(observer);
        registry.OrderBefore<ecs_lifecycle_test::Cohesive,ecs_lifecycle_test::Observe>();
        registry.Finalize(world.Components());
        ecs::Scheduler scheduler(world,registry,engine::jobs::JobSystemConfig{4});
        scheduler.Finalize(engine::time::FixedStep{60});
        BOOST_CHECK_THROW(scheduler.Execute(TestTime(0)), std::runtime_error);
        BOOST_TEST(scheduler.IsFailed()); BOOST_TEST(!world.IsScheduledExecutionActive());
        BOOST_TEST(world.EntityCount()==2u); BOOST_TEST(ecs_scheduler_test::ProbeOf<ecs_lifecycle_test::Observe>(world).count.load()==0u);
        BOOST_TEST(probe.afterCalls==(failure==3 ? 1u : 0u));
        BOOST_CHECK_THROW(scheduler.Execute(TestTime(1)), std::logic_error);
    }
}
BOOST_AUTO_TEST_SUITE_END()
