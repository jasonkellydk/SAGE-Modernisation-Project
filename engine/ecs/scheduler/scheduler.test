struct DeterministicSnapshot
{
	std::vector<int> positions;
	std::vector<std::pair<ecs::Entity, int>> markers;
};

DeterministicSnapshot RunDeterministicWorkload(const std::size_t workerCount)
{
	ecs::World world{ecs::WorldConfig{128}};
	RegisterSimulationComponents(world);
	std::vector<ecs::Entity> initial;
	constexpr std::size_t entityCount = 2048;
	initial.reserve(entityCount);
	for (std::size_t index = 0; index < entityCount; ++index)
	{
		const ecs::Entity entity = world.Create<ecs_scheduler_test::Position>();
		world.Get<ecs_scheduler_test::Position>(entity)->value = static_cast<int>(index);
		initial.push_back(entity);
	}

	ecs_scheduler_test::DeterministicMutationSystem system;
	ecs::SystemRegistry systems;
	systems.Register(system);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{workerCount});
	scheduler.Finalize(engine::time::FixedStep{60});
	scheduler.Execute(TestTime(42));

	DeterministicSnapshot snapshot;
	snapshot.positions.reserve(initial.size());
	for (const ecs::Entity entity : initial)
		snapshot.positions.push_back(world.Get<ecs_scheduler_test::Position>(entity)->value);

	ecs::Query<ecs::Read<ecs_scheduler_test::Marker>> markerQuery(world);
	markerQuery.ForEachChunk([&](auto chunk) {
		const auto values = chunk.template Get<ecs_scheduler_test::Marker>();
		const auto entities = chunk.Entities();
		for (std::size_t index = 0; index < values.size(); ++index)
			snapshot.markers.emplace_back(entities[index], values[index].value);
	});
	return snapshot;
}

BOOST_AUTO_TEST_CASE(worker_count_does_not_change_simulation_state_or_deferred_entity_ids)
{
	const DeterministicSnapshot one = RunDeterministicWorkload(1);
	const DeterministicSnapshot two = RunDeterministicWorkload(2);
	const DeterministicSnapshot four = RunDeterministicWorkload(4);

	BOOST_TEST(one.positions == two.positions);
	BOOST_TEST(one.positions == four.positions);
	BOOST_REQUIRE(one.markers.size() == two.markers.size());
	BOOST_REQUIRE(one.markers.size() == four.markers.size());
	for (std::size_t index = 0; index < one.markers.size(); ++index)
	{
		BOOST_TEST(one.markers[index].second == static_cast<int>(index));
		BOOST_TEST(one.markers[index].first.index == two.markers[index].first.index);
		BOOST_TEST(one.markers[index].first.generation == two.markers[index].first.generation);
		BOOST_TEST(one.markers[index].first.index == four.markers[index].first.index);
		BOOST_TEST(one.markers[index].first.generation == four.markers[index].first.generation);
		BOOST_TEST(one.markers[index].second == two.markers[index].second);
		BOOST_TEST(one.markers[index].second == four.markers[index].second);
	}
}

BOOST_AUTO_TEST_CASE(explicit_delta_reaches_all_chunk_jobs_independently_of_workers_and_render_reads)
{
	auto run = [](std::size_t workers, int renderReads) {
		ecs::World world{ecs::WorldConfig{256}};
		RegisterSimulationComponents(world);
		std::vector<ecs::Entity> entities;
		for (int index = 0; index < 2048; ++index)
		{
			const auto entity = world.Create<ecs_scheduler_test::Position, ecs_scheduler_test::Velocity>();
			world.Get<ecs_scheduler_test::Position>(entity)->value = index;
			world.Get<ecs_scheduler_test::Velocity>(entity)->value = 120;
			entities.push_back(entity);
		}
		ecs_scheduler_test::TimeIntegrationSystem system;
		ecs::SystemRegistry systems;
		systems.Register(system);
		systems.Finalize(world.Components());
		ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{workers});
		scheduler.Finalize(engine::time::FixedStep{60});
		for (std::uint64_t tick = 0; tick < 7; ++tick)
		{
			const auto time = TestTime(tick);
			for (int render = 0; render < renderReads; ++render)
				BOOST_TEST(time.Tick() == tick);
			scheduler.Execute(time);
		}
		DeterministicSnapshot result;
		for (std::size_t index = 0; index < entities.size(); ++index)
		{
			const int value = world.Get<ecs_scheduler_test::Position>(entities[index])->value;
			BOOST_TEST(value == static_cast<int>(index) + 14);
			result.positions.push_back(value);
		}
		ecs::Query<ecs::Read<ecs_scheduler_test::Marker>> query(world);
		query.ForEachChunk([&](auto chunk) {
			const auto markers = chunk.template Get<ecs_scheduler_test::Marker>();
			for (std::size_t index = 0; index < markers.size(); ++index)
				result.markers.emplace_back(chunk.Entities()[index], markers[index].value);
		});
		BOOST_TEST(result.markers.size() > 7u);
		return result;
	};
	const auto one = run(1, 0);
	const auto two = run(2, 3);
	const auto four = run(4, 11);
	BOOST_CHECK(one.positions == two.positions);
	BOOST_CHECK(one.positions == four.positions);
	BOOST_CHECK(one.markers == two.markers);
	BOOST_CHECK(one.markers == four.markers);
}

BOOST_AUTO_TEST_CASE(step_rate_is_bound_at_finalization_and_mismatches_do_not_execute)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	const auto entity = world.Create<ecs_scheduler_test::Position, ecs_scheduler_test::Velocity>();
	world.Get<ecs_scheduler_test::Velocity>(entity)->value = 120;
	ecs_scheduler_test::TimeIntegrationSystem system;
	ecs::SystemRegistry systems;
	systems.Register(system);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{1});
	scheduler.Finalize(engine::time::FixedStep{30});
	BOOST_CHECK_NO_THROW(scheduler.Finalize(engine::time::FixedStep{30}));
	BOOST_CHECK_THROW(scheduler.Finalize(engine::time::FixedStep{60}), std::logic_error);
	BOOST_CHECK_THROW(scheduler.Execute(TestTime(1)), std::invalid_argument);
	BOOST_TEST(!scheduler.IsFailed());
	BOOST_TEST(world.EntityCount() == 1u);
	BOOST_TEST(world.Get<ecs_scheduler_test::Position>(entity)->value == 0);
	scheduler.Execute(engine::time::SimulationTime{1, engine::time::FixedStep{30}});
	BOOST_TEST(world.Get<ecs_scheduler_test::Position>(entity)->value == 4);
}

BOOST_AUTO_TEST_CASE(scheduler_waits_for_every_wave_job_before_committing)
{
	ecs::World world{ecs::WorldConfig{128}};
	RegisterSimulationComponents(world);
	constexpr std::size_t entityCount = 2048;
	for (std::size_t index = 0; index < entityCount; ++index)
		world.Create<ecs_scheduler_test::Position>();

	ecs_scheduler_test::DeterministicMutationSystem producer;
	ecs_scheduler_test::AddProbes<ecs_scheduler_test::WaveCountObserveSystem>(world);
	ecs_scheduler_test::WaveCountObserveSystem observer;
	ecs::SystemRegistry systems;
	systems.Register(observer);
	systems.Register(producer);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems, engine::jobs::JobSystemConfig{4});
	scheduler.Finalize(engine::time::FixedStep{60});
	scheduler.Execute(TestTime(1));

	ecs::Query<ecs::Read<ecs_scheduler_test::Marker>> query(world);
	std::size_t committed = 0;
	query.ForEachChunk([&](auto chunk) { committed += chunk.Count(); });
	BOOST_TEST(committed > 1);
	BOOST_TEST(ecs_scheduler_test::ProbeOf<ecs_scheduler_test::WaveCountObserveSystem>(world).count.load() == committed);
}

BOOST_AUTO_TEST_CASE(scheduled_execution_rejects_direct_structural_world_mutation)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	world.Create<ecs_scheduler_test::Position>();
	ecs_scheduler_test::AddProbes<ecs_scheduler_test::DirectMutationSystem>(world);
