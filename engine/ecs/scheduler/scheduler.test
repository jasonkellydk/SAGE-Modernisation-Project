namespace
{

void RegisterSimulationComponents(ecs::World &world)
{
	world.RegisterComponent<ecs_scheduler_test::Position>();
	world.RegisterComponent<ecs_scheduler_test::Velocity>();
	world.RegisterComponent<ecs_scheduler_test::Marker>();
	world.FinalizeComponents();
}

// Gives each phase/order system its own probe, all logging into `log`.
template<typename... Systems>
void AttachLog(ecs::World &world, std::vector<int> &log)
{
	ecs_scheduler_test::AddProbes<Systems...>(world);
	((ecs_scheduler_test::ProbeOf<Systems>(world).log = &log), ...);
}

} // namespace

BOOST_AUTO_TEST_SUITE(ecs_scheduler)

BOOST_AUTO_TEST_CASE(systems_are_explicitly_finalized_before_scheduler_use)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	ecs_scheduler_test::AddProbes<ecs_scheduler_test::PreSystem>(world);
	ecs_scheduler_test::PreSystem pre;
	ecs::SystemRegistry systems;
	systems.Register(pre);
	ecs::Scheduler scheduler(world, systems);
	BOOST_CHECK_THROW(scheduler.Finalize(engine::time::FixedStep{60}), std::logic_error);
	BOOST_TEST(!scheduler.IsFinalized());
	BOOST_CHECK_THROW(scheduler.Execute(TestTime(1)), std::logic_error);

	systems.Finalize(world.Components());
	BOOST_TEST(systems.IsFrozen());
	scheduler.Finalize(engine::time::FixedStep{60});
	BOOST_TEST(scheduler.IsFinalized());
}

BOOST_AUTO_TEST_CASE(scheduler_rejects_a_different_component_schema)
{
	ecs::World registeredWorld;
	registeredWorld.RegisterComponent<ecs_scheduler_test::Position>();
	registeredWorld.FinalizeComponents();
	ecs_scheduler_test::PreSystem pre;
	ecs::SystemRegistry systems;
	systems.Register(pre);
	systems.Finalize(registeredWorld.Components());

	ecs::World differentWorld;
	RegisterSimulationComponents(differentWorld);
	ecs::Scheduler scheduler(differentWorld, systems);
	BOOST_CHECK_THROW(scheduler.Finalize(engine::time::FixedStep{60}), std::logic_error);
	BOOST_TEST(!scheduler.IsFinalized());
}

BOOST_AUTO_TEST_CASE(read_read_and_unrelated_accesses_share_a_wave)
{
	ecs::World world;
	RegisterSimulationComponents(world);
	ecs_scheduler_test::AddProbes<ecs_scheduler_test::SimulationSystem>(world);
	ecs_scheduler_test::SimulationSystem simulation;
	ecs_scheduler_test::UnrelatedSystem unrelated;
	ecs::SystemRegistry systems;
	systems.Register(unrelated);
	systems.Register(simulation);
	systems.Finalize(world.Components());
	ecs::Scheduler scheduler(world, systems);
	scheduler.Finalize(engine::time::FixedStep{60});

	const auto &waves = scheduler.Plan().Phases()[1].waves;
	BOOST_TEST(waves.size() == 1);
	BOOST_TEST(waves[0].size() == 2);
}

BOOST_AUTO_TEST_CASE(phases_and_explicit_transitive_ordering_are_deterministic)
{
	ecs::World firstWorld;
	RegisterSimulationComponents(firstWorld);
	std::vector<int> firstPhaseLog;
	AttachLog<ecs_scheduler_test::PreSystem, ecs_scheduler_test::SimulationSystem, ecs_scheduler_test::PostSystem,
		ecs_scheduler_test::OrderA, ecs_scheduler_test::OrderB, ecs_scheduler_test::OrderC>(firstWorld, firstPhaseLog);
	ecs_scheduler_test::PreSystem firstPre;
	ecs_scheduler_test::SimulationSystem firstSimulation;
	ecs_scheduler_test::PostSystem firstPost;
	ecs_scheduler_test::OrderA firstA;
	ecs_scheduler_test::OrderB firstB;
	ecs_scheduler_test::OrderC firstC;
	ecs::SystemRegistry firstSystems;
	firstSystems.Register(firstC);
	firstSystems.Register(firstPost);
	firstSystems.Register(firstA);
	firstSystems.Register(firstPre);
	firstSystems.Register(firstB);
	firstSystems.Register(firstSimulation);
	firstSystems.Finalize(firstWorld.Components());
	ecs::Scheduler firstScheduler(firstWorld, firstSystems, engine::jobs::JobSystemConfig{1});
		firstScheduler.Finalize(engine::time::FixedStep{60});

	ecs::World secondWorld;
	RegisterSimulationComponents(secondWorld);
	std::vector<int> secondPhaseLog;
	AttachLog<ecs_scheduler_test::PreSystem, ecs_scheduler_test::SimulationSystem, ecs_scheduler_test::PostSystem,
		ecs_scheduler_test::OrderA, ecs_scheduler_test::OrderB, ecs_scheduler_test::OrderC>(secondWorld, secondPhaseLog);
	ecs_scheduler_test::PreSystem secondPre;
	ecs_scheduler_test::SimulationSystem secondSimulation;
	ecs_scheduler_test::PostSystem secondPost;
	ecs_scheduler_test::OrderA secondA;
	ecs_scheduler_test::OrderB secondB;
	ecs_scheduler_test::OrderC secondC;
	ecs::SystemRegistry secondSystems;
	secondSystems.Register(secondSimulation);
	secondSystems.Register(secondB);
	secondSystems.Register(secondPre);
	secondSystems.Register(secondC);
	secondSystems.Register(secondA);
	secondSystems.Register(secondPost);
	secondSystems.Finalize(secondWorld.Components());
	ecs::Scheduler secondScheduler(secondWorld, secondSystems, engine::jobs::JobSystemConfig{1});
		secondScheduler.Finalize(engine::time::FixedStep{60});

	BOOST_TEST(firstScheduler.Graph().NodeCount() == secondScheduler.Graph().NodeCount());
	for (ecs::SystemId id = 0; id < firstScheduler.Graph().NodeCount(); ++id)
		BOOST_TEST(firstScheduler.Graph().Edges(id) == secondScheduler.Graph().Edges(id));
	BOOST_TEST(firstScheduler.Graph().HasPath(firstSystems.TryGet<ecs_scheduler_test::OrderA>(),
		firstSystems.TryGet<ecs_scheduler_test::OrderB>()));
	BOOST_TEST(firstScheduler.Graph().HasPath(firstSystems.TryGet<ecs_scheduler_test::OrderA>(),
		firstSystems.TryGet<ecs_scheduler_test::OrderC>()));
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves.size() == 3);
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves[0].size() == 2);
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves[1].size() == 1);
	BOOST_TEST(firstScheduler.Plan().Phases()[1].waves[2].size() == 1);

	const ecs::Entity firstEntity = firstWorld.Create<ecs_scheduler_test::Position>();
	const ecs::Entity secondEntity = secondWorld.Create<ecs_scheduler_test::Position>();
	BOOST_TEST(firstWorld.IsAlive(firstEntity));
	BOOST_TEST(secondWorld.IsAlive(secondEntity));
	firstScheduler.Execute(TestTime(9));
	secondScheduler.Execute(TestTime(9));
	// The first simulation wave's two systems run side by side (the waiting caller helps the worker), so their
	// order within the wave is not defined; everything else is.
	BOOST_TEST_REQUIRE(firstPhaseLog.size() == 6);
	BOOST_TEST_REQUIRE(secondPhaseLog.size() == 6);
	std::sort(firstPhaseLog.begin() + 1, firstPhaseLog.begin() + 3);
	std::sort(secondPhaseLog.begin() + 1, secondPhaseLog.begin() + 3);
	BOOST_TEST(firstPhaseLog == secondPhaseLog);
	BOOST_TEST(firstPhaseLog[0] == 9);
	BOOST_TEST(firstPhaseLog[1] == 0);
	BOOST_TEST(firstPhaseLog[2] == 1);
	BOOST_TEST(firstPhaseLog[3] == 1);
	BOOST_TEST(firstPhaseLog[4] == 2);
	BOOST_TEST(firstPhaseLog[5] == 2);
}

