	using Resources = ecs::Resources<ecs::Write<Probe<BarrierObserveSystem>>>;

	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const
	{
		context.Write<Probe<BarrierObserveSystem>>().count.fetch_add(chunk.Count(), std::memory_order_relaxed);
	}
};

