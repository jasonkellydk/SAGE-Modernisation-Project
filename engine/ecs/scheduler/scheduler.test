namespace
{
constexpr engine::time::SimulationTime TestTime(std::uint64_t tick)
{
	return {tick, engine::time::FixedStep{60}};
}
}

namespace ecs_scheduler_test
{

struct Position
{
	int value{0};
};

struct Velocity
{
	int value{0};
};

struct Marker
{
	int value{0};
};

// Per-system test probe, owned by the test world: what the test hands a
// system (a log, a target entity, a barrier) and what it observed (counters).
// One distinct resource type per system (keyed by the system ProbeName), so
// probes add no scheduling conflicts: the waves under test stay unchanged.
// Chunk jobs of one system run in parallel, hence the atomic counters.
template<typename System>
struct Probe
{
	std::vector<int> *log{nullptr};
	ecs::Entity target{};
	std::barrier<> *barrier{nullptr};
	std::atomic<std::size_t> count{0};
	std::atomic<std::size_t> extra{0};
};

} // namespace ecs_scheduler_test

namespace ecs
{
template<typename System>
struct ResourceTraits<ecs_scheduler_test::Probe<System>>
{
	static constexpr std::string_view StableName = System::ProbeName;
};
}

namespace ecs_scheduler_test
{

// The world must hold a probe for every probed system it runs.
template<typename... Systems>
void AddProbes(ecs::World &world)
{
	(world.EmplaceResource<Probe<Systems>>(), ...);
}

template<typename System>
Probe<System> &ProbeOf(ecs::World &world)
{
	return world.Resource<Probe<System>>();
}

// Logs `Value` (or the tick when Value < 0) and counts visited rows.
template<typename Self, int Value>
void LogAndCount(const typename Self::Query::Chunk &chunk, ecs::SystemContext &context)
{
	Probe<Self> &probe = context.Write<Probe<Self>>();
	if (probe.log != nullptr)
		probe.log->push_back(Value < 0 ? static_cast<int>(context.Tick()) : Value);
	probe.count.fetch_add(chunk.Count(), std::memory_order_relaxed);
}

struct PreSystem
{
	static constexpr std::string_view ProbeName = "tests.scheduler.probe.pre";
	using Query = ecs::Query<ecs::Read<Position>>;
	using Resources = ecs::Resources<ecs::Write<Probe<PreSystem>>>;
	void Execute(Query::Chunk chunk, ecs::SystemContext &context) const { LogAndCount<PreSystem, -1>(chunk, context); }
};

