// Each barrier system has its own probe (holding a pointer to the shared
// barrier), so the pair stays conflict-free and must share one wave.
template<typename Self>
void ArriveAndCount(const typename Self::Query::Chunk &chunk, ecs::SystemContext &context)
{
	Probe<Self> &probe = context.Write<Probe<Self>>();
	if (probe.barrier != nullptr)
		probe.barrier->arrive_and_wait();
	probe.count.fetch_add(chunk.Count(), std::memory_order_relaxed);
}

