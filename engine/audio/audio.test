#define BOOST_TEST_MODULE EngineAudio
#include <boost/test/included/unit_test.hpp>

#include <algorithm>
#include <cmath>
#include <cstddef>
#include <cstdint>
#include <map>
#include <memory>
#include <optional>
#include <string>
#include <string_view>
#include <vector>

import engine.audio.playback.sound_player;
import engine.audio.definitions.wave_length;

using namespace engine::audio;

namespace
{
std::shared_ptr<const PcmBuffer> Constant(float value, std::size_t frames)
{
	auto buffer = std::make_shared<PcmBuffer>();
	buffer->sampleRate = 1000;
	buffer->samples.assign(frames * 2, value);
	return buffer;
}

// Mixes `frames` frames and returns them.
std::vector<float> Run(Mixer &mixer, std::size_t frames)
{
	std::vector<float> out(frames * 2);
	mixer.Mix(out);
	return out;
}

// Sounds by name: each a short constant block whose level identifies it.
class FakeLibrary final : public SoundLibrary
{
public:
	std::shared_ptr<const PcmBuffer> Sound(std::string_view name) override
	{
		requested.emplace_back(name);
		const auto found = levels.find(std::string(name));
		return found == levels.end() ? nullptr : Constant(found->second, 10);
	}
	std::shared_ptr<StreamFeed> Stream(std::string_view, Bus) override { return nullptr; }

	std::map<std::string, float> levels{{"a", 0.1f}, {"b", 0.2f}, {"c", 0.3f}, {"up", 0.05f}, {"down", 0.06f}};
	std::vector<std::string> requested;
};

SoundEventDefinition Event(std::string name, std::vector<std::string> sounds, std::uint32_t control = 0)
{
	SoundEventDefinition sound;
	sound.name = std::move(name);
	sound.sounds = std::move(sounds);
	sound.control = control;
	sound.type = sound_type::Interface;
	return sound;
}

// Plays everything out (blocks of 10 frames).
void Drain(Mixer &mixer, SoundPlayer &player, int blocks = 50)
{
	for (int block = 0; block < blocks; ++block)
	{
		Run(mixer, 10);
		player.Update();
	}
}
}

BOOST_AUTO_TEST_SUITE(audio)

BOOST_AUTO_TEST_CASE(world_sounds_fall_off_with_distance_and_pan_to_their_side)
{
	BOOST_TEST(DistanceGain(50.0f, 100.0f, 1000.0f) == 1.0f);
	BOOST_TEST(DistanceGain(200.0f, 100.0f, 1000.0f) == 0.5f);
	BOOST_TEST(DistanceGain(1001.0f, 100.0f, 1000.0f) == 0.0f);
	const Listener listener{{0, 0, 0}, {1, 0, 0}};
	const StereoGain centre = Spatialize(listener, {0, 50, 0}, 100.0f, 1000.0f);
	BOOST_TEST(std::fabs(centre.left - centre.right) < 1e-4f);
	BOOST_TEST(centre.left > 0.99f);
	const StereoGain right = Spatialize(listener, {300, 0, 0}, 100.0f, 1000.0f);
	BOOST_TEST(right.right > right.left * 4.0f);
	const StereoGain left = Spatialize(listener, {-300, 0, 0}, 100.0f, 1000.0f);
	BOOST_TEST(left.left > left.right * 4.0f);
	BOOST_TEST(Spatialize(listener, {5000, 0, 0}, 100.0f, 1000.0f).left == 0.0f);
}

BOOST_AUTO_TEST_CASE(the_mixer_plays_delays_loops_and_reports_finished_voices)
{
	Mixer mixer(1000);
	mixer.SetMasterGain(1.0f);
	const VoiceId once = mixer.Play({Constant(0.25f, 8), nullptr, Bus::Effects, 1.0f, 1.0f, false, false, {}, 0, 1000, 4});
	const std::vector<float> first = Run(mixer, 16);
	BOOST_TEST(first[0] == 0.0f);     // delayed 4 frames
	BOOST_TEST(first[4 * 2] == 0.25f);
	BOOST_TEST(first[11 * 2] == 0.25f);
	BOOST_TEST(first[12 * 2] == 0.0f); // 8 frames played
	const auto finished = mixer.TakeFinished();
	BOOST_TEST_REQUIRE(finished.size() == 1u);
	BOOST_TEST(finished[0] == once);

	const VoiceId looping = mixer.Play({Constant(0.5f, 3), nullptr, Bus::Music, 1.0f, 1.0f, true});
	mixer.SetBusGain(Bus::Music, 0.5f);
	Run(mixer, 64);
	BOOST_TEST(Run(mixer, 8)[6] == 0.25f); // looped, at half bus gain
	BOOST_TEST(mixer.TakeFinished().empty());
	mixer.Stop(looping, 4);
	Run(mixer, 16);
	BOOST_TEST(mixer.TakeFinished().size() == 1u);
	BOOST_TEST(mixer.ActiveVoices() == 0u);
}

BOOST_AUTO_TEST_CASE(streams_play_what_their_producer_wrote)
{
	Mixer mixer(1000);
	auto stream = std::make_shared<PcmStream>(32);
	const std::vector<float> data(20 * 2, 0.4f);
	BOOST_TEST(stream->Write(data) == 20u);
	mixer.Play({nullptr, stream, Bus::Speech});
	const auto out = Run(mixer, 24);
	BOOST_TEST(out[19 * 2] == 0.4f);
	BOOST_TEST(out[21 * 2] == 0.0f); // starved, but not over
	BOOST_TEST(mixer.TakeFinished().empty());
	stream->Finish();
	Run(mixer, 4);
	BOOST_TEST(mixer.TakeFinished().size() == 1u);
}

BOOST_AUTO_TEST_CASE(events_keep_their_limit_and_take_turns_through_their_sounds)
{
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	SoundEventDefinition sound = Event("gun", {"a", "b", "c"});
	sound.limit = 2;
	BOOST_TEST(player.Play(sound) != 0u);
	BOOST_TEST(player.Play(sound) != 0u);
	BOOST_TEST(player.Play(sound) == 0u); // at the limit
	BOOST_TEST((library.requested == std::vector<std::string>{"a", "b"}));
	sound.control = sound_control::Interrupt;
	const SoundHandle third = player.Play(sound);
	BOOST_TEST(third != 0u);
	BOOST_TEST(player.PlayingCount() == 2u);
	BOOST_TEST(library.requested.back() == "c");
	Drain(mixer, player);
	BOOST_TEST(player.PlayingCount() == 0u);
	BOOST_TEST(!player.Playing(third));
	// Unknown sounds do not play.
	BOOST_TEST(player.Play(Event("missing", {"nope"})) == 0u);
}

// The original's sample pools (AudioSettings SampleCount2D / SampleCount3D) and
// killLowestPrioritySoundImmediately: over a full pool a new sound stops the
// oldest of the lowest-priority sounds below it, else it does not play; flat
// and world sounds have pools of their own.
BOOST_AUTO_TEST_CASE(legacy_parity_full_sample_pools_give_way_only_to_higher_priority)
{
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	player.SetSampleLimits({2, 3});
	SoundEventDefinition low = Event("low", {"a"}, sound_control::Loop);
	low.priority = SoundPriority::Low;
	SoundEventDefinition normal = Event("normal", {"b"}, sound_control::Loop);
	SoundEventDefinition high = Event("high", {"c"}, sound_control::Loop);
	high.priority = SoundPriority::High;
	const SoundHandle first = player.Play(low);
	const SoundHandle second = player.Play(normal);
	BOOST_TEST(first != 0u);
	BOOST_TEST(second != 0u);
	BOOST_TEST(player.Play(low) == 0u);    // full, nothing below it
	BOOST_TEST(player.Play(normal) != 0u); // stops the low one
	BOOST_TEST(!player.Playing(first));
	BOOST_TEST(player.Play(normal) == 0u); // only equals left
	const SoundHandle loud = player.Play(high);
	BOOST_TEST(loud != 0u);
	BOOST_TEST(!player.Playing(second)); // the older of the two normal ones
	BOOST_TEST(player.PlayingCount() == 2u);
	// World sounds have their own pool.
	SoundEventDefinition world = Event("boom", {"a"}, sound_control::Loop);
	world.type = sound_type::World | sound_type::Everyone;
	for (int index = 0; index < 3; ++index)
		BOOST_TEST(player.Play(world, Vec3{}) != 0u);
	BOOST_TEST(player.Play(world, Vec3{}) == 0u);
	BOOST_TEST(player.PlayingCount() == 5u);
	BOOST_TEST(player.Playing(loud));
}

// legacy_parity: MilesAudioManager::pauseAudio / resumeAudio (AudioAffect_Sound, as SUSPEND_BACKGROUND_SOUNDS and
// RESUME_BACKGROUND_SOUNDS call them): each playing 2D sample stops where it is (AIL_stop_sample) and resumes from
// there (AIL_resume_sample); 3D samples and streams are not touched, and a sound started while suspended plays.
// A flat sound of 10 frames at 0.1, paused after 4: 20 frames later it has neither advanced nor finished, the world
// sound beside it went on and finished; resumed, it plays its last 6 frames and finishes.
BOOST_AUTO_TEST_CASE(legacy_parity_suspended_flat_sounds_hold_and_resume_where_they_were)
{
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	const SoundEventDefinition flat = Event("ui", {"a"});
	SoundEventDefinition world = Event("boom", {"b"});
	world.type = sound_type::World | sound_type::Everyone;
	const SoundHandle ui = player.Play(flat);
	const SoundHandle boom = player.Play(world, Vec3{});
	BOOST_TEST_REQUIRE(ui != 0u);
	BOOST_TEST_REQUIRE(boom != 0u);
	const std::vector<float> first = Run(mixer, 4);
	BOOST_TEST(first[3 * 2] > 0.0f);
	player.PauseFlat(true);
	const std::vector<float> held = Run(mixer, 20);
	player.Update();
	BOOST_TEST(player.Playing(ui));    // held, not finished
	BOOST_TEST(!player.Playing(boom)); // the world sound went on to its end
	for (std::size_t frame = 0; frame < 20; ++frame)
		BOOST_TEST(held[frame * 2] <= 0.2f + 1e-6f); // only the world sound's 0.2 (and silence after it)
	BOOST_TEST(held[19 * 2] == 0.0f);
	// Started while suspended: it plays.
	const SoundHandle later = player.Play(Event("later", {"c"}));
	BOOST_TEST(Run(mixer, 1)[0] > 0.29f);
	player.Stop(later, false);
	Run(mixer, 70);
	player.Update();
	player.PauseFlat(false);
	const std::vector<float> resumed = Run(mixer, 8);
	player.Update();
	BOOST_TEST(resumed[0] == 0.1f);
	BOOST_TEST(resumed[5 * 2] == 0.1f);  // frames 4..9 of the sound
	BOOST_TEST(resumed[6 * 2] == 0.0f);  // then done
	BOOST_TEST(!player.Playing(ui));
}

BOOST_AUTO_TEST_CASE(all_attack_loop_count_and_decay_sequence_in_order)
{
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	// ALL: every sound once, in order.
	const SoundEventDefinition all = Event("speech", {"a", "b", "c"}, sound_control::All);
	player.Play(all);
	Drain(mixer, player);
	BOOST_TEST((library.requested == std::vector<std::string>{"a", "b", "c"}));
	BOOST_TEST(player.PlayingCount() == 0u);

	// Attack, the loop twice, then decay.
	library.requested.clear();
	SoundEventDefinition engine = Event("engine", {"a"}, sound_control::Loop);
	engine.attack = {"up"};
	engine.decay = {"down"};
	engine.loopCount = 2;
	player.Play(engine);
	Drain(mixer, player);
	BOOST_TEST((library.requested == std::vector<std::string>{"up", "a", "a", "down"}));
	BOOST_TEST(player.PlayingCount() == 0u);

	// A forever loop runs until stopped, then plays its decay.
	library.requested.clear();
	engine.loopCount = 0;
	engine.attack.clear();
	const SoundHandle loop = player.Play(engine);
	Drain(mixer, player, 20);
	BOOST_TEST(player.Playing(loop));
	player.Stop(loop);
	Drain(mixer, player);
	BOOST_TEST(!player.Playing(loop));
	BOOST_TEST(library.requested.back() == "down");
}

// A wave file's length from its header (AIL_WAV_info): 16-bit stereo PCM at 22050 Hz, 44100 bytes of data: 11025
// frames, half a second; IMA ADPCM with a 'fact' chunk: its frames; without one: whole 512-byte blocks of 1017 frames.
BOOST_AUTO_TEST_CASE(a_wave_files_length_comes_from_its_header)
{
	const auto wave = [](std::uint16_t format, std::uint32_t rate, std::uint16_t blockAlign, std::uint16_t samplesPerBlock,
						  std::optional<std::uint32_t> fact, std::uint32_t data) {
		std::vector<std::byte> bytes;
		const auto text = [&](std::string_view value) {
			for (const char c : value)
				bytes.push_back(static_cast<std::byte>(c));
		};
		const auto put = [&](std::uint32_t value, int size) {
			for (int index = 0; index < size; ++index)
				bytes.push_back(static_cast<std::byte>((value >> (8 * index)) & 0xFF));
		};
		text("RIFF");
		put(0, 4);
		text("WAVE");
		text("fmt ");
		put(20, 4);
		put(format, 2);
		put(2, 2);
		put(rate, 4);
		put(rate * blockAlign, 4);
		put(blockAlign, 2);
		put(16, 2);
		put(2, 2);
		put(samplesPerBlock, 2);
		if (fact)
		{
			text("fact");
			put(4, 4);
			put(*fact, 4);
		}
		text("data");
		put(data, 4);
		bytes.resize(bytes.size() + data);
		return bytes;
	};
	const auto pcm = ReadWaveLength(wave(1, 22050, 4, 0, std::nullopt, 44100));
	BOOST_TEST_REQUIRE(pcm.has_value());
	BOOST_TEST(pcm->frames == 11025u);
	BOOST_TEST(pcm->Microseconds() == 500000u);
	const auto adpcm = ReadWaveLength(wave(0x11, 22050, 512, 1017, 3000u, 1024));
	BOOST_TEST_REQUIRE(adpcm.has_value());
	BOOST_TEST(adpcm->frames == 3000u);
	const auto blocks = ReadWaveLength(wave(0x11, 22050, 512, 1017, std::nullopt, 1024));
	BOOST_TEST_REQUIRE(blocks.has_value());
	BOOST_TEST(blocks->frames == 2034u);
	std::vector<std::byte> junk(64, std::byte{7});
	BOOST_TEST(!ReadWaveLength(junk).has_value());
}

// legacy_parity: AudioManager::addAudioEvent (GameAudio.cpp: "cull muted audio") and SoundManager::canPlayNow
// (GameSounds.cpp: "culled due to distance"), with AudioSettings.ini's MinSampleVolume of 2%: an event whose volume (a
// script's override, else its own) is below 2% does not play; a world sound at or beyond its MaxRange from the
// microphone does not start (999 starts, 1000 does not) unless it is Global or Critical.
BOOST_AUTO_TEST_CASE(legacy_parity_muted_and_out_of_range_sounds_do_not_start)
{
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	player.SetCullSettings({0.02f, 5000.0f, 500000.0f});
	SoundEventDefinition faint = Event("faint", {"a"});
	faint.volume = 0.01f;
	BOOST_TEST(player.Play(faint) == 0u);
	BOOST_TEST(player.Play(faint, std::nullopt, 0.5f) != 0u); // a script's override above it
	BOOST_TEST(player.Play(Event("loud", {"a"}), std::nullopt, 0.019f) == 0u);
	const SoundEventDefinition edge = Event("edge", {"a"});
	BOOST_TEST(player.Play(edge, std::nullopt, 0.02f) != 0u); // "<": 2% itself plays

	SoundEventDefinition world = Event("boom", {"b"});
	world.type = sound_type::World | sound_type::Everyone;
	world.minRange = 100.0f;
	world.maxRange = 1000.0f;
	BOOST_TEST(player.Play(world, Vec3{0, 1000, 0}) != 0u); // no microphone yet: nothing culled for distance
	player.SetListenerPosition({0, 0, 0});
	BOOST_TEST(player.Play(world, Vec3{0, 999, 0}) != 0u);
	BOOST_TEST(player.Play(world, Vec3{0, 1000, 0}) == 0u);
	SoundEventDefinition critical = world;
	critical.name = "alarm";
	critical.priority = SoundPriority::Critical;
	BOOST_TEST(player.Play(critical, Vec3{0, 5000, 0}) != 0u);
	SoundEventDefinition global = world;
	global.name = "nuke";
	global.type |= sound_type::Global;
	BOOST_TEST(player.Play(global, Vec3{0, 5000, 0}) != 0u);
}

// legacy_parity: MilesAudioManager::processPlayingList and getEffectiveVolume (MilesAudioManager.cpp): each frame a
// positioned world sound's volume x 3D level x min / distance (beyond its MinRange) over the 2D level (the original
// divides by m_soundVolume) is compared with MinSampleVolume (2%) and the sound released when below. MinRange 10, 3D
// level 0.8, 2D level 0.72: at 550 it is 0.8 x 10 / 550 / 0.72 = 0.0202 and plays on; moved to 560, 0.0198: released.
// With a 2D level of 0.9 even 550 gives 0.0162: released. Critical and Global sounds are never culled; at MaxRange
// and beyond the volume is 0.
BOOST_AUTO_TEST_CASE(legacy_parity_quiet_world_sounds_are_culled_each_frame)
{
	BOOST_TEST(EffectiveDistanceScale(5.0f, 10.0f, 1000.0f) == 1.0f);
	BOOST_TEST(EffectiveDistanceScale(40.0f, 10.0f, 1000.0f) == 0.25f);
	BOOST_TEST(EffectiveDistanceScale(1000.0f, 10.0f, 1000.0f) == 0.0f);
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	player.SetCullSettings({0.02f, 5000.0f, 500000.0f});
	player.SetListenerPosition({0, 0, 0});
	SoundEventDefinition hum = Event("hum", {"a"}, sound_control::Loop);
	hum.type = sound_type::World | sound_type::Everyone;
	hum.minRange = 10.0f;
	hum.maxRange = 1000.0f;
	SoundEventDefinition alarm = hum;
	alarm.name = "alarm";
	alarm.priority = SoundPriority::Critical;
	SoundEventDefinition nuke = hum;
	nuke.name = "nuke";
	nuke.type |= sound_type::Global;
	const SoundHandle humming = player.Play(hum, Vec3{550, 0, 0});
	const SoundHandle loud = player.Play(alarm, Vec3{0, 900, 0});
	const SoundHandle global = player.Play(nuke, Vec3{0, 900, 0});
	BOOST_TEST_REQUIRE(humming != 0u);
	player.CullQuiet(0.8f, 0.72f);
	BOOST_TEST(player.Playing(humming));
	player.Move(humming, {560, 0, 0});
	player.CullQuiet(0.8f, 0.72f);
	BOOST_TEST(!player.Playing(humming));
	const SoundHandle again = player.Play(hum, Vec3{550, 0, 0});
	player.CullQuiet(0.8f, 0.9f);
	BOOST_TEST(!player.Playing(again));
	BOOST_TEST(player.Playing(loud));
	BOOST_TEST(player.Playing(global));
}

// legacy_parity: MilesAudioManager::playSample3D / getEffectiveVolume: a Global world sound plays with AudioSettings'
// GlobalMinRange and GlobalMaxRange (5000, 500000), not its own: 2000 away, straight ahead, it is at full volume
// (its own MinRange of 100 would give 100 / 2000). Within the float pan law's rounding (1e-6).
BOOST_AUTO_TEST_CASE(legacy_parity_global_sounds_take_the_global_ranges)
{
	Mixer mixer(1000);
	mixer.SetListener({{0, 0, 0}, {1, 0, 0}});
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	player.SetCullSettings({0.02f, 5000.0f, 500000.0f});
	player.SetListenerPosition({0, 0, 0});
	SoundEventDefinition global = Event("nuke", {"a"});
	global.type = sound_type::World | sound_type::Global | sound_type::Everyone;
	global.minRange = 100.0f;
	global.maxRange = 1000.0f;
	BOOST_TEST_REQUIRE(player.Play(global, Vec3{0, 2000, 0}) != 0u);
	const std::vector<float> out = Run(mixer, 4);
	BOOST_TEST(std::fabs(out[2] - 0.1f) < 1e-6f);
	BOOST_TEST(std::fabs(out[3] - 0.1f) < 1e-6f);
}

// legacy_parity: MilesAudioManager::processFadingList: a sound faded out (the music on a MUSIC_SET_TRACK with fade)
// plays at 1 - k / N of its volume on the k-th of N fade steps, silent on the N-th, then is released; it stops counting
// as playing at once. Over 4 output frames: 0.75, 0.5, 0.25 of 0.1, then nothing.
BOOST_AUTO_TEST_CASE(legacy_parity_a_faded_sound_falls_linearly_to_silence)
{
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	const SoundHandle music = player.Play(Event("track", {"a"}, sound_control::Loop));
	BOOST_TEST_REQUIRE(music != 0u);
	BOOST_TEST(Run(mixer, 4)[0] == 0.1f);
	player.FadeOut(music, 4);
	BOOST_TEST(!player.Playing(music));
	const std::vector<float> out = Run(mixer, 6);
	BOOST_TEST(std::fabs(out[0] - 0.075f) < 1e-7f);
	BOOST_TEST(std::fabs(out[2] - 0.05f) < 1e-7f);
	BOOST_TEST(std::fabs(out[4] - 0.025f) < 1e-7f);
	BOOST_TEST(out[6] == 0.0f);
	BOOST_TEST(out[8] == 0.0f);
	BOOST_TEST(mixer.TakeFinished().size() == 1u);
}

// legacy_parity: AudioEventRTS::generatePlayInfo (m_volumeShift = GameAudioRandomValueReal(1 + VolumeShift, 1)) and
// RandomValue.cpp GetGameAudioRandomValueReal (lo >= hi: hi): a VolumeShift of -20% plays each instance at a random
// 80..100% of its volume (the shipped sounds' -10% / -20%); 0 or a positive shift plays it at exactly its volume.
// A sound of level 0.1, played 200 times: every level within 0.08..0.1, spread across that range.
BOOST_AUTO_TEST_CASE(legacy_parity_volume_shift_lowers_each_play_by_up_to_its_share)
{
	Mixer mixer(1000);
	FakeLibrary library;
	SoundPlayer player(mixer, library);
	const auto levels = [&](float shift) {
		SoundEventDefinition sound = Event("shifted", {"a"});
		sound.volumeShift = shift;
		std::vector<float> heard;
		for (int play = 0; play < 200; ++play)
		{
			BOOST_TEST_REQUIRE(player.Play(sound) != 0u);
			heard.push_back(Run(mixer, 1)[0]);
			Run(mixer, 20);
			player.Update();
		}
		return heard;
	};
	const std::vector<float> shifted = levels(-0.2f);
	const auto [low, high] = std::minmax_element(shifted.begin(), shifted.end());
	BOOST_TEST(*low >= 0.08f - 1e-7f);
	BOOST_TEST(*high <= 0.1f + 1e-7f);
	BOOST_TEST(*low < 0.085f);
	BOOST_TEST(*high > 0.095f);
	for (const float shift : {0.0f, 0.2f})
		for (const float level : levels(shift))
			BOOST_TEST(level == 0.1f);
}

BOOST_AUTO_TEST_SUITE_END()
