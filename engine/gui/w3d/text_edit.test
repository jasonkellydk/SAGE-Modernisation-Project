#include <boost/test/unit_test.hpp>
import std;
import engine.gui.w3d.text_edit;
using namespace engine::gui::w3d;
BOOST_AUTO_TEST_CASE(edit_focus_selects_all_and_text_entry_replaces_selection_like_source) {
    TextEditModel model;BOOST_REQUIRE(model.Restore(u"Default settings"));model.Focus(true,100);
    BOOST_TEST(model.selection.Get().caret==16u);BOOST_TEST(model.selection.Get().anchor==0u);
    BOOST_REQUIRE(model.InsertUtf8("New profile",101));BOOST_CHECK(model.text.Get()==u"New profile");
    BOOST_TEST(model.selection.Get().caret==11u);BOOST_TEST(model.selection.Get().anchor==11u);
    model.Focus(false,200);BOOST_TEST(model.selection.Get().caret==0u);BOOST_TEST(!model.InsertUtf8("x",201));
    model.Focus(true,300);model.Key(EditAction::Backspace,false,false,301);BOOST_TEST(model.text.Get().empty());
}
BOOST_AUTO_TEST_CASE(edit_source_word_navigation_shift_anchor_delete_and_strict_caret_blink) {
    TextEditModel model;BOOST_REQUIRE(model.Restore(u"one  two three"));model.Focus(true,0);
    model.Key(EditAction::Left,false,true,1);BOOST_TEST(model.selection.Get().caret==9u);
    model.Key(EditAction::Left,true,true,2);BOOST_TEST(model.selection.Get().caret==5u);BOOST_TEST(model.selection.Get().anchor==9u);
    model.Key(EditAction::Delete,false,false,3);BOOST_CHECK(model.text.Get()==u"one  three");
    model.Key(EditAction::Home,false,false,4);model.Key(EditAction::Right,false,true,5);BOOST_TEST(model.selection.Get().caret==5u);
    model.Tick(505);BOOST_TEST(model.CaretVisible());model.Tick(506);BOOST_TEST(!model.CaretVisible());
    model.Tick(1006);BOOST_TEST(!model.CaretVisible());model.Tick(1007);BOOST_TEST(model.CaretVisible());
    BOOST_TEST(model.Key(EditAction::Enter,false,false,1008).submit);
    model.enabled.Set(false);BOOST_TEST(!model.Key(EditAction::Delete,false,false,1009).handled);
}
BOOST_AUTO_TEST_CASE(edit_unicode_commit_composition_limits_and_malformed_events_are_atomic) {
    TextEditModel model(4);model.Focus(true,0);
    BOOST_REQUIRE(model.InsertUtf8("A\xf0\x9f\x98\x80" "B",1));BOOST_TEST(model.text.Get().size()==4u);
    model.Key(EditAction::Left,false,false,2);BOOST_TEST(model.selection.Get().caret==3u);
    model.Key(EditAction::Left,false,false,3);BOOST_TEST(model.selection.Get().caret==1u);
    model.Key(EditAction::Delete,false,false,4);BOOST_CHECK(model.text.Get()==u"AB");
    BOOST_REQUIRE(model.ComposeUtf8("\xc3\xa6\xf0\x9f\x98\x80",1,1));
    BOOST_TEST(model.composition.Get().start==1u);BOOST_TEST(model.composition.Get().length==2u);
    BOOST_REQUIRE(model.ComposeUtf8("text",-1,-1));BOOST_TEST(model.composition.Get().start==0u);BOOST_TEST(model.composition.Get().length==0u);
    BOOST_CHECK(model.text.Get()==u"AB");
    for(const auto bytes:{"\xc0\xaf","\xed\xa0\x80","\xf4\x90\x80\x80","\xf0\x9f"}) {
        BOOST_TEST(!model.InsertUtf8(bytes,5));BOOST_TEST(!model.ComposeUtf8(bytes,0,0));BOOST_CHECK(model.text.Get()==u"AB");
    }
    BOOST_REQUIRE(model.InsertUtf8("\xf0\x9f\x98\x80" "C",6));BOOST_TEST(model.text.Get().size()==4u);
    BOOST_TEST(model.composition.Get().text.empty());BOOST_TEST(!model.Restore(std::u16string(1,char16_t(0xd800))));
    TextEditModel short_model(1);short_model.Focus(true,0);BOOST_REQUIRE(short_model.InsertUtf8("\xf0\x9f\x98\x80",1));
    BOOST_TEST(short_model.text.Get().empty());BOOST_TEST(short_model.selection.Get().caret==0u);
}
