#include <boost/test/unit_test.hpp>
#include <cstddef>
#include <cstdint>
#include <vector>
#include <span>
import engine.filesystem.adapters.pe.resources;

BOOST_AUTO_TEST_CASE(pe_resources_use_rva_translation_and_never_execute_image) {
    std::vector<std::byte> image(0x500);
    const auto put=[&](std::size_t p,std::uint32_t value,unsigned n=4) { for(unsigned i=0;i<n;++i) image[p+i]=std::byte(value>>(8*i)); };
    put(0,0x5a4d,2); put(60,0x80); put(0x80,0x4550); put(0x86,1,2); put(0x94,224,2);
    put(0x98,0x10b,2); put(0x108,0x6000); put(0x10c,0x200);
    put(0x184,0x6000); put(0x188,0x200); put(0x18c,0x300);
    // Type 5, dialog 128, language 1033; then a resource data entry.
    for(unsigned i=0;i<3;++i) { const auto p=0x300+i*24; put(p+14,1,2);
        put(p+16,i==0 ? 5 : i==1 ? 128 : 1033); put(p+20,i<2 ? 0x80000000u+(i+1)*24 : 72); }
    put(0x348,0x6060); put(0x34c,3); image[0x360]=std::byte{42};
    const auto result=engine::filesystem::pe::Resource(image,5,128);
    BOOST_REQUIRE(result.has_value()); BOOST_TEST(result->size()==3); BOOST_TEST(std::to_integer<unsigned>((*result)[0])==42);
    BOOST_CHECK(!engine::filesystem::pe::Resource(image,5,129));
    BOOST_CHECK(!engine::filesystem::pe::Resource(image,5,128,1031));
    BOOST_REQUIRE(engine::filesystem::pe::Resource(image,5,128,1033).has_value());
    for(std::size_t length=0;length<image.size();++length)
        BOOST_CHECK(!engine::filesystem::pe::Resource(std::span(image).first(length),5,128));
    put(0x348,0x6200); BOOST_CHECK(!engine::filesystem::pe::Resource(image,5,128));
}
