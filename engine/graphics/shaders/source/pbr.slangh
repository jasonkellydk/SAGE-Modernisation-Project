#ifndef GRAPHICS_PBR
#define GRAPHICS_PBR
#include "environment_lighting.slangh"
// GGX / Smith / Schlick, with perceptual roughness and linear-light albedo.
// Reference: https://google.github.io/filament/main/filament.html
#include "pbr_brdf.slangh"
// Per-fragment material outputs accompany forward scene color. They let
// indirect lighting operate on reflectance rather than darkening final RGB.
static float3 SurfaceDiffuseReflectance=0;
static float3 SurfaceIndirectRadiance=0;
static float3 SurfaceEncodedNormal=0;
struct SurfaceOutput
{
    float4 color : SV_TARGET0;
    float4 diffuse : SV_TARGET1;
    float4 normal : SV_TARGET2;
    float4 indirect : SV_TARGET3;
};
void Surface_Visibility(float3 visibility)
{
    SurfaceDiffuseReflectance*=visibility;
    SurfaceIndirectRadiance*=visibility;
}
SurfaceOutput Surface_Output(float4 color)
{
    SurfaceOutput result;
    result.color=color;
    result.diffuse=float4(SurfaceDiffuseReflectance,color.a);
    result.normal=float4(SurfaceEncodedNormal,color.a);
    result.indirect=float4(SurfaceIndirectRadiance,color.a);
    return result;
}
// Account for unresolved normal variation in the specular lobe. Without this,
// fine normal maps alias into isolated white pixels as the camera moves.
float Surface_Filter_Roughness(float roughness,float3 normal)
{
    const float3 dx=ddx(normal),dy=ddy(normal);
    const float variance=.5*(dot(dx,dx)+dot(dy,dy));
    return sqrt(saturate(roughness*roughness+min(variance,.25)));
}
float3 Surface_Environment(float3 albedo,float3 normal,float3 view,float roughness,float metallic,float occlusion=1,float3 dielectric_f0=float3(.04,.04,.04))
{
    float3 result=0;
    if (EnvironmentPBR.x > .5) {
    const float3 reflected=reflect(-view,normal);
    const float2 uv=float2(atan2(reflected.y,reflected.x)/(2*3.14159265)+.5,
        clamp(.5-asin(clamp(reflected.z,-1,1))/3.14159265,.015625,.984375));
    const float2 basis=EnvironmentRadianceTexture().SampleLevel(EnvironmentCloudSampler(),uv,roughness*6).rg;
    const float3 radiance=basis.x*EnvironmentSkyRadiance.rgb+basis.y*EnvironmentGroundRadiance.rgb;
    const float nv=saturate(dot(normal,view));
    const float3 f0=lerp(dielectric_f0,albedo,metallic);
    // Analytic fit to the integrated GGX split-sum BRDF (Lazarov).
    const float4 r=roughness*float4(-1,-.0275,-.572,.022)+float4(1,.0425,1.04,-.04);
    const float a004=min(r.x*r.x,exp2(-9.28*nv))*r.x+r.y;
    const float2 ab=float2(-1.04,1.04)*a004+r.zw;
    const float3 specular=radiance*(f0*ab.x+ab.y);
    const float3 diffuse_irradiance=lerp(EnvironmentGroundRadiance.rgb,EnvironmentSkyRadiance.rgb,
        saturate(normal.z*.333333+.5));
    const float3 fresnel=f0+(max((1-roughness).xxx,f0)-f0)*pow(1-nv,5);
    result=((1-fresnel)*(1-metallic)*albedo*diffuse_irradiance+specular)*occlusion*EnvironmentPBR.z;
    }
    return result;
}
float Surface_Inferred_Metallic(float3 albedo,float profile)
{
    const float brightest=max(albedo.r,max(albedo.g,albedo.b));
    const float darkest=min(albedo.r,min(albedo.g,albedo.b));
    const float saturation=(brightest-darkest)/max(brightest,.001);
    return profile*(1-smoothstep(.08,.35,saturation))*smoothstep(.035,.18,brightest);
}
// All world materials share these lights, units, falloff and BRDF.
float3 Surface_Local_Lights(float3 albedo,float3 normal,float3 view,float3 position,float roughness,float metallic,
    float3 dielectric_f0=float3(.04,.04,.04))
{
    float3 color=0;
    [loop] for (int i=0;i<min(int(EnvironmentLocalLightOptions.x),64);++i) {
        const float3 delta=EnvironmentLocalPositions[i].xyz-position;
        const float distance=length(delta),radius=EnvironmentLocalPositions[i].w;
        if (distance < radius) {
            const float3 light=Surface_Normalize(delta,normal);
            // Incident irradiance follows inverse square; radius only bounds support.
            float attenuation=Surface_Radiant_Attenuation(distance,radius);
            if (EnvironmentLocalDirection[i].w > -1) {
                const float cone=dot(-light,Surface_Normalize(EnvironmentLocalDirection[i].xyz,-light));
                attenuation*=pow(saturate((cone-EnvironmentLocalDirection[i].w)/
                    max(EnvironmentLocalSpot[i].x-EnvironmentLocalDirection[i].w,.0001)),max(EnvironmentLocalSpot[i].y,1));
            }
            attenuation*=LocalLightVisibility(i,position,normal);
            color+=attenuation*Surface_PBR(albedo,normal,view,light,roughness,metallic,1,dielectric_f0)
                *EnvironmentLocalDiffuse[i].rgb;
        }
    }
    return color;
}
float3 Surface_Direct_Lighting(float3 albedo,float3 normal,float3 view,float3 position,float roughness,float metallic,
    float3 dielectric_f0=float3(.04,.04,.04))
{
    float3 sunlight=Surface_PBR(albedo,normal,view,Surface_Normalize(EnvironmentSunDirection.xyz,normal),
        roughness,metallic,1,dielectric_f0)*EnvironmentSunRadiance.rgb;
    [unroll] for(int i=0;i<2;++i)
        sunlight+=Surface_PBR(albedo,normal,view,Surface_Normalize(EnvironmentSecondarySunDirection[i].xyz,normal),
            roughness,metallic,1,dielectric_f0)*EnvironmentSecondarySunRadiance[i].rgb;
    return sunlight*DirectionalVisibility(position)+Surface_Local_Lights(albedo,normal,view,position,roughness,metallic,dielectric_f0);
}
float3 Surface_Lighting(float3 albedo,float3 normal,float3 view,float3 position,float roughness,float metallic,
    float occlusion=1,float3 dielectric_f0=float3(.04,.04,.04))
{
    roughness=Surface_Filter_Roughness(roughness,normal);
    const float3 indirect=Surface_Environment(albedo,normal,view,roughness,metallic,occlusion,dielectric_f0);
    SurfaceDiffuseReflectance=albedo*(1-metallic)*(1-dielectric_f0);
    SurfaceIndirectRadiance=indirect;
    SurfaceEncodedNormal=normal*(.5+.5*roughness);
    return indirect+Surface_Direct_Lighting(albedo,normal,view,position,roughness,metallic,dielectric_f0);
}

// Ray-march height in texture space using the actual world-to-UV metric.
// Explicit gradients keep mip selection stable inside divergent traversal.
float2 Surface_Parallax(Texture2D<float4> height_map, SamplerState sampler_state,
    float2 uv, float3 position, float3 normal, float3 view, float amplitude, float2 max_offset)
{
    const float3 dx=ddx(position), dy=ddy(position);
    const float2 ux=ddx(uv), uy=ddy(uv);
    const float xx=dot(dx,dx), yy=dot(dy,dy), xy=dot(dx,dy);
    const float determinant=xx*yy-xy*xy;
    float2 result=uv;
    const float nv=dot(normal,view);
    if (amplitude > 0 && determinant > 1e-12 && nv > .05) {
        const float vx=dot(view,dx), vy=dot(view,dy);
        float2 ray=(ux*(vx*yy-vy*xy)+uy*(vy*xx-vx*xy))/determinant;
        ray*=amplitude/max(nv,.2);
        ray*=min(1,min(max_offset.x/max(abs(ray.x),1e-8),max_offset.y/max(abs(ray.y),1e-8)));
        const float fade=1-smoothstep(.02,.08,max(length(ux),length(uy)));
        ray*=fade;
        const int steps=int(lerp(24,8,saturate(nv)));
        const float layer=1.0/steps;
        float depth=0, previous_depth=0, previous_height=0;
        float sampled=1-height_map.SampleGrad(sampler_state,uv,ux,uy).r;
        [loop] for (int i=0;i<24;++i) {
            if (i >= steps || depth >= sampled) break;
            previous_depth=depth; previous_height=sampled;
            depth+=layer;
            sampled=1-height_map.SampleGrad(sampler_state,uv-ray*depth,ux,uy).r;
        }
        const float after=depth-sampled;
        const float before=previous_depth-previous_height;
        const float fraction=saturate(after/max(after-before,1e-6));
        result=uv-ray*lerp(depth,previous_depth,fraction);
    }
    return result;
}

// Surface-gradient bump mapping: no UV displacement, so atlas borders,
// cutout alpha and shadow silhouettes stay aligned.
float3 Surface_Height_Normal(float3 normal, float3 position, float height)
{
    const float3 dx=ddx(position), dy=ddy(position);
    const float3 r1=cross(dy,normal), r2=cross(normal,dx);
    const float determinant=dot(dx,r1);
    const float3 gradient=ddx(height)*r1+ddy(height)*r2;
    return abs(determinant)>1e-10
        ? Surface_Normalize(abs(determinant)*normal-sign(determinant)*gradient,normal) : normal;
}
float3 Surface_Mapped_Normal(float3 normal,float3 position,float2 uv,float3 bump)
{
    const float3 dx=ddx(position),dy=ddy(position);
    const float2 ux=ddx(uv),uy=ddy(uv);
    const float determinant=ux.x*uy.y-ux.y*uy.x;
    if (abs(determinant)<1e-10) return normal;
    float3 tangent=(dx*uy.y-dy*ux.y)/determinant;
    const float3 bitangent=(dy*ux.x-dx*uy.x)/determinant;
    tangent=Surface_Normalize(tangent-normal*dot(normal,tangent),float3(1,0,0));
    const float sign=dot(cross(normal,tangent),bitangent)<0 ? -1 : 1;
    return Surface_Normalize(tangent*bump.x+cross(normal,tangent)*sign*bump.y+normal*bump.z,normal);
}
#endif
