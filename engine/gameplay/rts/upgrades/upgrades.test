#define BOOST_TEST_MODULE EngineGameplayUpgrades
#include <boost/test/included/unit_test.hpp>

#include <cstdint>
#include <vector>

import engine.gameplay.rts.upgrades.systems.upgrade_system;
import engine.ecs.core.world;
import engine.ecs.scheduler.scheduler;
import engine.jobs.job_system;
import engine.time.simulation_time;

using namespace engine::gameplay;

namespace
{
// Upgrades 0..3: A, B, C (a conflict), D (an object upgrade).
constexpr std::uint32_t A = 0, B = 1, C = 2, D = 3;

UpgradeTrigger Trigger(std::initializer_list<std::uint32_t> by, std::uint32_t reaction, bool all = false)
{
	UpgradeTrigger trigger;
	for (const std::uint32_t upgrade : by)
		trigger.activation.Set(upgrade);
	trigger.requiresAll = all;
	trigger.reaction = reaction;
	return trigger;
}

struct Armory
{
	ecs::World world{ecs::WorldConfig{4}};
	UpgradeTriggers &triggers{world.EmplaceResource<UpgradeTriggers>()};
	PlayerUpgrades &players{world.EmplaceResource<PlayerUpgrades>()};
	UpgradeReactions &reactions{world.EmplaceResource<UpgradeReactions>()};
	ObjectUpgradeGrants &grants{world.EmplaceResource<ObjectUpgradeGrants>()};
	std::vector<std::vector<UpgradeReaction>> seen;

	Armory()
	{
		players.Resize(2);
		world.RegisterComponent<Upgradable>();
		world.RegisterComponent<DefinitionRef>();
		world.RegisterComponent<Owner>();
		world.FinalizeComponents();
	}

	ecs::Entity Add(std::uint32_t definition, std::uint32_t player)
	{
		const ecs::Entity entity = world.Create();
		world.Add<Upgradable>(entity);
		world.Add<DefinitionRef>(entity);
		world.Add<Owner>(entity);
		world.Get<DefinitionRef>(entity)->index = definition;
		world.Get<Owner>(entity)->player = player;
		return entity;
	}

	// Runs one tick; the reactions it set off.
	std::vector<UpgradeReaction> Tick(std::size_t workers = 1)
	{
		UpgradeSystem upgrades;
		ecs::SystemRegistry registry;
		registry.Register(upgrades);
		registry.Finalize(world.Components());
		ecs::Scheduler scheduler(world, registry, engine::jobs::JobSystemConfig{workers});
		scheduler.Finalize(engine::time::FixedStep{30});
		scheduler.Execute(engine::time::SimulationTime{++tick, engine::time::FixedStep{30}});
		std::vector<UpgradeReaction> out;
		reactions.ForEach([&](const UpgradeReaction &reaction) { out.push_back(reaction); });
		return out;
	}
	std::uint64_t tick{0};
};
}

BOOST_AUTO_TEST_SUITE(upgrades)

// UpgradeMux::wouldUpgrade / attemptUpgrade through Player::onUpgradeCompleted: a trigger goes once, when its
// player completes any upgrade it is TriggeredBy; other players' objects and later passes leave it be.
BOOST_AUTO_TEST_CASE(legacy_parity_a_trigger_goes_once_when_its_player_completes_the_upgrade)
{
	Armory armory;
	armory.triggers.byDefinition = {{Trigger({A, B}, 7)}};
	const ecs::Entity mine = armory.Add(0, 0);
	armory.Add(0, 1);
	BOOST_TEST(armory.Tick().empty()); // made: looks, nothing yet
	armory.players.Grant(0, B);
	const auto went = armory.Tick();
	BOOST_TEST_REQUIRE(went.size() == 1u);
	BOOST_TEST((went[0].entity == mine));
	BOOST_TEST(went[0].trigger == 0u);
	BOOST_TEST(went[0].reaction == 7u);
	armory.players.Grant(0, A);
	BOOST_TEST(armory.Tick().empty()); // already upgraded
	BOOST_TEST(armory.world.Get<Upgradable>(mine)->executed == 1u);
}

// RequiresAllTriggers: every trigger; ConflictsWith: none of the conflicts, on the player or the object.
BOOST_AUTO_TEST_CASE(legacy_parity_all_triggers_and_conflicts_follow_the_mux)
{
	Armory armory;
	UpgradeTrigger both = Trigger({A, B}, 1, true);
	UpgradeTrigger blocked = Trigger({A}, 2);
	blocked.conflicting.Set(C);
	armory.triggers.byDefinition = {{both, blocked}};
	const ecs::Entity tank = armory.Add(0, 0);
	armory.world.Get<Upgradable>(tank)->completed.Set(C); // its own conflict
	armory.players.Grant(0, A);
	BOOST_TEST(armory.Tick().empty()); // A alone: not both; C blocks the other
	armory.players.Grant(0, B);
	const auto went = armory.Tick();
	BOOST_TEST_REQUIRE(went.size() == 1u);
	BOOST_TEST(went[0].reaction == 1u);
}

// Object::updateUpgradeModules keys on the player's and the object's upgrades together; Object::giveUpgrade
// makes it look again. RemovesUpgrades (muxDataProcessUpgradeRemoval -> Object::removeUpgrade) takes the
// object's own upgrade off and lets the triggers it set off go again (resetUpgrade), in the same pass for
// those after it, whose key still holds it.
BOOST_AUTO_TEST_CASE(legacy_parity_object_upgrades_and_removals)
{
	Armory armory;
	UpgradeTrigger swap = Trigger({A}, 10);
	swap.removal.Set(D);
	armory.triggers.byDefinition = {{Trigger({D}, 11), swap, Trigger({D}, 12)}};
	const ecs::Entity truck = armory.Add(0, 0);
	armory.Tick();
	Upgradable &upgradable = *armory.world.Get<Upgradable>(truck);
	upgradable.completed.Set(D);
	upgradable.stale = 1; // Object::giveUpgrade
	auto went = armory.Tick();
	BOOST_TEST_REQUIRE(went.size() == 2u);
	BOOST_TEST(went[0].reaction == 11u);
	BOOST_TEST(went[1].reaction == 12u);
	armory.players.Grant(0, A);
	went = armory.Tick();
	// The swap goes, takes D off and resets both D triggers; the last one, after it in the pass, goes again
	// on the pass's old key; the first waits for the next pass (where D is gone).
	BOOST_TEST_REQUIRE(went.size() == 2u);
	BOOST_TEST(went[0].reaction == 10u);
	BOOST_TEST(went[1].reaction == 12u);
	BOOST_TEST(!armory.world.Get<Upgradable>(truck)->completed.Has(D));
	BOOST_TEST(armory.world.Get<Upgradable>(truck)->executed == 0b110u);
}

// Changing hands looks again against the new player's upgrades.
BOOST_AUTO_TEST_CASE(a_captured_object_looks_at_its_new_players_upgrades)
{
	Armory armory;
	armory.triggers.byDefinition = {{Trigger({A}, 3)}};
	armory.players.Grant(1, A);
	const ecs::Entity tank = armory.Add(0, 0);
	BOOST_TEST(armory.Tick().empty());
	armory.world.Get<Owner>(tank)->player = 1;
	BOOST_TEST(armory.Tick().size() == 1u);
}

// Players' upgrades checkpoint exactly; many objects react the same on any number of workers.
BOOST_AUTO_TEST_CASE(player_upgrades_round_trip_and_workers_agree)
{
	PlayerUpgrades upgrades;
	upgrades.Resize(3);
	upgrades.Grant(2, 200);
	upgrades.Grant(0, A);
	engine::core::serialization::ByteWriter writer;
	upgrades.Save(writer);
	PlayerUpgrades loaded;
	engine::core::serialization::ByteReader reader(writer.Bytes());
	BOOST_TEST_REQUIRE(loaded.Load(reader));
	BOOST_TEST((loaded.Completed(2) == upgrades.Completed(2)));
	BOOST_TEST(loaded.Grants(0) == 1u);

	const auto run = [](std::size_t workers) {
		Armory armory;
		armory.triggers.byDefinition = {{Trigger({A}, 1), Trigger({B}, 2)}, {Trigger({A, B}, 3, true)}};
		for (std::uint32_t index = 0; index < 3000; ++index)
			armory.Add(index % 2, index % 2);
		armory.Tick(workers);
		armory.players.Grant(0, A);
		armory.players.Grant(1, A);
		armory.players.Grant(1, B);
		std::vector<std::uint64_t> out;
		for (const UpgradeReaction &reaction : armory.Tick(workers))
			out.push_back((static_cast<std::uint64_t>(reaction.entity.index) << 32) | reaction.reaction);
		return out;
	};
	const auto one = run(1);
	BOOST_TEST(one.size() == 3000u);
	BOOST_TEST((one == run(4)));
}

BOOST_AUTO_TEST_SUITE_END()
