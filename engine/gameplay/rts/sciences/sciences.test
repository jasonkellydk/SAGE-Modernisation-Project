#define BOOST_TEST_MODULE EngineGameplaySciences
#include <boost/test/included/unit_test.hpp>

import engine.gameplay.rts.sciences.resources.player_sciences;
import engine.gameplay.rts.sciences.algorithms.ranks;
#include <vector>

using namespace engine::gameplay;

BOOST_AUTO_TEST_SUITE(sciences)

// Player::grantScience / hasScience: per player, kept across a checkpoint.
BOOST_AUTO_TEST_CASE(players_know_their_sciences_across_a_checkpoint)
{
	PlayerSciences sciences;
	sciences.Resize(2);
	sciences.Grant(1, 3);
	sciences.Grant(1, 200);
	BOOST_TEST(sciences.Has(1, 3));
	BOOST_TEST(sciences.Has(1, 200));
	BOOST_TEST(!sciences.Has(0, 3));
	BOOST_TEST(!sciences.Has(5, 3));
	engine::core::serialization::ByteWriter writer;
	sciences.Save(writer);
	PlayerSciences restored;
	engine::core::serialization::ByteReader reader(writer.Bytes());
	BOOST_TEST_REQUIRE(restored.Load(reader));
	BOOST_TEST(restored.Has(1, 200));
	BOOST_TEST(!restored.Has(0, 200));
}

namespace
{
// Rank.ini's first five ranks (SkillPointsNeeded 0, 800, 1500, 2500, 5000; purchase points 1, 1, 1, 1, 3; each grants
// SCIENCE_Rank<n>, here science n).
RankRules ShippedRanks()
{
	RankRules rules;
	const std::int32_t need[] = {0, 800, 1500, 2500, 5000};
	const std::int32_t points[] = {1, 1, 1, 1, 3};
	for (std::uint32_t level = 0; level < 5; ++level)
		rules.ranks.push_back({need[level], points[level], {level + 1}});
	rules.sciences.resize(10);
	rules.sciences[7] = {1, true, {}};
	rules.sciences[8] = {3, true, {7}};
	return rules;
}
}

// legacy_parity: Player::resetRank / addSkillPoints / setRankLevel. A new general is rank 1 with rank 1's point. 799
// points stay rank 1; one more reaches 800 (rank 2: one more point, SCIENCE_Rank2); 4200 more from 800 jump past 1500
// and 2500 to 5000, the cap (rank 5 of 5, limit 1000): ranks 3, 4 and 5 in order, 1 + 1 + 3 more points, and the points
// stop at 5000.
BOOST_AUTO_TEST_CASE(legacy_parity_skill_points_rank_a_general_up)
{
	const RankRules rules = ShippedRanks();
	PlayerRank rank;
	ResetRank(rank, rules, 0);
	BOOST_TEST(rank.level == 1);
	BOOST_TEST(rank.purchasePoints == 1);
	BOOST_TEST(rank.levelUp == 800);
	std::vector<std::uint32_t> granted;
	BOOST_TEST(!AddSkillPoints(rank, rules, 1000, 0, 799, granted));
	BOOST_TEST(rank.level == 1);
	BOOST_TEST(AddSkillPoints(rank, rules, 1000, 0, 1, granted));
	BOOST_TEST(rank.level == 2);
	BOOST_TEST(rank.purchasePoints == 2);
	BOOST_TEST((granted == std::vector<std::uint32_t>{2}));
	granted.clear();
	BOOST_TEST(AddSkillPoints(rank, rules, 1000, 0, 9999, granted));
	BOOST_TEST(rank.level == 5);
	BOOST_TEST(rank.skillPoints == 5000);
	BOOST_TEST(rank.purchasePoints == 7);
	BOOST_TEST((granted == std::vector<std::uint32_t>{3, 4, 5}));
	// PLAYER_SET_RANKLEVELLIMIT(3) caps the points at rank 3's need.
	PlayerRank capped;
	ResetRank(capped, rules, 0);
	granted.clear();
	AddSkillPoints(capped, rules, 3, 0, 9999, granted);
	BOOST_TEST(capped.level == 3);
	BOOST_TEST(capped.skillPoints == 1500);
	// Going down resets: rank 1 again, and rank 2 after it grants its science anew.
	bool reset = false;
	granted.clear();
	BOOST_TEST(SetRankLevel(rank, rules, 1000, 0, 2, granted, reset));
	BOOST_TEST(reset);
	BOOST_TEST(rank.level == 2);
	BOOST_TEST(rank.purchasePoints == 2);
	BOOST_TEST(rank.skillPoints == 800);
	BOOST_TEST((granted == std::vector<std::uint32_t>{2}));
}

// legacy_parity: Player::isCapableOfPurchasingScience / attemptToPurchaseScience: prerequisites first, not twice, cost 0
// never, and only with the points.
BOOST_AUTO_TEST_CASE(legacy_parity_generals_points_buy_sciences)
{
	const RankRules rules = ShippedRanks();
	PlayerRank rank;
	ResetRank(rank, rules, 0);
	PlayerSciences known;
	known.Resize(1);
	BOOST_TEST(!CanPurchaseScience(rank, known, rules, 0, 8)); // needs science 7
	BOOST_TEST(!CanPurchaseScience(rank, known, rules, 0, 9)); // costs nothing: not for sale
	BOOST_TEST(PurchaseScience(rank, known, rules, 0, 7));
	known.Grant(0, 7);
	BOOST_TEST(rank.purchasePoints == 0);
	BOOST_TEST(!CanPurchaseScience(rank, known, rules, 0, 7)); // known
	rank.purchasePoints = 2;
	BOOST_TEST(!CanPurchaseScience(rank, known, rules, 0, 8)); // costs 3
	rank.purchasePoints = 3;
	BOOST_TEST(PurchaseScience(rank, known, rules, 0, 8));
	BOOST_TEST(rank.purchasePoints == 0);
}

// Player.cpp setScienceAvailability / isCapableOfPurchasingScience: a script's "Disabled" or "Hidden" science cannot be
// bought (points and prerequisites notwithstanding) until made "Available"; the last setting wins (never both); kept
// across a checkpoint.
BOOST_AUTO_TEST_CASE(legacy_parity_unavailable_sciences_cannot_be_bought)
{
	const RankRules rules = ShippedRanks();
	PlayerRank rank;
	ResetRank(rank, rules, 0);
	PlayerSciences known;
	known.Resize(1);
	known.SetAvailability(0, 7, ScienceAvailability::Disabled);
	BOOST_TEST(known.Disabled(0, 7));
	BOOST_TEST(!CanPurchaseScience(rank, known, rules, 0, 7));
	known.SetAvailability(0, 7, ScienceAvailability::Hidden);
	BOOST_TEST(!known.Disabled(0, 7));
	BOOST_TEST(known.Hidden(0, 7));
	BOOST_TEST(!PurchaseScience(rank, known, rules, 0, 7));
	BOOST_TEST(rank.purchasePoints == 1);
	engine::core::serialization::ByteWriter writer;
	known.Save(writer);
	PlayerSciences restored;
	engine::core::serialization::ByteReader reader(writer.Bytes());
	BOOST_TEST_REQUIRE(restored.Load(reader));
	BOOST_TEST(restored.Hidden(0, 7));
	restored.SetAvailability(0, 7, ScienceAvailability::Available);
	BOOST_TEST(!restored.Hidden(0, 7));
	BOOST_TEST(PurchaseScience(rank, restored, rules, 0, 7));
}

BOOST_AUTO_TEST_SUITE_END()
