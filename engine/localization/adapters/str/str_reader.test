#include <boost/test/unit_test.hpp>

#include <cstddef>
#include <cstdlib>
#include <filesystem>
#include <string>
#include <string_view>

import engine.localization.adapters.str.str_reader;
import engine.filesystem.adapters.big.big_archive_source;

using namespace engine::localization;

BOOST_AUTO_TEST_SUITE(str_reader)

// Legacy parity (GameTextManager::parseStringFile, readToEndOfQuote, translateCopy).
BOOST_AUTO_TEST_CASE(legacy_parity_a_string_file_reads_as_the_original_parses_it)
{
	const std::string_view text =
		"// a comment\r\n"
		"\r\n"
		"GUI:CustomMission\r\n"
		"\"CUSTOM MISSION\"\r\n"
		"END\r\n"
		"  MAP:Line  \n"
		"\"First line\\nsecond,   \n"
		"  still \\\"quoted\\\" \\\\ text\" = GLA03Voice1\n"
		"\"a second text is ignored\"\n"
		"end\n";
	StringTable table;
	const auto read = str::Read(text, table);
	BOOST_TEST_REQUIRE(read.has_value(), (read ? "" : read.error()));
	BOOST_TEST(*read == 2u);
	BOOST_TEST(table.Text("gui:custommission") == "CUSTOM MISSION"); // labels case blind
	const LocalizedString *line = table.Find("MAP:Line");
	BOOST_TEST_REQUIRE(line != nullptr);
	BOOST_TEST(line->text == "First line\nsecond, still \"quoted\" \\ text"); // breaks become spaces, runs collapse
	BOOST_TEST(line->speech == "GLA03Voice1e"); // a name ending in a digit gets an "e"
	StringTable broken;
	BOOST_TEST(!str::Read("LABEL\n\"never closed\n", broken).has_value());
}

// A shipped map's string file (MapsZH.big Maps\MD_GLA03_CINE\map.str).
BOOST_AUTO_TEST_CASE(reads_a_shipped_map_string_file)
{
	const char *install = std::getenv("GENERALSZH_INSTALL_DIR");
	if (install == nullptr || !std::filesystem::exists(install))
	{
		BOOST_TEST_MESSAGE("SKIPPED: set GENERALSZH_INSTALL_DIR to a Zero Hour install");
		return;
	}
	auto archive = engine::filesystem::BigArchiveSource::Open(std::filesystem::path(install) / "MapsZH.big");
	BOOST_TEST_REQUIRE(archive.has_value());
	const auto bytes = (*archive)->Read("maps/md_gla03_cine/map.str");
	BOOST_TEST_REQUIRE(bytes.has_value());
	const std::string text(reinterpret_cast<const char *>(bytes->data()), bytes->size());
	StringTable table;
	const auto read = str::Read(text, table);
	BOOST_TEST_REQUIRE(read.has_value(), (read ? "" : read.error()));
	BOOST_TEST_MESSAGE("map.str: " << *read << " strings");
	BOOST_TEST(*read > 0u);
	BOOST_TEST(table.Size() == *read);
}

BOOST_AUTO_TEST_SUITE_END()
