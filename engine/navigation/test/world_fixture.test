BOOST_AUTO_TEST_CASE(twilight_flame_routes_match_independent_terrain_connectivity) {
    navigation::testing::World world(std::vector<std::string>(height,std::string(width,'.')));
    world.loadTwilightFlameTerrain();
    const auto terrain=world.terrainClassification();
    std::vector<int> components(width*height,-1), passable;
    std::vector<int> queue;
    int component=0;
    for (int start=0;start<width*height;++start) {
        if (terrain[start/width][start%width]!='.') continue;
        passable.push_back(start);
        if (components[start]>=0) continue;
        queue={start}; components[start]=component++;
        for (std::size_t head=0;head<queue.size();++head) {
            const int x=queue[head]%width,y=queue[head]/width;
            for (auto delta : {std::array{1,0},std::array{-1,0},std::array{0,1},std::array{0,-1}}) {
                const int xx=x+delta[0],yy=y+delta[1];
                if (xx<0 || xx>=width || yy<0 || yy>=height) continue;
                const int next=yy*width+xx;
                if (components[next]>=0 || terrain[yy][xx]!='.') continue;
                components[next]=components[start]; queue.push_back(next);
            }
        }
    }
    BOOST_REQUIRE(passable.size()>50000u);
    BOOST_REQUIRE(passable.size()<220000u);
    // Real terrain, native route/clearance code, and persistent occupancy.
    // These are occupancy records, not 10,000 simulated unit objects.
    world.populateMovingUnits(10000);
    std::uint32_t seed=0x7481u;
    auto next=[&] { seed=1664525u*seed+1013904223u; return passable[seed%passable.size()]; };
    for (int sample=0;sample<24;++sample) {
        const int from=next(),to=next();
        BOOST_TEST_CONTEXT("Twilight Flame route " << from << " -> " << to) {
            const auto first=world.normal(from%width,from/width,to%width,to/width);
            BOOST_TEST(first.found==(components[from]==components[to]));
            BOOST_TEST(first.legal);
            BOOST_TEST(first.clean);
            const auto repeated=world.normal(from%width,from/width,to%width,to/width);
            BOOST_TEST(first.raw==repeated.raw);
            BOOST_TEST(first.optimized==repeated.optimized);
            BOOST_TEST(world.movingUnitCount()==10000);
            if (sample<4) {
                // Paused kernels consume an immutable real-terrain view. This
                // proves slicing invariance; it does not pause live unit AI yet.
                const auto heuristic=[&](unsigned id) {
                    return 10u*unsigned(std::abs(int(id)%width-to%width)+std::abs(int(id)/width-to/width));
                };
                const auto neighbors=[&](unsigned id,auto emit) {
                    const int x=int(id)%width,y=int(id)/width;
                    for (auto delta : {std::array{1,0},std::array{-1,0},std::array{0,1},std::array{0,-1}}) {
                        const int xx=x+delta[0],yy=y+delta[1];
                        if(xx>=0 && xx<width && yy>=0 && yy<height && terrain[yy][xx]=='.')
                            emit(unsigned(yy*width+xx),10u);
                    }
                };
                navigation::RouteSearchResult expected;
                for (const unsigned budget : {50000u,73u,1u}) {
                    navigation::RouteSearchWorkspace sliced;
                    sliced.begin(width*height,from,to,heuristic);
                    while(sliced.status()==navigation::RouteSearchStatus::Searching) {
                        const auto before=sliced.result().expanded;
                        sliced.advance(budget,heuristic,neighbors);
                        BOOST_REQUIRE(sliced.result().expanded-before<=budget);
                    }
                    const auto& result=sliced.result();
                    BOOST_REQUIRE(result.found()==(components[from]==components[to]));
                    if (budget==50000) expected=result;
                    else {
                        BOOST_REQUIRE(result.nodes==expected.nodes);
                        BOOST_REQUIRE(result.cost==expected.cost);
                        BOOST_REQUIRE(result.expanded==expected.expanded);
                    }
                }
            }
        }
    }
}

BOOST_AUTO_TEST_CASE(enclosed_goal_proof_preserves_dx9_anchor_terrain_crossings) {
    // DX9 examineNeighboringCells checks anchor terrain; checkForMovement
    // applies the footprint to traffic, not surrounding terrain cells.
    std::vector<std::string> map(31,std::string(31,'.'));
    for (int y=10;y<=20;++y) for (int x=10;x<=20;++x)
        if (x==10 || x==20 || y==10 || y==20) map[y][x]='#';
    map[15][20]='.';
    navigation::testing::World world(map);
    BOOST_TEST(!world.enclosedGoal(25,15,15,15,1));
    BOOST_TEST(!world.enclosedGoal(25,15,15,15,0));
    world.setCell(20,15,'#');
    BOOST_TEST(world.enclosedGoal(25,15,15,15,1));
    BOOST_TEST(world.enclosedGoal(25,15,15,15,0));
}

