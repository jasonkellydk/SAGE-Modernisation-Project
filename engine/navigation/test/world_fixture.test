namespace {
// Exercise the captured fine graph under the same complete refinement policy
// as live routing. The expected raw route still comes from the native adapter;
// no native objects or lookup callbacks survive in this independent search.
class CapturedReferenceSearch {
    navigation::CapturedWeightedGraph& graph_;
    navigation::RouteSearchWorkspace search_;
    navigation::CapturedReferenceCursor cursor_;
public:
    explicit CapturedReferenceSearch(navigation::CapturedWeightedGraph& graph):graph_(graph) {
        // DX9 phase rays observe cheaper predecessors outside coarse corridors.
        // Ordinary queries therefore refine the complete fine graph.
        search_.useReferenceOrder();
        search_.begin(graph.nodeCount(),graph.start(),graph.goal(),[&](auto id){return graph.referenceHeuristic(id);});
    }
    bool done() const {
        return search_.result().found() || search_.status()==navigation::RouteSearchStatus::Unreachable;
    }
    const navigation::RouteSearchResult& result() const { return search_.result(); }
    void advance(unsigned budget) {
        const auto heuristic=[&](auto id){return graph_.referenceHeuristic(id);};
        search_.advanceReferenceSlice(budget,heuristic,[&](auto id,unsigned available,auto emit) {
            return graph_.advanceReferenceNeighbors(id,search_,cursor_,available,emit);
        });
    }
};
}

BOOST_AUTO_TEST_CASE(dx9_repair_bound_drains_queued_destinations_without_becoming_a_frame_budget) {
    navigation::testing::World world(std::vector<std::string>(96,std::string(96,'.')));
    for (unsigned slice:{1u,31u,4096u}) {
        const auto queued=world.boundedRejoin(17,16,1,slice);
        BOOST_TEST(queued.found);
        const auto distant=world.boundedRejoin(85,85,2000,slice);
        BOOST_TEST(!distant.found);
        BOOST_TEST(distant.cells<2100);
    }
    // The same distant request is reachable when no gameplay bound applies.
    BOOST_TEST(world.boundedRejoin(85,85,0,4096).found);
}

BOOST_AUTO_TEST_CASE(explicit_footprint_topology_and_dx9_anchor_routes_keep_distinct_rules) {
    std::vector<std::string> map(128,std::string(128,'.'));
    for (auto& row:map) row[63]='#';
    map[64][63]='.';
    for (int y=109;y<=111;++y) map[y][63]='.';
    navigation::testing::World world(map);
    // Explicit footprint topology uses the wide crossing. DX9 ordinary routing
    // checks anchor terrain and uses the footprint only for unit traffic.
    const auto coarse=world.coarseForFootprint(32,64,96,64,1);
    BOOST_REQUIRE(!coarse.empty());
    BOOST_TEST(std::any_of(coarse.begin(),coarse.end(),[](auto node) { return node/8==6; }));
    const auto point=world.coarseForFootprint(32,64,96,64,0);
    BOOST_REQUIRE(!point.empty());
    BOOST_TEST(std::none_of(point.begin(),point.end(),[](auto node) { return node/8==6; }));
    std::string raw,optimized;
    for (unsigned budget:{1u,31u,4096u}) {
        const auto before=world.hierarchyStats();
        const auto route=world.hierarchicalForFootprint(32,64,96,64,1,budget);
        BOOST_REQUIRE(route.found);
        BOOST_TEST(route.legal);
        BOOST_TEST(world.hierarchyStats()[0]==before[0]+1);
        BOOST_TEST(world.hierarchyStats()[1]==before[1]);
        BOOST_CHECK(std::find(route.rawGroundCells.begin(),route.rawGroundCells.end(),
            std::array<int,2>{63,64})!=route.rawGroundCells.end());
        if (raw.empty()) { raw=route.raw;optimized=route.optimized; }
        else { BOOST_TEST(route.raw==raw);BOOST_TEST(route.optimized==optimized); }
    }
    for (int y=63;y<=65;++y) world.setCell(63,y,'.');
    const auto opened=world.coarseForFootprint(32,64,96,64,1);
    BOOST_REQUIRE(!opened.empty());
    BOOST_TEST(std::none_of(opened.begin(),opened.end(),[](auto node) { return node/8==6; }));
    const auto route=world.hierarchicalForFootprint(32,64,96,64,1,31);
    BOOST_REQUIRE(route.found);
    BOOST_TEST(route.legal);
    BOOST_CHECK(std::find(route.rawGroundCells.begin(),route.rawGroundCells.end(),
        std::array<int,2>{63,64})!=route.rawGroundCells.end());
}

BOOST_AUTO_TEST_CASE(native_hpa_terrain_edits_invalidate_distant_footprint_anchors) {
    std::vector<std::string> map(128,std::string(128,'.'));
    for (auto& row:map) row[63]='#';
    for (int y=44;y<=84;++y) map[y][63]='.';
    navigation::testing::World world(map);
    // This unusually large footprint makes the dependency span more than a
    // cluster. Closing the top cell invalidates the crossing anchored at y=64.
    BOOST_REQUIRE(!world.coarseForFootprint(32,64,96,64,20).empty());
    world.setCell(63,44,'#');
    BOOST_TEST(world.coarseForFootprint(32,64,96,64,20).empty());
    BOOST_TEST(!world.coarseForFootprint(32,64,96,64,0).empty());
    world.setCell(63,44,'.');
    BOOST_TEST(!world.coarseForFootprint(32,64,96,64,20).empty());
}

BOOST_AUTO_TEST_CASE(cached_terrain_planes_match_independent_footprint_enumeration) {
    std::vector<std::string> map(32,std::string(32,'.'));
    for (int i=3;i<29;++i) {
        map[5][i]='#';map[12][i]='~';map[19][i]='^';map[26][i]='r';
    }
    navigation::testing::World world(map);
    for (const auto surfaces:{1u,3u,5u,17u,21u,31u})
        for (int radius=0;radius<=2;++radius) for (const bool centered:{false,true}) {
            const auto actual=world.cachedTerrainForFootprint(radius,centered,surfaces);
            BOOST_REQUIRE(actual.size()==1024u);
            const int above=std::max(1,radius+int(centered));
            for (int y=0;y<32;++y) for (int x=0;x<32;++x) {
                bool expected=true;
                for (int yy=y-radius;yy<y+above;++yy) for (int xx=x-radius;xx<x+above;++xx) {
                    if (xx<0 || yy<0 || xx>=32 || yy>=32) { expected=false;continue; }
                    const char cell=map[yy][xx];
                    const unsigned required=cell=='.'?1:cell=='~'?2:cell=='^'?4:cell=='r'?16:0;
                    expected&=(surfaces&8)!=0 || (surfaces&required)!=0;
                }
                BOOST_TEST_CONTEXT("surfaces=" << surfaces << " radius=" << radius << " centered=" << centered
                    << " x=" << x << " y=" << y) {
                    BOOST_TEST(bool(actual[y*32+x])==expected);
                }
            }
        }
}

