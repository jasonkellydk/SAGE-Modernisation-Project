BOOST_AUTO_TEST_CASE(closest_route_through_a_dx9_anchor_opening_reaches_the_goal) {
    std::vector<std::string> map(128,std::string(128,'.'));
    for (int y=10;y<=20;++y) for (int x=10;x<=20;++x)
        if (x==10 || x==20 || y==10 || y==20) map[y][x]='#';
    map[15][20]='.';
    navigation::testing::World world(map);
    const auto route=world.closestForFootprint(25,15,15,15,1);
    BOOST_REQUIRE(route.found);
    BOOST_TEST(route.legal);
    BOOST_TEST(route.cells<2000);
    BOOST_REQUIRE(!route.rawGroundCells.empty());
    const auto end=route.rawGroundCells.back();
    const int dx=end[0]-15,dy=end[1]-15;
    BOOST_TEST(dx*dx+dy*dy==0);
    const auto repeat=world.closestForFootprint(25,15,15,15,1);
    BOOST_TEST(repeat.raw==route.raw);
    BOOST_TEST(repeat.optimized==route.optimized);
}

BOOST_AUTO_TEST_CASE(twilight_flame_pinched_destination_is_projected_before_search) {
    navigation::testing::World world(std::vector<std::string>(height,std::string(width,'.')));
    world.loadTwilightFlameTerrain();
    const auto route=world.ground(76,16,365,256);
    BOOST_REQUIRE(route.found);
    BOOST_TEST(route.legal);
    BOOST_TEST(route.clean);
    const auto repeat=world.ground(76,16,365,256);
    BOOST_TEST(repeat.raw==route.raw);
    BOOST_TEST(repeat.optimized==route.optimized);
}

BOOST_AUTO_TEST_CASE(twilight_flame_pinched_start_keeps_its_position_and_uses_a_local_exit) {
    navigation::testing::World world(std::vector<std::string>(height,std::string(width,'.')));
    world.loadTwilightFlameTerrain();
    const auto route=world.ground(476,381,26,176);
    BOOST_REQUIRE(route.found);
    BOOST_TEST(route.legal);
    BOOST_TEST(route.clean);
    BOOST_REQUIRE(route.rawGroundCells.size()>1);
    BOOST_TEST(route.rawGroundCells.front()[0]==476);
    BOOST_TEST(route.rawGroundCells.front()[1]==381);
    const auto exit=route.rawGroundCells[1];
    BOOST_TEST(std::abs(exit[0]-476)+std::abs(exit[1]-381)==1);
    const auto repeat=world.ground(476,381,26,176);
    BOOST_TEST(repeat.raw==route.raw);
    BOOST_TEST(repeat.optimized==route.optimized);
}

BOOST_AUTO_TEST_CASE(pinched_start_cannot_escape_through_an_enclosing_cliff_wall) {
    std::vector<std::string> map(16,std::string(16,'.'));
    for (int y=5;y<=9;++y) for (int x=5;x<=9;++x)
        if (x==5 || x==9 || y==5 || y==9) map[y][x]='^';
    navigation::testing::World world(map);
    for (int y=6;y<=8;++y) for (int x=6;x<=8;++x) world.setPinched(x,y,true,true);
    const auto route=world.ground(7,7,13,13);
    BOOST_TEST(!route.found);
    BOOST_TEST(route.clean);
}

BOOST_AUTO_TEST_CASE(twilight_flame_multiple_step_start_escape_preserves_start_and_route) {
    navigation::testing::World world(std::vector<std::string>(height,std::string(width,'.')));
    world.loadTwilightFlameTerrain();
    const auto route=world.ground(116,314,4,219);
    BOOST_REQUIRE(route.found);
    BOOST_TEST(route.legal);
    BOOST_TEST(route.clean);
    BOOST_REQUIRE(route.rawGroundCells.size()>2);
    BOOST_TEST(route.rawGroundCells.front()[0]==116);
    BOOST_TEST(route.rawGroundCells.front()[1]==314);
    const auto repeat=world.ground(116,314,4,219);
    BOOST_TEST(repeat.raw==route.raw);
    BOOST_TEST(repeat.optimized==route.optimized);
}

BOOST_AUTO_TEST_CASE(twilight_captured_routes_and_cancellation_repeat_identically) {
    navigation::testing::World world(std::vector<std::string>(height,std::string(width,'.')));
    world.loadTwilightFlameTerrain();
    const auto serial=world.capturedNativeRoutes();
    BOOST_REQUIRE(!serial.empty());
    BOOST_TEST(world.capturedNativeRoutes()==serial);
    BOOST_TEST(world.capturedNativeRoutes()==serial);
}
