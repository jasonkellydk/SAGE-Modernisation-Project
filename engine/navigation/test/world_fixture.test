BOOST_AUTO_TEST_CASE(captured_twilight_weighted_search_survives_world_destruction_and_resumes) {
    const auto captured=[] {
        navigation::testing::World world(std::vector<std::string>(height,std::string(width,'.')));
        world.loadTwilightFlameTerrain();
        return world.captureWeightedRoute(116,314,4,219);
    }(); // Native map, pathfinder and game objects are destroyed here.
    auto& graph=*captured.graph;
    BOOST_REQUIRE(graph.goalAllowed());
    BOOST_REQUIRE(captured.reference.size()>2u);
    for (unsigned budget : {1u,31u,4096u}) {
        auto query=graph.cloneQuery();
        CapturedReferenceSearch search(query);
        unsigned updates=0;
        while (!search.done()) {
            const auto before=search.result().work;
            search.advance(budget);
            BOOST_TEST(search.result().work-before<=budget);
            // Credits now include individual phase samples, not just popped
            // nodes. Retain a finite guard while allowing those smaller slices.
            BOOST_REQUIRE(++updates<=std::uint64_t(graph.nodeCount())*32);
        }
        BOOST_TEST(search.result().nodes==captured.reference);
    }
}

BOOST_AUTO_TEST_CASE(twilight_captured_search_batches_repeat_identically) {
    const auto captured=[] {
        navigation::testing::World world(std::vector<std::string>(height,std::string(width,'.')));
        world.loadTwilightFlameTerrain();
        return world.captureWeightedRoute(116,314,4,219);
    }();
    // Share only immutable map/occupant planes. Every search owns its memo and
    // workspace; no native world remains alive during execution.
    std::vector<navigation::RouteSearchResult> reference;
    for (unsigned repetition=0;repetition<3;++repetition) {

        std::vector<navigation::CapturedWeightedGraph> graphs;
        for (unsigned i=0;i<8;++i) graphs.push_back(captured.graph->cloneQuery());
        std::vector<std::unique_ptr<CapturedReferenceSearch>> searches;
        for (unsigned i=0;i<8;++i) {
            searches.push_back(std::make_unique<CapturedReferenceSearch>(graphs[i]));
        }
        unsigned slices=0;
        while (std::any_of(searches.begin(),searches.end(),[](const auto& search) {
            return !search->done();
        })) {
            for (std::size_t i=0;i<8;++i) {
                searches[i]->advance(31);
            }
            BOOST_REQUIRE(++slices<=graphs.front().nodeCount());
        }
        for (unsigned i=0;i<8;++i) {
            const auto& result=searches[i]->result();
            BOOST_TEST(result.nodes==captured.reference,boost::test_tools::per_element());
            if (!repetition) reference.push_back(result);
            else {
                BOOST_TEST(result.nodes==reference[i].nodes,boost::test_tools::per_element());
                BOOST_TEST(result.cost==reference[i].cost);
                BOOST_TEST(result.expanded==reference[i].expanded);
                BOOST_TEST(result.work==reference[i].work);
            }
        }
    }
}

