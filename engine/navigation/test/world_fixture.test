    world.loadTwilightFlameTerrain();
    const auto [total,maximum,resumes]=world.weightedContinuationSlices();
    // Exact expansion counts are an implementation detail; repeated runs must
    // perform identical accounted work and retain every slice boundary.
    BOOST_TEST(total==world.weightedContinuationSlices()[0]);
    BOOST_TEST(maximum<=navigation::CellsPerFrame);
    BOOST_TEST(resumes>=9u);
}

