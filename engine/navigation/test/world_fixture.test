BOOST_AUTO_TEST_CASE(reconstructed_waypoint_flags_follow_dx9_cliff_boundaries) {
    // Pinned DX9 AIPathfind.cpp, Pathfinder::prependCells: non-start nodes
    // allow look-ahead, except a non-cliff node immediately beside a cliff.
    // Rubble does not by itself protect a waypoint. A single-cell lane fixes
    // the raw sequence independently of frontier ordering and smoothing.
    for (bool cliff:{false,true}) for (bool captured:{false,true}) {
        std::vector<std::string> map(5,std::string(16,'#'));
        map[2]=std::string(16,'.');
        for (int x=5;x<=8;++x) map[2][x]=cliff?'^':'r';
        navigation::testing::World world(map);
        const auto route=world.reconstructedWaypointMetadata(cliff,captured);
        BOOST_TEST_CONTEXT("cliff=" << cliff << " captured=" << captured) {
            BOOST_REQUIRE(route.found);
            BOOST_REQUIRE(route.rawGroundCells.size()==12u);
            BOOST_REQUIRE(route.rawOptimizationFlags.size()==12u);
            for (unsigned i=0;i<12;++i) {
                BOOST_TEST(route.rawGroundCells[i][0]==int(i+1));
                BOOST_TEST(route.rawGroundCells[i][1]==2);
                const unsigned expected=i!=0 && !(cliff && (i==3 || i==8));
                BOOST_TEST(route.rawOptimizationFlags[i]==expected);
            }
        }
    }
}

