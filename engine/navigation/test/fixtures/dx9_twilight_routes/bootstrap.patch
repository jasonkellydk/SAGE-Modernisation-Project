diff --git a/CMakeLists.txt b/CMakeLists.txt
index 3099079c6..b2afb5f2d 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -98,3 +98,17 @@ endif()
 
 feature_summary(WHAT ENABLED_FEATURES DESCRIPTION "Enabled features:")
 feature_summary(WHAT DISABLED_FEATURES DESCRIPTION "Disabled features:")
+
+# Isolated characterization executable. Never linked into the modern game.
+add_executable(dx9_route_reference navigation_reference.cpp)
+target_include_directories(dx9_route_reference PRIVATE
+    "${CMAKE_SOURCE_DIR}/Core/GameEngine/Include/Precompiled"
+    "${CMAKE_BINARY_DIR}/GeneralsMD/Code/Main")
+target_link_libraries(dx9_route_reference PRIVATE
+    comctl32 d3d9lib imm32 SDL3::SDL3 vfw32 winmm
+    z_gameengine z_gameenginedevice zi_always)
+add_custom_command(TARGET dx9_route_reference POST_BUILD
+    COMMAND ${CMAKE_COMMAND} -E copy_if_different
+        "$<TARGET_FILE:SDL3::SDL3>" "$<TARGET_FILE_DIR:dx9_route_reference>"
+    COMMAND ${CMAKE_COMMAND} -E copy_directory_if_different
+        "${ffmpeg_SOURCE_DIR}/bin" "$<TARGET_FILE_DIR:dx9_route_reference>")
