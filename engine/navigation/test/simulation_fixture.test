BOOST_AUTO_TEST_CASE(player_commands_respond_while_background_searches_are_busy,
    *boost::unit_test::disabled()) {
    const auto* configured=std::getenv("SAGE_NAVIGATION_COMMAND_UNIT");
    const auto* type=configured?configured:"AmericaVehicleDozer";
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    const auto result=simulation.playerUnitRespondsWithBusyNavigation(type);
    BOOST_TEST_MESSAGE("Command response: " << type << " first_ticks=" << result.firstRouteTicks
        << " replacement_ticks=" << result.replacementRouteTicks << " moved=" << result.moved << result.detail);
    BOOST_TEST(result.firstRouteTicks==1u);
    BOOST_TEST(result.replacementRouteTicks==1u);
    BOOST_TEST(result.latestGoal);
    BOOST_TEST(result.moved);
}

