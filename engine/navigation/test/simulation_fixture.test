BOOST_AUTO_TEST_CASE(ten_thousand_real_units_on_twilight_flame) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    // A deterministic budget may defer admission. Allow a finite 400 simulated
    // seconds for all 10,000 real units; keep the actual-movement requirement.
    const auto group = simulation.moveHumveeGroup(10000, 12000, true);
    BOOST_TEST_MESSAGE("10000 real Rangers: alive=" << group.alive << " advanced=" << group.advanced
        << " pending_after_first_update=" << group.pendingAfterFirstUpdate
        << " closer=" << group.closer << " abandoned=" << group.abandoned
        << " waiting=" << group.waiting << " invalid_initial_goals=" << group.invalidInitialGoals
        << " navigation_work=" << group.navigationWork
        << " pathfind_queue_ms=" << group.pathfindQueueMilliseconds
        << " worst_pathfind_queue_ms=" << group.worstPathfindQueueMilliseconds
        << " request_ms=" << group.requestMilliseconds
        << " worst_request_ms=" << group.worstRequestMilliseconds
        << " dispatch_ms=" << group.dispatchMilliseconds
        << " worst_dispatch_ms=" << group.worstDispatchMilliseconds
        << " max_slice_ms=" << group.maximumSliceMilliseconds
        << " max_slice_object=" << group.maximumSliceObject
        << " max_slice_work=" << group.maximumSliceWork
        << " max_slice_start=" << group.maximumSliceStartX << ',' << group.maximumSliceStartY
        << " max_slice_goal=" << group.maximumSliceGoalX << ',' << group.maximumSliceGoalY
        << " slice_ms=" << group.sliceMilliseconds
        << " commit_ms=" << group.commitMilliseconds
        << " maximum_navigation_work=" << group.maximumNavigationWork
        << " budget_exhausted_updates=" << group.budgetExhaustedUpdates
        << " command_ms=" << group.commandMilliseconds << " update_ms=" << group.updateMilliseconds
        << " worst_update_ms=" << group.worstUpdateMilliseconds << " digest=" << group.digest);
    for (const auto& stalled : group.stalled) BOOST_TEST_MESSAGE(stalled);
    BOOST_TEST(group.created == 10000u);
    BOOST_TEST(group.pendingAfterFirstUpdate>0u);
    BOOST_TEST(group.invalidInitialGoals == 0u);
    BOOST_TEST(group.alive == 10000u);
    BOOST_TEST(group.abandoned == 0u);
    BOOST_TEST(group.advanced == 10000u);
}

namespace {
void verifyNativeSerial(unsigned count=2000) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    simulation.resetNavigationPlanner();
    const unsigned frames=count==2000?2600u:600u;
    const auto group=simulation.moveHumveeGroup(count,frames,true,{},true);
    BOOST_TEST_MESSAGE("Native serial units=" << group.alive
        << " update_ms=" << group.updateMilliseconds << " navigation_work=" << group.navigationWork
        << " advanced=" << group.advanced << " digest=" << group.digest);
    BOOST_REQUIRE(group.alive==count);
    BOOST_TEST(group.abandoned==0u);
    if (count==2000) BOOST_TEST(group.advanced==count);
    BOOST_REQUIRE(group.frameCRCs.size()==frames);
    for (unsigned frame=0;frame<group.frameCRCs.size();++frame)
        BOOST_TEST_MESSAGE("navigation_frame_crc=" << frame << ":" << group.frameCRCs[frame]);
}

BOOST_AUTO_TEST_CASE(save_oracle_many_unit_commands_reproduce_deterministically, *boost::unit_test::disabled()) {
    const auto* configuredSave=std::getenv("SAGE_NAVIGATION_TEST_SAVE");
    if (!configuredSave || !*configuredSave) {
        BOOST_TEST_MESSAGE("SKIP: Set SAGE_NAVIGATION_TEST_SAVE to an external save fixture.");
        return;
    }
    const std::filesystem::path oracle=configuredSave;
    BOOST_REQUIRE_MESSAGE(std::filesystem::is_regular_file(oracle), "Save fixture does not exist: " << oracle.string());

    bool resetPlanner=false;
    if (const auto* value=std::getenv("SAGE_NAVIGATION_TEST_RESET_PLANNER"))
        resetPlanner=std::strtoul(value,nullptr,10)!=0;
    unsigned frames=120;
    if (const auto* value=std::getenv("SAGE_NAVIGATION_TEST_SAVE_FRAMES"))
        frames=static_cast<unsigned>(std::strtoul(value,nullptr,10));
    BOOST_REQUIRE(frames>0u && frames<=10000u);
    bool startupSeed=false;
    if (const auto* value=std::getenv("SAGE_NAVIGATION_TEST_STARTUP_SEED"))
        startupSeed=std::strtoul(value,nullptr,10)!=0;
    navigation::testing::Simulation simulation;
    const auto report=simulation.replaySaveOracle(oracle,frames,resetPlanner,startupSeed);
    BOOST_REQUIRE(report.loaded);
    BOOST_TEST(report.objectCount>100u);
    BOOST_TEST(report.frames==frames);
    BOOST_TEST(report.commandCount>0u);
    BOOST_TEST(report.commands.size()==report.commandCount);
    // save_oracle_determinism.cmake compares command and frame digests across
    // fresh serial processes. Historical modern checksums (16046841180281878794,
    // 13137731682003174573) predate restored DX9 terrain/route rules and are not
    // a cross-version contract. Independently captured DX9 routes have their
    // own frozen regression; full save/load continuation is tested separately.
    BOOST_TEST(report.worstUpdateMilliseconds<500.0);
    BOOST_TEST(report.totalUpdateMilliseconds<frames*500.0);
    BOOST_TEST_MESSAGE("Save oracle: objects=" << report.objectCount
        << " commands=" << report.commandCount
        << " load_ms=" << report.loadMilliseconds
        << " total_update_ms=" << report.totalUpdateMilliseconds
        << " worst_update_ms=" << report.worstUpdateMilliseconds
        << " max_path_queue_ms=" << report.maximumPathQueueMilliseconds
        << " max_path_slice_ms=" << report.maximumPathSliceMilliseconds
        << " max_path_slice_object=" << report.maximumPathSliceObject
        << " max_path_slice_work=" << report.maximumPathSliceWork
        << " max_path_commit_ms=" << report.maximumPathCommitMilliseconds
        << " max_path_request_ms=" << report.maximumPathRequestMilliseconds
        << " max_path_dispatch_ms=" << report.maximumPathDispatchMilliseconds
        << " navigation_work=" << report.navigationWork
        << " maximum_navigation_work=" << report.maximumNavigationWork
        << " command_digest=" << report.commandDigest
        << " frame_digest=" << report.frameDigest);
    std::ostringstream commandFrames;
    commandFrames << "Save oracle command counts per frame:";
    for (const auto count:report.commandCountsPerFrame) commandFrames << ' ' << count;
    BOOST_TEST_MESSAGE(commandFrames.str());
    std::ostringstream divergentCommands;
    divergentCommands << "Save oracle commands at frames 46-50:";
    for (const auto& command:report.commands)
        if (command.frame>=46 && command.frame<=50)
            divergentCommands << ' ' << command.frame << ':' << command.objectId << ':' << command.command;
    BOOST_TEST_MESSAGE(divergentCommands.str());

    // Compare fresh serial processes, including planner reconstruction after load.
}
void verifySpecialSerial() {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    simulation.resetNavigationPlanner();
    const auto crcs=simulation.specialRequestFrameCRCs();
    BOOST_TEST_MESSAGE("Native serial scenario=mixed_approach_flee_cancellation");
    BOOST_REQUIRE(crcs.size()==600u);
    for (unsigned frame=0;frame<crcs.size();++frame)
        BOOST_TEST_MESSAGE("navigation_frame_crc=" << frame << ":" << crcs[frame]);
}
}
BOOST_AUTO_TEST_CASE(native_special_serial, *boost::unit_test::disabled()) { verifySpecialSerial(); }
BOOST_AUTO_TEST_CASE(native_simulation_serial, *boost::unit_test::disabled()) { verifyNativeSerial(); }

BOOST_AUTO_TEST_CASE(native_ten_thousand_serial, *boost::unit_test::disabled()) { verifyNativeSerial(10000); }

BOOST_AUTO_TEST_CASE(supply_trucks_pick_up_and_deliver_through_shared_docks, *boost::unit_test::disabled()) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    for (unsigned count:{1u,4u}) {
        BOOST_TEST_MESSAGE("Supply truck count=" << count);
        const auto failures=simulation.supplyTrucksCompleteDockCycles(count);
        for (const auto& failure:failures) BOOST_TEST_MESSAGE(failure);
        BOOST_TEST(failures.empty());
    }
}

BOOST_AUTO_TEST_CASE(supply_trucks_keep_driving_between_shared_docks, *boost::unit_test::disabled()) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    const auto failures=simulation.supplyTrucksCompleteDockCycles(8,3);
    for (const auto& failure:failures) BOOST_TEST_MESSAGE(failure);
    BOOST_TEST(failures.empty());
}

BOOST_AUTO_TEST_CASE(returning_supply_truck_does_not_overtake_a_waiting_truck, *boost::unit_test::disabled()) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    BOOST_TEST(simulation.dockAdmissionsRespectArrival());
    BOOST_TEST(simulation.dockAdmissionsRespectArrival(true));
}
