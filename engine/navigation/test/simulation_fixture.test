BOOST_AUTO_TEST_CASE(crowded_native_and_captured_searches_agree,*boost::unit_test::disabled()) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    BOOST_TEST_MESSAGE(simulation.compareCrowdedLiveAndCapturedRoute());
