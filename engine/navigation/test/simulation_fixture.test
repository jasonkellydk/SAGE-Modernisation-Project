BOOST_AUTO_TEST_CASE(clear_route_driving_does_not_repeatedly_reverse_steering, *boost::unit_test::disabled()) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    for (const auto* type:{"AmericaInfantryRanger","AmericaVehicleHumvee","ChinaVehicleSupplyTruck"})
        for (unsigned count:{1u,2u,8u}) for (float angle:{0.f,1.0f}) {
            const auto result=simulation.driveClearParallelLane(type,count,angle);
            BOOST_TEST_CONTEXT(type << " count=" << count << " initial_angle=" << angle) {
                BOOST_TEST_MESSAGE("Driving: " << type << " count=" << count << " angle=" << angle
                    << " reversals=" << result.reversals << " maximum_reversals=" << result.maximumReversals << " blocked=" << result.blocked
                    << " progress=" << result.progress << " maximum_turn=" << result.maximumTurn);
                for (const auto& detail:result.details) BOOST_TEST_MESSAGE(detail);
                BOOST_TEST(result.maximumReversals<=2u);
                BOOST_TEST(result.progress>50);
            }
        }
}

BOOST_AUTO_TEST_CASE(route_repair_rejoins_farther_tail_when_nearest_node_is_enclosed, *boost::unit_test::disabled()) {
    // DX9 patchPath accepts every usable node in the original tail. It does
    // not restrict the destination set to the geometrically closest node.
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    BOOST_TEST(simulation.patchPathRejoinsBeyondEnclosedNearestNode());
}

BOOST_AUTO_TEST_CASE(northwest_twilight_crowd_keeps_moving, *boost::unit_test::disabled()) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    // Allow the deterministic FIFO to serve the burst, then observe movement.
    // Keep the all-units assertion: increasing the horizon must not hide drops.
    const auto group=simulation.moveNorthwestCrowd(2400);
    BOOST_TEST_MESSAGE("Northwest crowd: alive=" << group.alive << " advanced=" << group.advanced
        << " closer=" << group.closer << " update_ms=" << group.updateMilliseconds
        << " digest=" << group.digest);
    for (const auto& detail:group.stalled) BOOST_TEST_MESSAGE(detail);
    BOOST_TEST(group.created==1024u);
    BOOST_TEST(group.alive==1024u);
    BOOST_TEST(group.invalidInitialGoals==0u);
    BOOST_TEST(group.abandoned==0u);
    BOOST_TEST(group.advanced==1024u);
}

