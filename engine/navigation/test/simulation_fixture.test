BOOST_AUTO_TEST_CASE(real_twilight_flame_initialization_and_objectless_vehicle_preview) {
    navigation::testing::Simulation simulation;
    BOOST_TEST(simulation.userDataPath() == simulation.expectedDataPath());
    BOOST_TEST(simulation.hasUnitTemplate("AmericaVehicleHumvee"));
    BOOST_TEST(simulation.hasUnitTemplate("AmericaTankPaladin"));
    simulation.loadTwilightFlame();
    BOOST_TEST(simulation.objectCount() > 100u);
    BOOST_TEST(simulation.terrainWidth() > 4000.0f);
    BOOST_TEST(simulation.generalPartitionRangesMatchBruteForce());
    BOOST_TEST(simulation.movingSmallUnitsKeepPartitionMembershipsCurrent());
    BOOST_TEST(simulation.destroyedMoversCancelWeightedTasks());
    BOOST_TEST(simulation.replacementOrdersCancelWeightedTasks());
    BOOST_TEST(simulation.capturedOccupantsOutliveNativeObjects());
    BOOST_TEST(simulation.capturedCellsKeepHistoricalValues());
    BOOST_TEST(simulation.destinationReservationsMatchCapturedState());
    BOOST_TEST(simulation.groundBlockingFootprintMatchesFullPolicy());
    BOOST_TEST(simulation.lineChecksDistinguishFixedAndMovingOccupancy());
    BOOST_TEST(simulation.overlappingNativeContactsAreInitialized());
    BOOST_TEST(simulation.lineChecksKeepCrusherCapabilitiesQueryLocal());
    BOOST_TEST(simulation.followsProtectedCorner());
    BOOST_TEST(simulation.dx9FollowerUsesVisibleWaypointAndRefreshesAfterSmallMovement());
    BOOST_TEST(simulation.editedPathsDiscardCachedTargets());
    BOOST_TEST(simulation.nativeGroundRequestsCompleteAcrossSlices());
    BOOST_TEST(simulation.queuedSpecialRoutesCompleteAcrossSlices());
    BOOST_TEST(simulation.queuedSpecialRoutesCompleteAcrossSlices(true));
    BOOST_TEST(simulation.legacySpecialRouteContracts());
    BOOST_TEST(simulation.patchPathRejoinsUsableTail());
    BOOST_TEST(simulation.weightedRoutesPreserveAllyYieldFlag());
    BOOST_TEST(simulation.dozerCanPlanThroughFriendlyConstruction());
    const auto dockFailures=simulation.supplyTrucksCompleteDockCycles(4);
    for (const auto& failure:dockFailures) BOOST_TEST_MESSAGE(failure);
    BOOST_TEST(dockFailures.empty());
    BOOST_TEST(simulation.destroyedArmiesLeaveSurvivorUpdatesScheduled());
    BOOST_TEST(simulation.hijackingInvalidatesQueuedContacts());
    BOOST_TEST(simulation.deferredDestinationIsRevalidatedBeforePublication());
    BOOST_TEST(simulation.rangerMovesAfterTurningInsideItsWalkingAngle());
    BOOST_TEST(simulation.moveObjectlessVehiclePreview());
    BOOST_TEST(simulation.moveRealHumvee() > 100.0f);
    // Observe queued traffic through two 20-second windows, including blocked
    // recovery. Movement and progress are required for every unit; this is
    // separate from the per-frame performance gate.
    const auto group = simulation.moveHumveeGroup(250, 1200);
    BOOST_TEST_MESSAGE("250 real Humvees: alive=" << group.alive << " advanced=" << group.advanced
        << " closer=" << group.closer << " abandoned=" << group.abandoned << " command_ms=" << group.commandMilliseconds
        << " update_ms=" << group.updateMilliseconds << " worst_update_ms=" << group.worstUpdateMilliseconds
        << " pathfind_queue_ms=" << group.pathfindQueueMilliseconds
        << " worst_pathfind_queue_ms=" << group.worstPathfindQueueMilliseconds
        << " request_ms=" << group.requestMilliseconds
        << " worst_request_ms=" << group.worstRequestMilliseconds
        << " dispatch_ms=" << group.dispatchMilliseconds
        << " worst_dispatch_ms=" << group.worstDispatchMilliseconds
        << " max_slice_ms=" << group.maximumSliceMilliseconds
        << " max_slice_object=" << group.maximumSliceObject
        << " max_slice_work=" << group.maximumSliceWork
        << " max_slice_start=" << group.maximumSliceStartX << ',' << group.maximumSliceStartY
        << " max_slice_goal=" << group.maximumSliceGoalX << ',' << group.maximumSliceGoalY
        << " slice_ms=" << group.sliceMilliseconds
        << " commit_ms=" << group.commitMilliseconds
        << " digest=" << group.digest);
    for (const auto& stalled : group.stalled) BOOST_TEST_MESSAGE(stalled);
    BOOST_TEST(group.created == 250u);
    BOOST_TEST(group.alive == 250u);
    BOOST_TEST(group.abandoned == 0u);
    BOOST_TEST(group.advanced == 250u);
    BOOST_TEST(group.closer == 250u);
}

