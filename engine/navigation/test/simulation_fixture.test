BOOST_AUTO_TEST_CASE(long_replay_routes_repeat_on_static_twilight_terrain, *boost::unit_test::disabled()) {
    navigation::testing::Simulation simulation;
    simulation.loadTwilightFlame();
    unsigned repeats=16;
    if (const auto* configured=std::getenv("SAGE_NAVIGATION_ROUTE_REPEATS")) {
        char* end=nullptr;
        const auto value=std::strtoul(configured,&end,10);
        BOOST_REQUIRE(end!=configured && *end=='\0' && value>=2 && value<=4096);
        repeats=static_cast<unsigned>(value);
    }
    const auto* mode=std::getenv("SAGE_NAVIGATION_ROUTE_CAPTURED");
    const bool captured=mode && std::string_view(mode)=="1";
    const auto samples=simulation.longReplayRoutesOnStaticTerrain(repeats,std::getenv("SAGE_NAVIGATION_ROUTE_CSV"),captured);
    BOOST_REQUIRE(samples.size()==5u);
    // Independent reference captures: fixtures/dx9_twilight_routes. The first
    // three are unmodified DX9 outputs. The tanks require only increasing its
    // search-record pool; the modern solver must not inherit that fixed cap.
    // Work is implementation-specific, but every repeat must agree on it.
    const unsigned expectedNodes[]{361,371,324,478,471};
    const std::uint64_t expectedDigest[]{12132883142395869448ull,14605634901908253982ull,3702353680965788933ull,
        16046446919002575406ull,8741516313319190821ull};
    for (std::size_t i=0;i<samples.size();++i) {
        const auto& sample=samples[i];
        BOOST_TEST_CONTEXT(sample.unitType) {
            BOOST_TEST_MESSAGE("Replay terrain route: type=" << sample.unitType << " work=" << sample.work
                << " nodes=" << sample.nodes << " digest=" << sample.digest
                << " search_slices=" << sample.searchSlices << " maximum_slice_work=" << sample.maximumSliceWork
                << " maximum_pending_poll_work=" << sample.maximumPendingPollWork
                << " max_slice_ms=" << sample.maximumSearchSliceMilliseconds
                << " max_dispatch_ms=" << sample.maximumDispatchMilliseconds
                << " max_owner_poll_ms=" << sample.maximumOwnerPollMilliseconds
                << " first_ms=" << sample.firstMilliseconds << " maximum_warm_ms=" << sample.maximumWarmMilliseconds);
            BOOST_TEST(sample.found);
            BOOST_TEST(sample.repeatable);
            BOOST_TEST(sample.work>0u);
            BOOST_TEST(sample.nodes==expectedNodes[i]);
            BOOST_TEST(sample.digest==expectedDigest[i]);
            if (captured) {
                BOOST_TEST(sample.searchSlices>1u);
                BOOST_TEST(sample.maximumSliceWork<=10000u);
                BOOST_TEST(sample.maximumPendingPollWork==0u);
            }
        }
    }
}

