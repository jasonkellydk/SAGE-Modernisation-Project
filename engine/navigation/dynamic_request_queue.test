#include <boost/test/unit_test.hpp>
#include <cstdint>
#include <deque>
#include <set>

import engine.navigation.dynamic_request_queue;

BOOST_AUTO_TEST_SUITE(navigation_growing_request_queue)

BOOST_AUTO_TEST_CASE(accepts_one_hundred_thousand_units_without_dropping_requests)
{
    navigation::PathRequestQueue queue;
    for (std::uint32_t id = 1; id <= 100000; ++id) BOOST_REQUIRE(queue.push(id));
    for (std::uint32_t id = 1; id <= 100000; ++id) BOOST_TEST(!queue.push(id));
    BOOST_TEST(queue.size() == 100000U);
    for (std::uint32_t id = 1; id <= 100000; ++id) BOOST_TEST(queue.pop() == id);
    BOOST_TEST(queue.empty());
}

BOOST_AUTO_TEST_CASE(wrap_growth_and_tombstone_reuse_match_fifo_reference)
{
    navigation::PathRequestQueue queue;
    std::deque<std::uint32_t> fifo;
    std::set<std::uint32_t> membership;
    std::uint32_t random = 0x782192ab;
    for (int operation = 0; operation < 100000; ++operation) {
        random ^= random << 13; random ^= random >> 17; random ^= random << 5;
        if ((random & 3) && !fifo.empty()) {
            const auto id = fifo.front();
            fifo.pop_front();
            membership.erase(id);
            BOOST_TEST(queue.pop() == id);
        } else {
            const auto id = (random >> 8) % 1000;
            const bool added = membership.insert(id).second;
            if (added) fifo.push_back(id);
            BOOST_TEST(queue.push(id) == added);
        }
        BOOST_TEST(queue.size() == fifo.size());
    }
    for (auto id : fifo) BOOST_TEST(queue.pop() == id);
    queue.clear();
    for (std::uint32_t id = 1; id <= 64; ++id) queue.push(id);
    for (std::uint32_t id = 1; id <= 48; ++id) BOOST_TEST(queue.pop() == id);
    for (std::uint32_t id = 65; id <= 200; ++id) queue.push(id);
    for (std::uint32_t id = 49; id <= 200; ++id) BOOST_TEST(queue.pop() == id);
    for (auto id : {0U, 0xffffffffU, 0x80000000U, 1U}) BOOST_TEST(queue.push(id));
    for (auto id : {0U, 0xffffffffU, 0x80000000U, 1U}) BOOST_TEST(queue.pop() == id);
}

BOOST_AUTO_TEST_CASE(completing_active_requests_preserves_waiting_arrival_order) {
    navigation::PathRequestQueue queue;
    std::deque<std::uint32_t> expected;
    for (unsigned id=0;id<1000;++id) { queue.push(id);expected.push_back(id); }
    for (unsigned i=0;i<750;++i) { BOOST_TEST(queue.pop()==expected.front());expected.pop_front(); }
    for (unsigned id=1000;id<2000;++id) { queue.push(id);expected.push_back(id); }
    for (unsigned id:{750u,1000u,1999u,1500u,751u,1998u}) {
        BOOST_TEST(queue.erase(id));
        BOOST_TEST(!queue.contains(id));
        BOOST_TEST(!queue.erase(id));
        std::erase(expected,id);
        BOOST_TEST(queue.size()==expected.size());
        for (std::size_t i=0;i<expected.size();++i) BOOST_TEST(queue.at(i)==expected[i]);
    }
    for (const auto id:expected) BOOST_TEST(queue.pop()==id);
    BOOST_TEST(queue.empty());
    BOOST_TEST(queue.push(1500));BOOST_TEST(queue.erase(1500));BOOST_TEST(queue.empty());
}

BOOST_AUTO_TEST_SUITE_END()
