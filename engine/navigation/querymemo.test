#include <boost/test/unit_test.hpp>
#include <cstdint>
#include <limits>

import engine.navigation.querymemo;


BOOST_AUTO_TEST_CASE(ground_clearance_memo_is_scoped_and_keys_diameter_crushing_and_layer)
{
    navigation::GroundClearanceQueryMemo memo;
    int calls = 0, occupancy = 6;
    auto read = [&](int layer, int diameter, bool crusher) {
        return memo.evaluate(3, 4, layer, diameter, crusher, [&] { ++calls; return occupancy; });
    };
    {
        auto query = memo.begin(8, 8);
        for (int i=0;i<250;++i) BOOST_TEST(read(1,6,false)==6);
        BOOST_TEST(calls==1);
        BOOST_TEST(read(2,6,false)==6);
        BOOST_TEST(read(1,4,false)==6);
        BOOST_TEST(read(1,4,true)==6);
        BOOST_TEST(calls==4);
    }
    occupancy = 0;
    {
        auto query = memo.begin(8, 8);
        BOOST_TEST(read(1,6,false)==0);
        BOOST_TEST(calls==5);
    }
    occupancy = 4;
    BOOST_TEST(read(1,6,false)==4); // No verdict survives beyond the search.
    BOOST_TEST(calls==6);
    {
        auto query = memo.begin(16, 8);
        BOOST_TEST(read(1,6,false)==4);
        BOOST_TEST(calls==7);
    }
}
