#include <boost/test/unit_test.hpp>
#include <array>
#include <queue>
#include <vector>
import engine.navigation.topology.footprint_reachability;

BOOST_AUTO_TEST_CASE(footprint_components_match_independent_flood_fill_after_edits) {
    constexpr int width=17, height=13;
    std::vector<navigation::ReachabilityCell> map(width*height,{true,0});
    for (int y=0;y<height;++y) map[y*width+8].passable=false;
    map[6*width+8].passable=true;
    navigation::FootprintReachability cache;
    const auto read=[&](int x,int y) { return map[y*width+x]; };
    for (unsigned edit=0;edit<3;++edit) {
        if (edit) {
            map[7*width+8].passable=edit==1;
            cache.invalidate(8,7,8,7);
        }
        for (int radius=0;radius<=2;++radius) for (bool center:{false,true}) {
            cache.prepare(width,height,radius,center,read);
            const auto legal=[&](int x,int y) {
                for (int dy=-radius;dy<(radius+int(center)>0?radius+int(center):1);++dy)
                    for (int dx=-radius;dx<(radius+int(center)>0?radius+int(center):1);++dx) {
                        if (x+dx<0 || y+dy<0 || x+dx>=width || y+dy>=height ||
                            !map[(y+dy)*width+x+dx].passable) return false;
                    }
                return true;
            };
            std::vector<bool> seen(width*height);
            std::queue<std::array<int,2>> queue;
            queue.push({3,6}); seen[6*width+3]=true;
            while (!queue.empty()) {
                const auto p=queue.front(); queue.pop();
                for (int dy=-1;dy<=1;++dy) for (int dx=-1;dx<=1;++dx) {
                    const int x=p[0]+dx,y=p[1]+dy;
                    if (x<0 || y<0 || x>=width || y>=height || seen[y*width+x] || !legal(x,y)) continue;
                    seen[y*width+x]=true; queue.push({x,y});
                }
            }
            for (int y=0;y<height;++y) for (int x=0;x<width;++x)
                BOOST_TEST(cache.connected(3,6,x,y)==seen[y*width+x]);
        }
    }
}

BOOST_AUTO_TEST_CASE(footprint_portals_remain_optimistic_and_cached_reads_are_reused) {
    navigation::FootprintReachability cache;
    unsigned reads=0;
    const auto prepare=[&] { cache.prepare(15,9,1,false,[&](int x,int y) {
        ++reads;
        return navigation::ReachabilityCell{x<5 || x>9,
            static_cast<unsigned char>(y==4 && (x==4 || x==10)?1:0)};
    }); };
    prepare();
    BOOST_TEST(cache.connected(3,4,12,4));
    reads=0; prepare(); BOOST_TEST(reads==0u);
    cache.invalidate(7,4,7,4); prepare();
    BOOST_TEST(reads>0u);
    BOOST_TEST(cache.connected(3,4,12,4));
}
